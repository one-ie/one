# Cloudflare Pages Configuration for ONE Platform
# Copy this file to wrangler.toml and customize for your organization

name = "web"
pages_build_output_dir = "dist"
compatibility_date = "2024-09-25"
compatibility_flags = ["nodejs_compat"]

# Environment variables for your organization
# CUSTOMIZE THESE VALUES for your organization
[vars]
NODE_VERSION = "22.16.0"

# Frontend Onboarding System (v3.6.0+)
# CHANGE THESE to match your organization
ORG_NAME = "your-org-name"              # Your organization name (NOT "one")
ORG_WEBSITE = "https://yoursite.com"    # Your organization website (NOT "https://one.ie")
ORG_FOLDER = "your-org-folder"          # Your organization folder (NOT "onegroup")
ONE_BACKEND = "off"                      # "off" = frontend-only, "on" = full platform

# Backend Configuration (only if ONE_BACKEND="on")
# If you're using Convex backend, add these:
# PUBLIC_CONVEX_URL = "https://your-deployment.convex.cloud"
# CONVEX_DEPLOYMENT = "prod:your-deployment-name"

# OAuth Configuration (optional)
# If you're using GitHub/Google OAuth, add:
# GITHUB_CLIENT_ID = "your-github-client-id"
# GOOGLE_CLIENT_ID = "your-google-client-id"

# Session Storage (optional)
# If you need session storage, create a KV namespace in Cloudflare dashboard:
# [[kv_namespaces]]
# binding = "SESSION"
# id = "your-kv-namespace-id"

# Production environment
[env.production]
[env.production.vars]
NODE_VERSION = "22.16.0"
ORG_NAME = "your-org-name"
ORG_WEBSITE = "https://yoursite.com"
ORG_FOLDER = "your-org-folder"
ONE_BACKEND = "off"

# Preview environment
[env.preview]
[env.preview.vars]
NODE_VERSION = "22.16.0"
ORG_NAME = "your-org-name"
ORG_WEBSITE = "https://yoursite.com"
ORG_FOLDER = "your-org-folder"
ONE_BACKEND = "off"

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# QUICK START
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#
# 1. Copy this file: cp wrangler.toml.example wrangler.toml
# 2. Change ORG_NAME, ORG_WEBSITE, ORG_FOLDER above
# 3. Build: bun run build
# 4. Deploy: wrangler pages deploy dist --project-name=your-project
#
# Your site will show a branded "Get Started" prompt with
# your organization name and website.
#
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# RESERVED VALUES (DO NOT USE)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#
# These are reserved for ONE Platform:
# - ORG_NAME="one"
# - ORG_WEBSITE="https://one.ie"
# - ORG_FOLDER="onegroup"
#
# The CLI will reject these values during setup.
#
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
