---
export const prerender = true
import Layout from '../layouts/Layout.astro'
import { Chat } from '../components/Chat'
---

<Layout title="Chat — ONE" sidebar="mini" chat="none" chatLock>
  <Fragment slot="head">
    <link rel="preconnect" href="/api/chat" />
    <link rel="dns-prefetch" href="/api/chat" />
    <link rel="preload" as="image" href="/icon.svg" />
  </Fragment>
  <div class="h-[100dvh] overflow-hidden">
    <Chat client:idle fullPage />
  </div>
</Layout>
