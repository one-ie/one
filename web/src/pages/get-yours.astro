---
import Layout from '@/layouts/Layout.astro'
import { GetYoursButton } from '@/components/GetYoursButton'
---

<Layout title="Get yours — ONE" sidebar="none" chat="none">
  <main class="min-h-screen flex flex-col items-center justify-center gap-8 px-4">
    <div class="text-center max-w-md">
      <h1 class="text-4xl font-bold mb-3">Your own AI space</h1>
      <p class="text-font/60 text-lg mb-8">Sign in with your device. No password, no account. Your keys, your agents.</p>
      <GetYoursButton client:load />
    </div>
  </main>
</Layout>
