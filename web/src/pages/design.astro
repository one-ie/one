---
import Layout from '../layouts/Layout.astro'
import { IconBadge } from '../components/ui/IconBadge'
import { Icon } from '../components/ui/Icon'
import { Zap, Brain, Coins, Code2, Send, Check, Search, Settings, Bell, Heart, ArrowRight, X } from 'lucide-react'
import { CardShowcase } from '../components/showcase/CardShowcase'
import { ChatDock } from '../components/chat/ChatDock'
---

<Layout title="ONE Design System">
  <main class="design-page">
    <header class="hero">
      <h1>ONE Design System</h1>
      <p>
        6 editable tokens. 3 depth levels. 1 card. 1 input. Every component derives from these — pick a token,
        the whole system responds. Spec lives in <code>design.md</code>.
      </p>
      <div class="controls">
        <div class="mode-toggle" role="group" aria-label="Theme mode">
          <button data-mode="light" type="button">
            <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/>
            </svg>
            Light
          </button>
          <button data-mode="dark" type="button" aria-pressed="true">
            <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
            </svg>
            Dark
          </button>
        </div>
        <button class="reset-btn" type="button" id="theme-reset">
          <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/>
          </svg>
          Reset
        </button>
      </div>
    </header>

    <!-- ============== TOKENS ============== -->
    <section class="block">
      <div class="block-head">
        <h2>The 6 editable tokens</h2>
        <p>Click any swatch to recolor live. Picks persist to <code>localStorage</code>.</p>
      </div>

      <p class="picker-hint muted small">
        Surface tokens (background · foreground · font) flip with mode — picks apply to the
        <strong data-mode-label>dark</strong> mode you're viewing. Brand tokens apply to both.
      </p>

      <ul class="tokens" id="token-list">
        <li data-token-row="background">
          <label class="swatch-pick" data-token="background" data-mode="surface">
            <span class="swatch" data-swatch="background"></span>
            <input type="color" value="#1a1a1a" />
          </label>
          <div class="meta">
            <strong>background</strong>
            <span class="muted">L1 surface — cards, sidebar, popovers</span>
          </div>
          <div class="hex"><code data-hex="background">#1a1a1a</code></div>
        </li>
        <li data-token-row="foreground">
          <label class="swatch-pick" data-token="foreground" data-mode="surface">
            <span class="swatch" data-swatch="foreground"></span>
            <input type="color" value="#212121" />
          </label>
          <div class="meta">
            <strong>foreground</strong>
            <span class="muted">L2 surface — card body, inputs, code</span>
          </div>
          <div class="hex"><code data-hex="foreground">#212121</code></div>
        </li>
        <li data-token-row="font">
          <label class="swatch-pick" data-token="font" data-mode="surface">
            <span class="swatch swatch-font" data-swatch="font">Aa</span>
            <input type="color" value="#ffffff" />
          </label>
          <div class="meta">
            <strong>font</strong>
            <span class="muted">Body text — derives border · muted · faint</span>
          </div>
          <div class="hex"><code data-hex="font">#ffffff</code></div>
        </li>
        <li data-token-row="primary">
          <label class="swatch-pick" data-token="primary" data-mode="both">
            <span class="swatch" data-swatch="primary"></span>
            <input type="color" value="#1d3a66" />
          </label>
          <div class="meta">
            <strong>primary</strong>
            <span class="muted">Main CTA — also focus ring (both modes)</span>
          </div>
          <div class="hex"><code data-hex="primary">#1d3a66</code></div>
        </li>
        <li data-token-row="secondary">
          <label class="swatch-pick" data-token="secondary" data-mode="both">
            <span class="swatch" data-swatch="secondary"></span>
            <input type="color" value="#3d4451" />
          </label>
          <div class="meta">
            <strong>secondary</strong>
            <span class="muted">Supporting actions (both modes)</span>
          </div>
          <div class="hex"><code data-hex="secondary">#3d4451</code></div>
        </li>
        <li data-token-row="tertiary">
          <label class="swatch-pick" data-token="tertiary" data-mode="both">
            <span class="swatch" data-swatch="tertiary"></span>
            <input type="color" value="#324e32" />
          </label>
          <div class="meta">
            <strong>tertiary</strong>
            <span class="muted">Accent · success-tinted (both modes)</span>
          </div>
          <div class="hex"><code data-hex="tertiary">#324e32</code></div>
        </li>
      </ul>

      <div class="invariants-row">
        <span class="muted small">Invariants —</span>
        <span class="chip"><span class="dot" style="background: var(--color-destructive);"></span>destructive</span>
        <span class="chip"><span class="dot" style="background: var(--color-success);"></span>success</span>
        <span class="chip"><span class="dot dot-bordered" style="background: var(--color-white);"></span>white</span>
        <span class="chip"><span class="dot" style="background: var(--color-black);"></span>black</span>
        <span class="muted small">+ derived: <code>{'on-{primary,secondary,tertiary}'}</code> · <code>border</code> · <code>muted</code> · <code>page</code></span>
      </div>
    </section>

    <!-- ============== DEPTH ============== -->
    <section class="block">
      <div class="block-head">
        <h2>Three levels of depth</h2>
        <p>Page (L0) → card (L1) → content (L2). No 4th level. Sidebar = L1. Inputs = L2.</p>
      </div>

      <div class="depth">
        <span class="depth-label">L0 page · <code>--color-page</code></span>
        <div class="depth-card">
          <span class="depth-label inv">L1 card · <code>--color-background</code></span>
          <div class="depth-inner">
            <span class="depth-label inv">L2 content · <code>--color-foreground</code></span>
          </div>
        </div>
      </div>
    </section>

    <!-- ============== ANATOMY (CARD + APP SHELL) ============== -->
    <section class="grid-2">
      <!-- Card anatomy -->
      <article class="card">
        <header class="card-head">
          <div>
            <h3>Card anatomy</h3>
            <p class="muted small">Header · body · footer share one card surface</p>
          </div>
          <span class="badge">L1</span>
        </header>

        <div class="card-body">
          <div class="row">
            <strong>Body rectangle</strong>
            <span class="muted small">L2 — where data lives</span>
          </div>
          <ul class="data-list">
            <li><span>Strength</span><span class="mono">0.84</span></li>
            <li><span>Resistance</span><span class="mono">0.12</span></li>
            <li><span>Cycles</span><span class="mono">128</span></li>
          </ul>
        </div>

        <footer class="card-foot">
          <span class="muted small">Updated 2m ago</span>
          <div class="row-end">
            <button class="btn ghost">Cancel</button>
            <button class="btn primary">Save</button>
          </div>
        </footer>
      </article>

      <!-- App shell mock: sidebar + content -->
      <article class="card shell">
        <header class="card-head">
          <div>
            <h3>App shell</h3>
            <p class="muted small">Sidebar = L1 (card pinned to edge)</p>
          </div>
          <span class="badge">layout</span>
        </header>

        <div class="shell-frame">
          <aside class="shell-side">
            <div class="shell-brand">ONE</div>
            <nav class="shell-nav">
              <a class="shell-link active" href="#"><span class="shell-dot"></span> Home</a>
              <a class="shell-link" href="#"><span class="shell-dot"></span> Agents</a>
              <a class="shell-link" href="#"><span class="shell-dot"></span> Wallet</a>
              <a class="shell-link" href="#"><span class="shell-dot"></span> Settings</a>
            </nav>
          </aside>
          <section class="shell-main">
            <div class="shell-row"></div>
            <div class="shell-row short"></div>
            <div class="shell-row"></div>
          </section>
        </div>
      </article>
    </section>

    <!-- ============== FORMS ============== -->
    <section class="grid-2">
      <article class="card">
        <header class="card-head">
          <div>
            <h3>Form controls</h3>
            <p class="muted small">All inputs share one shape · L2 surface · 10px radius</p>
          </div>
          <span class="badge">forms</span>
        </header>

        <div class="card-body form">
          <div class="field">
            <label for="f-name">Name</label>
            <input id="f-name" type="text" placeholder="Ada Lovelace" />
            <span class="helper">Shown on your public profile</span>
          </div>

          <div class="field">
            <label for="f-email">Email <span class="req">*</span></label>
            <input id="f-email" type="email" value="not-an-email" aria-invalid="true" />
            <span class="error">Enter a valid email address</span>
          </div>

          <div class="field">
            <label for="f-role">Role</label>
            <div class="select-wrap">
              <select id="f-role">
                <option>Engineer</option>
                <option>Designer</option>
                <option>Operator</option>
              </select>
              <svg class="select-chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m6 9 6 6 6-6"/>
              </svg>
            </div>
          </div>

          <div class="field">
            <label for="f-bio">Bio</label>
            <textarea id="f-bio" rows="3" placeholder="One sentence about your work…"></textarea>
          </div>

          <div class="row-between">
            <label class="check">
              <input type="checkbox" checked />
              <span class="check-box"></span>
              <span>Subscribe to release notes</span>
            </label>

            <label class="switch">
              <input type="checkbox" checked />
              <span class="switch-track"><span class="switch-knob"></span></span>
              <span>Public</span>
            </label>
          </div>
        </div>

        <footer class="card-foot">
          <span class="muted small">Auto-saves on blur</span>
          <div class="row-end">
            <button class="btn ghost">Discard</button>
            <button class="btn primary">Save profile</button>
          </div>
        </footer>
      </article>

      <!-- Buttons + state -->
      <article class="card">
        <header class="card-head">
          <div>
            <h3>Buttons & states</h3>
            <p class="muted small">6 variants. <code>on-*</code> labels auto-contrast.</p>
          </div>
          <span class="badge">buttons</span>
        </header>

        <div class="card-body buttons-grid">
          <button class="btn primary">Primary</button>
          <button class="btn secondary">Secondary</button>
          <button class="btn tertiary">Tertiary</button>
          <button class="btn outline">Outline</button>
          <button class="btn ghost">Ghost</button>
          <button class="btn inverse">Inverse</button>

          <button class="btn primary" disabled>Disabled</button>
          <button class="btn primary loading">Loading…</button>
          <button class="btn destructive">Delete</button>
        </div>

        <footer class="card-foot">
          <span class="muted small">All buttons: 10px radius · 120ms ease · ring focus</span>
        </footer>
      </article>
    </section>

    <!-- ============== ICONS ============== -->
    <section class="block">
      <div class="block-head">
        <h2>Icons</h2>
        <p>One source: <code>lucide-react</code>. 1.5px stroke · round caps · token-driven color. Wrap with <code>{'<Icon>'}</code> or <code>{'<IconBadge>'}</code>.</p>
      </div>

      <div class="grid-2">
        <article class="card pad">
          <h3 class="card-title">IconBadge — tones</h3>
          <p class="muted small" style="margin-bottom: 16px">Used in feature grids, list items, profile rows.</p>
          <div class="badge-row">
            <div class="badge-cell">
              <IconBadge icon={Zap} tone="primary" size="md" />
              <code class="muted small">primary</code>
            </div>
            <div class="badge-cell">
              <IconBadge icon={Brain} tone="tertiary" size="md" />
              <code class="muted small">tertiary</code>
            </div>
            <div class="badge-cell">
              <IconBadge icon={Coins} tone="secondary" size="md" />
              <code class="muted small">secondary</code>
            </div>
            <div class="badge-cell">
              <IconBadge icon={Code2} tone="neutral" size="md" />
              <code class="muted small">neutral</code>
            </div>
          </div>

          <div style="height: 16px"></div>
          <p class="muted small" style="margin-bottom: 12px">Sizes — sm · md · lg</p>
          <div class="badge-row">
            <IconBadge icon={Heart} tone="tertiary" size="sm" />
            <IconBadge icon={Heart} tone="tertiary" size="md" />
            <IconBadge icon={Heart} tone="tertiary" size="lg" />
          </div>
        </article>

        <article class="card pad">
          <h3 class="card-title">Icon — sizes</h3>
          <p class="muted small" style="margin-bottom: 16px">Inline icons. Inherit color from parent via <code>currentColor</code>.</p>
          <div class="icon-row">
            <span class="icon-cell"><Icon icon={Search} size="sm" /><code class="muted small">sm · 14</code></span>
            <span class="icon-cell"><Icon icon={Search} size="md" /><code class="muted small">md · 16</code></span>
            <span class="icon-cell"><Icon icon={Search} size="lg" /><code class="muted small">lg · 20</code></span>
            <span class="icon-cell"><Icon icon={Search} size="xl" /><code class="muted small">xl · 24</code></span>
          </div>

          <div style="height: 16px"></div>
          <p class="muted small" style="margin-bottom: 12px">In context</p>
          <div class="icon-context">
            <button class="btn primary inline-btn">
              <Icon icon={Send} size="md" />
              Send message
            </button>
            <button class="btn outline inline-btn">
              <Icon icon={Settings} size="md" />
              Settings
            </button>
            <button class="btn ghost inline-btn">
              <Icon icon={Bell} size="md" />
              Notifications
            </button>
          </div>
        </article>
      </div>
    </section>

    <!-- ============== POLISH SCALE ============== -->
    <section class="block">
      <div class="block-head">
        <h2>Polish constants</h2>
        <p>Baked into components. Not editable. Snap to scale or polish breaks.</p>
      </div>

      <div class="grid-3">
        <article class="card pad">
          <h3 class="card-title">Radius</h3>
          <div class="scale">
            <div class="scale-row"><span class="rad rad-sm"></span><code>--radius-sm</code><span class="muted small">6px · chips</span></div>
            <div class="scale-row"><span class="rad rad-md"></span><code>--radius-md</code><span class="muted small">10px · buttons, inputs</span></div>
            <div class="scale-row"><span class="rad rad-lg"></span><code>--radius-lg</code><span class="muted small">16px · cards</span></div>
          </div>
        </article>

        <article class="card pad">
          <h3 class="card-title">Shadow</h3>
          <div class="scale">
            <div class="scale-row"><span class="shad shad-card"></span><code>--shadow-card</code><span class="muted small">cards, popovers</span></div>
            <div class="scale-row"><span class="shad shad-pop"></span><code>--shadow-pop</code><span class="muted small">menus, modals</span></div>
          </div>
        </article>

        <article class="card pad">
          <h3 class="card-title">Spacing</h3>
          <div class="space-row">
            <span class="sp" style="width: 4px"></span>
            <span class="sp" style="width: 8px"></span>
            <span class="sp" style="width: 12px"></span>
            <span class="sp" style="width: 16px"></span>
            <span class="sp" style="width: 20px"></span>
            <span class="sp" style="width: 24px"></span>
            <span class="sp" style="width: 32px"></span>
          </div>
          <p class="muted small">4 · 8 · 12 · 16 · 20 · 24 · 32 — every padding/gap lands here.</p>
        </article>
      </div>
    </section>

    <!-- ============== CARD VOCABULARY ============== -->
    <section class="block mt-20 mb-16">
      <div class="block-head">
        <h2>Card Vocabulary</h2>
        <p>13 card types. Every surface in the product derives from one of these shapes.</p>
      </div>
      <div id="card-showcase-root"></div>
      <CardShowcase client:idle />
    </section>

    <ChatDock surface="design" client:idle />

    <footer class="footer muted">
      6 tokens · 3 depths · 1 card · 1 input · 6 button variants · one palette per workspace
    </footer>
  </main>

  <script is:inline>
    const html = document.documentElement
    const STORAGE = 'one:theme'
    const TOKENS = ['background', 'foreground', 'font', 'primary', 'secondary', 'tertiary']
    const DEFAULT = {
      mode: 'dark',
      light: { background: '0 0% 93%', foreground: '0 0% 100%', font: '0 0% 13%',
               primary: '216 55% 25%', secondary: '219 14% 28%', tertiary: '105 22% 25%' },
      dark:  { background: '0 0% 10%', foreground: '0 0% 13%', font: '0 0% 100%',
               primary: '216 55% 25%', secondary: '219 14% 28%', tertiary: '105 22% 25%' },
    }

    const load = () => {
      try {
        const t = JSON.parse(localStorage.getItem(STORAGE) || 'null')
        if (t && t.light && t.dark) return t
      } catch {}
      return JSON.parse(JSON.stringify(DEFAULT))
    }

    const save = (t) => localStorage.setItem(STORAGE, JSON.stringify(t))

    const onLabel = (hsl) => (parseFloat(hsl.split(/\s+/)[2]) < 60 ? '#fff' : '#000')

    const apply = (t) => {
      const rule = (sel, set) => {
        const decls = TOKENS.map((k) => '--color-' + k + ':hsl(' + set[k] + ')')
        ;['primary', 'secondary', 'tertiary'].forEach((b) =>
          decls.push('--color-on-' + b + ':' + onLabel(set[b])),
        )
        return sel + '{' + decls.join(';') + '}'
      }
      let s = document.getElementById('theme-overrides')
      if (!s) { s = document.createElement('style'); s.id = 'theme-overrides'; document.head.appendChild(s) }
      s.textContent = rule(':root', t.light) + rule('html.dark', t.dark)
    }

    const hexToHsl = (hex) => {
      const r = parseInt(hex.slice(1, 3), 16) / 255
      const g = parseInt(hex.slice(3, 5), 16) / 255
      const b = parseInt(hex.slice(5, 7), 16) / 255
      const max = Math.max(r, g, b), min = Math.min(r, g, b)
      const l = (max + min) / 2
      let h = 0, s = 0
      if (max !== min) {
        const d = max - min
        s = l > 0.5 ? d / (2 - max - min) : d / (max + min)
        if (max === r) h = ((g - b) / d + (g < b ? 6 : 0))
        else if (max === g) h = (b - r) / d + 2
        else h = (r - g) / d + 4
        h *= 60
      }
      return Math.round(h) + ' ' + Math.round(s * 100) + '% ' + Math.round(l * 100) + '%'
    }

    const hslToHex = (hsl) => {
      const [hStr, sStr, lStr] = hsl.split(/\s+/)
      const h = parseFloat(hStr), s = parseFloat(sStr) / 100, l = parseFloat(lStr) / 100
      const c = (1 - Math.abs(2 * l - 1)) * s
      const x = c * (1 - Math.abs(((h / 60) % 2) - 1))
      const m = l - c / 2
      let r = 0, g = 0, b = 0
      if (h < 60)       [r, g, b] = [c, x, 0]
      else if (h < 120) [r, g, b] = [x, c, 0]
      else if (h < 180) [r, g, b] = [0, c, x]
      else if (h < 240) [r, g, b] = [0, x, c]
      else if (h < 300) [r, g, b] = [x, 0, c]
      else              [r, g, b] = [c, 0, 0]
      const toHex = (v) => Math.round((v + m) * 255).toString(16).padStart(2, '0')
      return '#' + toHex(r) + toHex(g) + toHex(b)
    }

    const currentMode = () => (html.classList.contains('dark') ? 'dark' : 'light')

    const syncUI = (t) => {
      const mode = currentMode()
      document.querySelectorAll('[data-swatch]').forEach((el) => {
        const token = el.dataset.swatch
        const val = t[mode][token]
        if (token === 'font') {
          el.style.color = 'hsl(' + val + ')'
          el.style.background = 'hsl(' + t[mode].foreground + ')'
        } else {
          el.style.background = 'hsl(' + val + ')'
        }
      })
      document.querySelectorAll('[data-hex]').forEach((el) => {
        el.textContent = hslToHex(t[mode][el.dataset.hex])
      })
      document.querySelectorAll('.swatch-pick input[type=color]').forEach((input) => {
        const token = input.closest('.swatch-pick').dataset.token
        input.value = hslToHex(t[mode][token])
      })
      const ml = document.querySelector('[data-mode-label]')
      if (ml) ml.textContent = mode
    }

    let theme = load()
    apply(theme)

    const buttons = document.querySelectorAll('.mode-toggle button')

    const applyMode = (mode) => {
      html.classList.toggle('dark', mode === 'dark')
      buttons.forEach((x) => x.setAttribute('aria-pressed', String(x.dataset.mode === mode)))
      syncUI(theme)
    }

    applyMode(theme.mode || 'dark')

    document.querySelectorAll('.swatch-pick').forEach((label) => {
      const input = label.querySelector('input[type=color]')
      const token = label.dataset.token
      const scope = label.dataset.mode  // 'surface' | 'both'
      const handler = () => {
        const hsl = hexToHsl(input.value)
        if (scope === 'both') {
          theme.light[token] = hsl
          theme.dark[token] = hsl
        } else {
          theme[currentMode()][token] = hsl
        }
        apply(theme)
        save(theme)
        syncUI(theme)
      }
      // Fire on both — Safari only fires `change` for color picker close.
      input.addEventListener('input', handler)
      input.addEventListener('change', handler)
    })

    document.getElementById('theme-reset').addEventListener('click', () => {
      localStorage.removeItem(STORAGE)
      const s = document.getElementById('theme-overrides')
      if (s) s.remove()
      theme = JSON.parse(JSON.stringify(DEFAULT))
      applyMode(theme.mode)
    })

    buttons.forEach((b) => {
      b.addEventListener('click', () => {
        theme.mode = b.dataset.mode
        applyMode(theme.mode)
        save(theme)
      })
    })
  </script>
</Layout>

<style is:global>
  /* =====================================================================
     ONE Design System — showcase
     Body bg comes from Layout (--color-page). No body:has() hacks here.
     Every surface uses tokens or var()-derived helpers. No off-scale values.
     ===================================================================== */

  .design-page {
    max-width: 1200px;
    margin: 0 auto;
    padding: 64px 32px 96px;
    color: var(--color-font);
    font-size: 15px;
    line-height: 1.55;
  }
  .design-page * { box-sizing: border-box; }

  /* ---------- Hero ---------- */
  .design-page .hero { text-align: center; margin-bottom: 64px; }
