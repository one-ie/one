---
import Layout from '../layouts/Layout.astro'
---

<Layout title="ONE Design System">
  <main class="design-page">
    <header class="hero">
      <h1>ONE Design System</h1>
      <p>
        6 colors. Extract from any site. Apply everywhere. Built on shadcn/ui.
        Simplified to 6 extractable tokens.
      </p>
      <div class="controls">
        <div class="mode-toggle" role="group" aria-label="Theme mode">
          <button data-mode="light" type="button">
            <span aria-hidden="true">☀</span> Light
          </button>
          <button data-mode="dark" type="button" aria-pressed="true">
            <span aria-hidden="true">☾</span> Dark
          </button>
        </div>
        <button class="reset-btn" type="button" id="theme-reset">Reset</button>
      </div>
    </header>

    <section class="grid">
      <div class="col">
        <h2>The 6 Extractable Colors</h2>
        <p class="muted">Extract from any website. Map to these 6 tokens. Apply everywhere.</p>

        <ul class="tokens" id="token-list">
          <li>
            <label class="swatch-pick" data-token="background" data-mode="light">
              <span class="swatch" data-swatch="background:light" style="background: hsl(0 0% 93%);"></span>
              <input type="color" value="#ededed" />
            </label>
            <label class="swatch-pick" data-token="background" data-mode="dark">
              <span class="swatch" data-swatch="background:dark" style="background: hsl(0 0% 10%);"></span>
              <input type="color" value="#1a1a1a" />
            </label>
            <div class="meta">
              <strong>background</strong>
              <span class="muted">Card surface · Sidebar color</span>
            </div>
            <div class="hsl">
              <span>Light: <code data-hsl="background:light">0 0% 93%</code></span>
              <span>Dark: <code data-hsl="background:dark">0 0% 10%</code></span>
            </div>
          </li>
          <li>
            <label class="swatch-pick" data-token="foreground" data-mode="light">
              <span class="swatch" data-swatch="foreground:light" style="background: hsl(0 0% 100%);"></span>
              <input type="color" value="#ffffff" />
            </label>
            <label class="swatch-pick" data-token="foreground" data-mode="dark">
              <span class="swatch" data-swatch="foreground:dark" style="background: hsl(0 0% 13%);"></span>
              <input type="color" value="#212121" />
            </label>
            <div class="meta">
              <strong>foreground</strong>
              <span class="muted">Content area inside card</span>
            </div>
            <div class="hsl">
              <span>Light: <code data-hsl="foreground:light">0 0% 100%</code></span>
              <span>Dark: <code data-hsl="foreground:dark">0 0% 13%</code></span>
            </div>
          </li>
          <li>
            <label class="swatch-pick" data-token="font" data-mode="light">
              <span class="swatch font-light" data-swatch="font:light">Aa</span>
              <input type="color" value="#212121" />
            </label>
            <label class="swatch-pick" data-token="font" data-mode="dark">
              <span class="swatch font-dark" data-swatch="font:dark">Aa</span>
              <input type="color" value="#ffffff" />
            </label>
            <div class="meta">
              <strong>font</strong>
              <span class="muted">Text color · Readable in both modes</span>
            </div>
            <div class="hsl">
              <span>Light: <code data-hsl="font:light">0 0% 13%</code></span>
              <span>Dark: <code data-hsl="font:dark">0 0% 100%</code></span>
            </div>
          </li>
          <li>
            <label class="swatch-pick" data-token="primary" data-mode="both">
              <span class="swatch" data-swatch="primary:both" style="background: hsl(216 55% 25%);"></span>
              <input type="color" value="#1d3a66" />
            </label>
            <div class="meta wide">
              <strong>primary</strong>
              <span class="muted">Main CTA · Buttons</span>
            </div>
            <div class="hsl"><code data-hsl="primary:both">216 55% 25%</code></div>
          </li>
          <li>
            <label class="swatch-pick" data-token="secondary" data-mode="both">
              <span class="swatch" data-swatch="secondary:both" style="background: hsl(219 14% 28%);"></span>
              <input type="color" value="#3d4451" />
            </label>
            <div class="meta wide">
              <strong>secondary</strong>
              <span class="muted">Supporting actions</span>
            </div>
            <div class="hsl"><code data-hsl="secondary:both">219 14% 28%</code></div>
          </li>
          <li>
            <label class="swatch-pick" data-token="tertiary" data-mode="both">
              <span class="swatch" data-swatch="tertiary:both" style="background: hsl(105 22% 25%);"></span>
              <input type="color" value="#324e32" />
            </label>
            <div class="meta wide">
              <strong>tertiary</strong>
              <span class="muted">Accent · Was "accent"</span>
            </div>
            <div class="hsl"><code data-hsl="tertiary:both">105 22% 25%</code></div>
          </li>
        </ul>

        <div class="note">
          <strong>Invariants — never editable</strong>
          <div class="invariants">
            <span class="chip"><span class="dot" style="background: var(--color-destructive);"></span>destructive</span>
            <span class="chip"><span class="dot" style="background: var(--color-success);"></span>success</span>
            <span class="chip"><span class="dot" style="background: var(--color-white); border: 1px solid var(--color-border);"></span>white</span>
            <span class="chip"><span class="dot" style="background: var(--color-black);"></span>black</span>
          </div>
          <span class="muted">
            Auto-derived: <code>{'--color-on-{primary,secondary,tertiary}'}</code> (auto-contrast),
            <code>--color-border</code>, <code>--color-muted</code>, <code>--color-ring</code>.
          </span>
        </div>
      </div>

      <div class="col">
        <h2>Cards + Buttons (shadcn)</h2>
        <p class="muted">Cards use background/foreground. Buttons use primary/secondary/tertiary.</p>

        <article class="card">
          <header class="card-head">
            <div>
              <h3>Product Thing</h3>
              <p class="muted">
                Card uses <code>background</code> with <code>foreground</code> content area
              </p>
            </div>
            <span class="badge">product</span>
          </header>

          <div class="content-area">
            <strong>Content Area</strong>
            <span class="muted">This uses foreground color</span>
          </div>

          <p class="price">$299</p>

          <div class="buttons">
            <button class="btn primary">Primary Button</button>
            <button class="btn secondary">Secondary Button</button>
            <button class="btn tertiary">Tertiary Button</button>
            <button class="btn outline">Outline Button</button>
            <button class="btn ghost">Ghost Button</button>
            <button class="btn inverse">Inverse Button</button>
          </div>
        </article>
      </div>
    </section>

    <footer class="footer muted">
      6 tokens · 6 button variants · 1 card shape · One palette per workspace
    </footer>
  </main>

  <script is:inline>
    const html = document.documentElement
    const STORAGE = 'one:theme'
    const TOKENS = ['background', 'foreground', 'font', 'primary', 'secondary', 'tertiary']
    const DEFAULT = {
      mode: 'dark',
      light: { background: '0 0% 93%', foreground: '0 0% 100%', font: '0 0% 13%',
               primary: '216 55% 25%', secondary: '219 14% 28%', tertiary: '105 22% 25%' },
      dark:  { background: '0 0% 10%', foreground: '0 0% 13%', font: '0 0% 100%',
               primary: '216 55% 25%', secondary: '219 14% 28%', tertiary: '105 22% 25%' },
    }

    const load = () => {
      try {
        const t = JSON.parse(localStorage.getItem(STORAGE) || 'null')
        if (t && t.light && t.dark) return t
      } catch {}
      return JSON.parse(JSON.stringify(DEFAULT))
    }

    const save = (t) => localStorage.setItem(STORAGE, JSON.stringify(t))

    const onLabel = (hsl) => (parseFloat(hsl.split(/\s+/)[2]) < 60 ? '#fff' : '#000')

    const apply = (t) => {
      const rule = (sel, set) => {
        const decls = TOKENS.map((k) => '--color-' + k + ':hsl(' + set[k] + ')')
        ;['primary', 'secondary', 'tertiary'].forEach((b) =>
          decls.push('--color-on-' + b + ':' + onLabel(set[b])),
        )
        return sel + '{' + decls.join(';') + '}'
      }
      let s = document.getElementById('theme-overrides')
      if (!s) { s = document.createElement('style'); s.id = 'theme-overrides'; document.head.appendChild(s) }
      s.textContent = rule(':root', t.light) + rule('html.dark', t.dark)
    }

    // hex (#rrggbb) -> "H S% L%"
    const hexToHsl = (hex) => {
      const r = parseInt(hex.slice(1, 3), 16) / 255
      const g = parseInt(hex.slice(3, 5), 16) / 255
      const b = parseInt(hex.slice(5, 7), 16) / 255
      const max = Math.max(r, g, b), min = Math.min(r, g, b)
      const l = (max + min) / 2
      let h = 0, s = 0
      if (max !== min) {
        const d = max - min
        s = l > 0.5 ? d / (2 - max - min) : d / (max + min)
        if (max === r) h = ((g - b) / d + (g < b ? 6 : 0))
        else if (max === g) h = (b - r) / d + 2
        else h = (r - g) / d + 4
        h *= 60
      }
      return Math.round(h) + ' ' + Math.round(s * 100) + '% ' + Math.round(l * 100) + '%'
    }

    // "H S% L%" -> "#rrggbb"
    const hslToHex = (hsl) => {
      const [hStr, sStr, lStr] = hsl.split(/\s+/)
      const h = parseFloat(hStr), s = parseFloat(sStr) / 100, l = parseFloat(lStr) / 100
      const c = (1 - Math.abs(2 * l - 1)) * s
      const x = c * (1 - Math.abs(((h / 60) % 2) - 1))
      const m = l - c / 2
      let r = 0, g = 0, b = 0
      if (h < 60)       [r, g, b] = [c, x, 0]
      else if (h < 120) [r, g, b] = [x, c, 0]
      else if (h < 180) [r, g, b] = [0, c, x]
      else if (h < 240) [r, g, b] = [0, x, c]
      else if (h < 300) [r, g, b] = [x, 0, c]
      else              [r, g, b] = [c, 0, 0]
      const toHex = (v) => Math.round((v + m) * 255).toString(16).padStart(2, '0')
      return '#' + toHex(r) + toHex(g) + toHex(b)
    }

    const syncUI = (t) => {
      document.querySelectorAll('[data-swatch]').forEach((el) => {
        const [token, mode] = el.dataset.swatch.split(':')
        const val = mode === 'both' ? t.light[token] : t[mode][token]
        if (token === 'font') {
          el.style.color = 'hsl(' + val + ')'
          el.style.background = 'hsl(' + t[mode].foreground + ')'
        } else {
          el.style.background = 'hsl(' + val + ')'
        }
      })
      document.querySelectorAll('[data-hsl]').forEach((el) => {
        const [token, mode] = el.dataset.hsl.split(':')
        el.textContent = mode === 'both' ? t.light[token] : t[mode][token]
      })
      document.querySelectorAll('.swatch-pick input[type=color]').forEach((input) => {
        const label = input.closest('.swatch-pick')
        const token = label.dataset.token, mode = label.dataset.mode
        const val = mode === 'both' ? t.light[token] : t[mode][token]
        input.value = hslToHex(val)
      })
    }

    let theme = load()
    apply(theme)
    syncUI(theme)

    document.querySelectorAll('.swatch-pick').forEach((label) => {
      const input = label.querySelector('input[type=color]')
      const token = label.dataset.token, mode = label.dataset.mode
      input.addEventListener('input', () => {
        const hsl = hexToHsl(input.value)
        if (mode === 'both') { theme.light[token] = hsl; theme.dark[token] = hsl }
        else theme[mode][token] = hsl
        apply(theme)
        save(theme)
        syncUI(theme)
      })
    })

    const buttons = document.querySelectorAll('.mode-toggle button')

    const applyMode = (mode) => {
      html.classList.toggle('dark', mode === 'dark')
      buttons.forEach((x) => x.setAttribute('aria-pressed', String(x.dataset.mode === mode)))
    }

    applyMode(theme.mode || 'dark')

    document.getElementById('theme-reset').addEventListener('click', () => {
      localStorage.removeItem(STORAGE)
      const s = document.getElementById('theme-overrides')
      if (s) s.remove()
      theme = JSON.parse(JSON.stringify(DEFAULT))
      applyMode(theme.mode)
      syncUI(theme)
    })

    buttons.forEach((b) => {
      b.addEventListener('click', () => {
        theme.mode = b.dataset.mode
        applyMode(theme.mode)
        save(theme)
      })
    })
  </script>
</Layout>

<style is:global>
  .design-page {
    max-width: 1280px;
    margin: 0 auto;
    padding: 64px 32px;
    color: var(--color-font);
  }

  /* Page bg derived from the live background token — slightly tinted toward font for contrast */
  body:has(.design-page) {
    background: color-mix(in oklab, var(--color-background) 92%, var(--color-font));
  }

  .design-page * {
    box-sizing: border-box;
  }

  .design-page .hero {
    text-align: center;
    margin-bottom: 64px;
  }

  .design-page .hero h1 {
    font-size: 56px;
    font-weight: 800;
    letter-spacing: -0.03em;
    margin: 0 0 16px;
  }

  .design-page .hero p {
    max-width: 640px;
    margin: 0 auto;
    color: color-mix(in oklab, var(--color-font) 65%, transparent);
    font-size: 16px;
    line-height: 1.6;
  }

  .design-page .controls {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-top: 32px;
  }

  .design-page .mode-toggle {
    display: inline-flex;
    gap: 4px;
    padding: 4px;
    background: var(--color-background);
    border: 1px solid color-mix(in oklab, var(--color-font) 8%, transparent);
    border-radius: 12px;
  }

  .design-page .reset-btn {
    padding: 10px 16px;
    background: transparent;
    color: color-mix(in oklab, var(--color-font) 70%, transparent);
    border: 1px solid color-mix(in oklab, var(--color-font) 12%, transparent);
    border-radius: 10px;
    font: inherit;
    font-weight: 500;
    cursor: pointer;
  }

  .design-page .reset-btn:hover {
    color: var(--color-font);
    border-color: color-mix(in oklab, var(--color-font) 24%, transparent);
  }

  .design-page .swatch-pick {
    position: relative;
    display: inline-block;
    cursor: pointer;
    line-height: 0;
  }

  .design-page .swatch-pick input[type='color'] {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: pointer;
    border: 0;
    padding: 0;
  }

  .design-page .swatch-pick:hover .swatch {
    transform: scale(1.05);
    transition: transform 0.12s ease;
  }

  .design-page .swatch-pick input[type='color']:focus-visible {
    outline: none;
  }

  .design-page .swatch-pick:has(input:focus-visible) .swatch {
    outline: 2px solid var(--color-ring);
    outline-offset: 3px;
  }

  .design-page .mode-toggle button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 20px;
    background: transparent;
    color: color-mix(in oklab, var(--color-font) 70%, transparent);
    border: 0;
    border-radius: 8px;
    font: inherit;
    cursor: pointer;
  }

  .design-page .mode-toggle button[aria-pressed='true'] {
    background: color-mix(in oklab, var(--color-font) 8%, transparent);
    color: var(--color-font);
  }

  .design-page .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
  }

  @media (max-width: 960px) {
    .design-page .grid {
      grid-template-columns: 1fr;
    }
  }

  .design-page h2 {
    font-size: 22px;
    font-weight: 700;
    margin: 0 0 8px;
  }

  .design-page .col > p {
    margin: 0 0 24px;
  }

  .design-page .muted {
    color: color-mix(in oklab, var(--color-font) 55%, transparent);
    font-size: 14px;
  }

  .design-page .tokens {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .design-page .tokens li {
    display: grid;
    grid-template-columns: auto auto 1fr auto;
    align-items: center;
    gap: 16px;
    padding: 16px;
    background: var(--color-background);
    border: 1px solid color-mix(in oklab, var(--color-font) 6%, transparent);
    border-radius: 12px;
  }

  .design-page .swatch {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 10px;
    border: 1px solid color-mix(in oklab, var(--color-font) 8%, transparent);
    font-weight: 600;
  }

  .design-page .font-light {
    background: hsl(0 0% 100%);
    color: hsl(0 0% 13%);
  }

  .design-page .font-dark {
    background: hsl(0 0% 13%);
    color: hsl(0 0% 100%);
  }

  .design-page .meta {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .design-page .meta.wide {
    grid-column: 3 / span 1;
  }

  .design-page .meta strong {
    font-weight: 600;
    font-size: 15px;
  }

  .design-page .hsl {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 12px;
    color: color-mix(in oklab, var(--color-font) 55%, transparent);
  }

  .design-page .note {
    margin-top: 16px;
    padding: 16px;
    background: var(--color-background);
    border: 1px solid color-mix(in oklab, var(--color-font) 6%, transparent);
    border-radius: 12px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .design-page .invariants {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .design-page .chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    background: var(--color-foreground);
    border: 1px solid color-mix(in oklab, var(--color-font) 8%, transparent);
    border-radius: 999px;
    font-size: 12px;
  }

  .design-page .dot {
    width: 12px;
    height: 12px;
    border-radius: 999px;
  }

  .design-page .card {
    padding: 24px;
    background: var(--color-background);
    border: 1px solid color-mix(in oklab, var(--color-font) 6%, transparent);
    border-radius: 16px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .design-page .card-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
  }

  .design-page .card-head h3 {
    margin: 0 0 4px;
    font-size: 18px;
    font-weight: 700;
  }

  .design-page .card-head p {
    margin: 0;
  }

  .design-page .badge {
    padding: 4px 12px;
    background: var(--color-background);
    border: 1px solid color-mix(in oklab, var(--color-font) 12%, transparent);
    border-radius: 999px;
    font-size: 12px;
    color: color-mix(in oklab, var(--color-font) 70%, transparent);
  }

  .design-page code {
    padding: 1px 6px;
    background: color-mix(in oklab, var(--color-font) 8%, transparent);
    border-radius: 4px;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 12px;
  }

  .design-page .content-area {
    padding: 16px;
    background: var(--color-foreground);
    color: var(--color-font);
    border-radius: 10px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .design-page .content-area .muted {
    color: color-mix(in oklab, var(--color-font) 60%, transparent);
  }

  .design-page .price {
    margin: 4px 0;
    font-size: 28px;
    font-weight: 700;
  }

  .design-page .buttons {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .design-page .btn {
    padding: 12px 16px;
    border-radius: 10px;
    border: 1px solid transparent;
    font: inherit;
    font-weight: 600;
    cursor: pointer;
    transition: filter 0.12s ease;
  }

  .design-page .btn:hover {
    filter: brightness(1.1);
  }

  .design-page .btn.primary {
    background: var(--color-primary);
    color: var(--color-on-primary);
  }

  .design-page .btn.secondary {
    background: var(--color-secondary);
    color: var(--color-on-secondary);
  }

  .design-page .btn.tertiary {
    background: var(--color-tertiary);
    color: var(--color-on-tertiary);
  }

  .design-page .btn.outline {
    background: transparent;
    border-color: var(--color-primary);
    color: var(--color-font);
  }

  .design-page .btn.ghost {
    background: transparent;
    color: var(--color-font);
  }

  .design-page .btn.inverse {
    background: var(--color-font);
    color: var(--color-foreground);
  }

  .design-page .footer {
    margin-top: 64px;
    text-align: center;
  }
</style>
