---
/**
 * Shop Hero Component Demo Page
 * Showcases the ultra-premium ShopHero component
 */
import Layout from '@/layouts/Layout.astro';
import { ShopHero } from '@/components/shop/ShopHero';
---

<Layout title="Shop Hero Demo - ONE Store" description="Experience our world-class shop hero component">
  <ShopHero
    client:load
    stats={{
      customers: '50k+',
      rating: '4.9',
      support: '24/7'
    }}
  />

  <!-- Demo Content Below Hero -->
  <section class="py-24 bg-muted/20">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-4xl font-bold mb-6">
          World-Class Shop Hero Component
        </h2>
        <p class="text-xl text-muted-foreground leading-relaxed">
          This hero section features premium design elements including:
        </p>
        <div class="mt-12 grid md:grid-cols-2 gap-8 text-left">
          <div class="p-6 rounded-2xl border border-border bg-card">
            <h3 class="text-xl font-bold mb-3">✨ Visual Excellence</h3>
            <ul class="space-y-2 text-muted-foreground">
              <li>• Glass morphism effects</li>
              <li>• Animated gradient orbs</li>
              <li>• Floating particle system</li>
              <li>• Premium grid overlay</li>
            </ul>
          </div>
          <div class="p-6 rounded-2xl border border-border bg-card">
            <h3 class="text-xl font-bold mb-3">🎯 Smart Features</h3>
            <ul class="space-y-2 text-muted-foreground">
              <li>• Trust badges with hover effects</li>
              <li>• Staggered fade-in animations</li>
              <li>• Premium CTA buttons</li>
              <li>• Real-time stats display</li>
            </ul>
          </div>
          <div class="p-6 rounded-2xl border border-border bg-card">
            <h3 class="text-xl font-bold mb-3">🚀 Performance</h3>
            <ul class="space-y-2 text-muted-foreground">
              <li>• GPU-accelerated animations</li>
              <li>• Optimized blur effects</li>
              <li>• Lazy-loaded components</li>
              <li>• Minimal JavaScript</li>
            </ul>
          </div>
          <div class="p-6 rounded-2xl border border-border bg-card">
            <h3 class="text-xl font-bold mb-3">📱 Responsive</h3>
            <ul class="space-y-2 text-muted-foreground">
              <li>• Mobile-first design</li>
              <li>• Adaptive typography</li>
              <li>• Touch-optimized buttons</li>
              <li>• Fluid spacing</li>
            </ul>
          </div>
        </div>

        <div class="mt-16 p-8 rounded-2xl border border-primary/20 bg-primary/5">
          <h3 class="text-2xl font-bold mb-4">How to Use</h3>
          <pre class="text-left bg-background p-6 rounded-xl overflow-x-auto">
            <code>{`import { ShopHero } from '@/components/shop/ShopHero';

<ShopHero
  client:load
  stats={{
    customers: '50k+',
    rating: '4.9',
    support: '24/7'
  }}
/>`}</code>
          </pre>
        </div>
      </div>
    </div>
  </section>
</Layout>
