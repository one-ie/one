---
/**
 * TODO: Refactor to use backend-agnostic data fetching
 * This page needs to use REST API endpoints instead of direct backend imports
 * See CLAUDE.md for proper architecture patterns
 */

import Layout from '@/layouts/Layout.astro';
import { GroupSettingsForm } from '@/components/groups/GroupSettingsForm';
import type { Id } from '@/types/convex';

export const prerender = false;

// Define Group type matching component expectations
interface Group {
  _id: Id<'groups'>;
  name: string;
  type: string;
  description?: string;
  settings: {
    visibility: 'public' | 'private';
    joinPolicy: 'open' | 'invite_only' | 'approval_required';
    plan?: 'starter' | 'pro' | 'enterprise';
  };
  status?: string;
  slug: string;
}

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/groups');
}

// Check if user is authenticated
const user = Astro.locals.user;

if (!user) {
  return Astro.redirect(`/account/signin?redirect=/group/${slug}/settings`);
}

// TODO: Replace with backend-agnostic API call
// For now, use mock data to allow page to render
const group: Group = {
  _id: 'mock-id' as Id<'groups'>,
  name: 'Loading...',
  type: 'community',
  description: 'This page needs to be refactored to use backend-agnostic data fetching',
  settings: {
    visibility: 'public',
    joinPolicy: 'open',
    plan: 'starter',
  },
  status: 'active',
  slug: slug,
};

// TODO: Add proper ownership/admin check
// For now, assuming authenticated user has access
const isOwner = true; // Replace with actual ownership check

if (!isOwner) {
  return Astro.redirect(`/group/${slug}`);
}
---

<Layout title={`${group.name} - Settings`}>
  <div class="mx-auto max-w-4xl space-y-8">
    <div class="space-y-2">
      <h1 class="text-4xl font-bold tracking-tight">{group.name}</h1>
      <p class="text-lg text-muted-foreground">
        Manage your group settings, permissions, and configuration.
      </p>
    </div>

    <GroupSettingsForm client:load group={group} user={user} />
  </div>
</Layout>
