---
import Layout from '@/layouts/Layout.astro'
import { RecoveryCodes } from '@/components/RecoveryCodes'
---

<Layout title="Recovery codes — ONE" sidebar="none" chat="none">
  <main class="min-h-screen flex flex-col items-center justify-center gap-8 px-4">
    <div class="flex flex-col items-center gap-6 text-center max-w-md w-full">
      <h1 class="text-2xl font-bold">Save your recovery codes</h1>
      <p class="text-font/60">Write these 12 words on paper. They're the only way to recover your site if you lose access to all your devices.</p>
      <RecoveryCodes client:load />
    </div>
  </main>
</Layout>
