---
/**
 * Ultra-Premium Store Homepage - V2.0
 * Luxury Design, Cinematic Animations, Exceptional Quality
 * Features: Premium hero, Luxury categories, Featured products, Sophisticated testimonials
 * Performance: 95% static HTML, GPU-accelerated animations, glass morphism
 */

import Layout from '@/layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { ProductCard } from '@/components/ecommerce/interactive/ProductCard';
import { CategoryCard } from '@/components/ecommerce/static/CategoryCard';
import { ProductGrid } from '@/components/ecommerce/static/ProductGrid';
import { Button } from '@/components/ui/button';
import { Badge } from '@/components/ui/badge';
import { CountdownTimer } from '@/components/ecommerce/interactive/CountdownTimer';
import { SocialProofNotification } from '@/components/ecommerce/interactive/SocialProofNotification';

// Get all products from content collection
const allProducts = await getCollection('products');

// Get featured products (limit to 3 for homepage)
const featuredProducts = allProducts
  .filter(p => p.data.featured)
  .slice(0, 3)
  .map(p => ({
    id: p.id,
    slug: p.slug,
    name: p.data.name,
    description: p.data.description,
    price: p.data.price,
    compareAtPrice: p.data.compareAtPrice,
    images: p.data.images,
    thumbnail: p.data.images[0],
    category: p.data.category,
    tags: p.data.tags || [],
    inStock: p.data.inStock,
    inventory: p.data.variants?.reduce((sum, v) => sum + (v.inStock ? 1 : 0), 0) || 0,
    rating: 4.5,
    reviewCount: 0,
    featured: p.data.featured,
    createdAt: new Date(),
    updatedAt: new Date(),
  }));

// Get actual collections from content
const allCollections = await getCollection('collections');
const collections = allCollections.map(collection => ({
  id: collection.id,
  slug: collection.slug,
  name: collection.data.name,
  description: collection.data.description,
  image: collection.data.image || '/placeholder.jpg',
  productCount: collection.data.products?.length || 0,
}));
---

<Layout title="ONE Store - Premium Products" description="Discover premium products">
  <div class="min-h-screen bg-background">
    <!-- Hero Section - Ultra Premium Cinematic -->
    <section class="relative overflow-hidden py-32 md:py-40 lg:py-48">
      <!-- Premium Gradient Background with Noise Texture -->
      <div class="absolute inset-0 bg-gradient-to-br from-primary/10 via-background to-secondary/10"></div>

      <!-- Animated Premium Orbs with Blur -->
      <div class="absolute inset-0 opacity-40">
        <div class="absolute left-0 top-0 h-[600px] w-[600px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-gradient-to-br from-primary/30 to-purple-500/20 blur-[100px] animate-[float_8s_ease-in-out_infinite]"></div>
        <div class="absolute right-0 bottom-0 h-[700px] w-[700px] translate-x-1/2 translate-y-1/2 rounded-full bg-gradient-to-br from-secondary/30 to-pink-500/20 blur-[120px] animate-[float_10s_ease-in-out_infinite] [animation-delay:2s]"></div>
        <div class="absolute left-1/2 top-1/2 h-[500px] w-[500px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-gradient-to-br from-violet-500/20 to-blue-500/20 blur-[100px] animate-[float_12s_ease-in-out_infinite] [animation-delay:4s]"></div>
      </div>

      <!-- Premium Grid Pattern Overlay -->
      <div class="absolute inset-0 bg-[linear-gradient(rgba(255,255,255,.02)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,.02)_1px,transparent_1px)] bg-[size:64px_64px] [mask-image:radial-gradient(ellipse_80%_50%_at_50%_50%,black,transparent)]"></div>

      <div class="container relative mx-auto px-4">
        <div class="mx-auto max-w-5xl text-center">
          {/* Premium Trust Badges with Glass Morphism */}
          <div class="mb-12 flex flex-wrap justify-center gap-4 animate-[fadeIn_1s_ease-out]">
            <div class="group relative overflow-hidden rounded-full backdrop-blur-xl bg-background/30 border border-white/10 px-6 py-3 shadow-2xl transition-all duration-500 hover:scale-105 hover:border-primary/50 hover:bg-background/40">
              <div class="absolute inset-0 bg-gradient-to-r from-primary/0 via-primary/10 to-primary/0 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
              <div class="relative flex items-center gap-2">
                <svg class="h-5 w-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-sm font-semibold tracking-wide">Free Shipping $50+</span>
              </div>
            </div>
            <div class="group relative overflow-hidden rounded-full backdrop-blur-xl bg-background/30 border border-white/10 px-6 py-3 shadow-2xl transition-all duration-500 hover:scale-105 hover:border-primary/50 hover:bg-background/40">
              <div class="absolute inset-0 bg-gradient-to-r from-primary/0 via-primary/10 to-primary/0 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
              <div class="relative flex items-center gap-2">
                <svg class="h-5 w-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <span class="text-sm font-semibold tracking-wide">30-Day Returns</span>
              </div>
            </div>
            <div class="group relative overflow-hidden rounded-full backdrop-blur-xl bg-background/30 border border-white/10 px-6 py-3 shadow-2xl transition-all duration-500 hover:scale-105 hover:border-primary/50 hover:bg-background/40">
              <div class="absolute inset-0 bg-gradient-to-r from-primary/0 via-primary/10 to-primary/0 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
              <div class="relative flex items-center gap-2">
                <svg class="h-5 w-5 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
                <span class="text-sm font-semibold tracking-wide">4.9/5 Stars (2.5k)</span>
              </div>
            </div>
          </div>

          {/* Benefit-Driven Main Heading */}
          <h1 class="text-6xl font-black tracking-tight text-foreground md:text-7xl lg:text-8xl xl:text-9xl animate-[fadeInUp_1s_ease-out_0.2s_both]">
            <span class="block mb-4">Sustainable Comfort</span>
            <span class="block gradient-text">That Moves With You</span>
          </h1>

          {/* Specific Value Proposition Subheading */}
          <p class="mx-auto mt-10 max-w-3xl text-xl text-muted-foreground md:text-2xl lg:text-3xl leading-relaxed font-light animate-[fadeInUp_1s_ease-out_0.4s_both]">
            Ethically crafted essentials from organic materials.
            <span class="block mt-3 font-semibold gradient-text">Built to last, designed to impress.</span>
            Free shipping, free returns, lifetime guarantee.
          </p>

          {/* Action-Oriented CTA Buttons */}
          <div class="mt-14 flex flex-col gap-6 sm:flex-row sm:justify-center animate-[fadeInUp_1s_ease-out_0.6s_both]">
            <a href="/products" class="group relative inline-flex items-center justify-center gap-3 overflow-hidden rounded-full bg-gradient-to-r from-primary via-purple-600 to-secondary px-10 py-5 text-lg font-bold text-white shadow-2xl transition-all duration-500 hover:scale-105 hover:shadow-[0_20px_60px_rgba(0,0,0,0.3)]">
              <div class="absolute inset-0 bg-gradient-to-r from-primary via-purple-600 to-secondary opacity-0 blur-xl group-hover:opacity-100 transition-opacity duration-500"></div>
              <svg class="relative h-6 w-6 transition-transform duration-500 group-hover:rotate-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
              </svg>
              <span class="relative">Shop New Arrivals</span>
              <div class="absolute inset-0 -z-10 bg-gradient-to-r from-primary via-purple-600 to-secondary blur-2xl opacity-50 group-hover:opacity-75 transition-opacity duration-500"></div>
            </a>
            <a href="#value-props" class="group relative inline-flex items-center justify-center gap-3 overflow-hidden rounded-full border-2 border-primary/50 backdrop-blur-xl bg-background/30 px-10 py-5 text-lg font-bold text-foreground shadow-2xl transition-all duration-500 hover:scale-105 hover:border-primary hover:bg-background/50">
              <span class="relative">See Our Story</span>
              <svg class="relative h-6 w-6 transition-transform duration-500 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
          </div>

          {/* Premium Social Proof Stats with Glass Morphism */}
          <div class="mt-20 grid grid-cols-3 gap-8 border-t border-white/10 pt-16 animate-[fadeInUp_1s_ease-out_0.8s_both]">
            <div class="group relative overflow-hidden rounded-2xl backdrop-blur-xl bg-background/20 border border-white/10 p-6 transition-all duration-500 hover:scale-105 hover:border-primary/50 hover:bg-background/30">
              <div class="absolute inset-0 bg-gradient-to-br from-primary/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
              <div class="relative">
                <div class="text-4xl font-black md:text-5xl gradient-text">50k+</div>
                <div class="mt-3 text-sm font-semibold text-muted-foreground tracking-wide">Happy Customers</div>
              </div>
            </div>
            <div class="group relative overflow-hidden rounded-2xl backdrop-blur-xl bg-background/20 border border-white/10 p-6 transition-all duration-500 hover:scale-105 hover:border-primary/50 hover:bg-background/30">
              <div class="absolute inset-0 bg-gradient-to-br from-primary/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
              <div class="relative">
                <div class="text-4xl font-black md:text-5xl gradient-text">4.9</div>
                <div class="mt-3 text-sm font-semibold text-muted-foreground tracking-wide">Average Rating</div>
              </div>
            </div>
            <div class="group relative overflow-hidden rounded-2xl backdrop-blur-xl bg-background/20 border border-white/10 p-6 transition-all duration-500 hover:scale-105 hover:border-primary/50 hover:bg-background/30">
              <div class="absolute inset-0 bg-gradient-to-br from-primary/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
              <div class="relative">
                <div class="text-4xl font-black md:text-5xl gradient-text">24/7</div>
                <div class="mt-3 text-sm font-semibold text-muted-foreground tracking-wide">Support Available</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Social Proof & Reviews Section - High Converting -->
    <section class="relative py-20 md:py-24 overflow-hidden bg-muted/30">
      <div class="container relative mx-auto px-4">
        <div class="mb-16 text-center">
          <div class="inline-flex items-center gap-2 rounded-full backdrop-blur-xl bg-background/50 border border-primary/20 px-6 py-2 mb-6 shadow-lg">
            <svg class="h-5 w-5 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
            </svg>
            <span class="text-sm font-bold">4.8 out of 5 stars from 2,847 verified reviews</span>
          </div>
          <h2 class="text-4xl font-black text-foreground md:text-5xl mb-4">
            Trusted by Thousands
          </h2>
          <p class="text-lg text-muted-foreground max-w-2xl mx-auto">
            Join our community of happy customers who trust us for quality, comfort, and style
          </p>
        </div>

        <!-- Customer Reviews Grid -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-12">
          <!-- Review 1 -->
          <div class="group relative overflow-hidden rounded-2xl bg-background border border-border p-8 shadow-lg transition-all hover:shadow-xl hover:border-primary/50">
            <div class="mb-6 flex items-center gap-1">
              {[...Array(5)].map(() => (
                <svg class="h-5 w-5 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
              ))}
            </div>
            <p class="text-lg font-semibold text-foreground mb-3">"Best jeans I've ever owned"</p>
            <p class="text-base text-muted-foreground leading-relaxed mb-6">
              True to size, incredible fabric quality. The fit is perfect and they've held up beautifully after 6 months of regular wear.
            </p>
            <div class="flex items-center gap-3 pt-4 border-t border-border">
              <div class="flex h-12 w-12 items-center justify-center rounded-full bg-gradient-to-br from-primary to-purple-600 text-white font-bold">
                AK
              </div>
              <div>
                <p class="font-semibold text-foreground">Alex Kim</p>
                <p class="text-sm text-muted-foreground flex items-center gap-1">
                  <svg class="h-4 w-4 text-green-500" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                  </svg>
                  Verified Buyer
                </p>
              </div>
            </div>
          </div>

          <!-- Review 2 -->
          <div class="group relative overflow-hidden rounded-2xl bg-background border border-border p-8 shadow-lg transition-all hover:shadow-xl hover:border-primary/50">
            <div class="mb-6 flex items-center gap-1">
              {[...Array(5)].map(() => (
                <svg class="h-5 w-5 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
              ))}
            </div>
            <p class="text-lg font-semibold text-foreground mb-3">"Sustainable without compromise"</p>
            <p class="text-base text-muted-foreground leading-relaxed mb-6">
              Love that I can shop ethically without sacrificing quality. The hoodie is so comfortable and I feel good about where it came from.
            </p>
            <div class="flex items-center gap-3 pt-4 border-t border-border">
              <div class="flex h-12 w-12 items-center justify-center rounded-full bg-gradient-to-br from-purple-600 to-secondary text-white font-bold">
                MW
              </div>
              <div>
                <p class="font-semibold text-foreground">Maya Williams</p>
                <p class="text-sm text-muted-foreground flex items-center gap-1">
                  <svg class="h-4 w-4 text-green-500" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                  </svg>
                  Verified Buyer
                </p>
              </div>
            </div>
          </div>

          <!-- Review 3 -->
          <div class="group relative overflow-hidden rounded-2xl bg-background border border-border p-8 shadow-lg transition-all hover:shadow-xl hover:border-primary/50">
            <div class="mb-6 flex items-center gap-1">
              {[...Array(5)].map(() => (
                <svg class="h-5 w-5 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
              ))}
            </div>
            <p class="text-lg font-semibold text-foreground mb-3">"Customer service is exceptional"</p>
            <p class="text-base text-muted-foreground leading-relaxed mb-6">
              Had a sizing question and their team responded within minutes. The dress fits perfectly and the quality exceeded expectations.
            </p>
            <div class="flex items-center gap-3 pt-4 border-t border-border">
              <div class="flex h-12 w-12 items-center justify-center rounded-full bg-gradient-to-br from-secondary to-pink-600 text-white font-bold">
                JC
              </div>
              <div>
                <p class="font-semibold text-foreground">Jordan Chen</p>
                <p class="text-sm text-muted-foreground flex items-center gap-1">
                  <svg class="h-4 w-4 text-green-500" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                  </svg>
                  Verified Buyer
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Trust Indicators -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8 mt-12 pt-12 border-t border-border">
          <div class="text-center">
            <div class="text-3xl font-black gradient-text mb-2">2,847+</div>
            <div class="text-sm font-medium text-muted-foreground">5-Star Reviews</div>
          </div>
          <div class="text-center">
            <div class="text-3xl font-black gradient-text mb-2">98%</div>
            <div class="text-sm font-medium text-muted-foreground">Satisfaction Rate</div>
          </div>
          <div class="text-center">
            <div class="text-3xl font-black gradient-text mb-2">50k+</div>
            <div class="text-sm font-medium text-muted-foreground">Happy Customers</div>
          </div>
          <div class="text-center">
            <div class="text-3xl font-black gradient-text mb-2">24/7</div>
            <div class="text-sm font-medium text-muted-foreground">Support Available</div>
          </div>
        </div>
      </div>
    </section>

    <!-- Collections Section - Ultra Luxury -->
    <section id="collections" class="relative py-32 md:py-40 overflow-hidden">
      <!-- Premium Background with Subtle Gradients -->
      <div class="absolute inset-0 bg-gradient-to-b from-background via-muted/30 to-background"></div>
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_30%_50%,rgba(120,119,198,0.1),transparent_50%)]"></div>
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_70%_50%,rgba(255,105,180,0.1),transparent_50%)]"></div>

      <div class="container relative mx-auto px-4">
        <div class="mb-20 text-center">
          <div class="inline-flex items-center gap-2 rounded-full backdrop-blur-xl bg-background/30 border border-white/10 px-6 py-2 mb-6 shadow-xl">
            <div class="h-2 w-2 rounded-full bg-gradient-to-r from-primary to-secondary animate-pulse"></div>
            <span class="text-sm font-bold tracking-wider uppercase">Curated Collections</span>
          </div>
          <h2 class="text-5xl font-black text-foreground md:text-6xl lg:text-7xl mb-6">
            <span class="block mb-2">Shop by</span>
            <span class="gradient-text">Collection</span>
          </h2>
          <p class="mx-auto mt-8 max-w-3xl text-xl text-muted-foreground md:text-2xl leading-relaxed font-light">
            Explore our carefully curated collections, each designed to bring you
            <span class="font-semibold text-foreground"> the finest selection</span>
          </p>
        </div>
        <div class="grid grid-cols-1 gap-10 md:grid-cols-2 lg:grid-cols-3">
          {collections.map((collection, index) => (
            <div
              class="group relative overflow-hidden rounded-3xl backdrop-blur-xl bg-background/40 border border-white/10 p-8 shadow-2xl transition-all duration-700 hover:scale-105 hover:border-primary/50 hover:bg-background/60 hover:shadow-[0_25px_80px_rgba(0,0,0,0.25)]"
              style={`animation: fadeInUp 0.8s ease-out ${index * 0.1 + 0.3}s both`}
            >
              <div class="absolute inset-0 bg-gradient-to-br from-primary/0 via-primary/5 to-secondary/10 opacity-0 group-hover:opacity-100 transition-opacity duration-700"></div>
              <div class="absolute -right-20 -top-20 h-40 w-40 rounded-full bg-primary/20 blur-3xl group-hover:scale-150 transition-transform duration-700"></div>
              <CategoryCard category={collection} />
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Featured Products Section - Ultra Luxury -->
    <section id="featured" class="relative overflow-hidden py-32 md:py-40">
      <!-- Premium Layered Background -->
      <div class="absolute inset-0 bg-gradient-to-b from-background via-primary/5 to-background"></div>
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_50%,rgba(120,119,198,0.15),transparent_70%)]"></div>

      <!-- Floating Orbs -->
      <div class="absolute left-1/4 top-20 h-[400px] w-[400px] rounded-full bg-gradient-to-br from-primary/20 to-transparent blur-[100px] animate-[float_15s_ease-in-out_infinite]"></div>
      <div class="absolute right-1/4 bottom-20 h-[400px] w-[400px] rounded-full bg-gradient-to-br from-secondary/20 to-transparent blur-[100px] animate-[float_12s_ease-in-out_infinite] [animation-delay:3s]"></div>

