---
import Layout from '@/layouts/Layout.astro'
import Reveal from '@/components/motion/Reveal'
import Stagger from '@/components/motion/Stagger'
import Parallax from '@/components/motion/Parallax'
import HeroScene from '@/components/motion/demo/HeroScene'
import ScrollCounter from '@/components/motion/demo/ScrollCounter'
import GlowGrid from '@/components/motion/demo/GlowGrid'
import TypewriterDemo from '@/components/motion/demo/TypewriterDemo'
---

<Layout title="ONE Motion System">
  <!-- ─── Hero ─────────────────────────────────────────────────────────── -->
  <section class="hero-section">
    <Reveal client:visible dist="lg" speed="slow" className="hero-text">
      <p class="label">Motion System</p>
      <h1>Crisp.<br/>Purposeful.<br/>Fast.</h1>
      <p class="sub">
        Four primitives. Six tokens. One mental model.<br/>
        Scroll to explore every capability.
      </p>
    </Reveal>

    <HeroScene client:visible />

    <div class="scroll-hint">
      <span>Scroll</span>
      <div class="scroll-line"></div>
    </div>
  </section>

  <!-- ─── Primitives index ──────────────────────────────────────────────── -->
  <section class="section">
    <Reveal client:visible className="section-head">
      <p class="label">Layer 1</p>
      <h2>The four primitives</h2>
      <p class="muted">Everything derives from these. Drop them in `.astro` files as islands.</p>
    </Reveal>

    <Stagger client:visible className="primitives-grid" stagger={0.1}>
      <div class="prim-card">
        <code>&lt;Reveal&gt;</code>
        <p>Fade + translate on viewport enter. One-shot. The building block for 80% of your reveals.</p>
        <div class="prim-tag">whileInView</div>
      </div>
      <div class="prim-card">
        <code>&lt;Stagger&gt;</code>
        <p>Parent that staggers children reveals. Lists, grids, feature rows — rhythm for free.</p>
        <div class="prim-tag">staggerChildren</div>
      </div>
      <div class="prim-card">
        <code>&lt;Parallax&gt;</code>
        <p>Depth through scroll-bound translation. useScroll + useTransform, no second library.</p>
        <div class="prim-tag">useScroll</div>
      </div>
      <div class="prim-card">
        <code>&lt;ScrollScene&gt;</code>
        <p>Pin + expose progress 0→1. Signature moments: hero reveals, before/after demos.</p>
        <div class="prim-tag">scrubbed</div>
      </div>
    </Stagger>
  </section>

  <!-- ─── Reveal demo ───────────────────────────────────────────────────── -->
  <section class="section reveal-demo">
    <Reveal client:visible className="section-head">
      <p class="label">Primitive 1</p>
      <h2>Reveal</h2>
    </Reveal>

    <div class="reveal-variants">
      <Reveal client:visible dist="sm" speed="fast" delay={0}>
        <div class="demo-chip">dist=sm · fast</div>
      </Reveal>
      <Reveal client:visible dist="md" speed="base" delay={0.1}>
        <div class="demo-chip active">dist=md · base ← default</div>
      </Reveal>
      <Reveal client:visible dist="lg" speed="slow" delay={0.2}>
        <div class="demo-chip">dist=lg · slow</div>
      </Reveal>
    </div>

    <Reveal client:visible delay={0.1} className="reveal-code-block">
      <pre><code>{`<Reveal client:visible dist="md" speed="base" delay={0.1}>
  <HeroHeadline />
</Reveal>`}</code></pre>
    </Reveal>
  </section>

  <!-- ─── Stagger demo ──────────────────────────────────────────────────── -->
  <section class="section">
    <Reveal client:visible className="section-head">
      <p class="label">Primitive 2</p>
      <h2>Stagger</h2>
    </Reveal>

    <Stagger client:visible className="stagger-row" stagger={0.07}>
      {Array.from({ length: 8 }, (_, i) => (
        <div class="stagger-bar" style={`--i:${i}`}></div>
      ))}
    </Stagger>

    <Stagger client:visible className="feature-list" stagger={0.09}>
      <div class="feature-row">
        <span class="feature-icon">◈</span>
        <div><strong>Works with any children</strong><p class="muted">Wraps each child in a motion div automatically.</p></div>
      </div>
      <div class="feature-row">
        <span class="feature-icon">◈</span>
        <div><strong>Configurable rhythm</strong><p class="muted">Tune <code>stagger</code> from tight (0.04s) to spacious (0.15s).</p></div>
      </div>
      <div class="feature-row">
        <span class="feature-icon">◈</span>
        <div><strong>Reduced motion safe</strong><p class="muted">Opacity only — the rhythm survives, translation doesn't.</p></div>
      </div>
      <div class="feature-row">
        <span class="feature-icon">◈</span>
        <div><strong>client:visible hydration</strong><p class="muted">Zero JS shipped until the list enters the viewport.</p></div>
      </div>
    </Stagger>
  </section>

  <!-- ─── Parallax demo ────────────────────────────────────────────────── -->
  <section class="section parallax-section">
    <Reveal client:visible className="section-head">
      <p class="label">Primitive 3</p>
      <h2>Parallax</h2>
    </Reveal>

    <div class="parallax-demo-area">
      <Parallax client:visible speed={80} direction="up" className="para-layer para-back">
        <div class="para-grid"></div>
      </Parallax>
      <Parallax client:visible speed={40} direction="up" className="para-layer para-mid">
        <GlowGrid client:visible />
      </Parallax>
      <div class="para-layer para-front">
        <Reveal client:visible dist="md">
          <div class="para-label">
            <h3>Layered depth</h3>
            <p class="muted">Three layers at different speeds — back, mid, front. Scroll through to see the shift.</p>
          </div>
        </Reveal>
      </div>
    </div>
  </section>

  <!-- ─── ScrollScene demo ─────────────────────────────────────────────── -->
  <section class="section">
    <Reveal client:visible className="section-head">
      <p class="label">Primitive 4</p>
      <h2>ScrollScene</h2>
      <p class="muted">Sticky pin + scrubbed progress. The signature moment.</p>
    </Reveal>
  </section>

  <ScrollCounter client:visible height="280vh" className="scene-stage" />

  <!-- ─── Tokens ────────────────────────────────────────────────────────── -->
  <section class="section">
    <Reveal client:visible className="section-head">
      <p class="label">Layer 2</p>
      <h2>Motion tokens</h2>
      <p class="muted">Four numbers that make everything feel like the same product.</p>
    </Reveal>

    <Stagger client:visible className="token-grid" stagger={0.06}>
      <div class="token-card">
        <p class="token-label">ease.out</p>
        <div class="token-curve" data-ease="out"></div>
        <code>[0.22, 1, 0.36, 1]</code>
        <p class="muted">Confident exit. Default for reveals.</p>
      </div>
      <div class="token-card">
        <p class="token-label">ease.inOut</p>
        <div class="token-curve" data-ease="inout"></div>
        <code>[0.65, 0, 0.35, 1]</code>
        <p class="muted">Scrubbed scroll. Smooth both ways.</p>
      </div>
      <div class="token-card">
        <p class="token-label">ease.spring</p>
        <div class="token-curve" data-ease="spring"></div>
        <code>stiffness 380 · damping 32</code>
        <p class="muted">Natural snap. Hover states, drawers.</p>
      </div>
      <div class="token-card">
        <p class="token-label">duration</p>
        <div class="duration-bars">
          <div class="dur-bar" style="width:32%"><span>fast 0.32s</span></div>
          <div class="dur-bar active" style="width:48%"><span>base 0.48s</span></div>
          <div class="dur-bar" style="width:72%"><span>slow 0.72s</span></div>
        </div>
        <p class="muted">Short durations — nothing lingers.</p>
      </div>
    </Stagger>
  </section>

  <!-- ─── Reduced motion ────────────────────────────────────────────────── -->
  <section class="section">
    <Reveal client:visible className="section-head">
      <p class="label">Layer 3</p>
      <h2>Reduced motion</h2>
    </Reveal>

    <Stagger client:visible className="reduced-grid" stagger={0.08}>
      <div class="reduced-card">
        <p class="token-label">Reveal</p>
        <p>opacity only · no y</p>
      </div>
      <div class="reduced-card">
        <p class="token-label">Stagger</p>
        <p>opacity only · rhythm preserved</p>
      </div>
      <div class="reduced-card">
        <p class="token-label">Parallax</p>
        <p>returns null transform</p>
      </div>
      <div class="reduced-card">
        <p class="token-label">ScrollScene</p>
        <p>progress flows · children branch</p>
      </div>
    </Stagger>

    <Reveal client:visible delay={0.1} className="reduced-note">
      <p>
        Every primitive calls <code>usePrefersReducedMotion()</code>.
        The choreography survives — the movement doesn't.
      </p>
    </Reveal>
  </section>

  <!-- ─── Typewriter / spring demo ─────────────────────────────────────── -->
  <section class="section">
    <Reveal client:visible className="section-head">
      <p class="label">Bonus</p>
      <h2>Spring + layout</h2>
      <p class="muted">motion's spring easing applied to layout-safe properties.</p>
    </Reveal>

    <TypewriterDemo client:visible />
  </section>

  <!-- ─── Close ────────────────────────────────────────────────────────── -->
  <section class="section section-close">
    <Reveal client:visible dist="lg" speed="slow" className="close-inner">
      <h2>One system.<br/>Zero overhead.</h2>
      <p class="muted">
        Motion tree-shakes — unused primitives ship nothing.<br/>
        <code>client:visible</code> defers hydration until each island enters the viewport.
      </p>
      <div class="close-pills">
        <Stagger client:visible stagger={0.07} className="pills-row">
          <span class="pill">motion 12</span>
          <span class="pill">Astro 6</span>
          <span class="pill">React 19</span>
          <span class="pill">client:visible</span>
          <span class="pill">4 primitives</span>
          <span class="pill">WCAG AA</span>
        </Stagger>
      </div>
    </Reveal>
  </section>
</Layout>

<style>
  /* ── base ──────────────────────────────────────────────────────────── */
  :global(body) {
    background: var(--color-page);
    color: var(--color-font);
  }

  .label {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-primary);
    margin-bottom: 0.5rem;
  }

  .muted { color: var(--color-muted); }

  code {
    font-family: 'SF Mono', 'Fira Code', monospace;
    font-size: 0.82em;
    color: var(--color-tertiary);
  }

  /* ── hero ──────────────────────────────────────────────────────────── */
  .hero-section {
    position: relative;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    padding: 6rem clamp(1.5rem, 6vw, 8rem);
    overflow: hidden;
  }

  :global(.hero-text) {
    position: relative;
    z-index: 2;
    max-width: 540px;
  }

  .hero-section h1 {
    font-size: clamp(3rem, 8vw, 6rem);
    font-weight: 800;
    line-height: 1.0;
    letter-spacing: -0.03em;
    margin: 0.5rem 0 1.25rem;
  }

  .hero-section .sub {
    font-size: 1.1rem;
    line-height: 1.6;
    color: var(--color-muted);
    max-width: 400px;
  }

  .scroll-hint {
    position: absolute;
    bottom: 2.5rem;
    left: clamp(1.5rem, 6vw, 8rem);
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .scroll-line {
    width: 40px;
    height: 1px;
    background: var(--color-muted);
    position: relative;
    overflow: hidden;
  }

  .scroll-line::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--color-primary);
    transform: translateX(-100%);
    animation: scan 1.8s ease-in-out infinite;
  }

  @keyframes scan {
    to { transform: translateX(100%); }
  }

  /* ── sections ───────────────────────────────────────────────────────── */
  .section {
    padding: 6rem clamp(1.5rem, 6vw, 8rem);
    max-width: 1100px;
    margin: 0 auto;
    width: 100%;
  }

  :global(.section-head) {
    margin-bottom: 3rem;
  }

  .section h2 {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    margin: 0.5rem 0 0.75rem;
  }

  /* ── primitives grid ──────────────────────────────────────────────── */
  :global(.primitives-grid) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.25rem;
  }

  .prim-card {
    background: var(--color-background);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    box-shadow: var(--shadow-card);
    transition: border-color 120ms var(--ease);
  }

  .prim-card:hover { border-color: var(--color-primary); }

  .prim-card code {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-primary);
  }

  .prim-card p { font-size: 0.85rem; line-height: 1.55; color: var(--color-muted); }

  .prim-tag {
    margin-top: auto;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-tertiary);
  }

  /* ── reveal demo ──────────────────────────────────────────────────── */
  .reveal-variants {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .demo-chip {
    padding: 0.6rem 1.2rem;
    border: 1px solid var(--color-border);
    border-radius: 9999px;
    font-size: 0.82rem;
    font-weight: 500;
    background: var(--color-background);
  }

  .demo-chip.active {
    background: color-mix(in srgb, var(--color-primary) 12%, var(--color-foreground));
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  :global(.reveal-code-block) {
    background: var(--color-foreground);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: auto;
  }

  :global(.reveal-code-block) pre {
    padding: 1.25rem 1.5rem;
    margin: 0;
    font-size: 0.83rem;
    line-height: 1.65;
  }

  /* ── stagger bar demo ─────────────────────────────────────────────── */
  :global(.stagger-row) {
    display: flex;
    align-items: flex-end;
    gap: 8px;
    height: 80px;
    margin-bottom: 3rem;
  }

  .stagger-bar {
    flex: 1;
    background: color-mix(in srgb, var(--color-primary) 60%, transparent);
    border-radius: 4px 4px 0 0;
    height: calc(30% + var(--i) * 10%);
    transition: background 200ms;
  }

  :global(.feature-list) {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .feature-row {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .feature-row:last-child { border-bottom: none; }

  .feature-icon {
    font-size: 1.1rem;
    color: var(--color-tertiary);
    flex-shrink: 0;
    margin-top: 0.1rem;
  }

  .feature-row strong { font-size: 0.95rem; display: block; margin-bottom: 0.2rem; }
  .feature-row p { font-size: 0.83rem; line-height: 1.5; margin: 0; }

  /* ── parallax section ────────────────────────────────────────────── */
  .parallax-section {
    max-width: 100%;
    padding-left: 0;
    padding-right: 0;
  }

  .parallax-section :global(.section-head) {
    padding: 0 clamp(1.5rem, 6vw, 8rem);
  }

  .parallax-demo-area {
    position: relative;
    height: 480px;
    overflow: hidden;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  :global(.para-layer) {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  :global(.para-back) {
    z-index: 0;
    opacity: 0.4;
  }

  :global(.para-mid) {
    z-index: 1;
    opacity: 0.7;
  }

  :global(.para-front) {
    z-index: 2;
    padding: 2rem clamp(1.5rem, 6vw, 8rem);
    align-items: flex-end;
    justify-content: flex-start;
  }

  .para-grid {
    width: 100%;
    height: 100%;
    background-image:
      linear-gradient(var(--color-border) 1px, transparent 1px),
      linear-gradient(90deg, var(--color-border) 1px, transparent 1px);
    background-size: 48px 48px;
  }

  .para-label {
    background: var(--color-background);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1.25rem 1.5rem;
    max-width: 340px;
    box-shadow: var(--shadow-pop);
  }

  .para-label h3 { font-size: 1.1rem; font-weight: 700; margin: 0 0 0.4rem; }
  .para-label p  { font-size: 0.83rem; line-height: 1.5; margin: 0; }

  /* ── scroll scene stage ──────────────────────────────────────────── */
  :global(.scene-stage) {
    background: var(--color-foreground);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  /* ── token grid ──────────────────────────────────────────────────── */
  :global(.token-grid) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.25rem;
  }

  .token-card {
    background: var(--color-background);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    box-shadow: var(--shadow-card);
  }

  .token-label {
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--color-secondary);
    margin: 0;
  }

  .token-curve {
    height: 48px;
    border-radius: var(--radius-sm);
    background: var(--color-foreground);
    border: 1px solid var(--color-border);
    position: relative;
    overflow: hidden;
  }

  .token-curve::after {
    content: '';
    position: absolute;
    bottom: 8px;
    left: 8px;
    right: 8px;
    height: 2px;
    background: var(--color-primary);
    border-radius: 2px;
    transform-origin: left center;
  }

  .token-curve[data-ease="out"]::after {
    clip-path: path('M 0 0 C 30 0, 100 -30, 100 -30');
  }

  .duration-bars {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .dur-bar {
    height: 8px;
    background: color-mix(in srgb, var(--color-secondary) 40%, transparent);
    border-radius: 4px;
    position: relative;
    display: flex;
    align-items: center;
  }

  .dur-bar.active {
    background: color-mix(in srgb, var(--color-primary) 70%, transparent);
  }

  .dur-bar span {
    position: absolute;
    left: calc(100% + 8px);
    font-size: 0.72rem;
    color: var(--color-muted);
    white-space: nowrap;
  }

  /* ── reduced motion grid ─────────────────────────────────────────── */
  :global(.reduced-grid) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .reduced-card {
    background: var(--color-foreground);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 1.25rem;
  }

  .reduced-card p { font-size: 0.82rem; color: var(--color-muted); margin: 0.35rem 0 0; }

  :global(.reduced-note) {
    background: color-mix(in srgb, var(--color-tertiary) 8%, var(--color-foreground));
    border: 1px solid color-mix(in srgb, var(--color-tertiary) 20%, transparent);
    border-radius: var(--radius-md);
    padding: 1.25rem 1.5rem;
    font-size: 0.88rem;
    line-height: 1.65;
  }

  /* ── close section ───────────────────────────────────────────────── */
  .section-close {
    padding-top: 8rem;
    padding-bottom: 8rem;
  }

  :global(.close-inner) {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  .section-close h2 {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.05;
    max-width: 600px;
    margin: 0;
  }

  .section-close .muted {
    font-size: 1rem;
    line-height: 1.65;
  }

  :global(.pills-row) {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
  }

  .pill {
    padding: 0.4rem 0.9rem;
    border: 1px solid var(--color-border);
    border-radius: 9999px;
    font-size: 0.78rem;
    font-weight: 500;
    background: var(--color-background);
  }
</style>
