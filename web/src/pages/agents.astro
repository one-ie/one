---
import Layout from '../layouts/Layout.astro'
import { listAgentsMeta } from '../lib/agents-meta'
import { ChatDock } from '../components/chat/ChatDock'
import { AgentPageClient } from '../components/AgentPageClient'

const agents = listAgentsMeta()
const tones = ['primary', 'secondary', 'tertiary'] as const

// Deep-link: if ?drawer=<id> is set, pass the id to the client island
const openDrawerId = Astro.url.searchParams.get('drawer') ?? undefined
---

<Layout title="Agents" description="Choose an agent to chat with." sidebar="mini">
  <main class="max-w-5xl mx-auto px-6 py-16">
    <div class="mb-12">
      <h1 class="text-3xl font-bold tracking-tight mb-2">Agents</h1>
      <p class="text-font/60">Choose an agent to start a conversation.</p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {agents.map((agent, i) => {
        const tone = tones[i % tones.length]
        return (
          <article
            class="bg-background border rounded-2xl flex flex-col"
            style="border-color: var(--color-border); box-shadow: var(--shadow-card)"
          >
            <header class="flex items-start justify-between gap-4 px-5 pt-5">
              <div class="flex items-center gap-3">
                <span
                  class={`w-8 h-8 rounded-lg flex items-center justify-center text-on-${tone} bg-${tone} text-sm font-bold shrink-0`}
                >
                  {agent.title.slice(0, 1).toUpperCase()}
                </span>
                <h2 class="font-semibold text-base">{agent.title}</h2>
              </div>
              <span
                class="px-2.5 py-1 rounded-full text-xs bg-foreground text-font/60 border shrink-0"
                style="border-color: var(--color-border)"
              >
                web
              </span>
            </header>

            <div
              class="mx-5 mt-4 p-4 bg-foreground rounded-xl border flex-1"
              style="border-color: var(--color-border)"
            >
              <p class="text-sm text-font/60 mb-4">{agent.description}</p>
              {agent.starters.length > 0 && (
                <ul class="space-y-1.5">
                  {agent.starters.slice(0, 3).map((s) => (
                    <li class="text-xs text-font/50 flex items-start gap-2">
                      <span class="mt-0.5 shrink-0">›</span>
                      <span>{s}</span>
                    </li>
                  ))}
                </ul>
              )}
            </div>

            <footer
              class="flex items-center justify-end gap-2 px-5 py-4 mt-2 border-t"
              style="border-color: var(--color-border)"
            >
              {/* Drawer trigger — client-side URL update, no full navigation */}
              <button
                type="button"
                data-drawer-trigger={agent.id}
                class="px-3 py-2 rounded-lg text-sm text-font/60 hover:text-font hover:bg-foreground transition-[color,background-color]"
                style="transition-duration: 120ms"
              >
                Details
              </button>
              <a
                href={agent.id === agents[0].id ? '/chat' : `/chat?agent=${agent.id}`}
                class={`px-4 py-2 rounded-lg text-sm font-medium bg-${tone} text-on-${tone} hover:brightness-110 transition-[filter]`}
                style="transition-duration: 120ms"
              >
                Chat →
              </a>
            </footer>
          </article>
        )
      })}
    </div>
  </main>

  {/* Drawer island — client:load so it can self-open from ?drawer= on first paint */}
  <AgentPageClient client:load agents={agents} />

  {/* ChatDock — deferred until idle, preserves Lighthouse score */}
  <ChatDock surface="agents" client:idle />
</Layout>

{/* Wire the static "Details" buttons to open their drawer via URL param */}
<script>
  document.querySelectorAll<HTMLButtonElement>('[data-drawer-trigger]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = btn.dataset.drawerTrigger
      if (!id) return
      const url = new URL(window.location.href)
      url.searchParams.set('drawer', id)
      history.pushState(null, '', url.toString())
      // Dispatch a storage event so the Drawer's internal state can react,
      // or rely on the Drawer's own popstate listener if present.
      // Simplest approach: dispatch a custom event the Drawer island listens to.
      window.dispatchEvent(new CustomEvent('drawer:open', { detail: { id } }))
    })
  })
</script>
