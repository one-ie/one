---
import Layout from '@/layouts/Layout.astro'
import { listFiles } from '@/lib/slug'

export const prerender = false

const { slug, kind } = Astro.params as { slug: string; kind: string }
const env = (await import('cloudflare:workers' as string)).env as { CONTENT?: R2Bucket }
if (!env.CONTENT) return Astro.redirect('/')

const allFiles = await listFiles(slug, env.CONTENT)
const items = allFiles
  .filter(f => f.startsWith(`${kind}/`))
  .map(f => f.slice(kind.length + 1))
---

<Layout title={`${kind}s — @${slug}`} sidebar="mini" chat="none">
  <div class="max-w-2xl mx-auto px-4 py-8">
    <h1 class="text-2xl font-bold mb-6 capitalize">{kind}s</h1>
    {items.length > 0 ? (
      <ul class="space-y-2">
        {items.map(name => (
          <li>
            <a href={`/u/${slug}/${kind}/${name}`} class="text-primary hover:underline">{name}</a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="text-font/40 text-sm">No {kind}s yet.</p>
    )}
  </div>
</Layout>
