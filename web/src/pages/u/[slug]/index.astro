---
import Layout from '@/layouts/Layout.astro'
import { OwnerControls } from '@/components/OwnerControls'
import { getSlugOwner, listFiles } from '@/lib/slug'

export const prerender = false

const { slug } = Astro.params as { slug: string }
const env = Astro.locals.runtime?.env
if (!env) return Astro.redirect('/')

const owner = await getSlugOwner(slug, env.DB)
if (!owner) return new Response(null, { status: 404 })

const files = await listFiles(slug, env.CONTENT)
const grouped: Record<string, string[]> = {}
for (const f of files) {
  const [kind] = f.split('/')
  ;(grouped[kind] ??= []).push(f)
}
---

<Layout title={`@${slug} — ONE`} sidebar="mini" chat="none">
  <div class="max-w-2xl mx-auto px-4 py-8">
    <div class="flex items-center justify-between mb-6">
      <h1 class="text-2xl font-bold">@{slug}</h1>
      <OwnerControls slug={slug} client:load />
    </div>
    {Object.entries(grouped).map(([kind, items]) => (
      <section class="mb-6">
        <h2 class="text-sm font-medium text-font/60 mb-2 capitalize">{kind}s</h2>
        <ul class="space-y-1">
          {items.map(f => {
            const name = f.split('/').slice(1).join('/')
            return <li><a href={`/u/${slug}/${kind}/${name}`} class="text-primary hover:underline">{name}</a></li>
          })}
        </ul>
      </section>
    ))}
    {files.length === 0 && (
      <p class="text-font/40 text-sm">No content yet. Chat to create your first page.</p>
    )}
  </div>
</Layout>
