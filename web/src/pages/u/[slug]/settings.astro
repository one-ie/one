---
import Layout from '@/layouts/Layout.astro'
import { getSlugOwner } from '@/lib/slug'
import { AddDeviceButton } from '@/components/AddDeviceButton'
import { DomainSettings } from '@/components/settings/DomainSettings'
import { parseSite, COLOR_KEYS } from '@/lib/site'

export const prerender = false

const { slug } = Astro.params as { slug: string }
const env = (await import('cloudflare:workers' as string)).env as { DB?: D1Database; CONTENT?: R2Bucket }

const owner = env.DB ? await getSlugOwner(slug, env.DB) : null
if (!owner) return Astro.redirect(`/u/${slug}`)

const siteObj = env.CONTENT ? await env.CONTENT.get(`${slug}/site.md`) : null
const site = siteObj ? parseSite(await siteObj.text()) : null
const tokens = site?.tokens ?? {}

const row = owner as typeof owner & { wallet?: string; agentverse_key_enc?: string; display_name?: string }
const keys = env.DB
  ? (await env.DB.prepare('SELECT pubkey, label, registered_at FROM owners_keys WHERE slug = ?')
      .bind(slug).all<{ pubkey: string; label: string | null; registered_at: number }>()).results
  : []
const publicUrl = `https://one.ie/u/${slug}`
---

<Layout title={`@${slug} settings`} profileSlug={slug} profileName={site?.name} siteStyles={site?.styleBlock}>
  <div class="max-w-xl mx-auto px-4 py-12 flex flex-col gap-8">
    <header>
      <h1 class="text-2xl font-bold text-font">Settings</h1>
      <p class="text-font/60 text-sm mt-1">@{slug}</p>
    </header>

    <section class="bg-background rounded-2xl p-6 flex flex-col gap-4" style="border:1px solid var(--color-border)">
      <h2 class="font-semibold text-font">Branding</h2>
      <p class="text-xs text-font/60">Logo and colors shown on your profile page.</p>
      <form method="POST" action="/api/branding" enctype="multipart/form-data" class="flex flex-col gap-5">
        <input type="hidden" name="slug" value={slug} />

        <div class="flex flex-col gap-1.5">
          <label class="text-sm font-medium text-font" for="branding-name">Site name</label>
          <input
            id="branding-name"
            name="name"
            type="text"
            value={site?.name ?? ''}
            placeholder={`@${slug}`}
            maxlength="80"
            class="px-3.5 py-2.5 rounded-lg bg-foreground text-font border text-sm focus:outline-none"
            style="border-color:var(--color-border)"
          />
          <span class="text-xs text-font/40">Shown in the sidebar and browser tab. Defaults to @{slug}.</span>
        </div>

        <div class="flex flex-col gap-2">
          <span class="text-sm font-medium text-font">Logo</span>
          <div class="flex items-center gap-4">
            <img
              src={`/api/logo/${slug}`}
              alt=""
              id="logo-preview"
              class="w-14 h-14 rounded-xl object-contain bg-foreground"
              style={`border:1px solid var(--color-border)`}
              onerror="this.style.display='none'"
            />
            <label class="cursor-pointer px-4 py-2 rounded-lg text-sm border text-font hover:text-font/80" style="border-color:var(--color-border)">
              Upload image
              <input
                name="logo"
                type="file"
                accept="image/*"
                class="sr-only"
                onchange="const p=document.getElementById('logo-preview');if(this.files[0]){const u=URL.createObjectURL(this.files[0]);p.src=u;p.style.display='block'}"
              />
            </label>
          </div>
          <span class="text-xs text-font/40">PNG, JPG or SVG. Shown at 56×56 px on your profile.</span>
        </div>

        <div class="flex flex-col gap-3">
          <span class="text-sm font-medium text-font">Colors</span>
          <div class="grid grid-cols-2 gap-3 sm:grid-cols-3">
            {COLOR_KEYS.map(key => {
              const current = tokens[key]
              const hexVal = current?.startsWith('#') ? current : ''
              return (
                <div class="flex flex-col gap-1">
                  <label class="text-xs text-font/60 capitalize">{key}</label>
                  <div class="flex items-center gap-2">
                    <input
                      type="color"
                      name={hexVal ? key : undefined}
                      value={hexVal || '#6366f1'}
                      data-key={key}
                      class={`w-8 h-8 rounded cursor-pointer border-0 bg-transparent p-0${!hexVal ? ' opacity-40' : ''}`}
                    />
                    <code class="text-xs text-font/60">{current || 'default'}</code>
                  </div>
                </div>
              )
            })}
          </div>
        </div>

        <button type="submit" class="self-start px-4 py-2 rounded-lg bg-primary text-on-primary text-sm font-medium">
          Save branding
        </button>
      </form>
    </section>

    <section class="bg-background rounded-2xl p-6 flex flex-col gap-4" style="border:1px solid var(--color-border)">
      <h2 class="font-semibold text-font">Identity</h2>
      <div class="flex flex-col gap-1">
        <span class="text-xs text-font/60">Your site URL</span>
        <div class="flex items-center gap-2">
          <code class="text-sm bg-foreground px-3 py-2 rounded-lg text-font flex-1 truncate">{publicUrl}</code>
          <button
            onclick={`navigator.clipboard.writeText('${publicUrl}'); this.textContent='Copied!'; setTimeout(()=>this.textContent='Copy',1500)`}
            class="px-3 py-2 rounded-lg text-sm border text-font hover:text-font/80 shrink-0"
            style="border-color:var(--color-border)"
          >Copy</button>
        </div>
      </div>
      <div class="flex flex-col gap-1">
        <span class="text-xs text-font/60">Handle</span>
        <code class="text-sm bg-foreground px-3 py-2 rounded-lg text-font">@{slug}</code>
      </div>
    </section>

    <section class="bg-background rounded-2xl p-6 flex flex-col gap-4" style="border:1px solid var(--color-border)">
      <h2 class="font-semibold text-font">Passkeys</h2>
      <p class="text-xs text-font/60">Devices that can approve changes to your site.</p>
      <ul class="divide-y" style="border-color:var(--color-border)">
        <li class="flex items-center justify-between py-2">
          <span class="text-sm text-font">Primary device</span>
          <span class="text-xs text-font/40">registered</span>
        </li>
        {keys.map(k => (
          <li class="flex items-center justify-between py-2">
            <span class="text-sm text-font">{k.label ?? `Device ${k.pubkey.slice(0, 8)}`}</span>
            <span class="text-xs text-font/40">{new Date(k.registered_at * 1000).toLocaleDateString()}</span>
          </li>
        ))}
      </ul>
      <AddDeviceButton slug={slug} client:load />
    </section>

    <section class="bg-background rounded-2xl p-6 flex flex-col gap-4" style="border:1px solid var(--color-border)">
      <h2 class="font-semibold text-font">Recovery</h2>
      <form method="POST" action="/api/settings" class="flex flex-col gap-3">
        <input type="hidden" name="slug" value={slug} />
        <div class="flex flex-col gap-1.5">
          <label class="text-sm font-medium text-font">Recovery email</label>
          <input
            name="recovery_email"
            type="email"
            placeholder="backup@example.com"
            class="px-3.5 py-2.5 rounded-lg bg-foreground text-font border text-sm focus:outline-none"
            style="border-color:var(--color-border)"
          />
          <span class="text-xs text-font/40">Used only to contact you if you lose all devices.</span>
        </div>
        <button type="submit" class="self-start px-4 py-2 rounded-lg bg-primary text-on-primary text-sm font-medium">
          Save email
        </button>
      </form>
    </section>

    <section class="bg-background rounded-2xl p-6 flex flex-col gap-4" style="border:1px solid var(--color-border)">
      <h2 class="font-semibold text-font">Wallet &amp; integrations</h2>
      <form method="POST" action="/api/settings" class="flex flex-col gap-4">
        <input type="hidden" name="slug" value={slug} />
        <div class="flex flex-col gap-1.5">
          <label class="text-sm font-medium text-font">Wallet address</label>
          <input
            name="wallet"
            type="text"
            value={row.wallet ?? ''}
            placeholder="0x… or sui1…"
            class="px-3.5 py-2.5 rounded-lg bg-foreground text-font border text-sm focus:outline-none"
            style="border-color:var(--color-border)"
          />
        </div>
        <div class="flex flex-col gap-1.5">
          <label class="text-sm font-medium text-font">Agentverse API key (encrypted)</label>
          <input
            name="agentverse_key"
            type="password"
            placeholder="Leave blank to keep existing"
            class="px-3.5 py-2.5 rounded-lg bg-foreground text-font border text-sm focus:outline-none"
            style="border-color:var(--color-border)"
          />
          <span class="text-xs text-font/40">Stored encrypted with your passkey. Never leaves your device unencrypted.</span>
        </div>
        <button type="submit" class="self-start px-4 py-2 rounded-lg bg-primary text-on-primary text-sm font-medium">
          Save changes
        </button>
      </form>
    </section>

    <section class="bg-background rounded-2xl p-6 flex flex-col gap-4" style="border:1px solid var(--color-border)">
      <h2 class="font-semibold text-font">Import skill</h2>
      <p class="text-xs text-font/60">Import a skill from a GitHub repo or URL.</p>
      <form id="import-skill-form" class="flex flex-col gap-3">
        <div class="flex flex-col gap-1.5">
          <label for="import-ref" class="text-sm font-medium text-font">Reference</label>
          <input
            id="import-ref"
            type="text"
            placeholder="github:owner/repo/path or https://agentskills.io/skill/foo"
            class="px-3.5 py-2.5 rounded-lg bg-foreground text-font border text-sm focus:outline-none"
            style="border-color:var(--color-border)"
            required
          />
          <span class="text-xs text-font/40">GitHub path or full skill URL</span>
        </div>
        <div class="flex flex-col gap-1.5">
          <label for="import-name" class="text-sm font-medium text-font">Name (optional)</label>
          <input
            id="import-name"
            type="text"
            placeholder="Override skill name"
            class="px-3.5 py-2.5 rounded-lg bg-foreground text-font border text-sm focus:outline-none"
            style="border-color:var(--color-border)"
          />
        </div>
        <div class="flex flex-col gap-1.5">
          <label for="import-price" class="text-sm font-medium text-font">Price (USD)</label>
          <input
            id="import-price"
            type="number"
            step="0.01"
            value="0.02"
            min="0"
            class="px-3.5 py-2.5 rounded-lg bg-foreground text-font border text-sm focus:outline-none"
            style="border-color:var(--color-border)"
          />
        </div>
        <button type="submit" class="self-start px-4 py-2 rounded-lg bg-primary text-on-primary text-sm font-medium">
          Import
        </button>
      </form>
      <pre id="import-result" style="display:none" class="mt-3 p-3 rounded-lg bg-foreground text-font text-xs overflow-auto" style="border-color:var(--color-border)"></pre>
    </section>

    <section class="bg-background rounded-2xl p-6 flex flex-col gap-4" style="border:1px solid var(--color-border)">
      <h2 class="font-semibold text-font">Custom domain</h2>
      <p class="text-sm text-font/60">Connect your own domain to <code class="bg-foreground px-1.5 py-0.5 rounded text-xs">@{slug}</code>.</p>
      <DomainSettings slug={slug} client:load />
    </section>

    <section class="bg-background rounded-2xl p-6 flex flex-col gap-4" style="border:1px solid var(--color-border)">
      <h2 class="font-semibold text-font">Export &amp; delete</h2>
      <p class="text-xs text-font/60">Your content is yours. Export everything as a ZIP at any time.</p>
      <div class="flex gap-3">
        <a
          href={`/u/${slug}/export`}
          class="px-4 py-2 rounded-lg text-sm border text-font hover:text-font/80"
          style="border-color:var(--color-border)"
        >Export .zip</a>
        <button
          class="px-4 py-2 rounded-lg text-sm text-destructive border opacity-50 cursor-not-allowed"
          style="border-color:var(--color-border)"
          disabled
        >Delete site</button>
      </div>
    </section>

    <a href={`/u/${slug}`} class="text-sm text-font/60 hover:text-font">← Back to profile</a>
  </div>
</Layout>

<script define:vars={{ slug }}>
  const form = document.getElementById('import-skill-form')
  const resultEl = document.getElementById('import-result')

  form?.addEventListener('submit', async (e) => {
    e.preventDefault()

    const ref = document.getElementById('import-ref')?.value?.trim()
    const name = document.getElementById('import-name')?.value?.trim()
    const price = parseFloat(document.getElementById('import-price')?.value || '0.02')

    if (!ref) {
      resultEl.textContent = 'Error: ref is required'
      resultEl.style.display = 'block'
      return
    }

    try {
      // TODO: wire auth — for now we'll attempt without Bearer token
      const response = await fetch('/api/skill/import', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ ref, slug, name: name || undefined, price }),
      })

      const data = await response.json()
      resultEl.textContent = JSON.stringify(data, null, 2)
      resultEl.style.display = 'block'
    } catch (err) {
      resultEl.textContent = `Error: ${err instanceof Error ? err.message : String(err)}`
      resultEl.style.display = 'block'
    }
  })
</script>

<script>
  // Live-preview: update CSS vars and sidebar name/logo as the user edits branding
  const root = document.documentElement

  // Hex → HSL lightness (0–100) for on-* contrast label
  function hexToL(hex: string): number {
    const r = parseInt(hex.slice(1, 3), 16) / 255
    const g = parseInt(hex.slice(3, 5), 16) / 255
    const b = parseInt(hex.slice(5, 7), 16) / 255
    return ((Math.max(r, g, b) + Math.min(r, g, b)) / 2) * 100
  }

  // Color pickers — set name on first change so the value is included in the form POST
  document.querySelectorAll<HTMLInputElement>('input[type="color"][data-key]').forEach(picker => {
    picker.addEventListener('input', () => {
      picker.name = picker.dataset.key!
      picker.classList.remove('opacity-40')
      const key = picker.dataset.key!
      root.style.setProperty(`--color-${key}`, picker.value)
      if (key === 'primary' || key === 'secondary' || key === 'tertiary') {
        root.style.setProperty(`--color-on-${key}`, hexToL(picker.value) < 60 ? '#fff' : '#000')
      }
    })
  })

  // Site name → sidebar brand label (live)
  const nameInput = document.getElementById('branding-name') as HTMLInputElement | null
  const brandLabels = document.querySelectorAll<HTMLElement>('[data-brand-label]')
  nameInput?.addEventListener('input', () => {
    brandLabels.forEach(el => { el.textContent = nameInput.value || el.dataset.brandDefault || '' })
  })
</script>
