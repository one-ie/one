---
import Layout from '../layouts/Layout.astro';
import { GetStartedPrompt } from '@/components/GetStartedPrompt';
import { Button } from '@/components/ui/button';
import {
  Card,
  CardHeader,
  CardTitle,
  CardDescription,
  CardContent,
} from '@/components/ui/card';
import { Badge } from '@/components/ui/badge';
import { GitSection } from '@/components/GitSection';
import { PerformanceChart } from '@/components/features/PerformanceChart';
import OrbitingCircles from '@/components/magicui/orbiting-circles';
import {
  Github,
  Check,
  Rocket,
  Users,
  Box,
  GitBranch,
  Activity,
  Brain,
  Coins,
  Wand2,
  Sparkles,
  Zap,
  Globe,
  Shield,
  Target,
  TrendingUp,
  Code,
  DollarSign,
  Network,
  Bot,
  Building2,
  ArrowRight,
} from 'lucide-react';

const innerOrbits = [
  {
    startAngle: 0,
    duration: 36,
    logo: '/logos/shopify.svg',
    name: 'Shopify',
    caption: 'Storefront',
  },
  {
    startAngle: 90,
    duration: 36,
    logo: '/logos/woocommerce.svg',
    name: 'WooCommerce',
    caption: 'Commerce',
  },
  {
    startAngle: 180,
    duration: 36,
    logo: '/logos/magento.svg',
    name: 'Magento',
    caption: 'Enterprise',
  },
  {
    startAngle: 270,
    duration: 36,
    logo: '/logos/stripe.svg',
    name: 'Stripe',
    caption: 'Billing',
  },
];

const outerOrbits = [
  {
    startAngle: 0,
    duration: 48,
    logo: '/logos/openai.svg',
    name: 'OpenAI',
    caption: 'GPT-4',
  },
  {
    startAngle: 72,
    duration: 48,
    logo: '/logos/anthropic.svg',
    name: 'Anthropic',
    caption: 'Claude 3',
  },
  {
    startAngle: 144,
    duration: 48,
    logo: '/logos/gemini.svg',
    name: 'Google Gemini',
    caption: 'Multimodal',
  },
  {
    startAngle: 216,
    duration: 48,
    logo: '/logos/mistral.svg',
    name: 'Mistral AI',
    caption: 'Open-Weight',
  },
  {
    startAngle: 288,
    duration: 48,
    logo: '/logos/deepseek.svg',
    name: 'DeepSeek',
    caption: 'Optimized',
  },
];

// Detect if this is ONE Platform or a customer org
const isONE = import.meta.env.ORG_NAME === "one" || !import.meta.env.ORG_NAME;
const orgName = import.meta.env.ORG_NAME || "ONE";
---

{!isONE ? (
  <!-- Customer org: Show GetStartedPrompt -->
  <Layout title={`${orgName} - Get Started`}>
    <GetStartedPrompt client:load orgName={orgName} />
  </Layout>
) : (
  <!-- ONE Platform: Show full homepage -->
<Layout title="ONE - Build AI Agents, Applications, and Your Audience">
  <style is:global>
    /* Desktop only: hide header until scroll on home page */
    @media (min-width: 1024px) {
      body.home-header-hidden header[data-home-header] {
        opacity: 0;
        pointer-events: none;
        transform: translateY(-12px);
        transition:
          opacity 0.3s ease,
          transform 0.3s ease;
      }
      body.home-header-hidden.home-header-visible header[data-home-header] {
        opacity: 1;
        pointer-events: auto;
        transform: translateY(0);
      }
    }

    /* Mobile: header always visible */
    @media (max-width: 1023px) {
      body.home-header-hidden header[data-home-header] {
        opacity: 1;
        pointer-events: auto;
        transform: translateY(0);
      }
    }
  </style>
  <script is:inline>
    if (typeof window !== 'undefined') {
      const init = () => {
        const body = document.body;
        if (!body) return;

        // Check if we're on desktop (lg breakpoint = 1024px)
        const isDesktop = () => window.innerWidth >= 1024;

        const applyVisibility = () => {
          // Only hide/show header on desktop
          if (isDesktop()) {
            if (window.scrollY > 120) {
              body.classList.add('home-header-visible');
            } else {
              body.classList.remove('home-header-visible');
            }
          } else {
            // On mobile, always show header
            body.classList.remove('home-header-visible');
          }
        };

        // Only add hidden class on desktop
        if (isDesktop()) {
          body.classList.add('home-header-hidden');
        }

        applyVisibility();
        window.addEventListener('scroll', applyVisibility, { passive: true });

        // Handle window resize
        const handleResize = () => {
          if (isDesktop()) {
            body.classList.add('home-header-hidden');
            applyVisibility();
          } else {
            body.classList.remove('home-header-hidden', 'home-header-visible');
          }
        };
        window.addEventListener('resize', handleResize, { passive: true });

        const cleanup = () => {
          body.classList.remove('home-header-hidden', 'home-header-visible');
          window.removeEventListener('scroll', applyVisibility);
          window.removeEventListener('resize', handleResize);
          window.removeEventListener('pagehide', cleanup);
          window.removeEventListener('beforeunload', cleanup);
        };

        window.addEventListener('pagehide', cleanup);
        window.addEventListener('beforeunload', cleanup);
      };

      if (document.readyState === 'loading') {
        window.addEventListener('DOMContentLoaded', init, { once: true });
      } else {
        init();
      }
    }
  </script>
  <GitSection client:load />

  <!-- Who ONE Is For -->
  <section
    class="border-y bg-muted/50 px-4 py-20 sm:px-6 sm:py-24 md:px-8 md:py-32"
  >
    <div class="mx-auto max-w-full sm:max-w-6xl">
      <div class="mb-20 space-y-4 text-center">
        <Badge
          variant="outline"
          className="mb-2 inline-flex items-center gap-2"
          data-usal="fade-down duration-600"
        >
          <Users className="h-4 w-4" />
          Built For Everyone
        </Badge>
        <h2
          class="text-4xl font-bold leading-tight tracking-tight sm:text-5xl"
          data-usal="fade-up duration-700 delay-100"
        >
          Who Is ONE For?
          <br />
          <span class="text-muted-foreground">You. Right Now.</span>
        </h2>
        <p
          class="mx-auto max-w-3xl text-lg leading-relaxed text-muted-foreground"
          data-usal="fade-up duration-700 delay-200"
        >
          From kids learning to code to enterprises managing billions in
          revenue—the same 6-dimension ontology scales to your needs.
        </p>
      </div>

      <!-- Segment Selector Grid -->
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        <!-- Kids -->
        <Card
          className="group border-border/50 bg-card/50 backdrop-blur transition-all hover:scale-[1.02] hover:border-primary/20 hover:bg-card hover:shadow-lg hover:shadow-primary/5 cursor-pointer"
          data-usal="fade-up duration-600 delay-100"
        >
          <CardHeader className="space-y-4">
            <div
              class="flex h-12 w-12 items-center justify-center rounded-lg bg-primary/10 transition-colors group-hover:bg-primary/15"
            >
              <Users className="h-6 w-6 text-primary" />
            </div>
            <CardTitle className="text-xl">For Kids 🧒</CardTitle>
            <CardDescription className="leading-relaxed">
              Create, share, and play safely. Learn to build your first AI agent
              or community.
            </CardDescription>
            <div class="flex flex-wrap gap-2 pt-2">
              <Badge variant="secondary" className="text-xs">Communities</Badge>
              <Badge variant="secondary" className="text-xs">Content</Badge>
              <Badge variant="secondary" className="text-xs">Safe</Badge>
            </div>
          </CardHeader>
        </Card>

        <!-- Young People -->
        <Card
          className="group border-border/50 bg-card/50 backdrop-blur transition-all hover:scale-[1.02] hover:border-primary/20 hover:bg-card hover:shadow-lg hover:shadow-primary/5 cursor-pointer"
          data-usal="fade-up duration-600 delay-150"
        >
          <CardHeader className="space-y-4">
            <div
              class="flex h-12 w-12 items-center justify-center rounded-lg bg-primary/10 transition-colors group-hover:bg-primary/15"
            >
              <Code className="h-6 w-6 text-primary" />
            </div>
            <CardTitle className="text-xl">For Young People 🧑‍💻</CardTitle>
            <CardDescription className="leading-relaxed">
              Learn skills, build projects, start your first side hustle. Launch
              your career.
            </CardDescription>
            <div class="flex flex-wrap gap-2 pt-2">
              <Badge variant="secondary" className="text-xs">Courses</Badge>
              <Badge variant="secondary" className="text-xs">Projects</Badge>
              <Badge variant="secondary" className="text-xs">Monetize</Badge>
            </div>
          </CardHeader>
        </Card>

        <!-- Creators -->
        <Card
          className="group border-border/50 bg-card/50 backdrop-blur transition-all hover:scale-[1.02] hover:border-primary/20 hover:bg-card hover:shadow-lg hover:shadow-primary/5 cursor-pointer"
          data-usal="fade-up duration-600 delay-200"
        >
          <CardHeader className="space-y-4">
            <div
              class="flex h-12 w-12 items-center justify-center rounded-lg bg-primary/10 transition-colors group-hover:bg-primary/15"
            >
              <Wand2 className="h-6 w-6 text-primary" />
            </div>
            <CardTitle className="text-xl">For Creators 🧑‍🎨</CardTitle>
            <CardDescription className="leading-relaxed">
              Build your audience, clone yourself, monetize your passion. AI
              works for you 24/7.
            </CardDescription>
            <div class="flex flex-wrap gap-2 pt-2">
              <Badge variant="secondary" className="text-xs">AI Clones</Badge>
              <Badge variant="secondary" className="text-xs">Tokens</Badge>
              <Badge variant="secondary" className="text-xs">Courses</Badge>
            </div>
          </CardHeader>
        </Card>

        <!-- Sellers -->
        <Card
          className="group border-border/50 bg-card/50 backdrop-blur transition-all hover:scale-[1.02] hover:border-primary/20 hover:bg-card hover:shadow-lg hover:shadow-primary/5 cursor-pointer"
          data-usal="fade-up duration-600 delay-250"
        >
          <CardHeader className="space-y-4">
            <div
              class="flex h-12 w-12 items-center justify-center rounded-lg bg-primary/10 transition-colors group-hover:bg-primary/15"
            >
              <DollarSign className="h-6 w-6 text-primary" />
            </div>
            <CardTitle className="text-xl">For Sellers 🛒</CardTitle>
            <CardDescription className="leading-relaxed">
              Sell products, manage customers, automate sales. AI agents handle
              the funnel.
            </CardDescription>
            <div class="flex flex-wrap gap-2 pt-2">
              <Badge variant="secondary" className="text-xs">Products</Badge>
              <Badge variant="secondary" className="text-xs">Sales Agents</Badge
              >
              <Badge variant="secondary" className="text-xs">Analytics</Badge>
            </div>
          </CardHeader>
        </Card>

        <!-- Marketers -->
        <Card
          className="group border-border/50 bg-card/50 backdrop-blur transition-all hover:scale-[1.02] hover:border-primary/20 hover:bg-card hover:shadow-lg hover:shadow-primary/5 cursor-pointer"
          data-usal="fade-up duration-600 delay-100"
        >
          <CardHeader className="space-y-4">
            <div
              class="flex h-12 w-12 items-center justify-center rounded-lg bg-primary/10 transition-colors group-hover:bg-primary/15"
            >
              <TrendingUp className="h-6 w-6 text-primary" />
            </div>
            <CardTitle className="text-xl">For Marketers 📈</CardTitle>
            <CardDescription className="leading-relaxed">
              Launch campaigns, generate leads, analyze performance. Data-driven
              automation.
            </CardDescription>
            <div class="flex flex-wrap gap-2 pt-2">
              <Badge variant="secondary" className="text-xs">Campaigns</Badge>
              <Badge variant="secondary" className="text-xs">Leads</Badge>
              <Badge variant="secondary" className="text-xs">Insights</Badge>
            </div>
          </CardHeader>
        </Card>

        <!-- Designers -->
        <Card
          className="group border-border/50 bg-card/50 backdrop-blur transition-all hover:scale-[1.02] hover:border-primary/20 hover:bg-card hover:shadow-lg hover:shadow-primary/5 cursor-pointer"
          data-usal="fade-up duration-600 delay-150"
        >
          <CardHeader className="space-y-4">
            <div
              class="flex h-12 w-12 items-center justify-center rounded-lg bg-primary/10 transition-colors group-hover:bg-primary/15"
            >
              <Sparkles className="h-6 w-6 text-primary" />
            </div>
            <CardTitle className="text-xl">For Designers 🎨</CardTitle>
            <CardDescription className="leading-relaxed">
              Create assets, build templates, maintain brand consistency. Design
              at scale.
            </CardDescription>
            <div class="flex flex-wrap gap-2 pt-2">
              <Badge variant="secondary" className="text-xs">Templates</Badge>
              <Badge variant="secondary" className="text-xs">Assets</Badge>
              <Badge variant="secondary" className="text-xs">Branding</Badge>
            </div>
          </CardHeader>
        </Card>

        <!-- Engineers -->
        <Card
          className="group border-border/50 bg-card/50 backdrop-blur transition-all hover:scale-[1.02] hover:border-primary/20 hover:bg-card hover:shadow-lg hover:shadow-primary/5 cursor-pointer"
          data-usal="fade-up duration-600 delay-200"
        >
          <CardHeader className="space-y-4">
            <div
              class="flex h-12 w-12 items-center justify-center rounded-lg bg-primary/10 transition-colors group-hover:bg-primary/15"
            >
              <Code className="h-6 w-6 text-primary" />
            </div>
            <CardTitle className="text-xl">For Engineers ⚙️</CardTitle>
            <CardDescription className="leading-relaxed">
              Connect systems, automate workflows, build integrations. APIs that
              just work.
            </CardDescription>
            <div class="flex flex-wrap gap-2 pt-2">
              <Badge variant="secondary" className="text-xs">Integrations</Badge
              >
              <Badge variant="secondary" className="text-xs">Workflows</Badge>
              <Badge variant="secondary" className="text-xs">APIs</Badge>
            </div>
          </CardHeader>
        </Card>

        <!-- Executives -->
        <Card
          className="group border-border/50 bg-card/50 backdrop-blur transition-all hover:scale-[1.02] hover:border-primary/20 hover:bg-card hover:shadow-lg hover:shadow-primary/5 cursor-pointer"
          data-usal="fade-up duration-600 delay-250"
        >
          <CardHeader className="space-y-4">
            <div
              class="flex h-12 w-12 items-center justify-center rounded-lg bg-primary/10 transition-colors group-hover:bg-primary/15"
            >
              <Building2 className="h-6 w-6 text-primary" />
            </div>
            <CardTitle className="text-xl">For Executives 🤵</CardTitle>
            <CardDescription className="leading-relaxed">
              Monitor performance, make data-driven decisions, oversee strategy.
              Business intelligence.
            </CardDescription>
            <div class="flex flex-wrap gap-2 pt-2">
              <Badge variant="secondary" className="text-xs">Analytics</Badge>
              <Badge variant="secondary" className="text-xs">Strategy</Badge>
              <Badge variant="secondary" className="text-xs">Insights</Badge>
            </div>
          </CardHeader>
        </Card>
      </div>

      <div
        class="mt-16 rounded-lg border border-primary/20 bg-primary/5 p-8 backdrop-blur text-center"
      >
        <p class="text-lg leading-relaxed">
          <strong class="text-foreground"
            >Same platform. Same 6 dimensions. Infinite possibilities.</strong
          >
          <br class="hidden sm:block" />
          <span class="text-muted-foreground"
            >The ontology adapts to YOUR world, not the other way around.</span
          >
        </p>
        <div class="mt-6">
          <a href="/ontology">
            <Button size="lg" variant="outline">
              Explore The Ontology
              <ArrowRight className="ml-2 h-5 w-5" />
            </Button>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- How It Works -->
  <section class="px-4 py-20 sm:px-6 sm:py-24 md:px-8 md:py-32">
    <div class="mx-auto max-w-full sm:max-w-6xl">
      <!-- Orbiting Circles with Logos -->
      <div
        class="relative mx-auto mb-20 flex h-[500px] sm:h-[600px] w-full max-w-[360px] sm:max-w-[500px] items-center justify-center origin-center scale-[0.85] sm:scale-100"
      >
        <div class="absolute inset-0 flex items-center justify-center">
          <svg class="absolute size-full" viewBox="0 0 900 900">
            <circle
              cx="450"
              cy="450"
              r="240"
              fill="none"
              stroke="currentColor"
              stroke-opacity="0.12"
              stroke-width="1.5"
              stroke-dasharray="6 4"></circle>
            <circle
              cx="450"
              cy="450"
              r="360"
              fill="none"
              stroke="currentColor"
              stroke-opacity="0.1"
              stroke-width="1.5"
              stroke-dasharray="6 4"></circle>
          </svg>
        </div>

        <div
          class="relative flex h-60 w-60 items-center justify-center rounded-full bg-primary/10 shadow-inner"
        >
          <div
            class="flex h-28 w-28 items-center justify-center rounded-full bg-primary text-xl font-semibold text-primary-foreground shadow-lg"
          >
            <img
              src="/logos/one.svg"
              alt="ONE"
              class="h-16 w-16"
              loading="lazy"
            />
          </div>
        </div>

        {
          innerOrbits.map(
            ({ startAngle, duration, logo, name, caption }, index) => (
              <OrbitingCircles
                radius={240}
                duration={duration}
                startAngle={startAngle}
                client:load
              >
                <div class="flex flex-col items-center text-center">
                  <div class="flex h-14 w-14 items-center justify-center rounded-full bg-background/90 p-2 shadow-sm backdrop-blur">
                    <img
                      src={logo}
                      alt={name}
                      class="h-full w-full object-contain"
                      loading="lazy"
                    />
                  </div>
                  <span class="mt-2 text-sm font-medium text-foreground">
                    {name}
                  </span>
                  <span class="text-xs text-muted-foreground whitespace-nowrap">
                    {caption}
                  </span>
                </div>
              </OrbitingCircles>
            )
          )
        }

        {
          outerOrbits.map(
            ({ startAngle, duration, logo, name, caption }, index) => (
              <OrbitingCircles
                radius={360}
                duration={duration}
                startAngle={startAngle}
                client:load
              >
                <div class="flex flex-col items-center text-center">
                  <div class="flex h-16 w-16 items-center justify-center rounded-full bg-card/70 p-3 shadow-md backdrop-blur">
                    <img
                      src={logo}
                      alt={name}
                      class="h-full w-full object-contain"
                      loading="lazy"
                    />
                  </div>
                  <span class="mt-2 text-sm font-semibold text-foreground">
                    {name}
                  </span>
                  <span class="text-xs text-muted-foreground whitespace-nowrap">
                    {caption}
                  </span>
                </div>
              </OrbitingCircles>
            )
          )
        }
      </div>

      <div class="mb-20 space-y-4 text-center">
        <Badge
          variant="outline"
          className="mb-2 inline-flex items-center gap-2"
          data-usal="fade-down duration-600"
        >
          <Zap className="h-4 w-4" />
          How It Works
        </Badge>
        <h2
          class="text-4xl font-bold leading-tight tracking-tight sm:text-5xl"
          data-usal="fade-up duration-700 delay-100"
        >
          English → Code → Reality
          <br />
          <span class="text-muted-foreground">In Minutes, Not Months</span>
        </h2>
        <p
          class="mx-auto max-w-3xl text-lg leading-relaxed text-muted-foreground"
          data-usal="fade-up duration-700 delay-200"
        >
          Describe your feature in plain English. The system validates it
          against the ontology, compiles to TypeScript, generates tests, and
          deploys to the edge.
        </p>
      </div>

      <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-4">
        <Card
          className="border-border/50 bg-card/50 backdrop-blur"
          data-usal="fade-up duration-600 delay-100"
        >
          <CardHeader className="space-y-4">
            <div
              class="flex h-12 w-12 items-center justify-center rounded-lg bg-primary/10 text-2xl font-bold text-primary"
            >
              1
            </div>
            <CardTitle className="text-xl">Write in English</CardTitle>
            <CardDescription className="leading-relaxed">
              Describe what you want: "CREATE ai clone", "CALL OpenAI", "RECORD
              purchase". Use 15 simple commands anyone can understand.
            </CardDescription>
            <div class="space-y-2 pt-2">
              <div class="text-xs text-muted-foreground">
                <span class="font-semibold text-foreground">Creator:</span> "CREATE
                my AI clone"
              </div>
              <div class="text-xs text-muted-foreground">
                <span class="font-semibold text-foreground">Seller:</span> "RECORD
                purchase event"
              </div>
              <div class="text-xs text-muted-foreground">
                <span class="font-semibold text-foreground">Engineer:</span> "CONNECT
                to Stripe API"
              </div>
            </div>
          </CardHeader>
        </Card>

        <Card
          className="border-border/50 bg-card/50 backdrop-blur"
          data-usal="fade-up duration-600 delay-200"
        >
          <CardHeader className="space-y-4">
            <div
              class="flex h-12 w-12 items-center justify-center rounded-lg bg-primary/10 text-2xl font-bold text-primary"
            >
              2
            </div>
            <CardTitle className="text-xl">System Validates</CardTitle>
            <CardDescription className="leading-relaxed">
              Checks against the ontology: Do these entity types exist? Are
              connections valid? Are services available? Instant feedback.
            </CardDescription>
            <div class="space-y-2 pt-2">
              <div class="text-xs text-muted-foreground">
                <Check className="inline h-3 w-3 text-green-500" />
                <span class="font-semibold text-foreground">ai_clone</span> entity
                type exists
              </div>
              <div class="text-xs text-muted-foreground">
                <Check className="inline h-3 w-3 text-green-500" />
                <span class="font-semibold text-foreground"
                  >tokens_purchased</span
                > event valid
              </div>
              <div class="text-xs text-muted-foreground">
                <Check className="inline h-3 w-3 text-green-500" />
                <span class="font-semibold text-foreground">Stripe</span> service
                available
              </div>
            </div>
          </CardHeader>
        </Card>

        <Card
          className="border-border/50 bg-card/50 backdrop-blur"
          data-usal="fade-up duration-600 delay-300"
        >
          <CardHeader className="space-y-4">
            <div
              class="flex h-12 w-12 items-center justify-center rounded-lg bg-primary/10 text-2xl font-bold text-primary"
            >
              3
            </div>
            <CardTitle className="text-xl">Code Generated</CardTitle>
            <CardDescription className="leading-relaxed">
              Compiles to production TypeScript with Effect.ts, Convex
              functions, React components, full test suite. Type-safe, tested,
              ready.
            </CardDescription>
            <div class="space-y-2 pt-2">
              <div class="flex items-center gap-2">
                <Badge variant="secondary" className="text-xs">Backend</Badge>
                <span class="text-xs text-muted-foreground"
                  >Mutations + Queries</span
                >
              </div>
              <div class="flex items-center gap-2">
                <Badge variant="secondary" className="text-xs">Frontend</Badge>
                <span class="text-xs text-muted-foreground"
                  >React Components</span
                >
              </div>
              <div class="flex items-center gap-2">
                <Badge variant="secondary" className="text-xs">Tests</Badge>
                <span class="text-xs text-muted-foreground">50+ test cases</span
                >
              </div>
            </div>
          </CardHeader>
        </Card>

        <Card
          className="border-border/50 bg-card/50 backdrop-blur"
          data-usal="fade-up duration-600 delay-400"
        >
          <CardHeader className="space-y-4">
            <div
              class="flex h-12 w-12 items-center justify-center rounded-lg bg-primary/10 text-2xl font-bold text-primary"
            >
              4
            </div>
            <CardTitle className="text-xl">Deploy to Edge</CardTitle>
            <CardDescription className="leading-relaxed">
              Push to Cloudflare's global network. Unlimited requests, instant
              updates, zero configuration. Live in 60 seconds.
            </CardDescription>
