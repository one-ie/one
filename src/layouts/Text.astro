---
import Layout from "@layouts/Layout.astro";
import { Chat } from "@/components/Chat";
import { normalizeConfig } from "@/schema/chat";

interface Props {
  frontmatter: any;
  // For MDX files
  Content?: any;
  // Raw content 
  content?: string;
}

const { frontmatter, Content, content } = Astro.props;

// Get the raw content
let rawContent = '';

try {
  // First try: Direct content if provided
  if (content && typeof content === 'string') {
    rawContent = content;
    console.log('[Direct content found]', {
      length: content.length,
      preview: content.substring(0, 100)
    });
  }
  
  // Second try: MDX/Markdown Content component
  if (!rawContent && Content?.rawContent) {
    rawContent = await Content.rawContent();
    console.log('[Markdown content found]', {
      length: rawContent.length,
      preview: rawContent.substring(0, 100)
    });
  }
  
  // Last try: Render default slot
  if (!rawContent) {
    rawContent = await Astro.slots.render('default');
    if (rawContent) {
      console.log('[Slot content found]', {
        length: rawContent.length,
        preview: rawContent.substring(0, 100)
      });
    }
  }
} catch (error) {
  console.error('[Content extraction failed]:', error);
}

// Always normalize the configuration from frontmatter
const chatConfig = normalizeConfig({
  ...frontmatter,
  // If includeContent is true, add the content to chat context
  ...(frontmatter.includeContent && rawContent ? { content: rawContent } : {})
});

---

<Layout title={frontmatter.title} description={frontmatter.description}>
  <div class="flex flex-col md:flex-row h-screen">
    <!-- Content area -->
    <div class="w-full md:w-3/4 overflow-auto p-8">
      <article class="prose prose-lg dark:prose-invert max-w-3xl mx-auto">
        {Content ? <Content /> : <slot />}
      </article>
    </div>
    
    <!-- Chat area -->
    <div class="w-full md:w-1/4 border-l border-gray-200 dark:border-gray-800 h-full">
      <Chat
        client:load
        chatConfig={chatConfig}
        content={frontmatter.includeContent ? rawContent : undefined}
        className="h-full"
      />
    </div>
  </div>
</Layout>

<style>
  /* Hide scrollbars but keep functionality */
  :global(*::-webkit-scrollbar) {
    display: none;
  }
  
  :global(*) {
    -ms-overflow-style: none;  /* IE and Edge */
    scrollbar-width: none;  /* Firefox */
  }
</style>