---
import Layout from "./Layout.astro";

type Props = {
  frontmatter: {
    title: string;
    description: string;
    chatConfig?: any;
  };
};

const { frontmatter } = Astro.props as Props;

// Get raw content and strip frontmatter
const rawContent = await Astro.slots.render('default');
const cleanContent = rawContent.replace(/^---[\s\S]*?---/, '').trim();
---
<Layout 
  title={frontmatter.title} 
  description={frontmatter.description}
  chatConfig={frontmatter.chatConfig}
  content={cleanContent}
>
  <article class="prose dark:prose-invert prose-slate max-w-1000 py-8 px-8 mx-auto container">
    <slot />
  </article>
</Layout>