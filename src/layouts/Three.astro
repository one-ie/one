---
import Layout from "@layouts/1.left.astro";
import { Chat as ChatComponent } from "@/components/Chat";
import { normalizeConfig } from "@/schema/chat";

import type { ChatConfig } from "@/schema/chat"; // Import the type

interface Props {
  frontmatter?: any; // Make frontmatter optional as config might come via chatConfig prop
  chatConfig?: ChatConfig; // Add chatConfig prop
  // For MDX files
  Content?: any;
  // Raw content
  content?: string;
}

// Destructure props, getting chatConfig directly if passed
const { chatConfig: passedChatConfig, frontmatter = {}, Content, content } = Astro.props;

// Get the raw content
let rawContent = '';

try {
  // First try: Direct content if provided
  if (content && typeof content === 'string') {
    rawContent = content;
    console.log('[Direct content found]', {
      length: content.length,
      preview: content.substring(0, 100)
    });
  }
  
  // Second try: MDX/Markdown Content component
  if (!rawContent && Content?.rawContent) {
    rawContent = await Content.rawContent();
    console.log('[Markdown content found]', {
      length: rawContent.length,
      preview: rawContent.substring(0, 100)
    });
  }
  
  // Last try: Render default slot
  if (!rawContent) {
    rawContent = await Astro.slots.render('default');
    if (rawContent) {
      console.log('[Slot content found]', {
        length: rawContent.length,
        preview: rawContent.substring(0, 100)
      });
    }
  }
} catch (error) {
  console.error('[Content extraction failed]:', error);
}

// Use the passed chatConfig prop directly, merging with potential rawContent
const chatConfig = normalizeConfig({
  ...(passedChatConfig || {}), // Use the passed config object
  // If includeContent is true (based on the passed config), add the raw slot content
  ...(passedChatConfig?.includeContent && rawContent ? { content: rawContent } : {})
});

// Debug final state
console.log('Content processing:', {
  type: typeof rawContent,
  rawLength: rawContent?.length || 0,
  rawPreview: rawContent ? rawContent.substring(0, 100) : 'N/A',
  includeContent: Boolean(passedChatConfig?.includeContent),
  isJSON: typeof rawContent === 'string' && rawContent.startsWith('{'),
  contentSettings: {
    hasContent: Boolean(rawContent),
    includeContent: Boolean(passedChatConfig?.includeContent)
  }
});
---

{/* Use the normalized chatConfig for title, description etc. */}
<Layout title={chatConfig.title} description={chatConfig.description}>
  <div class="flex items-center justify-center h-screen">
    <!-- Centered chat window -->
    <div class="w-full max-w-2xl h-[90vh]">
      <ChatComponent
        client:load
        chatConfig={chatConfig}
        content={chatConfig.includeContent ? rawContent : undefined}
        className="h-full"
      />
    </div>
  </div>
</Layout>

<style>
  /* Hide scrollbars but keep functionality */
  :global(*::-webkit-scrollbar) {
    display: none;
  }
  
  :global(*) {
    -ms-overflow-style: none;  /* IE and Edge */
    scrollbar-width: none;  /* Firefox */
  }
</style>