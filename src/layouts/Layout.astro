---
import "../styles/global.css";
import "../styles/one.css";
import ThemeInit from "../components/Theme.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer";
import Sidebar from "../components/Sidebar.astro";
import Right from "../components/Right";
import { ChatConfigSchema } from "../schema/chat";

interface Props {
  title: string;
  description?: string;
  children: any;
  header?: boolean;
  footer?: boolean;
  initialPanelMode?: "Quarter" | "Half" | "Full" | "Floating" | "Icon";
  chatConfig?: any;
  rightPanelMode?: "hidden" | "full" | "half" | "quarter" | "floating" | "icon";
  content?: string;
}

const {
  title,
  description = "ONE",
  initialPanelMode,
  rightPanelMode = "quarter",
  chatConfig: providedConfig,
  content,
} = Astro.props;

const { header = true, footer = true } = Astro.props;

// Default chat configuration
const defaultChatConfig = ChatConfigSchema.parse({
  // ... existing chat config
});

// Use provided config or fall back to default
const chatConfig = providedConfig || defaultChatConfig;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <ThemeInit />
  </head>
  <body>
    <div
      class="main-grid"
      id="main-grid"
      data-panel-mode={initialPanelMode || "Quarter"}
    >
      <Sidebar />
      <div class="center-grid" id="center-grid">
        {header && <Header client:load />}
        
        <main>
          <slot />
        </main>

        {footer && <Footer client:idle />}
      </div>
      <Right
        client:idle
        chatConfig={chatConfig}
        rightPanelMode={rightPanelMode}
        content={content}
      />
    </div>
  </body>
</html>

<style>
  :global(body) {
    min-height: 100vh;
    background-color: hsl(var(--one-background-main));
    color: hsl(var(--one-foreground));
  }

  .main-grid {
    display: grid;
    min-height: 100vh;
    position: relative;
    z-index: 10;
    width: 100%;
    max-width: 100%;
    overflow-x: hidden;
  }

  .main-grid[data-panel-mode="Quarter"] {
    /* Ensure main content takes remaining space while panel maintains minimum width */
    grid-template-columns: minmax(0, calc(100% - 350px));
  }

  .main-grid[data-panel-mode="Half"] {
    grid-template-columns: minmax(0, 50%);
  }

  .main-grid[data-panel-mode="Full"] {
    grid-template-columns: 0;
  }

  .main-grid[data-panel-mode="Floating"],
  .main-grid[data-panel-mode="Icon"] {
    grid-template-columns: 1fr;
    padding-right: 0;
  }

  .main-grid.transitions-enabled {
    transition: grid-template-columns 0.3s ease;
  }

  .center-grid {
    position: relative;
    z-index: 10;
    width: 100%;
    max-width: 100%;
    margin-right: 0;
    overflow: hidden;
  }

  @media (min-width: 640px) {
    .main-grid:not([data-panel-mode="Full"]) .center-grid {
      padding-left: 60px;
    }
  }

  :global(.right-panel) {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    z-index: 9999;
    background-color: hsl(var(--one-background-nav));
    border-left: 1px solid hsl(var(--one-border));
    display: flex;
    flex-direction: column;
    overflow-y: auto;
  }

  :global(.transitions-enabled .right-panel) {
    transition: all 0.3s ease;
  }
</style>

<script>
  // Enable transitions after initial render
  window.addEventListener("load", () => {
    document.querySelector(".main-grid")?.classList.add("transitions-enabled");
  });
</script>
