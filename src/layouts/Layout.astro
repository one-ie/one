---
/// <reference types="astro/client" />
import "../styles/global.css";
import ThemeInit from "../components/Theme.astro";
import Header from "../components/Header";
import Footer from "../components/Footer";
import Sidebar from "../components/Sidebar.astro";
import Right from "../components/Right";
import { ChatConfigSchema } from "../schema/chat";

interface Props {
  title: string;
  description?: string;
  children: any;
  header?: boolean;
  footer?: boolean;
  initialPanelMode?: "Quarter" | "Half" | "Full" | "Floating" | "Icon";
  chatConfig?: any;
  rightPanelMode?: "hidden" | "full" | "half" | "quarter" | "floating" | "icon";
  content?: string;
}

const {
  title,
  description = "ONE",
  initialPanelMode,
  rightPanelMode = "quarter",
  chatConfig: providedConfig,
  content,
} = Astro.props;

// Default chat configuration
const defaultChatConfig = ChatConfigSchema.parse({
  // ... existing chat config
});

// Use provided config or fall back to default
const chatConfig = providedConfig || defaultChatConfig;
---

<!DOCTYPE html>
<html lang="en" class="dark" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <ThemeInit />
    <script src="../scripts/theme-init.js" is:inline></script>
  </head>
  <body>
    <div
      class="main-grid"
      id="main-grid"
      data-panel-mode={initialPanelMode || "Quarter"}
    >
      <Sidebar />
      <div class="center-grid" id="center-grid">
        <Header client:load />
        
        <main>
          <slot />
        </main>

        <Footer client:load />
      </div>
      <Right
        client:only="react"
        chatConfig={chatConfig}
        rightPanelMode={rightPanelMode}
        content={content}
      />
    </div>
  </body>
</html>

<script>
  // Enable transitions after initial render
  window.addEventListener("load", () => {
    document.querySelector(".main-grid")?.classList.add("transitions-enabled");
  });
</script>
