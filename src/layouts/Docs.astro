---
import Layout from "./Layout.astro";
import { Chat, ChatSchema } from "../schema/chat";

interface Props {
  title: string;
  description?: string;
  children: any;
  header?: boolean;
  footer?: boolean;
  chatConfig?: Chat;
  rightPanelMode?: "hidden" | "full" | "half" | "quarter" | "floating" | "icon";
  content?: string;
}

const { title, description, header = true, footer = true } = Astro.props;

// Get raw content from the slot
const rawContent = await Astro.slots.render("default");

// Create docs-specific chat configuration
const docsConfig = ChatSchema.parse({
  aiProvider: "mistral",
  aiModel: "mistral-large-latest",
  systemPrompt: `You are ONE's documentation specialist, helping users understand our comprehensive toolkit for building AI-powered brands. Your role is to guide users through:

• Toolkit Components
  - Rich prompt library and templates
  - AI agent frameworks and automation
  - Content generation and optimization tools
  - Modern UI components and layouts
  - Payment processing integrations
  - Multi-platform deployment options

• Key Benefits
  - 100% free and open source
  - No platform fees or restrictions
  - Deploy anywhere (local/cloud/edge)
  - Full code ownership
  - Commercial use allowed
  - Active community support

• Implementation Areas
  - Content creation and management
  - Course and product development
  - Website and application building
  - AI agent deployment
  - Payment system integration
  - Business automation

Your goal is to help users understand how to leverage ONE's toolkit to build their AI-powered brand while emphasizing our commitment to being free, open-source, and restriction-free.`,
  welcomeMessage: "👋 Welcome! I'm here to help you understand ONE's toolkit for building AI-powered brands. What would you like to learn about our free, open-source platform?",
  avatar: "/icon.svg",
  suggestions: [
    {
      label: "🎯 Toolkit Overview",
      prompt: "What components and tools are available in ONE's toolkit?"
    },
    {
      label: "🚀 Getting Started",
      prompt: "How do I start building with ONE's templates and frameworks?"
    },
    {
      label: "💡 Use Cases",
      prompt: "Show me some examples of what I can build with ONE?"
    }
  ]
});
// Create page data with async children
const children = await Astro.slots.render('default');

const pageData = {
  title,
  description,
  header,
  footer,
  children,
  chatConfig: docsConfig,
  rightPanelMode: "quarter" as const,
  content: rawContent
} satisfies Props;
---

<Layout {...pageData}>
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <article class="prose dark:prose-invert prose-slate max-w-none py-8">
      <slot />
    </article>
  </div>
</Layout>