---
import Layout from "./Layout.astro";
import { ChatConfigSchema, type Chat } from "../schema/chat";
import CopyButton from "../components/CopyButton";

interface Props {
  title: string;
  description?: string;
  children: any;
  header?: boolean;
  footer?: boolean;
  chatConfig?: Chat;
  rightPanelMode?: "hidden" | "full" | "half" | "quarter" | "floating" | "icon";
  content?: string;
  // For MDX files
  Content?: any;
}

const { title, description, header = true, footer = true, Content } = Astro.props;

// Get the raw content with fallbacks
let rawContent = '';

try {
  // First try: Direct content if provided
  if (Astro.props.content && typeof Astro.props.content === 'string') {
    rawContent = Astro.props.content;
  }
  
  // Second try: MDX/Markdown Content component
  if (!rawContent && Content) {
    try {
      if (Content.rawContent) {
        rawContent = await Content.rawContent();
      } else if (Content.render) {
        const rendered = await Content.render();
        rawContent = rendered.props.markdown;
      }
    } catch (error) {
      console.error('[Content extraction warning]:', error);
    }
  }
  
  // Last try: Render default slot
  if (!rawContent) {
    try {
      rawContent = await Astro.slots.render('default');
    } catch (error) {
      console.error('[Slot rendering warning]:', error);
      rawContent = '';
    }
  }
} catch (error) {
  console.error('[Content extraction failed]:', error);
}

// Create docs-specific chat configuration
const docsConfig = ChatConfigSchema.parse({
  aiProvider: "mistral",
  aiModel: "mistral-large-latest",
  systemPrompt: `You are ONE's documentation specialist, helping users understand our comprehensive toolkit for building AI-powered brands. Your role is to guide users through the documentation and help them understand:

• Toolkit Components
  - Rich prompt library and templates
  - AI agent frameworks and automation
  - Content generation and optimization tools
  - Modern UI components and layouts
  - Payment processing integrations
  - Multi-platform deployment options

• Key Benefits
  - 100% free and open source
  - No platform fees or restrictions
  - Deploy anywhere (local/cloud/edge)
  - Full code ownership
  - Commercial use allowed
  - Active community support

• Implementation Areas
  - Content creation and management
  - Course and product development
  - Website and application building
  - AI agent deployment
  - Payment system integration
  - Business automation

Your goal is to help users understand the documentation and how to leverage ONE's toolkit while emphasizing our commitment to being free, open-source, and restriction-free.

Here is the documentation content you should reference:
${rawContent}`,
  welcomeMessage: "👋 Welcome! I'm here to help you understand ONE's documentation. What would you like to know?",
  avatar: "/icon.svg",
  suggestions: [
    {
      label: "📖 Explain This",
      prompt: "Can you explain what this documentation page is about?"
    },
    {
      label: "🔍 Key Points",
      prompt: "What are the key points covered in this documentation?"
    },
    {
      label: "💡 Examples",
      prompt: "Can you show me some examples from this documentation?"
    }
  ],
  includeContent: true
});
// Create page data with async children
const children = await Astro.slots.render('default');

const pageData = {
  title,
  description,
  header,
  footer,
  children,
  chatConfig: docsConfig,
  rightPanelMode: "quarter" as const,
  content: rawContent // This will be passed to Right component through Layout
} satisfies Props;

---

<Layout {...pageData}>
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-end py-4">
      <CopyButton
        client:load
        content={rawContent.replace(/<[^>]*>/g, '').replace(/\s+/g, ' ').trim()}
        label="Copy Text Content"
        className="px-4 py-2 text-base bg-[#1a1a1a] text-white hover:bg-[#252525] rounded-lg"
      />
    </div>
    <article class="prose dark:prose-invert prose-slate max-w-none py-8">
      <slot />
    </article>
    <div class="flex justify-end py-8">
      <CopyButton
        client:load
        content={rawContent.replace(/<[^>]*>/g, '').replace(/\s+/g, ' ').trim()}
        label="Copy Text Content"
        className="px-4 py-2 text-base bg-[#1a1a1a] text-white hover:bg-[#252525] rounded-lg"
      />
    </div>
  </div>
</Layout>

<script>
  function wrapCodeBlocks() {
    document.querySelectorAll('pre').forEach(pre => {
      // Only wrap if not already wrapped
      if (!pre.parentElement?.classList.contains('code-block-wrapper')) {
        const wrapper = document.createElement('div');
        wrapper.className = 'code-block-wrapper relative';
        pre.parentNode?.insertBefore(wrapper, pre);
        wrapper.appendChild(pre);
        
        // Add copy button container
        const copyContainer = document.createElement('div');
        copyContainer.className = 'copy-button-container absolute top-2 right-2';
        copyContainer.innerHTML = `
          <button class="relative inline-flex items-center gap-2 rounded-lg p-2 transition-colors hover:bg-slate-700/50"
                  onclick="
                    const btn = this;
                    const pre = btn.closest('.code-block-wrapper').querySelector('pre');
                    navigator.clipboard.writeText(pre.textContent).then(() => {
                      // Show tooltip
                      const tooltip = document.createElement('span');
                      tooltip.className = 'copy-tooltip';
                      tooltip.textContent = 'Copied!';
                      btn.appendChild(tooltip);

                      // Animate icon
                      btn.querySelector('svg').style.color = '#22c55e';
                      btn.querySelector('svg').style.animation = 'copy-feedback 0.2s ease';
                      
                      // Reset after animation
                      setTimeout(() => {
                        btn.querySelector('svg').style.color = '';
                        btn.querySelector('svg').style.animation = '';
                        tooltip.remove();
                      }, 1000);
                    });
                  ">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                 class="text-slate-400">
              <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/>
              <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
            </svg>
          </button>
        `;
        wrapper.appendChild(copyContainer);
      }
    });
  }

  // Run on page load and after navigation
  wrapCodeBlocks();
  document.addEventListener('astro:page-load', wrapCodeBlocks);
</script>

<style is:global>
  .astro-code {
    background-color: #1a1a1a !important;
    padding: 1.5rem !important;
    margin: 0;
    border-radius: 0.5rem;
  }

  .code-block-wrapper {
    position: relative;
  }

  .copy-button-container {
    opacity: 0;
    transition: opacity 0.2s;
  }

  .code-block-wrapper:hover .copy-button-container {
    opacity: 1;
  }

  .copy-button-container button {
    transition: all 0.2s;
  }

  .copy-button-container button:active {
    transform: scale(0.95);
  }

  /* Add animation for copy feedback */
  @keyframes copy-feedback {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.1); }
  }

  @keyframes tooltip-slide {
    0% { opacity: 0; transform: translateY(10px); }
    100% { opacity: 1; transform: translateY(0); }
  }

  .copy-tooltip {
    position: absolute;
    bottom: calc(100% + 5px);
    left: 50%;
    transform: translateX(-50%);
    background-color: #22c55e;
    color: white;
    padding: 4px 8px;
    border-radius: 4px;
    font-size: 12px;
    white-space: nowrap;
    pointer-events: none;
    animation: tooltip-slide 0.2s ease;
  }

  .copy-tooltip::after {
    content: '';
    position: absolute;
    top: 100%;
    left: 50%;
    margin-left: -5px;
    border-width: 5px;
    border-style: solid;
    border-color: #22c55e transparent transparent transparent;
  }

  .copy-button-container button:active svg {
    animation: copy-feedback 0.2s ease;
    color: #22c55e;
  }
</style>