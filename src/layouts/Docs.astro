---
import Layout from "./Layout.astro";
import { ChatConfigSchema, type Chat } from "../schema/chat";

interface Props {
  title: string;
  description?: string;
  children: any;
  header?: boolean;
  footer?: boolean;
  chatConfig?: Chat;
  rightPanelMode?: "hidden" | "full" | "half" | "quarter" | "floating" | "icon";
  content?: string;
  // For MDX files
  Content?: any;
}

const { title, description, header = true, footer = true, Content } = Astro.props;

// Get the raw content with fallbacks
let rawContent = '';

try {
  // First try: Direct content if provided
  if (Astro.props.content && typeof Astro.props.content === 'string') {
    rawContent = Astro.props.content;
  }
  
  // Second try: MDX/Markdown Content component
  if (!rawContent && Content?.rawContent) {
    rawContent = await Content.rawContent();
  }
  
  // Last try: Render default slot
  if (!rawContent) {
    rawContent = await Astro.slots.render('default');
  }
} catch (error) {
  console.error('[Content extraction failed]:', error);
}

// Create docs-specific chat configuration
const docsConfig = ChatConfigSchema.parse({
  aiProvider: "mistral",
  aiModel: "mistral-large-latest",
  systemPrompt: `You are ONE's documentation specialist, helping users understand our comprehensive toolkit for building AI-powered brands. Your role is to guide users through the documentation and help them understand:

• Toolkit Components
  - Rich prompt library and templates
  - AI agent frameworks and automation
  - Content generation and optimization tools
  - Modern UI components and layouts
  - Payment processing integrations
  - Multi-platform deployment options

• Key Benefits
  - 100% free and open source
  - No platform fees or restrictions
  - Deploy anywhere (local/cloud/edge)
  - Full code ownership
  - Commercial use allowed
  - Active community support

• Implementation Areas
  - Content creation and management
  - Course and product development
  - Website and application building
  - AI agent deployment
  - Payment system integration
  - Business automation

Your goal is to help users understand the documentation and how to leverage ONE's toolkit while emphasizing our commitment to being free, open-source, and restriction-free.

Here is the documentation content you should reference:
${rawContent}`,
  welcomeMessage: "👋 Welcome! I'm here to help you understand ONE's documentation. What would you like to know?",
  avatar: "/icon.svg",
  suggestions: [
    {
      label: "📖 Explain This",
      prompt: "Can you explain what this documentation page is about?"
    },
    {
      label: "🔍 Key Points",
      prompt: "What are the key points covered in this documentation?"
    },
    {
      label: "💡 Examples",
      prompt: "Can you show me some examples from this documentation?"
    }
  ],
  includeContent: true
});
// Create page data with async children
const children = await Astro.slots.render('default');

const pageData = {
  title,
  description,
  header,
  footer,
  children,
  chatConfig: docsConfig,
  rightPanelMode: "quarter" as const,
  content: rawContent // This will be passed to Right component through Layout
} satisfies Props;

---

<Layout {...pageData}>
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <article class="prose dark:prose-invert prose-slate max-w-none py-8">
      <slot />
    </article>
  </div>
</Layout>