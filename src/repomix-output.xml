  --one-dark: hsl(217 33% 17%);       /* Slate 800 */
  --one-background: hsl(222 47% 11%); /* Slate 950 - Deep blue-black */
  --one-white: hsl(0 0% 100%);        /* Pure white */
  
  /* Semantic mappings */
  --one-background-main: var(--one-background);
  --one-background-nav: var(--one-dark);
  --one-background-logo: var(--one-black);
  --one-background-card: hsl(215 28% 20%);         /* Darker card background */
  
  /* Text colors */
  --one-foreground: hsl(214 15% 95%);              /* Nearly white text */
  --one-foreground-muted: hsl(210 40% 93%);
  
  /* Primary action colors */
  --one-primary: hsl(217 91% 60%);                 /* Blue 500 - Vibrant blue */
  --one-primary-foreground: hsl(0 0% 100%);
  
  /* Secondary elements */
  --one-secondary: hsl(215 25% 25%);               /* Slate 600 */
  --one-secondary-foreground: hsl(214 15% 95%);
  
  /* Accent colors */
  --one-accent: hsl(199 89% 48%);                  /* Sky 500 - Bright cyan */
  --one-accent-foreground: hsl(0 0% 100%);
  
  /* Interface elements */
  --one-muted: hsl(215 25% 25%);                   /* Slate 600 */
  --one-muted-foreground: hsl(214 15% 85%);
  --one-card: hsl(215 28% 20%);                    /* Clearly darker than background */
  --one-card-foreground: hsl(214 15% 95%);
  --one-popover: hsl(215 28% 20%);
  --one-popover-foreground: hsl(214 15% 95%);
  
  /* Border colors - More defined borders for contrast */
  --one-border: hsla(214, 32%, 91%, 0.15);
  --one-border-nav: hsla(214, 32%, 91%, 0.1);
  
  /* Input elements */
  --one-input: hsl(215 25% 22%);                   /* Darker input background */
  --one-input-foreground: hsl(214 15% 95%);
  --one-ring: hsla(217, 91%, 60%, 0.6);

  /* Chart colors - Vibrant for better distinction */
  --one-chart-1: hsl(217 91% 60%);                 /* Blue 500 */
  --one-chart-2: hsl(199 89% 48%);                 /* Sky 500 */
  --one-chart-3: hsl(152 76% 50%);                 /* Emerald 500 - Brighter */
  --one-chart-4: hsl(262 83% 62%);                 /* Violet 500 - Brighter */
  --one-chart-5: hsl(334 85% 50%);                 /* Rose 500 - Brighter */

  /* Update Tailwind compatibility vars */
