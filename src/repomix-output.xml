// drizzle/schema.ts
import { pgTable, uuid, text, jsonb, timestamp, boolean, integer } from 'drizzle-orm/pg-core';
import { InferModel } from 'drizzle-orm';
import { z } from 'zod';
import { textBlockSchema } from '../src/lib/components/blocks/text/schema';
import { imageBlockSchema } from '../src/lib/components/blocks/image/schema';
import { listBlockSchema } from '../src/lib/components/blocks/list/schema';
import { codeBlockSchema } from '../src/lib/components/blocks/code/schema';

// Combine all content types
const BlockContent = z.discriminatedUnion('type', [
  z.object({ type: z.literal('text'), content: textBlockSchema }),
  z.object({ type: z.literal('image'), content: imageBlockSchema }),
  z.object({ type: z.literal('list'), content: listBlockSchema }),
  z.object({ type: z.literal('code'), content: codeBlockSchema }),
]);

export const blocks = pgTable('blocks', {
  id: uuid('id').defaultRandom().primaryKey(),
  type: text('type').notNull(),
  content: jsonb('content').$type<z.infer<typeof BlockContent>>().notNull(),
  user_id: uuid('user_id').notNull(),
  parent_id: uuid('parent_id').references(() => blocks.id),
  order: integer('order').notNull(),
  is_latest: boolean('is_latest').notNull().default(true),
  created_at: timestamp('created_at').defaultNow().notNull(),
  updated_at: timestamp('updated_at').defaultNow().notNull()
});

export type Block = InferModel<typeof blocks>;
export type NewBlock = InferModel<typeof blocks, 'insert'>;

// ... rest of the schema
```

