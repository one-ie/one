							value={model}
							disabled={disabledModels?.includes(model)}
						>
							<div className="flex items-center gap-2">
								<Icon className="h-4 w-4" />
								<span>{model}</span>
							</div>
						</SelectItem>
					);
				})}
			</SelectContent>
		</Select>
	);
}

