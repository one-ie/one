  url: z.string().url(),
  alt: z.string(),
  caption: z.string().optional(),
});

const ListBlockContent = z.object({
  items: z.array(z.string()),
  ordered: z.boolean(),
});

const CodeBlockContent = z.object({
  code: z.string(),
  language: z.string(),
});

// Combine all content types
const BlockContent = z.discriminatedUnion('type', [
  z.object({ type: z.literal('text'), content: TextBlockContent }),
  z.object({ type: z.literal('image'), content: ImageBlockContent }),
  z.object({ type: z.literal('list'), content: ListBlockContent }),
  z.object({ type: z.literal('code'), content: CodeBlockContent }),
]);

export const blocks = pgTable('blocks', {
  id: uuid('id').defaultRandom().primaryKey(),
  type: text('type').notNull(),
  content: jsonb('content').$type<z.infer<typeof BlockContent>>().notNull(),
  user_id: uuid('user_id').notNull(),
  parent_id: uuid('parent_id').references(() => blocks.id),
  order: integer('order').notNull(),
  is_latest: boolean('is_latest').notNull().default(true),
  created_at: timestamp('created_at').defaultNow().notNull(),
  updated_at: timestamp('updated_at').defaultNow().notNull()
});

export type Block = InferModel<typeof blocks>;
export type NewBlock = InferModel<typeof blocks, 'insert'>;

export const vectors = pgTable('vectors', {
  id: uuid('id').defaultRandom().primaryKey(),
  block_id: uuid('block_id').references(() => blocks.id).notNull(),
  embedding: text('embedding').notNull(),
  created_at: timestamp('created_at').defaultNow().notNull(),
  updated_at: timestamp('updated_at').defaultNow().notNull()
});

export type Vector = InferModel<typeof vectors>;
export type NewVector = InferModel<typeof vectors, 'insert'>;
```

In this updated schema:

1. We've defined Zod schemas for different types of block content (TextBlockContent, ImageBlockContent, etc.).
2. We've combined these into a discriminated union `BlockContent` that uses the `type` field to determine the content structure.
3. We've used the `.$type<>()` method on the `jsonb` field to specify the TypeScript type for the content.

Now, when you're working with blocks in your application, you'll get type checking and autocompletion for the content field. Here's an example of how you might use this:

```typescript
import { blocks, NewBlock } from './drizzle/schema';
import { db } from './db';

async function createTextBlock(userId: string, text: string): Promise<void> {
  const newBlock: NewBlock = {
    type: 'text',
    content: {
      type: 'text',
      content: {
        text: text,
        format: 'plain'
      }
    },
    user_id: userId,
    order: 0  // You'd need to determine the appropriate order
  };

  await db.insert(blocks).values(newBlock);
}

async function getBlockContent(blockId: string) {
  const result = await db.select().from(blocks).where(eq(blocks.id, blockId));
  const block = result[0];

  if (block.content.type === 'text') {
    console.log(block.content.content.text);
  } else if (block.content.type === 'image') {
    console.log(block.content.content.url);
  }
  // ... handle other types
}
```

This approach gives you:

1. Type safety: TypeScript will catch errors if you try to create a block with invalid content.
2. Autocompletion: Your IDE will suggest the correct properties for each type of block content.
3. Runtime validation: If you use Zod to validate input data, you can ensure that the data matches your schema before inserting it into the database.



This setup provides a powerful and type-safe way to work with your block content, while still maintaining the flexibility of a JSONB column in your database.

### Links 

The `links` array is a crucial part of our block structure that enables us to create relationships between blocks, including hierarchical structures. Let's dive deeper into how it works.



Here's how the `links` array works:

1. Basic Structure:
   The `links` array is part of each block and contains UUIDs of other blocks that this block is related to.

   ```typescript
   {
     id: UUID,
     type: string,
     content: { /* ... */ },
     links: UUID[],
     // other fields...
   }
   ```

2. Representing Hierarchy:
   By convention, we use the first item in the `links` array to represent the parent of the current block.

3. Examples:

   Let's consider a simple blog post structure:

   ```
   Page: "My Blog Post" (id: 1234)
   ├── Section: "Introduction" (id: 5678)
   │   ├── Content: Text Block (id: 9012)
   │   └── Content: Image Block (id: 3456)
   └── Section: "Conclusion" (id: 7890)
       └── Content: Text Block (id: 2345)
   ```

   Here's how the `links` array would look for each block:

   a. Page Block:
   ```json
   {
     "id": "1234",
     "type": "page",
     "content": { "title": "My Blog Post" },
     "links": []  // No parent, it's the top-level block
   }
   ```

   b. Introduction Section:
   ```json
   {
     "id": "5678",
     "type": "section",
     "content": { "title": "Introduction" },
     "links": ["1234"]  // Parent is the page
   }
   ```

   c. Text Block in Introduction:
   ```json
   {
     "id": "9012",
     "type": "content",
     "content": { "body": "This is the introduction..." },
     "links": ["5678"]  // Parent is the Introduction section
   }
   ```

   d. Image Block in Introduction:
   ```json
   {
     "id": "3456",
     "type": "content",
     "content": { "imageUrl": "https://example.com/image.jpg" },
     "links": ["5678"]  // Parent is the Introduction section
   }
   ```

4. Complex Relationships:
   The `links` array can contain multiple UUIDs, allowing for more complex relationships:

   ```json
   {
     "id": "6789",
     "type": "content",
     "content": { "body": "This content appears in multiple sections" },
     "links": ["5678", "7890"]  // This block appears in both Introduction and Conclusion
   }
   ```

5. Querying:
   You can use the `links` array in your queries to fetch related blocks:

   ```sql
   -- Fetch all direct child blocks of a given parent
   SELECT * FROM blocks WHERE links[1] = 'parent_id_here';

   -- Fetch blocks that are linked to multiple parents
   SELECT * FROM blocks WHERE links @> ARRAY['parent1_id', 'parent2_id']::uuid[];
   ```

6. Traversing the Structure:
   To traverse the entire structure, you can use a recursive query:

   ```sql
   WITH RECURSIVE block_tree AS (
     SELECT id, links, 0 AS depth
     FROM blocks
     WHERE id = 'root_block_id'
     
     UNION ALL
     
     SELECT b.id, b.links, bt.depth + 1
     FROM blocks b
     JOIN block_tree bt ON b.links[1] = bt.id
   )
   SELECT * FROM block_tree;
   ```

7. Advantages:
   - Flexibility: Can represent both simple parent-child and more complex many-to-many relationships.
   - Efficiency: Allows for quick traversal and querying of related blocks.
   - Simplicity: Maintains a flat table structure while allowing for complex relationships.

8. Considerations:
   - When deleting a block, you may need to update or delete blocks that link to it.
   - For very deep hierarchies, you might need to optimize your queries to handle the recursion efficiently.

By using the `links` array in this way, we can create complex, interconnected structures of blocks while maintaining a simple and flexible database schema. This approach allows for easy creation of nested documents, reusable content blocks, and even graph-like structures, all within the same unified block system.


