}

export async function fetchSimpleIcons(slugs: string[]): Promise<Icon[]> {
  try {
    const response = await fetch(
      `https://cdn.jsdelivr.net/npm/simple-icons@v9/icons/${slugs.join(",")}.json`
    );
    if (!response.ok) {
      throw new Error("Failed to fetch icons");
