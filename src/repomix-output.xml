        swarm: {
          coordinate: true,
          distribute: true,
          consensus: true,
          heal: true
        }
      },
      tools: [
        'core',
        'monitor',
        'registry',
        'wallet',
        'knowledge',
        'swarm_utils'
      ],
      connections: [
        'direct',
        'discord',
        'telegram',
        'mesh'
      ],
