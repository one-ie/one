Here's a brief description of each file:

1. `schema/index.ts`: Exports all database schema definitions. (rename db to database)
2. `schema/groups.ts`: Defines the schema for groups table.
3. `schema/users.ts`: Defines the schema for users table.
4. `schema/screens.ts`: Defines the schema for screens table.
5. `schema/blocks.ts`: Defines the schema for blocks table.
7. `src/db/index.ts`: Sets up the database connection and exports the db client.
8. `src/blocks/text/schema.ts`: Defines the schema for text blocks.
9. `src/blocks/image/schema.ts`: Defines the schema for image blocks.
10. `src/blocks/index.ts`: Registers all block types.
11. `src/types/index.ts`: Exports all types and interfaces used across the application.
12. `src/types/claims.ts`: Defines types and schemas for user claims and raw app metadata.
14. `src/index.ts`: The main entry point of the application.
15. `drizzle.config.ts`: Configuration file for Drizzle ORM.
16. `tsconfig.json`: TypeScript configuration file.

This structure provides a clear organization for our TypeScript files, making it easy for developers to navigate and understand the codebase. Each file has a specific purpose and is placed in a logical location within the project structure.
# Types

```typescript
// src/types/index.ts
import { InferModel } from 'drizzle-orm';
import { groups, users, screens, blocks } from '../db/schema';
import { z } from 'zod';

// Re-export claim types
export * from './claims';

// Database model types
export type Group = InferModel<typeof groups>;
export type NewGroup = InferModel<typeof groups, 'insert'>;

export type User = InferModel<typeof users>;
export type NewUser = InferModel<typeof users, 'insert'>;

export type Screen = InferModel<typeof screens>;
export type NewScreen = InferModel<typeof screens, 'insert'>;

export type Block = InferModel<typeof blocks>;
export type NewBlock = InferModel<typeof blocks, 'insert'>;

// Block type definitions
export const BlockTypeEnum = z.enum(['text', 'image', 'code', 'list', 'table', 'embed']);
export type BlockType = z.infer<typeof BlockTypeEnum>;

export interface BlockSchema {
  type: BlockType;
  schema: z.ZodType<any>;
  component: any; // This will be an Astro component type
}

// Content types for different blocks
export const TextBlockContent = z.object({
  text: z.string(),
  format: z.enum(['plain', 'markdown', 'html'])
});

export const ImageBlockContent = z.object({
  url: z.string().url(),
  alt: z.string(),
  caption: z.string().optional()
});

export const CodeBlockContent = z.object({
  code: z.string(),
  language: z.string()
});

export const ListBlockContent = z.object({
  items: z.array(z.string()),
  ordered: z.boolean()
});

export const TableBlockContent = z.object({
  headers: z.array(z.string()),
  rows: z.array(z.array(z.string()))
});

export const EmbedBlockContent = z.object({
  url: z.string().url(),
  type: z.enum(['video', 'tweet', 'instagram', 'other']),
  html: z.string().optional()
});

// Union type for all block contents
export const BlockContent = z.discriminatedUnion('type', [
  z.object({ type: z.literal('text'), content: TextBlockContent }),
  z.object({ type: z.literal('image'), content: ImageBlockContent }),
  z.object({ type: z.literal('code'), content: CodeBlockContent }),
  z.object({ type: z.literal('list'), content: ListBlockContent }),
  z.object({ type: z.literal('table'), content: TableBlockContent }),
  z.object({ type: z.literal('embed'), content: EmbedBlockContent })
]);

export type BlockContentType = z.infer<typeof BlockContent>;

// Portable block set type
export interface PortableBlockSet {
  id: string;
  userId: string;
  blocks: Block[];
}

// Action types for blocks
export type BlockAction = 
  | { type: 'CREATE', payload: NewBlock }
  | { type: 'UPDATE', payload: { id: string, changes: Partial<Block> } }
  | { type: 'DELETE', payload: string }
  | { type: 'MOVE', payload: { id: string, newIndex: number } }
  | { type: 'MAKE_PORTABLE', payload: { id: string, userId: string } }
  | { type: 'ADD_TO_screen', payload: { id: string, screenId: string } };

// screen action types
export type screenAction =
  | { type: 'CREATE', payload: NewScreen }
  | { type: 'UPDATE', payload: { id: string, changes: Partial<Screen> } }
  | { type: 'DELETE', payload: string }
  | { type: 'PUBLISH', payload: string }
  | { type: 'UNPUBLISH', payload: string };

// Group action types
export type GroupAction =
  | { type: 'CREATE', payload: NewGroup }
  | { type: 'UPDATE', payload: { id: string, changes: Partial<Group> } }
  | { type: 'DELETE', payload: string }
  | { type: 'ADD_USER', payload: { groupId: string, userId: string } }
  | { type: 'REMOVE_USER', payload: { groupId: string, userId: string } };

// User action types
export type UserAction =
  | { type: 'CREATE', payload: NewUser }
  | { type: 'UPDATE', payload: { id: string, changes: Partial<User> } }
  | { type: 'DELETE', payload: string }
  | { type: 'UPDATE_CLAIMS', payload: { id: string, claims: Partial<Claims> } };

// API response types
export interface ApiResponse<T> {
  data: T | null;
  error: string | null;
}

export interface PaginatedResponse<T> extends ApiResponse<T[]> {
  total: number;
  screen: number;
  screenSize: number;
}

// Search types
export interface SearchResult {
  id: string;
  type: 'screen' | 'block';
  title: string;
  snippet: string;
  score: number;
}

export interface SearchParams {
  query: string;
  groupId?: string;
  type?: 'screen' | 'block';
  screen?: number;
  screenSize?: number;
}

// Event types for real-time updates
export type EventType = 'block' | 'screen' | 'group' | 'user';

export interface Event<T extends EventType, P> {
  type: T;
  action: 'create' | 'update' | 'delete';
  payload: P;
}

export type BlockEvent = Event<'block', Block>;
export type screenEvent = Event<'screen', screen>;
export type GroupEvent = Event<'group', Group>;
export type UserEvent = Event<'user', User>;

export type AppEvent = BlockEvent | screenEvent | GroupEvent | UserEvent;
```

To use these types effectively:

1. In API endpoints:
   ```typescript
   app.get('/api/1/build/blocks/:id', async (req, res): Promise<ApiResponse<Block>> => {
     // Implementation
   });
   ```

2. In action creators:
   ```typescript
   function createBlock(block: NewBlock): BlockAction {
     return { type: 'CREATE', payload: block };
   }
   ```

3. In components:
    ```astro
    ---
    import type { Block, BlockContentType } from '../types';
    interface Props {
      block: Block;
    }
    const { block } = Astro.props;
    const content = block.content as BlockContentType;
    ---
    ```

4. In event handlers:
   ```typescript
   function handleEvent(event: AppEvent) {
     switch(event.type) {
       case 'block':
         // Handle block event
         break;
       case 'screen':
         // Handle screen event
         break;
       // ... handle other event types
     }
   }
   ```

This type system provides a strong foundation for building a type-safe, robust application. It covers all aspects of our data model and user interactions, making it easier to catch errors at compile-time and provide better developer experience through improved autocompletion and type inference.



## Blocks

1. Our `src/db/schema/blocks.ts` file:

```typescript
// src/db/schema/blocks.ts
import { pgTable, uuid, text, jsonb, integer, timestamp, boolean } from 'drizzle-orm/pg-core';
import { screens } from './screens';
import { groups } from './groups';
import { users } from './users';

export const blocks = pgTable('blocks', {
  id: uuid('id').defaultRandom().primaryKey(),
  screenId: uuid('screen_id').references(() => screens.id),
  groupId: uuid('group_id').references(() => groups.id),
  userId: uuid('user_id').references(() => users.id),
  type: text('type').notNull(),
  content: jsonb('content').notNull(),
  order: integer('order'),
  isPortable: boolean('is_portable').default(false).notNull(),
  portableSetId: uuid('portable_set_id'),
  createdAt: timestamp('created_at').defaultNow().notNull(),
  updatedAt: timestamp('updated_at').defaultNow().notNull()
});
```


1. We've added `userId` to directly associate blocks with users when they're part of a portable set.
2. We've introduced `isPortable` to flag whether a block is part of a portable set.
3. We've added `portableSetId` to group portable blocks together.
4. We've made `screenId` optional by removing the `notNull()` constraint, as portable blocks might not be associated with a screen.
5. We've kept `groupId`, allowing portable blocks to maintain their original group association.

This structure allows us to:

- Keep all blocks in a single table, simplifying queries and reducing joins.
- Easily transition blocks between being part of a screen and being in a portable set.
- Maintain the original context (group) of portable blocks.
- Group portable blocks together using the `portableSetId`.



```typescript
// src/types/index.ts
import { InferModel } from 'drizzle-orm';
import { groups, users, screens, blocks } from '../db/schema';
export * from './claims';

// ... other type definitions ...

export type Block = InferModel<typeof blocks>;
export type NewBlock = InferModel<typeof blocks, 'insert'>;

export interface PortableBlockSet {
  id: string;
  userId: string;
  blocks: Block[];
}
```

Utility functions to work with portable blocks:

```typescript
// src/utils/blockUtils.ts
import { eq } from 'drizzle-orm';
import { db } from '../db';
import { blocks } from '../db/schema';
import { v4 as uuidv4 } from 'uuid';

export async function createPortableBlockSet(userId: string, blockIds: string[]): Promise<string> {
  const portableSetId = uuidv4();
  await db.transaction(async (tx) => {
    await tx
      .update(blocks)
      .set({ 
        isPortable: true, 
        portableSetId, 
        userId, 
        screenId: null 
      })
      .where(eq(blocks.id, blockIds));
  });
  return portableSetId;
}

export async function getPortableBlockSet(portableSetId: string): Promise<PortableBlockSet> {
  const portableBlocks = await db
    .select()
    .from(blocks)
    .where(eq(blocks.portableSetId, portableSetId));

  if (portableBlocks.length === 0) {
    throw new Error('Portable block set not found');
  }

  return {
    id: portableSetId,
    userId: portableBlocks[0].userId!,
    blocks: portableBlocks,
  };
}

export async function addBlockToscreen(blockId: string, screenId: string): Promise<void> {
  await db
    .update(blocks)
    .set({ 
      isPortable: false, 
      portableSetId: null, 
      screenId 
    })
    .where(eq(blocks.id, blockId));
}
```

This approach offers several benefits:

1. Simplicity: simplifying our schema.
2. Flexibility: Blocks can easily transition between being part of a screen and being portable.
3. Efficiency: We can query all blocks, whether they're part of a screen or a portable set, from a single table.
4. Consistency: We maintain the relationship between blocks and their original context (user, group) even when they're portable.
5. Scalability: This structure can easily accommodate future extensions, such as sharing portable blocks between users or groups.

To use this 

```typescript
