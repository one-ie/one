              </div>
              <span className={cn(
                "transition-all duration-200 text-foreground",
                sidebarState === 'expanded' ? "opacity-100 pl-4" : "opacity-0 w-0",
                "truncate"
              )}>
                {theme === 'dark' ? 'Light Mode' : theme === 'high-contrast' ? 'Dark Mode' : 'High Contrast'}
