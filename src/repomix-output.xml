const blockIds = ['block-1', 'block-2', 'block-3'];

// Create a portable block set
const portableSetId = await createPortableBlockSet(userId, blockIds);

// Retrieve a portable block set
const portableSet = await getPortableBlockSet(portableSetId);

// Add a block back to a screen
await addBlockToscreen(portableSet.blocks[0].id, 'screen-456');
```

This structure provides a clean and intuitive way to handle portable blocks within our existing block system, maintaining the flexibility and power of our original design while simplifying our database schema.

Let's create a robust type system for the `rawAppMetaData` that will be stored in the users table. This will provide strong typing for our claims and permissions system, making it easier and safer for developers to work with user metadata.

Let's create a new file `src/types/claims.ts` to define these types:

```typescript
// src/types/claims.ts
import { z } from 'zod';

// Define the possible permissions
export const PermissionEnum = z.enum([
  'read:own',
  'write:own',
  'delete:own',
  'read:group',
  'write:group',
  'delete:group',
  'manage:users',
  'manage:groups',
  'detach:blocks',
  'run:blocks',
  'deploy:blocks'
]);

export type Permission = z.infer<typeof PermissionEnum>;

// Define the possible roles
export const RoleEnum = z.enum([
  'user',
  'editor',
  'admin',
  'super_admin'
]);

export type Role = z.infer<typeof RoleEnum>;

// Define the structure of claims
export const ClaimsSchema = z.object({
  role: RoleEnum,
  permissions: z.array(PermissionEnum),
  group_id: z.string().uuid(),
  // Add any additional custom claims here
  email_verified: z.boolean().optional(),
  subscription_tier: z.enum(['free', 'pro', 'enterprise']).optional(),
});

export type Claims = z.infer<typeof ClaimsSchema>;

// Define the full raw app metadata structure
export const RawAppMetaDataSchema = z.object({
  claims: ClaimsSchema,
  // You can add more top-level fields here if needed
  last_login: z.string().datetime().optional(),
  login_count: z.number().int().optional(),
});

export type RawAppMetaData = z.infer<typeof RawAppMetaDataSchema>;

// Helper function to create a new RawAppMetaData object
export function createRawAppMetaData(claims: Claims, additionalData: Partial<RawAppMetaData> = {}): RawAppMetaData {
  return RawAppMetaDataSchema.parse({
    claims,
    ...additionalData
  });
}

// Helper function to validate RawAppMetaData
export function validateRawAppMetaData(data: unknown): RawAppMetaData {
  return RawAppMetaDataSchema.parse(data);
}

// Helper function to update claims
export function updateClaims(rawAppMetaData: RawAppMetaData, newClaims: Partial<Claims>): RawAppMetaData {
  return {
    ...rawAppMetaData,
    claims: {
      ...rawAppMetaData.claims,
      ...newClaims
    }
  };
}
```

