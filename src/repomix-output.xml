  description: The unified API for ONE system
  contact:
    name: ONE Support
    url: https://one.ie

servers:
  - url: https://one.ie/api/1
    description: Production server
  - url: http://localhost:1111/api/1
    description: Development server

paths:
  /{capability}:
    parameters:
      - name: capability
        in: path
        required: true
        schema:
          type: string
        description: The capability to execute
    get:
      summary: Execute capability (GET)
      responses:
        '200':
          description: Successful response
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Response'
        '400':
          description: Invalid request
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Error'
    post:
      summary: Execute capability (POST)
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
      responses:
        '200':
          description: Successful response
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Response'
        '400':
          description: Invalid request
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Error'

components:
  schemas:
    Response:
      type: object
      required:
        - status
        - message
        - data
        - _one
      properties:
        status:
          type: integer
