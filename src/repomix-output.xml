</article>

<script>
  // Client-side real-time updates
  import { supabase } from '../../lib/supabaseClient';
  
  const article = document.querySelector('article');
  const articleId = article.dataset.id;
  
  supabase
    .from(`blocks:page_id=eq.${articleId}`)
    .on('*', payload => {
      // Use ViewTransitions API for smooth updates
      document.startViewTransition(() => {
        // Find and update the specific block
        const blockEl = article.querySelector(`[data-block-id="${payload.new.id}"]`);
        if (blockEl) {
          blockEl.innerHTML = renderBlock(payload.new);
        }
      });
    })
    .subscribe();
</script>
```

