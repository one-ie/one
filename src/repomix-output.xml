    await writeFile(filePath, content as string);

    return new Response(JSON.stringify({
      success: true,
      message: 'Content saved successfully'
    }), {
      status: 200,
      headers: { 'Content-Type': 'application/json' }
    });
  } catch (error) {
    console.error('Save error:', error);
