        WebkitTextFillColor: "transparent",
      } as CSSProperties}
      className={cn(
        "mx-auto max-w-md font-bold",
        // Solid background color for the text itself
        "text-gray-800 dark:text-gray-200",
        // Add a base text size to ensure visibility
        "text-xl",
        className,
      )}
    >
      {children}
    </div>
  );
};

