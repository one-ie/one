```typescript
type PanelMode = "quarter" | "half" | "full" | "floating" | "icon" | "hidden";

interface LayoutProps {
  title: string;
  description?: string;
  rightPanelMode?: PanelMode;
  chatConfig?: ChatConfig;
  content?: string;
}
