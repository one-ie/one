---
import Layout from "../layouts/Layout.astro";
import { Stripe as StripeClient } from "stripe";

// Get form data if submitted
const price_id = Astro.url.searchParams.get('price_id');
const quantity = Astro.url.searchParams.get('quantity');

let session;
let error: string | null = null;

if (price_id) {
  try {
    const stripeKey = import.meta.env.STRIPE_SECRET_KEY;
    if (!stripeKey) {
      throw new Error('Stripe secret key is not configured');
    }

    const stripe = new StripeClient(stripeKey, {
      apiVersion: '2025-02-24.acacia'
    });
    
    const { origin } = Astro.url;
    
    session = await stripe.checkout.sessions.create({
      mode: "subscription",
      line_items: [
        {
          price: price_id,
          quantity: parseInt(quantity || "1"),
        },
      ],
      success_url: `${origin}/thankyou?session_id={CHECKOUT_SESSION_ID}`,
      cancel_url: `${origin}/stripe`,
    });

    if (session.url) {
      return Astro.redirect(session.url);
    }
  } catch (e) {
    console.error('Stripe error:', e);
    error = e instanceof Error ? e.message : 'An error occurred with the payment system';
  }
}
---

<style>
  .input {
    display: flex;
    height: 2.5rem;
    width: 100%;
    border-radius: var(--radius);
    border: 1px solid hsl(var(--input));
    background-color: hsl(var(--background));
    padding: 0.5rem 0.75rem;
    font-size: 0.875rem;
  }
  .input::file-selector-button {
    border: none;
    background: transparent;
    font-size: 0.875rem;
    font-weight: 500;
  }
  .input::placeholder {
    color: hsl(var(--muted-foreground));
  }
  .input:focus-visible {
    outline: none;
    box-shadow: 0 0 0 2px hsl(var(--ring));
  }
  .input:disabled {
    cursor: not-allowed;
    opacity: 0.5;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 2.5rem;
    padding: 0.5rem 1rem;
    width: 100%;
    border-radius: var(--radius);
    font-size: 0.875rem;
    font-weight: 500;
    background-color: hsl(var(--primary));
    color: hsl(var(--primary-foreground));
    transition: background-color 0.2s;
  }
  .button:hover {
    background-color: hsl(var(--primary) / 0.9);
  }
  .button:focus-visible {
    outline: none;
    box-shadow: 0 0 0 2px hsl(var(--ring));
  }
  .button:disabled {
    pointer-events: none;
    opacity: 0.5;
  }

  .card {
    border: 1px solid hsl(var(--border));
    border-radius: var(--radius);
    padding: 1.5rem;
    background-color: hsl(var(--card));
    color: hsl(var(--card-foreground));
  }
</style>

<Layout title="Stripe Configuration">
  <div class="container mx-auto p-6">
    <div class="max-w-2xl mx-auto">
      <h1 class="text-3xl font-bold mb-2">Stripe Payment Configuration</h1>
      <p class="text-muted-foreground mb-6">
        Configure your Stripe payment parameters below. Enter your price ID and quantity to test the checkout flow.
      </p>

      <div class="card">
        <form method="get" class="space-y-4">
          <div class="space-y-2">
            <label class="text-sm font-medium block">
              Price ID
              <span class="text-muted-foreground ml-2 text-xs">
                (from your Stripe Dashboard)
              </span>
            </label>
            <input
              type="text"
              id="price_id"
              name="price_id"
              class="input"
              placeholder="price_xxx..."
              value="price_0MC5WIqs14Mpveu1bfwvrkq6"
              required
            />
          </div>

          <div class="space-y-2">
            <label class="text-sm font-medium block">
              Quantity
            </label>
            <input
              type="number"
              id="quantity"
              name="quantity"
              class="input"
              min="1"
              value="1"
              required
            />
          </div>

          <button type="submit" class="button">
            Test Checkout
          </button>
        </form>

        {error && (
          <div class="mt-4 border-l-4 border-destructive bg-destructive/10 p-4 text-destructive">
            <p>{error}</p>
          </div>
        )}

        <div class="mt-6 text-sm text-muted-foreground">
          <p class="font-medium">Developer Notes:</p>
          <ul class="list-disc list-inside space-y-1 mt-2">
            <li>Set STRIPE_SECRET_KEY in your .env file</li>
            <li>Update success_url and cancel_url as needed</li>
            <li>Test mode is recommended for development</li>
            <li>Check Stripe Dashboard for successful payments</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</Layout>
