---
import Layout from "../layouts/Layout.astro";
import { ChatConfigSchema } from "../schema/chat";

import {
    Newspaper,
    Headphones,
    Download,
    Shield,
    BookText,
    LayoutGrid,
} from "lucide-react";

const menuItems = [
    { title: "Blog", path: "/blog", icon: Newspaper },
    { title: "Download", path: "/download", icon: Download },
    { title: "Docs", path: "/docs", icon: BookText },
    { title: "Pages", path: "/pages", icon: LayoutGrid },
    { title: "License", path: "/free-license", icon: Shield },
];

---

<Layout
    title="ONE - Own Your AI Solutions Completely Free"
    chatConfig={ChatConfigSchema.parse({})}
    rightPanelMode="quarter"
>
    <div
        class="fixed inset-0 w-screen h-screen bg-[hsl(var(--one-background-nav))] z-50"
    >
        <div class="container mx-auto px-4 py-8">
            <!-- Header with close button -->
            <div class="flex justify-end mb-8">
                <a
                    href="/"
                    class="p-2 hover:bg-accent rounded-md focus:outline-none"
                    aria-label="Close Menu"
                >
                    <svg
                        class="h-6 w-6"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                        xmlns="http://www.w3.org/2000/svg"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                </a>
            </div>

            <!-- Navigation Items -->
            <nav class="flex flex-col items-center space-y-8">
                {
                    menuItems.map(({ title, path, icon: Icon }) => (
                        <a
                            href={path}
                            class="flex items-center gap-4 text-xl font-medium hover:text-primary transition-colors p-4 rounded-lg hover:bg-accent/10"
                        >
                            <Icon className="h-6 w-6" />
                            <span>{title}</span>
                        </a>
                    ))
                }
            </nav>
        </div>
    </div>
</Layout>
