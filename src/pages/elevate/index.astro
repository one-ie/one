  <style>
    @keyframes gradient {
      0%, 100% { background-position: 0% 50%; }
      50% { background-position: 100% 50%; }
    }
    
    @keyframes float {
      0%, 100% { transform: translateY(0px) rotateY(25deg); }
      50% { transform: translateY(-20px) rotateY(25deg); }
    }
    
    .animate-gradient {
      background-size: 200% 200%;
      animation: gradient 8s ease infinite;
    }
    
    .animate-float {
      animation: float 6s ease-in-out infinite;
    }
    
    .delay-1000 {
      animation-delay: 1s;
    }
    
    .transform-3d {
      transform-style: preserve-3d;
      perspective: 1000px;
    }
    
    .rotate-y-25 {
      transform: rotateY(25deg);
    }
    
    /* Smooth scroll behavior */
    html {
      scroll-behavior: smooth;
    }
  </style>
  
  <script>
    // Diagnostic Tool Logic
    document.addEventListener('DOMContentLoaded', () => {
      const questions = document.querySelectorAll('.diagnostic-question');
      const results = document.getElementById('diagnostic-results');
      const bottleneckResult = document.getElementById('bottleneck-result');
      const restartBtn = document.getElementById('restart-diagnostic');
      let currentQuestion = 0;
      let scores = { reach: 0, sales: 0, value: 0 };
      
      // Handle option clicks
      document.querySelectorAll('.diagnostic-option').forEach(option => {
        option.addEventListener('click', () => {
          const category = (option as HTMLElement).dataset.category;
          const score = parseInt((option as HTMLElement).dataset.score || '0');
          
          if (category) (scores as any)[category] += score;
          
          // Hide current question
          questions[currentQuestion].classList.add('hidden');
          currentQuestion++;
          
          // Show next question or results
          if (currentQuestion < questions.length) {
            questions[currentQuestion].classList.remove('hidden');
          } else {
            showResults();
          }
        });
      });
      
      // Show results
      function showResults() {
        document.getElementById('diagnostic-quiz')!.classList.add('hidden');
        results!.classList.remove('hidden');
        
        // Determine bottleneck
        let bottleneck = 'reach';
        let minScore = scores.reach;
        
        if (scores.sales < minScore) {
          bottleneck = 'sales';
          minScore = scores.sales;
        }
        if (scores.value < minScore) {
          bottleneck = 'value';
        }
        
        // Display result
        const bottleneckInfo = {
          reach: {
            title: 'Level 1: ATTRACT (Reach Problem)',
            description: 'Your biggest opportunity is getting more qualified traffic. Focus on HOOK, GIFT, and IDENTIFY steps.',
            color: 'text-purple-400',
            bgColor: 'bg-purple-900/20',
            borderColor: 'border-purple-500/30'
          },
          sales: {
            title: 'Level 2: CONVERT (Sales Problem)',
            description: 'You have traffic but need to convert more visitors into customers. Focus on ENGAGE, SELL, and NURTURE.',
            color: 'text-pink-400',
            bgColor: 'bg-pink-900/20',
            borderColor: 'border-pink-500/30'
          },
          value: {
            title: 'Level 3: GROW (Value Problem)',
            description: 'You\'re making sales but missing opportunities to maximize customer value. Focus on UPSELL, UNDERSTAND, and SHARE.',
            color: 'text-blue-400',
            bgColor: 'bg-blue-900/20',
            borderColor: 'border-blue-500/30'
          }
        };
        
        const info = (bottleneckInfo as any)[bottleneck];
        bottleneckResult!.innerHTML = `
          <div class="${info.bgColor} ${info.borderColor} border rounded-xl p-6">
            <h4 class="text-xl font-bold ${info.color} mb-2">${info.title}</h4>
            <p class="text-neutral-300">${info.description}</p>
          </div>
        `;
      }
      
      // Restart diagnostic
      restartBtn?.addEventListener('click', () => {
        currentQuestion = 0;
        scores = { reach: 0, sales: 0, value: 0 };
        questions.forEach((q, i) => {
          q.classList.toggle('hidden', i !== 0);
        });
        results!.classList.add('hidden');
        document.getElementById('diagnostic-quiz')!.classList.remove('hidden');
      });
    });
    
    // ROI Calculator
    document.addEventListener('DOMContentLoaded', () => {
      const visitorsInput = document.getElementById('calc-visitors');
      const conversionInput = document.getElementById('calc-conversion');
      const aovInput = document.getElementById('calc-aov');
      const roiResult = document.getElementById('roi-result');
      
      function calculateROI() {
        const visitors = parseFloat((visitorsInput as HTMLInputElement)?.value || '0');
        const conversion = parseFloat((conversionInput as HTMLInputElement)?.value || '0') / 100;
        const aov = parseFloat((aovInput as HTMLInputElement)?.value || '0');
        
        const currentRevenue = visitors * conversion * aov;
        const improvedConversion = conversion * 1.35; // 35% improvement
        const improvedRevenue = visitors * improvedConversion * aov;
        const increase = improvedRevenue - currentRevenue;
        
        if (roiResult) {
          roiResult.textContent = `$${increase.toLocaleString('en-US', { maximumFractionDigits: 0 })}`;
        }
      }
      
      // Calculate on input change
      [visitorsInput, conversionInput, aovInput].forEach(input => {
        input?.addEventListener('input', calculateROI);
      });
      
      // Initial calculation
      calculateROI();
    });
    
    // Smooth scroll for navigation
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
      anchor.addEventListener('click', function (this: HTMLElement, e) {
        e.preventDefault();
        const target = document.querySelector(this.getAttribute('href') || '');
        if (target) {
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    });
    
    // Parallax effect on scroll
    window.addEventListener('scroll', () => {
      const scrolled = window.pageYOffset;
      const parallax = document.querySelector('.animate-float');
      if (parallax) {
        (parallax as HTMLElement).style.transform = `translateY(${scrolled * 0.5}px) rotateY(25deg)`;
      }
    });
  </script>
