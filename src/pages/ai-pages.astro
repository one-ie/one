---
import Layout from "../layouts/Layout.astro";
import { Card } from "@/components/ui/card";
import { Button } from "@/components/ui/button";
import { ChatConfigSchema } from '../schema/chat';

// Define the chat configuration for this page
const chatConfig = ChatConfigSchema.parse({
  systemPrompt: [{
    type: "text" as const,
    text: "You are a helpful assistant for the ONE framework. Your role is to help users understand the AI-powered markdown pages feature and guide them to the appropriate resources."
  }],
  welcome: {
    message: "👋 Hello! I can help you navigate our AI-powered documentation. What would you like to know about?",
    avatar: "/icon.svg",
    suggestions: [
      {
        label: "🔍 What are AI pages?",
        prompt: "What are AI-powered markdown pages and how do they work?"
      },
      {
        label: "🚀 Getting Started",
        prompt: "How do I create my first AI-powered markdown page?"
      },
      {
        label: "💡 Use Cases",
        prompt: "What are some good use cases for AI-powered markdown pages?"
      }
    ]
  }
});

// Define the pages to display
const pages = [
  {
    title: "AI-Powered Markdown Pages",
    description: "Learn how to create interactive documentation with AI assistance",
    path: "/docs/ai-markdown",
    icon: "📚",
    tags: ["Documentation", "Guide"]
  },
  {
    title: "Todo App Tutorial",
    description: "Step-by-step tutorial for creating a Todo application",
    path: "/docs/example-tutorial",
    icon: "✅",
    tags: ["Tutorial", "React", "TypeScript"]
  },
  {
    title: "Content Test Page",
    description: "A test page to verify AI content integration",
    path: "/content-test",
    icon: "🧪",
    tags: ["Test", "Debug"]
  },
  {
    title: "Debug LLM Messages",
    description: "See what's being sent to the LLM",
    path: "/debug",
    icon: "🔍",
    tags: ["Debug", "Development"]
  },
  {
    title: "Todo App Demo",
    description: "Interactive Todo application demo",
    path: "/todo",
    icon: "📝",
    tags: ["Demo", "React"]
  }
];
---

<Layout title="AI-Powered Pages | ONE Framework" chatConfig={chatConfig} rightPanelMode="quarter">
  <main class="container mx-auto py-12 px-4">
    <h1 class="text-4xl font-bold text-center mb-4">AI-Powered Pages</h1>
    <p class="text-center text-muted-foreground mb-12 max-w-2xl mx-auto">
      Explore our collection of AI-powered markdown pages that demonstrate the capabilities of the ONE framework.
      Each page includes contextual AI assistance that can answer questions about the content.
    </p>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {pages.map(page => (
        <Card className="overflow-hidden hover:shadow-md transition-shadow">
          <div class="p-6">
            <div class="flex items-start justify-between mb-4">
              <div class="text-4xl">{page.icon}</div>
              <div class="flex flex-wrap gap-2">
                {page.tags.map(tag => (
                  <span class="text-xs px-2 py-1 bg-primary/10 text-primary rounded-full">
                    {tag}
                  </span>
                ))}
              </div>
            </div>
            <h2 class="text-xl font-semibold mb-2">{page.title}</h2>
            <p class="text-muted-foreground mb-6">{page.description}</p>
            <a href={page.path} class="block">
              <Button className="w-full">
                Visit Page
              </Button>
            </a>
          </div>
        </Card>
      ))}
    </div>
    
    <div class="mt-16 max-w-2xl mx-auto">
      <h2 class="text-2xl font-bold mb-4">How It Works</h2>
      <div class="prose prose-lg dark:prose-invert max-w-none">
        <p>
          Each page in this collection demonstrates how to create AI-powered documentation using markdown files.
          The AI assistant on each page has access to the content of that page, allowing it to answer specific
          questions about the material.
        </p>
        
        <h3>Key Features:</h3>
        <ul>
          <li><strong>Contextual AI</strong> - The AI has access to the page content</li>
          <li><strong>Interactive Documentation</strong> - Ask questions about specific sections</li>
          <li><strong>Easy Configuration</strong> - Simple frontmatter setup</li>
          <li><strong>Customizable</strong> - Control AI behavior, appearance, and suggestions</li>
        </ul>
        
        <p>
          To learn how to create your own AI-powered markdown pages, visit the 
          <a href="/docs/ai-markdown">AI-Powered Markdown Pages</a> documentation.
        </p>
      </div>
    </div>
  </main>
</Layout>

<style>
  .prose a {
    color: hsl(var(--primary));
    text-decoration: underline;
  }
</style> 