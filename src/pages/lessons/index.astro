---
import Layout from "../../layouts/LayoutCourse.astro";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { Card } from "@/components/ui/card";
import { Badge } from "@/components/ui/badge";
import { Input } from "@/components/ui/input";
import {
  RocketIcon,
  LayersIcon,
  InfoCircledIcon,
  LightningBoltIcon,
  MagnifyingGlassIcon
} from "@radix-ui/react-icons";
import {
  Grid2x2,
  Grid3x3, Search,
  BookText,
  FileText,
  List,
  Table,
  Grid,
  Tag,
  Folder,
  FolderOpen
} from "lucide-react";
import { ChatConfigSchema } from '../../schema/chat';

// Type definitions
type DocEntry = CollectionEntry<'lessons'>;
type DocFolder = Record<string, DocEntry[]>;

// Get view preference from URL or default to list view
const viewMode = (Astro.url.searchParams.get("view") || "list") as
    | "list"
    | "compact"
    | "grid1"
    | "grid2"
    | "grid3"
    | "grid4";

// Get all lessons entries
const entries = (await getCollection("lessons")) as DocEntry[];

// Get search query from URL
const searchQuery = Astro.url.searchParams.get("search")?.toLowerCase() || '';

// Get tag filter from URL
const tagFilter = Astro.url.searchParams.get("tag")?.toLowerCase() || '';

// Get folder filter from URL
const folderFilter = Astro.url.searchParams.get("folder")?.toLowerCase() || '';

// Filter entries by search query, tag, or folder
const filteredEntries = searchQuery || tagFilter || folderFilter
  ? entries.filter((entry: DocEntry) => {
      const title = entry.data.title?.toLowerCase() || '';
      const description = entry.data.description?.toLowerCase() || '';
      const section = entry.data.section?.toLowerCase() || '';
      const tags = entry.data.tags?.map((t: string) => t.toLowerCase()) || [];
      const folderPath = entry.slug.split('/')[0].toLowerCase();
      
      // If folder filter is present, it takes precedence
      if (folderFilter) {
        return folderPath === folderFilter;
      }
      
      // If tag filter is present, it takes precedence over search
      if (tagFilter) {
        return tags.includes(tagFilter);
      }
      
      // Otherwise use search query
      return title.includes(searchQuery) || 
             description.includes(searchQuery) || 
             section.includes(searchQuery) ||
             tags.some((tag: string) => tag.includes(searchQuery));
    })
  : entries;

// Group by folders (first level of path)
const folders = filteredEntries.reduce((acc: DocFolder, entry: DocEntry) => {
  // Extract the folder name from the slug (first part before slash, or 'root' if no slash)
  const folderPath = entry.slug.includes('/') 
    ? entry.slug.split('/')[0] 
    : 'root';
  
  if (!acc[folderPath]) {
    acc[folderPath] = [];
  }
  acc[folderPath].push(entry);
  return acc;
}, {});

// Sort folders alphabetically with 'root' at the top
const orderedFolders = Object.entries(folders)
  .sort(([a, _a]: [string, DocEntry[]], [b, _b]: [string, DocEntry[]]) => {
    if (a === 'root') return -1;
    if (b === 'root') return 1;
    return a.localeCompare(b);
  })
  .reduce((acc, [key, value]) => ({ ...acc, [key]: value }), {}) as Record<string, DocEntry[]>;

// Configure AI assistant for lessons
const chat = {
  // Layout and Meta
  layout: "documentation",
  title: "Documentation - ONE Framework",
  description: "Everything you need to build intelligent applications",
  
  // AI Config
  aiProvider: "openrouter",
  aiModel: "google/gemini-2.0-flash-001",
  apiEndpoint: "https://api.openai.com/v1",
  temperature: 0.7,
  maxTokens: 900000,

  // Prompt Config
  systemPrompt: [{
    type: "text",
    text: `I am your Documentation Guide for ONE Framework, a specialized AI assistant focused on helping you navigate and understand our documentation. I lead a team of specialized documentation experts:

🎯 Our Documentation Team:
- Alex (Getting Started): Helps you begin your journey with ONE
- Sarah (Core Concepts): Explains fundamental framework concepts
- Max (Advanced Topics): Guides through complex implementations
- Emma (Tutorials): Assists with hands-on learning
- Tom (Troubleshooting): Helps resolve common issues

I can help you:
1. Find relevant documentation quickly
2. Understand complex concepts
3. Navigate between related topics
4. Follow the recommended learning path
5. Troubleshoot common issues
6. Implement specific features

The documentation is organized into key sections:
- Getting Started: Quick setup and basic concepts
- Core Concepts: Essential framework features
- Advanced Topics: In-depth technical details
- Tutorials: Step-by-step guides
- Troubleshooting: Common issues and solutions

Let me know what you'd like to learn about, and I'll guide you to the right resources.`
  }],
  addSystemPrompt: true,
  addBusinessPrompt: true,

  // Welcome Config
  welcomeMessage: "👋 Welcome to ONE Framework Documentation! I'm your Documentation Guide. How can I help you today?",
  avatar: "/icon.svg",
  suggestions: [
    { 
      label: "🚀 Quick Start", 
      prompt: "I'm new to ONE Framework. Where should I start?" 
    },
    { 
      label: "📚 Learning Path", 
      prompt: "What's the recommended learning path for mastering ONE Framework?" 
    },
    { 
      label: "🔍 Find Docs", 
      prompt: "I'm looking for documentation about a specific topic..." 
    },
    { 
      label: "💡 Core Concepts", 
      prompt: "What are the core concepts I need to understand?" 
    },
    { 
      label: "📖 Tutorials", 
      prompt: "Show me available tutorials and guides" 
    },
    { 
      label: "❓ Common Issues", 
      prompt: "What are some common issues and their solutions?" 
    },
    { 
      label: "🛠️ Advanced Topics", 
      prompt: "I want to learn about advanced features and implementations" 
    },
    { 
      label: "🎯 Best Practices", 
      prompt: "What are the recommended best practices for using ONE Framework?" 
    }
  ],

  // Optional Config
  runtime: "edge",
  includeContent: true
};

// Get appropriate icon based on folder name
function getFolderIcon(folder: string) {
  switch (folder.toLowerCase()) {
    case 'getting-started':
      return RocketIcon;
    case 'core-concepts':
      return LayersIcon;
    case 'advanced':
    case 'ai-sdk':
      return LightningBoltIcon;
    case 'tutorials':
      return BookText;
    case 'troubleshooting':
      return InfoCircledIcon;
    default:
      return FolderOpen;
  }
}

// Format folder name for display
function formatFolderName(folder: string): string {
  if (folder === 'root') return 'Get Started ';
  
  // Replace hyphens with spaces and capitalize each word
  return folder
    .replace(/-/g, ' ')
    .split(' ')
    .map(word => word.charAt(0).toUpperCase() + word.slice(1))
    .join(' ');
}

// Function to create tag URL
function createTagUrl(tag: string): string {
  return `/lessons?tag=${encodeURIComponent(tag)}`;
}

// Function to create folder URL
function createFolderUrl(folder: string): string {
  return `/lessons?folder=${encodeURIComponent(folder)}`;
}
---

<Layout
  title="Documentation - ONE Framework"
  description="Learn how to build AI-powered applications with ONE framework"
  chatConfig={chat}
  rightPanelMode="quarter"
>
  <div class="max-w-full px-3 sm:px-4 pt-4 pb-2">
    {/* Header with Search and View Toggles */}
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-3 mb-4">
      <div>
        <h1 class="text-3xl md:text-4xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-primary to-primary/70">
          Documentation
        </h1>
        <p class="text-base text-muted-foreground mt-1">
          Everything you need to build intelligent applications
        </p>
      </div>
      
      <div class="flex flex-col sm:flex-row gap-2 w-full md:w-auto">
        {/* Search Input */}
        <form class="relative w-full sm:w-64 md:w-80" method="GET" action="/lessons">
          <Search className="absolute left-2.5 top-2.5 h-4 w-4 text-muted-foreground" />
          <Input 
            type="search" 
            name="search" 
            placeholder="Search documentation..." 
            className="pl-9 h-9 w-full bg-muted/40 focus:bg-background"
            value={searchQuery}
          />
          {viewMode !== "list" && <input type="hidden" name="view" value={viewMode} />}
          {folderFilter && <input type="hidden" name="folder" value={folderFilter} />}
          <button type="submit" class="sr-only">Search</button>
        </form>
        
        <div class="flex gap-1 bg-muted/50 p-0.5 rounded-lg">
          <a
            href={`?view=list${searchQuery ? `&search=${searchQuery}` : ''}${tagFilter ? `&tag=${tagFilter}` : ''}${folderFilter ? `&folder=${folderFilter}` : ''}`}
            class={`p-2 rounded-md transition-all ${viewMode === "list" ? "bg-background shadow-sm" : "hover:bg-background/50"}`}
            aria-label="List view"
            title="List view"
          >
            <List className="w-4 h-4" />
          </a>
          <a
            href={`?view=compact${searchQuery ? `&search=${searchQuery}` : ''}${tagFilter ? `&tag=${tagFilter}` : ''}${folderFilter ? `&folder=${folderFilter}` : ''}`}
            class={`p-2 rounded-md transition-all ${viewMode === "compact" ? "bg-background shadow-sm" : "hover:bg-background/50"}`}
            aria-label="Compact view"
            title="Compact view"
          >
            <Table className="w-4 h-4" />
          </a>
          <a
            href={`?view=grid2${searchQuery ? `&search=${searchQuery}` : ''}${tagFilter ? `&tag=${tagFilter}` : ''}${folderFilter ? `&folder=${folderFilter}` : ''}`}
            class={`p-2 rounded-md transition-all ${viewMode === "grid2" ? "bg-background shadow-sm" : "hover:bg-background/50"}`}
            aria-label="Grid view with 2 columns"
            title="Grid view (2 columns)"
          >
            <Grid2x2 className="w-4 h-4" />
          </a>
          <a
            href={`?view=grid3${searchQuery ? `&search=${searchQuery}` : ''}${tagFilter ? `&tag=${tagFilter}` : ''}${folderFilter ? `&folder=${folderFilter}` : ''}`}
            class={`p-2 rounded-md transition-all ${viewMode === "grid3" ? "bg-background shadow-sm" : "hover:bg-background/50"}`}
            aria-label="Grid view with 3 columns"
            title="Grid view (3 columns)"
          >
            <Grid3x3 className="w-4 h-4" />
          </a>
          <a
            href={`?view=grid4${searchQuery ? `&search=${searchQuery}` : ''}${tagFilter ? `&tag=${tagFilter}` : ''}${folderFilter ? `&folder=${folderFilter}` : ''}`}
            class={`p-2 rounded-md transition-all ${viewMode === "grid4" ? "bg-background shadow-sm" : "hover:bg-background/50"}`}
            aria-label="Grid view with 4 columns"
            title="Grid view (4 columns)"
          >
            <Grid className="w-4 h-4" />
          </a>
        </div>
      </div>
    </div>

    {/* Filter Results */}
    {(searchQuery || tagFilter || folderFilter) && (
      <div class="mb-4 bg-primary/5 rounded-lg p-2 text-base">
        <div class="flex items-center gap-2">
          {searchQuery ? (
            <>
              <MagnifyingGlassIcon className="w-4 h-4 text-primary" />
              <span>
                Found {filteredEntries.length} result{filteredEntries.length !== 1 ? 's' : ''} for <strong>"{searchQuery}"</strong>
              </span>
            </>
          ) : tagFilter ? (
            <>
              <Tag className="w-4 h-4 text-primary" />
              <span>
                Found {filteredEntries.length} document{filteredEntries.length !== 1 ? 's' : ''} tagged <strong>"{tagFilter}"</strong>
              </span>
            </>
          ) : (
            <>
              <Folder className="w-4 h-4 text-primary" />
              <span>
                Found {filteredEntries.length} document{filteredEntries.length !== 1 ? 's' : ''} in folder <strong>"{formatFolderName(folderFilter)}"</strong>
              </span>
            </>
          )}
          <a href="/lessons" class="ml-auto text-primary hover:underline text-base">Clear</a>
        </div>
      </div>
    )}

    {/* All Folders Navigation */}
    {!searchQuery && !tagFilter && !folderFilter && (
      <div class="mb-4 overflow-x-auto pb-2">
        <div class="flex gap-2 flex-nowrap">
          {Object.keys(orderedFolders).map((folder: string) => (
            <a href={createFolderUrl(folder)} class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-muted/40 hover:bg-primary/10 transition whitespace-nowrap no-underline">
              {(() => {
                const Icon = getFolderIcon(folder);
                return <Icon className="w-4 h-4 text-primary" />;
              })()}
              <span class="text-base">{formatFolderName(folder)}</span>
              <Badge variant="secondary" className="bg-primary/10 text-primary text-xs px-1.5 py-0">
                {folders[folder].length}
              </Badge>
            </a>
          ))}
        </div>
      </div>
    )}

    {/* Documentation Folders */}
    <div class="space-y-6">
      {(Object.entries(orderedFolders) as Array<[string, DocEntry[]]>).map(([folder, entries]) => entries.length > 0 && (
        <div class="mb-6">
          <div class="flex items-center gap-2 mb-3 pb-1 border-b border-border/40">
            {/* Display folder icon dynamically */}
            <div class="w-6 h-6 rounded-md bg-primary/10 flex items-center justify-center">
              {(() => {
                const Icon = getFolderIcon(folder);
                return <Icon className="w-4 h-4 text-primary" />;
              })()}
            </div>
            
            <div class="flex flex-wrap items-center gap-2">
              <h2 class="text-lg font-bold text-foreground">{formatFolderName(folder)}</h2>
              <Badge
                variant="secondary"
                className="bg-primary/10 text-primary text-xs px-1.5 py-0"
              >
                {entries.length}
              </Badge>
              {!folderFilter && (
                <a href={createFolderUrl(folder)} class="text-primary hover:underline text-base">
                  View all
                </a>
              )}
            </div>
          </div>

          {/* Grid 4 View - No descriptions, 4 columns */}
          {viewMode === "grid4" && (
            <div class="grid gap-2 grid-cols-2 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
              {entries
                .sort((a: DocEntry, b: DocEntry) => (a.data.order || 0) - (b.data.order || 0))
                .map((entry: DocEntry) => (
                  <Card className="p-2 hover:shadow-sm transition-shadow border-muted/30 hover:border-primary/30 bg-background/80 backdrop-blur-sm">
                    <a href={`/lessons/${entry.slug}`} class="group block">
                      <div class="flex items-center gap-2">
                        <div class="mt-0.5 p-1.5 rounded-md bg-muted/40 group-hover:bg-primary/10 transition-colors">
                          <FileText className="w-3.5 h-3.5 text-muted-foreground group-hover:text-primary transition-colors" />
                        </div>
                        <h3 class="text-base font-medium group-hover:text-primary transition-colors line-clamp-1">
                          {entry.data.title}
                        </h3>
                      </div>
                    </a>
                  </Card>
                ))}
            </div>
          )}

          {/* Compact View - Table-like format */}
          {viewMode === "compact" && (
            <div class="border border-border/30 rounded-lg overflow-hidden">
              <div class="divide-y divide-border/30">
                {entries
                  .sort((a: DocEntry, b: DocEntry) => (a.data.order || 0) - (b.data.order || 0))
                  .map((entry: DocEntry) => (
                    <div class="grid grid-cols-[auto_1fr_auto] items-center hover:bg-muted/20">
                      <div class="p-2">
                        <div class="p-1.5 rounded-md bg-muted/40 flex items-center justify-center">
                          <FileText className="w-4 h-4 text-muted-foreground" />
                        </div>
                      </div>
                      <div class="p-2">
                        <a href={`/lessons/${entry.slug}`} class="group">
                          <h3 class="text-base font-medium group-hover:text-primary transition-colors no-underline">
                            {entry.data.title}
                          </h3>
                        </a>
                      </div>
                      <div class="p-2 flex flex-wrap gap-1 justify-end">
                        {entry.data.tags ? (
                          entry.data.tags.slice(0, 3).map((tag: string) => (
                            <a href={createTagUrl(tag)} class="no-underline">
                              <Badge className="text-base px-2 py-0.5 bg-primary/10 hover:bg-primary/20 text-primary border-none flex items-center gap-1">
                                <Tag className="w-3 h-3" />
                                <span>{tag}</span>
                              </Badge>
                            </a>
                          ))
                        ) : (
                          <span class="text-base text-muted-foreground">-</span>
                        )}
                        {entry.data.tags && entry.data.tags.length > 3 && (
                          <span class="text-base text-muted-foreground">+{entry.data.tags.length - 3}</span>
                        )}
                      </div>
                    </div>
                  ))
                }
              </div>
            </div>
          )}

          {/* Standard Grid Views */}
          {(viewMode === "grid2" || viewMode === "grid3") && (
            <div
              class={`grid gap-3 ${
                viewMode === "grid3" 
                ? "md:grid-cols-2 lg:grid-cols-3" 
                : "md:grid-cols-2"
              }`}
            >
              {entries
                .sort((a: DocEntry, b: DocEntry) => (a.data.order || 0) - (b.data.order || 0))
                .map((entry: DocEntry) => (
                  <Card className="h-full p-3 hover:shadow-md transition-shadow border-muted/50 hover:border-primary/30 bg-background/80 backdrop-blur-sm">
                    <a href={`/lessons/${entry.slug}`} class="group block no-underline">
                      <div class="flex items-center gap-2 mb-2">
                        <div class="mt-0.5 p-1.5 rounded-md bg-muted/40 group-hover:bg-primary/10 transition-colors">
                          <FileText className="w-4 h-4 text-muted-foreground group-hover:text-primary transition-colors" />
                        </div>
                        <h3 class="text-base font-medium group-hover:text-primary transition-colors line-clamp-1">
                          {entry.data.title}
                        </h3>
                      </div>
                      <p class="text-base text-muted-foreground line-clamp-2 mb-2 ml-8 group-hover:text-muted-foreground/80 transition-colors">
                        {entry.data.description}
                      </p>
                      <div class="flex flex-wrap gap-1 ml-8">
                        {entry.data.tags ? (
                          entry.data.tags.map((tag: string) => (
                            <a href={createTagUrl(tag)} class="no-underline">
                              <Badge className="text-base px-2 py-0.5 bg-primary/10 hover:bg-primary/20 text-primary border-none flex items-center gap-1">
                                <Tag className="w-3 h-3" />
                                <span>{tag}</span>
                              </Badge>
                            </a>
                          ))
                        ) : null}
                      </div>
                    </a>
                  </Card>
                ))}
            </div>
          )}

          {/* List View - Optimized */}
          {viewMode === "list" && (
            <div class="space-y-1.5">
              {entries
                .sort((a: DocEntry, b: DocEntry) => (a.data.order || 0) - (b.data.order || 0))
                .map((entry: DocEntry) => (
                  <Card className="group hover:shadow-sm transition-all duration-300 border-muted/30 hover:border-primary/30 bg-background/80 backdrop-blur-sm py-2 px-3">
                    <a href={`/lessons/${entry.slug}`} class="no-underline block">
                      <div class="flex gap-2">
                        <div class="flex-shrink-0 mt-0.5 p-1.5 rounded-md bg-muted/30 group-hover:bg-primary/10 transition-colors h-fit">
                          <FileText className="w-4 h-4 text-muted-foreground group-hover:text-primary transition-colors" />
                        </div>
                        <div class="min-w-0 flex flex-col gap-1 flex-grow">
                          <h3 class="text-base font-medium group-hover:text-primary transition-colors">
                            {entry.data.title}
                          </h3>
                          <p class="text-base text-muted-foreground line-clamp-1">
                            {entry.data.description}
                          </p>
                          <div class="flex flex-wrap gap-1 mt-1">
                            {entry.data.tags ? (
                              entry.data.tags.slice(0, 4).map((tag: string) => (
                                <a href={createTagUrl(tag)} class="no-underline">
                                  <Badge className="text-base px-2 py-0.5 bg-primary/10 hover:bg-primary/20 text-primary border-none flex items-center gap-1">
                                    <Tag className="w-3 h-3" />
                                    <span>{tag}</span>
                                  </Badge>
                                </a>
                              ))
                            ) : null}
                            {entry.data.tags && entry.data.tags.length > 4 && (
                              <span class="text-base text-muted-foreground">+{entry.data.tags.length - 4}</span>
                            )}
                          </div>
                        </div>
                      </div>
                    </a>
                  </Card>
                ))}
            </div>
          )}
        </div>
      ))}
    </div>

    {/* Empty State */}
    {filteredEntries.length === 0 && (
      <div class="text-center py-8 bg-muted/20 rounded-lg mt-4">
        <div class="max-w-md mx-auto">
          <FileText className="w-12 h-12 text-muted-foreground mx-auto mb-4 opacity-50" />
          <h2 class="text-xl font-semibold mb-2">
            {searchQuery 
              ? 'No matching documents found' 
              : tagFilter 
                ? 'No documents with this tag' 
                : folderFilter
                  ? 'No documents in this folder'
                  : 'No documentation found'}
          </h2>
          <p class="text-base text-muted-foreground">
            {searchQuery 
              ? `No documentation pages match your search for "${searchQuery}".` 
              : tagFilter
                ? `No documentation pages found with tag "${tagFilter}".`
                : folderFilter
                  ? `No documentation pages found in folder "${formatFolderName(folderFilter)}".`
                  : 'No documentation pages exist in the content collection.'}
          </p>
          {(searchQuery || tagFilter || folderFilter) && (
            <a href="/lessons" class="inline-block mt-3 text-primary hover:underline text-base">
              View all documentation
            </a>
          )}
        </div>
      </div>
    )}
  </div>
</Layout>

<style>
  .card {
    transition: all 0.2s ease-in-out;
  }
  .card:hover {
    transform: translateY(-1px);
  }
  
  /* Gradient background styling */
  :global(body) {
    background-image: 
      radial-gradient(at 100% 0%, hsla(var(--primary-hsl) / 0.15) 0px, transparent 50%),
      radial-gradient(at 0% 100%, hsla(var(--primary-hsl) / 0.1) 0px, transparent 50%);
    background-attachment: fixed;
  }

  /* Remove underlines from all links */
  a {
    text-decoration: none !important;
  }

  /* Tag hover styling */
  .badge:hover {
    transform: translateY(-1px);
    transition: all 0.2s ease;
  }
</style>

<script>
  // Handle search form submission
  document.addEventListener('DOMContentLoaded', () => {
    const lessonsearchForm = document.querySelector('form');
    const lessonsearchInput = lessonsearchForm?.querySelector('input[type="search"]') as HTMLInputElement;
    const viewModeLinks = document.querySelectorAll('a[href^="?view="]');
    
    if (lessonsearchForm && lessonsearchInput) {
      // Add event listener for the form submission
      lessonsearchForm.addEventListener('submit', (e) => {
        if (lessonsearchInput.value.trim() === '') {
          // If search is empty and we're already on the lessons page with no query,
          // prevent the default action to avoid unnecessary page refresh
          const currentUrl = new URL(window.location.href);
          if (currentUrl.pathname === '/lessons' && !currentUrl.searchParams.has('search')) {
            e.preventDefault();
          }
        }
      });
      
      // Set focus on search input with a slight delay
      setTimeout(() => {
        if (lessonsearchInput.value) {
          // If there's a search value, place cursor at the end
          lessonsearchInput.setSelectionRange(lessonsearchInput.value.length, lessonsearchInput.value.length);
        }
      }, 100);
    }
    
    // Update view mode links to preserve search query and tag filter
    if (viewModeLinks.length > 0) {
      const searchParams = new URLSearchParams(window.location.search);
      const currentSearch = searchParams.get('search');
      const currentTag = searchParams.get('tag');
      const currentFolder = searchParams.get('folder');
      
      viewModeLinks.forEach(link => {
        const href = link.getAttribute('href') || '';
        let newHref = href;
        
        if (currentSearch && !newHref.includes('search=')) {
          newHref += (newHref.includes('?') ? '&' : '?') + `search=${encodeURIComponent(currentSearch)}`;
        }
        
        if (currentTag && !newHref.includes('tag=')) {
          newHref += (newHref.includes('?') ? '&' : '?') + `tag=${encodeURIComponent(currentTag)}`;
        }
        
        if (currentFolder && !newHref.includes('folder=')) {
          newHref += (newHref.includes('?') ? '&' : '?') + `folder=${encodeURIComponent(currentFolder)}`;
        }
        
        if (newHref !== href) {
          link.setAttribute('href', newHref);
        }
      });
    }
  });
</script>