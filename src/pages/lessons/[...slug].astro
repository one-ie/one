---
import { getCollection, type CollectionEntry } from 'astro:content';
import DocsPage from '../../layouts/Docs.astro';
import { ChatConfigSchema } from '../../schema/chat';
import LessonContent from '@/components/lessons/LessonContent.astro';
import VideoEmbed from '@/components/lessons/VideoEmbed.astro';
import { Card } from '@/components/ui/card';

export const prerender = true;

export async function getStaticPaths() {
  const lessons = await getCollection('lessons');
  return lessons.map((entry: CollectionEntry<'lessons'>) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

type Props = {
  entry: CollectionEntry<'lessons'>;
};

const { entry } = Astro.props;
const { Content } = await entry.render();

// Get all lessons and sort by order, then slug
const allLessons: CollectionEntry<'lessons'>[] = await getCollection('lessons');
const sortedLessons = allLessons
  .slice()
  .sort((a: CollectionEntry<'lessons'>, b: CollectionEntry<'lessons'>) => {
    const orderA = a.data.order ?? 0;
    const orderB = b.data.order ?? 0;
    if (orderA !== orderB) return orderA - orderB;
    return a.slug.localeCompare(b.slug);
  });
const currentIndex = sortedLessons.findIndex((l: CollectionEntry<'lessons'>) => l.slug === entry.slug);
const prevLesson = currentIndex > 0 ? sortedLessons[currentIndex - 1] : null;
const nextLesson = currentIndex < sortedLessons.length - 1 ? sortedLessons[currentIndex + 1] : null;

// Get the system prompt from the content collection
const systemPrompt = await getCollection('prompts', ({ slug }: { slug: string }) => slug === '-SystemPrompt');
const systemPromptContent = systemPrompt[0]?.body || '';

// Get chat configuration from frontmatter or use defaults
const chatConfig = ChatConfigSchema.parse({
  // Layout and Meta
  layout: entry.data.layout || "lesson",
  title: entry.data.title || "Lesson",
  description: entry.data.description || "Interactive lesson on this topic",
  
  // AI Config
  aiProvider: entry.data.aiProvider || "openrouter",
  aiModel: entry.data.aiModel || "google/gemini-2.0-flash-001",
  apiEndpoint: entry.data.apiEndpoint || "https://api.openai.com/v1",
  temperature: entry.data.temperature || 0.7,
  maxTokens: entry.data.maxTokens || 4000,
  runtime: "edge",
  includeContent: true,

  // Prompt Config
  systemPrompt: entry.data.aiConfig?.systemPrompt || [
    {
      type: "text",
      text: `${systemPromptContent}

You are ONE's lesson guide for \"${entry.data.title || 'this lesson'}\". Your role is to help users learn and master the concepts covered in this specific lesson.

Core Capabilities:
1. Lesson Content
   • Key concepts
   • Learning objectives
   • Step-by-step guidance
   • Interactive exercises

2. Learning Support
   • Clear explanations
   • Practical examples
   • Progress tracking
   • Skill assessment

3. Implementation Help
   • Code examples
   • Best practices
   • Troubleshooting
   • Common pitfalls

4. Next Steps
   • Related lessons
   • Practice exercises
   • Further reading
   • Skill development

Communication Style:
• Be clear and concise
• Provide actionable advice
• Use relevant examples
• Maintain professional tone
• Focus on practical learning

Key Principles:
• Student success first
• Practical implementation
• Clear guidance
• Best practices
• Security awareness`
    }
  ],
  addSystemPrompt: true,
  addBusinessPrompt: true,

  // Welcome Config
  welcomeMessage: entry.data.aiConfig?.welcomeMessage || `👋 Welcome to \"${entry.data.title || 'this lesson'}\"! I'm your AI guide to help you learn and master the concepts in this lesson. What would you like to explore?`,
  avatar: entry.data.aiConfig?.avatar || "/icon.svg",
  suggestions: entry.data.aiConfig?.suggestions || [
    { 
      label: "📚 Lesson Overview", 
      prompt: "What are the main concepts and learning objectives of this lesson?" 
    },
    { 
      label: "💡 Examples", 
      prompt: "Can you show me some practical examples from this lesson?" 
    },
    { 
      label: "🔧 Implementation", 
      prompt: "How do I implement the concepts from this lesson?" 
    },
    { 
      label: "❓ Questions", 
      prompt: "I have a question about something in this lesson..." 
    },
    { 
      label: "🎯 Practice", 
      prompt: "What exercises can I do to practice these concepts?" 
    },
    { 
      label: "📈 Next Steps", 
      prompt: "What should I learn next after completing this lesson?" 
    }
  ]
});
---

<DocsPage 
  title={entry.data.title}
  description={entry.data.description}
  chatConfig={chatConfig}
  rightPanelMode={entry.data.rightPanelMode || "quarter"}
>
  <div class="px-4 sm:px-6 max-w-3xl mx-auto space-y-10">
    {entry.data.presentation ? (
      <div class="w-full" style="aspect-ratio: 4/3; max-width: 100%; margin-bottom: 2rem;">
        <iframe
          src={`/${entry.data.presentation}/`}
          title="Lesson Presentation"
          style="width:100%; height:100%; min-height:400px; border:none; background:#111; border-radius:12px; box-shadow:0 4px 32px #0008;"
          allowfullscreen
        ></iframe>
      </div>
    ) : entry.data.video?.id && (
      <VideoEmbed 
        id={entry.data.video.id}
        params={entry.data.video.params}
      />
    )}

    {entry.data.lessonContent ? (
      <LessonContent content={entry.data.lessonContent} />
    ) : (
      <div class="prose dark:prose-invert max-w-none">
        <Content />
      </div>
    )}

    {entry.data.resources && entry.data.resources.length > 0 && (
      <section class="mt-12">
        <ul class="space-y-4">
          {entry.data.resources.map((resource: any) => (
            <li>
              <Card className="p-4 flex flex-col gap-1">
                <div class="flex items-center gap-2 mb-1">
                  <span class="font-semibold">{resource.title}</span>
                  {resource.type && (
                    <span class="ml-2 px-2 py-0.5 rounded-full text-xs bg-primary/10 text-primary capitalize">{resource.type}</span>
                  )}
                </div>
                {resource.description && <p class="text-muted-foreground text-sm mb-1">{resource.description}</p>}
                {resource.url && (
                  <a href={resource.url} class="text-blue-600 hover:underline text-sm" target="_blank" rel="noopener noreferrer">Open Resource</a>
                )}
                {resource.type === 'prompt' && resource.tag && (
                  <div class="text-xs text-muted-foreground">Prompt Tag: <span class="font-mono">{resource.tag}</span></div>
                )}
                {resource.type === 'bookChapter' && resource.bookTitle && (
                  <div class="text-xs text-muted-foreground">Book: <span class="font-mono">{resource.bookTitle}</span></div>
                )}
                {resource.type === 'worksheet' && resource.worksheetTitle && (
                  <div class="text-xs text-muted-foreground">Worksheet: <span class="font-mono">{resource.worksheetTitle}</span></div>
                )}
                {resource.type === 'checklist' && resource.checklistTitle && (
                  <div class="text-xs text-muted-foreground">Checklist: <span class="font-mono">{resource.checklistTitle}</span></div>
                )}
                {resource.type === 'assignment' && (
                  <div class="text-xs text-muted-foreground">
                    {resource.assignmentType && <span>Type: <span class="font-mono">{resource.assignmentType}</span></span>}
                    {resource.dueDate && <span class="ml-2">Due: <span class="font-mono">{resource.dueDate}</span></span>}
                    {resource.points !== undefined && <span class="ml-2">Points: <span class="font-mono">{resource.points}</span></span>}
                  </div>
                )}
                {resource.type === 'community' && (
                  <div class="text-xs text-muted-foreground">
                    {resource.platform && <span>Platform: <span class="font-mono">{resource.platform}</span></span>}
                    {resource.engagementInstructions && <span class="ml-2">{resource.engagementInstructions}</span>}
                  </div>
                )}
              </Card>
            </li>
          ))}
        </ul>
        <nav class="flex justify-center items-center gap-8 mt-10">
          {prevLesson ? (
            <a href={"/lessons/" + prevLesson.slug} class="flex items-center gap-2 px-4 py-2 rounded-lg bg-muted hover:bg-primary/10 text-primary transition-all shadow-sm">
              <span class="text-2xl">&#8592;</span>
              <div class="flex flex-col items-start">
                <span class="text-xs text-muted-foreground">Previous</span>
                <span class="font-semibold line-clamp-1 max-w-[160px]">{prevLesson.data.title || 'Previous Lesson'}</span>
              </div>
            </a>
          ) : (
            <span class="flex items-center gap-2 px-4 py-2 rounded-lg bg-muted text-gray-400 cursor-not-allowed shadow-sm">
              <span class="text-2xl">&#8592;</span>
              <div class="flex flex-col items-start">
                <span class="text-xs">Previous</span>
                <span class="font-semibold line-clamp-1 max-w-[160px] opacity-60">No lesson</span>
              </div>
            </span>
          )}
          <span class="hidden md:inline-block w-8 h-8 rounded-full bg-primary/10 flex items-center justify-center text-primary font-bold text-lg mx-2">•</span>
          {nextLesson ? (
            <a href={"/lessons/" + nextLesson.slug} class="flex items-center gap-2 px-4 py-2 rounded-lg bg-muted hover:bg-primary/10 text-primary transition-all shadow-sm">
              <div class="flex flex-col items-end">
                <span class="text-xs text-muted-foreground text-right">Next</span>
                <span class="font-semibold line-clamp-1 max-w-[160px]">{nextLesson.data.title || 'Next Lesson'}</span>
              </div>
              <span class="text-2xl">&#8594;</span>
            </a>
          ) : (
            <span class="flex items-center gap-2 px-4 py-2 rounded-lg bg-muted text-gray-400 cursor-not-allowed shadow-sm">
              <div class="flex flex-col items-end">
                <span class="text-xs text-right">Next</span>
                <span class="font-semibold line-clamp-1 max-w-[160px] opacity-60">No lesson</span>
              </div>
              <span class="text-2xl">&#8594;</span>
            </span>
          )}
        </nav>
      </section>
    )}
  </div>
</DocsPage>