---
import { getCollection } from 'astro:content';
import DocsPage from '../../layouts/LayoutCourse.astro';
import type { CollectionEntry } from 'astro:content';

export const prerender = true;

export async function getStaticPaths() {
  const lessons = await getCollection('lessons');
  return lessons.map((entry: CollectionEntry<'lessons'>) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

type Props = {
  entry: CollectionEntry<'lessons'>;
};

const { entry } = Astro.props;
const { Content } = await entry.render();

// Chat configuration for lessons
const chat = {
  // Layout and Meta
  layout: "lesson",
  title: entry.data.title || "Lesson",
  description: entry.data.description || "Learn more about this topic",
  
  // AI Config
  aiProvider: "openrouter",
  aiModel: "google/gemini-2.0-flash-001",
  apiEndpoint: "https://api.openai.com/v1",
  temperature: 0.7,
  maxTokens: 900000,

  // Prompt Config
  systemPrompt: [{
    type: "text",
    text: `I am your AI Learning Assistant for this lesson on "${entry.data.title}". I'm here to help you understand and apply the concepts covered in this lesson.

My role is to:
1. Answer questions about the lesson content
2. Provide additional examples and explanations
3. Help you apply concepts to real-world scenarios
4. Guide you through practical exercises
5. Clarify any confusing points

I have deep knowledge of this lesson's content and can help you master the material. What would you like to learn more about?`
  }],
  addSystemPrompt: true,
  addBusinessPrompt: true,

  // Welcome Config
  welcomeMessage: `👋 Welcome to the lesson on "${entry.data.title}". I'm your AI Learning Assistant. How can I help you understand this topic better?`,
  avatar: "/icon.svg",
  suggestions: [
    { 
      label: "📚 Key Concepts", 
      prompt: "What are the main concepts covered in this lesson?" 
    },
    { 
      label: "💡 Examples", 
      prompt: "Can you provide some practical examples from this lesson?" 
    },
    { 
      label: "❓ Questions", 
      prompt: "I have a question about something in this lesson..." 
    },
    { 
      label: "🔍 Deep Dive", 
      prompt: "Let's explore this topic in more detail" 
    }
  ],

  // Optional Config
  runtime: "edge",
  includeContent: true
};
---

<DocsPage 
  title={entry.data.title}
  description={entry.data.description}
  chatConfig={chat}
  rightPanelMode="quarter"
>
  <div class="px-4 sm:px-6">
    <Content />
  </div>
</DocsPage>