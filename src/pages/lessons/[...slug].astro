---
import { getCollection } from 'astro:content';
import DocsPage from '../../layouts/LayoutCourse.astro';
import type { CollectionEntry } from 'astro:content';
import { ChatConfigSchema } from '../../schema/chat';

export const prerender = true;

export async function getStaticPaths() {
  const lessons = await getCollection('lessons');
  return lessons.map((entry: CollectionEntry<'lessons'>) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

type Props = {
  entry: CollectionEntry<'lessons'>;
};

const { entry } = Astro.props;
const { Content } = await entry.render();

// Get chat configuration from frontmatter or use defaults
const chatConfig = ChatConfigSchema.parse({
  // Layout and Meta
  layout: entry.data.layout || "lesson",
  title: entry.data.title || "Lesson",
  description: entry.data.description || "Learn more about this topic",
  
  // AI Config
  aiProvider: entry.data.aiProvider || "openrouter",
  aiModel: entry.data.aiModel || "google/gemini-2.0-flash-001",
  apiEndpoint: entry.data.apiEndpoint || "https://openrouter.ai/api/v1",
  temperature: entry.data.temperature || 0.7,
  maxTokens: entry.data.maxTokens || 4000,

  // Prompt Config
  systemPrompt: entry.data.systemPrompt || [
    {
      type: "text",
      text: `I am your AI Learning Assistant for "${entry.data.title || 'this lesson'}". I'm here to help you understand and apply the concepts covered in this lesson.

My role is to:
1. Answer questions about the lesson content
2. Provide additional examples and explanations
3. Help you apply concepts to real-world scenarios
4. Guide you through practical exercises
5. Clarify any confusing points

I have deep knowledge of this lesson's content and can help you master the material. What would you like to learn more about?`
    }
  ],
  addSystemPrompt: true,
  addBusinessPrompt: true,

  // Welcome Config
  welcomeMessage: entry.data.welcomeMessage || `👋 Welcome to "${entry.data.title || 'this lesson'}"! How can I help you understand this topic better?`,
  avatar: entry.data.avatar || "/icon.svg",
  suggestions: entry.data.suggestions || [
    { 
      label: "📚 Key Concepts", 
      prompt: "What are the main concepts covered in this lesson?" 
    },
    { 
      label: "💡 Examples", 
      prompt: "Can you provide some practical examples from this lesson?" 
    },
    { 
      label: "❓ Questions", 
      prompt: "I have a question about something in this lesson..." 
    },
    { 
      label: "🔍 Deep Dive", 
      prompt: "Let's explore this topic in more detail" 
    }
  ],

  // Optional Config
  runtime: "edge",
  includeContent: true
});
---

<DocsPage 
  title={entry.data.title}
  description={entry.data.description}
  chatConfig={chatConfig}
  rightPanelMode={entry.data.rightPanelMode || "quarter"}
>
  <div class="px-4 sm:px-6">
    <Content />
  </div>
</DocsPage>