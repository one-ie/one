---
import Layout from "../layouts/Layout.astro";
import { Button } from "../components/ui/button";
import { Badge } from "../components/ui/badge";
import { ArrowRightIcon, StarIcon } from "lucide-react";
import { AccordionWrapper } from "../components/AccordionWrapper";
import { BorderBeam } from "../components/magicui/border-beam";
import { PricingCard, type PricingPlan } from "../components/pricing/PricingCard";
import { FeatureComparison, type FeatureItem } from "../components/pricing/FeatureComparison";

const title = "Pricing Plans";
const description = "Choose the perfect plan for your AI business needs";

// Testimonials data
const testimonials = [
  {
    quote: "The AI Agent plan has transformed our customer service. Our AI agents handle 80% of inquiries automatically now.",
    author: "Michael Thompson",
    role: "CEO, TechFlow",
    initial: "M"
  },
  {
    quote: "We started with the Book plan and quickly upgraded to the AI Agent plan as we saw the incredible ROI. Best decision we made this year.",
    author: "Sarah Johnson",
    role: "Marketing Director, Elevate",
    initial: "S"
  }
];

// Plans data
const plans: PricingPlan[] = [
  {
    name: "Software",
    price: "0",
    period: "forever free",
    description: "Perfect for developers and small businesses getting started with AI",
    features: [
      "Open source code",
      "Basic AI integration",
      "Community support",
      "Standard response time",
      "Basic customization"
    ],
    cta: "Get Started",
    popular: false
  },
  {
    name: "Book",
    price: "50",
    period: "one-time payment",
    description: "Comprehensive guide to building AI-powered businesses",
    features: [
      "Complete framework guide",
      "Step-by-step tutorials",
      "Best practices",
      "Implementation examples",
      "Lifetime updates",
      "Community access"
    ],
    cta: "Buy Now",
    popular: false
  },
  {
    name: "Prompts",
    price: "100",
    period: "one-time payment",
    description: "Access to our complete prompt library and templates",
    features: [
      "200+ tested prompts",
      "Custom templates",
      "Industry-specific prompts",
      "Regular updates",
      "Implementation guides",
      "Priority support"
    ],
    cta: "Get Access",
    popular: false
  },
  {
    name: "AI Agent",
    price: "100",
    period: "per month",
    description: "Complete AI agent solution for your business",
    features: [
      "100 AI Agents",
      "100 users included",
      "Advanced customization",
      "Fastest response time",
      "24/7 dedicated support",
      "Unlimited messages",
      "Advanced analytics",
      "Custom integrations",
      "White labeling",
      "API access"
    ],
    cta: "Start Free Trial",
    popular: true
  }
];

// Feature comparison
const featureComparison: FeatureItem[] = [
  { name: "AI Agents", software: "Basic", book: "❌", prompts: "❌", agent: "100" },
  { name: "Users", software: "Unlimited", book: "1", prompts: "1", agent: "100" },
  { name: "Custom training", software: "Basic", book: "❌", prompts: "Advanced", agent: "Enterprise" },
  { name: "Response time", software: "Standard", book: "❌", prompts: "❌", agent: "Fastest" },
  { name: "Support", software: "Community", book: "Email", prompts: "Priority", agent: "24/7 Dedicated" },
  { name: "Analytics", software: "Basic", book: "❌", prompts: "❌", agent: "Advanced" },
  { name: "White labeling", software: "❌", book: "❌", prompts: "❌", agent: "✓" },
  { name: "API access", software: "Basic", book: "❌", prompts: "❌", agent: "✓" },
  { name: "Custom domain", software: "❌", book: "❌", prompts: "❌", agent: "✓" },
  { name: "SLA guarantee", software: "❌", book: "❌", prompts: "❌", agent: "✓" }
];

// FAQ items
const faqs = [
  {
    title: "Can I switch plans later?",
    content: "Yes, you can upgrade or downgrade your plan at any time. Changes take effect at the start of your next billing cycle."
  },
  {
    title: "Is there a free trial?",
    content: "We offer a 14-day free trial on the AI Agent plan. No credit card required to start your trial."
  },
  {
    title: "How do I cancel my subscription?",
    content: "You can cancel your subscription at any time from your account dashboard. If you cancel, you'll still have access until the end of your current billing period."
  },
  {
    title: "Do you offer refunds?",
    content: "We offer a 30-day money-back guarantee on all paid plans. If you're not satisfied with our service, contact us within 30 days of your purchase for a full refund."
  },
  {
    title: "What payment methods do you accept?",
    content: "We accept all major credit cards, PayPal, and cryptocurrency payments including Bitcoin, Ethereum, and Solana."
  }
];
---

<Layout title={title} description={description}>
  <div class="container mx-auto px-4 py-16">
    <!-- Hero Section -->
    <section class="mb-24">
      <div class="max-w-3xl mx-auto text-center">
        <h1 class="text-5xl md:text-6xl font-bold mb-6 tracking-tight one-text-gradient">
          Simple, Transparent Pricing
        </h1>
        <p class="text-xl text-muted-foreground mb-12">
          Choose the perfect plan for your business needs with no hidden fees or surprises
        </p>
      </div>
      
      <!-- Pricing Cards -->
      <div class="max-w-7xl mx-auto grid md:grid-cols-2 lg:grid-cols-4 gap-8">
        {plans.map((plan) => (
          <PricingCard plan={plan} />
        ))}
      </div>
    </section>
    
    <!-- Feature Comparison -->
    <section class="mb-24">
      <h2 class="text-4xl font-bold mb-12 text-center">
        Feature Comparison
      </h2>
      <div class="max-w-5xl mx-auto">
        <FeatureComparison features={featureComparison} />
      </div>
    </section>
    
    <!-- Testimonials -->
    <section class="mb-24">
      <h2 class="text-4xl font-bold mb-12 text-center">
        What Our Customers Say
      </h2>
      
      <div class="max-w-5xl mx-auto grid md:grid-cols-2 gap-8">
        {testimonials.map((testimonial) => (
          <div class="one-glass-dark border border-[hsla(var(--one-border))] p-8 rounded-xl">
            <div class="flex items-center mb-4">
              {Array(5).fill(0).map(() => (
                <StarIcon className="w-5 h-5 text-white fill-white" />
              ))}
            </div>
            <p class="italic mb-6 text-lg">{testimonial.quote}</p>
            <div class="flex items-center">
              <div class="w-12 h-12 rounded-full bg-[hsla(var(--one-background-nav))] flex items-center justify-center font-bold mr-3">
                {testimonial.initial}
              </div>
              <div>
                <div class="font-medium">{testimonial.author}</div>
                <div class="text-sm text-muted-foreground">{testimonial.role}</div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- FAQ -->
    <section class="mb-24">
      <h2 class="text-4xl font-bold mb-12 text-center">
        Frequently Asked Questions
      </h2>
      
      <div class="max-w-4xl mx-auto one-glass-dark border border-[hsla(var(--one-border))] p-8 rounded-xl">
        <AccordionWrapper items={faqs} client:visible />
      </div>
    </section>

    <!-- Final CTA -->
    <section class="max-w-3xl mx-auto">
      <div class="one-glass-dark border border-[hsla(var(--one-border))] shadow-xl p-12 rounded-xl text-center">
        <h2 class="text-4xl font-bold mb-6 tracking-tight one-text-gradient">
          Ready to Get Started?
        </h2>
        <p class="text-xl text-muted-foreground mb-8 max-w-xl mx-auto">
          Choose the plan that's right for you and start building your AI-powered business today
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <BorderBeam duration={8} containerClassName="rounded-md">
            <Button size="lg" className="one-button bg-white text-black hover:bg-white/90 border-0 px-8 py-6 text-lg">
              View Plans
              <ArrowRightIcon className="ml-2 h-5 w-5" aria-hidden="true" />
            </Button>
          </BorderBeam>
          <Button variant="outline" size="lg" className="border-white text-white hover:bg-white/10 px-8 py-6 text-lg">
            Contact Sales
          </Button>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  /* Add custom fonts for MCM aesthetic */
  @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap');
  
  /* 70s MCM geometric patterns */
  .geometric-pattern {
    background-image: radial-gradient(circle at 25px 25px, hsla(0, 0%, 100%, 0.1) 2%, transparent 0%), 
                      radial-gradient(circle at 75px 75px, hsla(0, 0%, 100%, 0.1) 2%, transparent 0%);
    background-size: 100px 100px;
  }

  .container {
    max-width: 1400px;
  }
</style>

