---
import Layout from "../layouts/Layout.astro";
import { Button } from "../components/ui/button";
import { Badge } from "../components/ui/badge";
import { Card } from "../components/ui/card";
import { CheckIcon, ArrowRightIcon, SparklesIcon, ShieldCheckIcon, ZapIcon, StarIcon, ClockIcon, UserIcon, HeartIcon, BarChartIcon, LightbulbIcon, PlayIcon } from "lucide-react";
import { AccordionWrapper } from "../components/AccordionWrapper";
import { CourseModuleContent } from "../components/CourseModuleContent";
import { Progress } from "../components/ui/progress";
import { Separator } from "../components/ui/separator";

const title = "Master AI Business Building - Complete Course";
const description = "Transform your ideas into profitable AI-powered businesses with our comprehensive, step-by-step system";

// Course details
const courseDetails = {
  badge: "Limited-Time Offer: 50% OFF",
  title: "AI Business Accelerator™",
  subtitle: "The Complete System to Build, Launch & Scale Your AI Business in 30 Days",
  originalPrice: "997",
  currentPrice: "497",
  guarantee: "30-Day 100% Money-Back Guarantee",
  ctaText: "Secure Your Spot Now",
  valueProposition: "All the tools, templates & support you need to create your profitable AI business",
  spots: {
    total: 50,
    remaining: 7
  }
};

// Course modules data
const courseModulesData = [
  {
    title: "Foundation & Setup",
    description: "Build your technical foundation",
    lessons: [
      { name: "Environment Setup", value: "Complete development environment configuration" },
      { name: "Project Structure", value: "Optimized file organization for scalability" },
      { name: "AI Integration", value: "Connect to leading AI providers" }
    ]
  },
  {
    title: "Brand Development",
    description: "Create a compelling AI brand identity",
    lessons: [
      { name: "Brand Strategy", value: "Position your AI business for success" },
      { name: "Visual Identity", value: "Design system implementation" },
      { name: "Voice & Tone", value: "Consistent communication framework" }
    ]
  },
  {
    title: "AI Agent Creation",
    description: "Build powerful AI assistants",
    lessons: [
      { name: "Agent Architecture", value: "Design intelligent conversation flows" },
      { name: "Prompt Engineering", value: "Create effective AI instructions" },
      { name: "Personality Design", value: "Develop unique AI personalities" }
    ]
  },
  {
    title: "Content Automation",
    description: "Scale your content production",
    lessons: [
      { name: "Content Strategy", value: "Plan your automated content ecosystem" },
      { name: "Multi-channel Publishing", value: "Distribute across platforms" },
      { name: "SEO Optimization", value: "Maximize content visibility" }
    ]
  },
  {
    title: "Monetization & Sales",
    description: "Generate revenue from your AI business",
    lessons: [
      { name: "Payment Integration", value: "Accept multiple payment methods" },
      { name: "Sales Automation", value: "Create AI-powered sales systems" },
      { name: "Subscription Models", value: "Build recurring revenue streams" }
    ]
  }
];

// Benefits - Enhanced with stronger outcomes
const benefits = [
  { title: "Launch in 30 Days", icon: ClockIcon, description: "Go from idea to paying customers in just 4 weeks" },
  { title: "Done-for-You Templates", icon: CheckIcon, description: "Save 100+ hours with ready-to-use systems" },
  { title: "AI Business Toolkit", icon: SparklesIcon, description: "Access $5,000+ worth of premium resources" },
  { title: "Private Community", icon: UserIcon, description: "Get help from successful AI entrepreneurs" },
  { title: "Lifetime Updates", icon: ZapIcon, description: "Stay ahead with the latest AI strategies" },
  { title: "Expert Support", icon: ShieldCheckIcon, description: "Get answers within 24 hours, guaranteed" }
];

// Enhanced testimonials with more specific results
const testimonials = [
  {
    quote: "Within 3 weeks of starting this course, I launched my AI writing assistant and secured my first 5 clients, generating $3,750 in my first month. The step-by-step framework eliminated all the guesswork.",
    author: "Alex K., Founder of ContentAI Pro",
    business: "AI Content Generation",
    result: "$3,750 in first month",
    image: "/testimonials/alex.jpg"
  },
  {
    quote: "As someone with zero technical background, I was worried this would be over my head. But the course breaks everything down so clearly that I was able to build and launch my AI legal assistant, which now generates $7,200/month in recurring revenue.",
    author: "Sarah M., Creator of LegalAssistAI",
    business: "Legal Tech",
    result: "$7,200/month recurring",
    image: "/testimonials/sarah.jpg"
  }
];

// Learning outcomes
const learningOutcomes = [
  "How to identify profitable AI business opportunities in under 60 minutes",
  "The exact tech stack needed to build any AI business (even as a non-developer)",
  "Our proven 7-step framework for creating AI agents that sell themselves",
  "How to automate content creation across blogs, social media, and email",
  "The simple method for setting up payments and subscription systems",
  "Advanced AI prompt engineering techniques for performance optimization",
  "Step-by-step marketing strategy to attract your first 100 customers",
  "Scaling techniques to grow from $0 to $10,000/month"
];

// Instructor details
const instructor = {
  name: "David Chen",
  title: "AI Business Strategist & Entrepreneur",
  bio: "Over the past 3 years, David has built and sold 4 AI businesses with a combined exit value of $2.7M. He's helped over 300 entrepreneurs create profitable AI businesses through his proven framework.",
  image: "/instructor.jpg"
};

// FAQs
const faqs = [
  {
    question: "Do I need technical skills to succeed with this course?",
    answer: "No technical background is required. We've designed the course to be beginner-friendly while still covering advanced concepts. We provide step-by-step instructions and templates so you can focus on building your business, not learning to code."
  },
  {
    question: "How quickly can I expect to see results?",
    answer: "Most students launch their AI business within 30 days of starting the course. The fastest student went from zero to first paying customer in just 18 days. Your results will depend on how quickly you implement the steps, but our framework is designed for rapid deployment."
  },
  {
    question: "What makes this different from other AI business courses?",
    answer: "Unlike other courses that focus only on theory, we provide a complete system including step-by-step implementation guides, done-for-you templates, technical assistance, and community support. We focus on practical, proven strategies that are currently working in the AI space."
  },
  {
    question: "How much time do I need to commit?",
    answer: "Most students spend 5-7 hours per week implementing the course material. The course is designed to fit around a full-time job, with bite-sized lessons and actionable steps you can complete in small time blocks."
  }
];

// Bonuses
const bonuses = [
  {
    title: "AI Business Templates Bundle",
    description: "20+ ready-to-use templates for your AI business including prompts, marketing materials, and legal documents",
    value: "$997 Value"
  },
  {
    title: "Private Community Access",
    description: "Connect with 300+ AI entrepreneurs building profitable businesses with this system",
    value: "$497 Value"
  },
  {
    title: "6 Weekly Group Coaching Calls",
    description: "Get your specific questions answered and receive personalized guidance",
    value: "$997 Value"
  }
];
---

<Layout title={title} description={description}>
  <div class="min-h-screen bg-gradient-to-b from-primary/5 to-background">
    <!-- Hero Section -->
    <div class="container mx-auto px-4 py-16">
      <div class="text-center mb-16">
        <Badge variant="outline" className="mb-4 animate-pulse">
          {courseDetails.badge}
        </Badge>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-4 tracking-tight">{courseDetails.title}</h1>
        <p class="text-xl md:text-2xl text-muted-foreground max-w-3xl mx-auto mb-8">{courseDetails.subtitle}</p>
        <div class="max-w-2xl mx-auto mb-8">
          <Progress value={(courseDetails.spots.total - courseDetails.spots.remaining) / courseDetails.spots.total * 100} className="h-2 mb-2" />
          <p class="text-sm text-muted-foreground">
            <span class="text-primary font-medium">{courseDetails.spots.remaining} spots remaining</span> out of {courseDetails.spots.total} total enrollments
          </p>
        </div>
        
        <!-- Benefits Grid -->
        <div class="grid md:grid-cols-3 gap-4 max-w-4xl mx-auto mb-8">
          {benefits.map((benefit) => (
            <div class="flex flex-col items-center p-4 rounded-lg bg-primary/5">
              <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center mb-2">
                <benefit.icon className="w-6 h-6 text-primary" />
              </div>
              <h3 class="font-bold mb-1">{benefit.title}</h3>
              <p class="text-sm text-muted-foreground text-center">{benefit.description}</p>
            </div>
          ))}
        </div>
        
        <Button 
          size="lg" 
          className="bg-primary hover:bg-primary/90 text-white text-lg font-bold py-6 px-8 shadow-lg hover:shadow-xl transition-all duration-200"
          asChild
        >
          <a href="#pricing">
            {courseDetails.ctaText}
            <ArrowRightIcon className="ml-2 w-5 h-5" />
          </a>
        </Button>
      </div>
      
      <!-- Main Content -->
      <div class="grid lg:grid-cols-3 gap-8 max-w-6xl mx-auto" id="pricing">
        <!-- Left Column (Course Details) -->
        <div class="lg:col-span-2">
          <!-- Video Preview -->
          <Card className="mb-10 overflow-hidden">
            <div class="aspect-video bg-muted/50 flex items-center justify-center">
              <div class="text-center">
                <div class="w-16 h-16 rounded-full bg-primary/20 flex items-center justify-center mx-auto mb-2">
                  <PlayIcon className="w-8 h-8 text-primary" />
                </div>
                <span class="text-sm text-muted-foreground">Click to Play Course Preview</span>
              </div>
            </div>
          </Card>
          
          <!-- What You'll Learn -->
          <Card className="p-8 mb-10 border-primary/10">
            <h2 class="text-2xl font-bold mb-6 flex items-center">
              <LightbulbIcon className="w-6 h-6 text-primary mr-2" />
              What You'll Learn
            </h2>
            <div class="grid sm:grid-cols-2 gap-4">
              {learningOutcomes.map(outcome => (
                <div class="flex items-start">
                  <CheckIcon className="w-5 h-5 text-green-500 mt-1 mr-2 flex-shrink-0" />
                  <p>{outcome}</p>
                </div>
              ))}
            </div>
          </Card>

          <!-- Course Modules -->
          <h2 class="text-2xl font-bold mb-6">Course Curriculum</h2>
          <Card className="p-0 overflow-hidden mb-10 border-primary/10">
            <div class="bg-primary/5 p-4 flex items-center justify-between">
              <div>
                <span class="font-medium">5 Modules</span>
                <span class="text-muted-foreground"> • </span>
                <span class="font-medium">15 Lessons</span>
                <span class="text-muted-foreground"> • </span>
                <span class="font-medium">6+ Hours</span>
              </div>
              <span class="inline-flex items-center border border-primary/20 bg-primary/10 text-primary px-2.5 py-0.5 text-xs font-semibold rounded-full">
                Lifetime Access
              </span>
            </div>
            <div class="p-0">
              <AccordionWrapper client:load 
                items={courseModulesData.map(module => ({
                  title: module.title,
                  content: { type: "module", description: module.description, lessons: module.lessons }
                }))}
              />
            </div>
          </Card>

          <!-- Instructor -->
          <Card className="p-8 mb-10 border-primary/10">
            <h2 class="text-2xl font-bold mb-6">Your Instructor</h2>
            <div class="flex flex-col sm:flex-row gap-6 items-center sm:items-start">
              <div class="w-32 h-32 rounded-full overflow-hidden border-4 border-primary/20 flex-shrink-0">
                <img src={instructor.image} alt={instructor.name} class="w-full h-full object-cover" />
              </div>
              <div>
                <h3 class="text-xl font-bold">{instructor.name}</h3>
                <p class="text-primary mb-3">{instructor.title}</p>
                <p class="text-muted-foreground">{instructor.bio}</p>
              </div>
            </div>
          </Card>

          <!-- Testimonials -->
          <h2 class="text-2xl font-bold mb-6">Student Success Stories</h2>
          <div class="grid md:grid-cols-2 gap-6 mb-10">
            {testimonials.map(testimonial => (
              <Card className="p-6 border-primary/10 relative overflow-hidden">
                <div class="absolute top-0 right-0 w-20 h-20 bg-primary/5 rounded-full -mr-10 -mt-10 z-0"></div>
                <div class="relative z-10">
                  <div class="flex text-amber-400 mb-2">
                    <StarIcon className="w-4 h-4" />
                    <StarIcon className="w-4 h-4" />
                    <StarIcon className="w-4 h-4" />
                    <StarIcon className="w-4 h-4" />
                    <StarIcon className="w-4 h-4" />
                  </div>
                  <p class="italic mb-4">{testimonial.quote}</p>
                  <div class="flex items-center">
                    <div class="w-12 h-12 rounded-full overflow-hidden mr-3">
                      <img src={testimonial.image} alt={testimonial.author} class="w-full h-full object-cover" />
                    </div>
                    <div>
                      <p class="font-medium">{testimonial.author}</p>
                      <p class="text-sm text-muted-foreground">{testimonial.business}</p>
                    </div>
                  </div>
                  <div class="mt-3 bg-green-50 dark:bg-green-950/30 text-green-700 dark:text-green-400 text-sm font-medium px-3 py-1 rounded inline-block">
                    Result: {testimonial.result}
                  </div>
                </div>
              </Card>
            ))}
          </div>

          <!-- FAQs -->
          <Card className="p-8 mb-10 border-primary/10">
            <h2 class="text-2xl font-bold mb-6">Frequently Asked Questions</h2>
            <AccordionWrapper client:load 
              items={faqs.map(item => ({
                title: item.question,
                content: item.answer
              }))}
            />
          </Card>
        </div>
        
        <!-- Right Column (Pricing) -->
        <div class="lg:col-span-1">
          <div class="sticky top-24">
            <Card className="p-8 border-primary/20 shadow-lg relative overflow-hidden bg-white dark:bg-zinc-900">
              <!-- Decorative elements -->
              <div class="absolute top-0 right-0 w-40 h-40 bg-primary/5 rounded-full -mr-20 -mt-20"></div>
              <div class="absolute bottom-0 left-0 w-40 h-40 bg-primary/5 rounded-full -ml-20 -mb-20"></div>
              
              <div class="relative z-10">
                <div class="mb-6 text-center">
                  <div class="inline-block bg-red-50 dark:bg-red-950/30 text-red-600 dark:text-red-400 px-3 py-1 rounded-full text-sm font-medium mb-2">
                    Save ${parseInt(courseDetails.originalPrice) - parseInt(courseDetails.currentPrice)} Today
                  </div>
                  
                  <div class="flex items-baseline justify-center gap-2 mb-1">
                    <span class="text-muted-foreground line-through text-lg">
                      ${courseDetails.originalPrice}
                    </span>
                    <span class="text-4xl font-bold text-primary">
                      ${courseDetails.currentPrice}
                    </span>
                  </div>
                  
                  <p class="text-sm text-muted-foreground mb-2">
                    One-time payment, lifetime access
                  </p>
                </div>

                <!-- Limited spots -->
                <div class="mb-6">
                  <div class="flex justify-between text-sm mb-1">
                    <span>Enrollment Closing Soon</span>
                    <span class="text-red-500 font-medium">
                      Only {courseDetails.spots.remaining} spots left
                    </span>
                  </div>
                  <Progress value={(courseDetails.spots.total - courseDetails.spots.remaining) / courseDetails.spots.total * 100} className="h-2" />
                </div>

                <!-- Bonuses -->
                <div class="mb-6">
                  <h3 class="font-bold text-lg mb-3">Fast-Action Bonuses</h3>
                  {bonuses.map((bonus, i) => (
                    <div class="mb-3 bg-primary/5 rounded-lg p-3 last:mb-0">
                      <div class="flex justify-between font-medium mb-1">
                        <span>BONUS #{i+1}: {bonus.title}</span>
                        <span class="text-primary">{bonus.value}</span>
                      </div>
                      <p class="text-sm text-muted-foreground">{bonus.description}</p>
                    </div>
                  ))}
                </div>

                <!-- Value stack -->
                <div class="mb-6 bg-primary/5 p-4 rounded-lg">
                  <h3 class="font-medium mb-3">Total Value: <span class="line-through">$3,988</span></h3>
                  <div class="text-center">
                    <div class="text-2xl font-bold text-primary mb-1">Today: ${courseDetails.currentPrice}</div>
                    <div class="text-sm text-muted-foreground mb-1">88% OFF Total Value</div>
                  </div>
                </div>

                <!-- CTA Button -->
                <Button 
                  size="lg" 
                  className="w-full bg-primary hover:bg-primary/90 text-white font-bold text-lg py-6 shadow-lg hover:shadow-xl transition-all duration-200 mb-4"
                  asChild
                >
                  <a href="/checkout">
                    {courseDetails.ctaText}
                    <ArrowRightIcon className="ml-2 w-5 h-5" />
                  </a>
                </Button>

                <!-- Guarantee -->
                <div class="flex items-center justify-center text-sm text-muted-foreground mb-6">
                  <ShieldCheckIcon className="w-4 h-4 mr-2 text-primary" />
                  <span>{courseDetails.guarantee}</span>
                </div>

                <!-- Payment methods -->
                <div class="text-center">
                  <p class="text-xs text-muted-foreground mb-2">Secure payment via:</p>
                  <div class="flex justify-center space-x-2">
                    <div class="w-10 h-6 bg-muted rounded opacity-70"></div>
                    <div class="w-10 h-6 bg-muted rounded opacity-70"></div>
                    <div class="w-10 h-6 bg-muted rounded opacity-70"></div>
                    <div class="w-10 h-6 bg-muted rounded opacity-70"></div>
                  </div>
                </div>
              </div>
            </Card>
          </div>
        </div>
      </div>

      <!-- Final CTA -->
      <div class="mt-16 text-center max-w-3xl mx-auto">
        <h2 class="text-3xl font-bold mb-4">Ready to Build Your AI Business?</h2>
        <p class="text-muted-foreground mb-8 text-lg">
          Join 300+ entrepreneurs who have already transformed their ideas into profitable AI businesses.
        </p>
        <Button
          size="lg"
          className="bg-primary hover:bg-primary/90 text-white font-bold text-lg tracking-wide shadow-lg hover:shadow-xl transition-all duration-200 px-8 py-6"
          asChild
        >
          <a href="/checkout">
            Secure Your Spot Now
            <ArrowRightIcon className="ml-2 w-5 h-5" />
          </a>
        </Button>
        <p class="mt-4 text-sm text-muted-foreground">
          Only {courseDetails.spots.remaining} spots remaining. Enrollment closes soon.
        </p>
      </div>
    </div>
  </div>
</Layout>

