---
// src/pages/gemini.astro
// This page provides a dedicated chat interface configured for Google Gemini models.

import Layout from "../layouts/Chat.astro"; // Using the Chat layout
import { normalizeConfig } from "@/schema/chat"; // Import schema normalizer

// Define chat configuration specifically for Google Gemini
const chatConfig = normalizeConfig({
  title: "Google Gemini Chat",
  description: "Chat directly with Google's Gemini Pro model.",
  
  // --- AI Configuration ---
  provider: "gemini", // Use direct Gemini integration
  model: "gemini-pro-vision", // The model we've configured in openrouter.ts
  temperature: 0.7,
  maxTokens: 12000,

  // --- Prompt Configuration ---
  // Define the AI's role and context
  systemPrompt: `You are Google Gemini, a large language model trained by Google. 
                 You can understand both text and images.
                 Respond helpfully, accurately, and concisely.`,
  // Don't add the generic system/business prompts for this specific agent page
  addSystemPrompt: false, 
  addBusinessPrompt: false, 
  includeContent: false, 

  // --- UI Configuration ---
  welcome: {
    message: "👋 Hi! I'm Google Gemini. I can help you with both text and images. What would you like to explore?",
    avatar: "/logos/gemini-logo-round.svg", // Assuming you have a Gemini logo here
    suggestions: [
      { label: "🖼️ Image Analysis", prompt: "Upload an image and I'll analyze it for you." },
      { label: "💡 Capabilities", prompt: "What can you do with both text and images?" },
      { label: "🤖 About Gemini", prompt: "Tell me about Google's Gemini model." },
      { label: "💻 Code Example", prompt: "Show me a Python code example." }
    ]
  }
});
---

<Layout
  chatConfig={chatConfig}
>
  <!-- 
    The Chat.astro layout handles rendering the actual Chat component. 
    No additional content is needed here unless you want to add specific 
    UI elements around the chat interface for this particular page.
  -->
</Layout>