---
import Layout from "../layouts/Layout.astro";
// Set rightPanelMode to hidden to remove the chat functionality
const rightPanelMode = "hidden";
---

<Layout title="404 - Page Not Found" rightPanelMode={rightPanelMode}>
  <div class="container mx-auto px-4 py-16 min-h-[calc(100vh-4rem)] flex flex-col items-center justify-center">
    <div class="max-w-3xl w-full text-center space-y-8">
      <!-- Glitchy 404 Text -->
      <div class="relative">
        <h1 class="text-[10rem] md:text-[15rem] font-bold leading-none tracking-tighter text-primary/80 glitch-text">
          404
        </h1>
        <div class="absolute top-0 left-0 w-full h-full flex items-center justify-center">
          <h1 class="text-[10rem] md:text-[15rem] font-bold leading-none tracking-tighter text-primary/30 glitch-shadow">
            404
          </h1>
        </div>
      </div>
      
      <!-- Message -->
      <div class="space-y-4">
        <h2 class="text-3xl md:text-4xl font-bold">Signal Lost</h2>
        <p class="text-xl text-muted-foreground max-w-xl mx-auto">
          The digital coordinates you're looking for seem to have drifted into uncharted territory.
        </p>
      </div>
      
      <!-- Cool SVG Illustration -->
      <div class="py-8 flex justify-center">
        <img 
          src="/images/drawings/Elevate.svg" 
          alt="Lost in digital space" 
          class="w-full max-w-md mx-auto hover:scale-105 transition-transform duration-500"
        />
      </div>
      
      <!-- Action Buttons -->
      <div class="flex flex-wrap gap-4 justify-center pt-4">
        <a 
          href="/" 
          class="px-6 py-3 bg-primary text-primary-foreground rounded-md font-medium hover:bg-primary/90 transition-colors"
        >
          Return to Base
        </a>
        <a 
          href="/sitemap" 
          class="px-6 py-3 bg-muted text-foreground rounded-md font-medium hover:bg-muted/80 transition-colors"
        >
          View Map
        </a>
      </div>
      
      <!-- Random Fun Fact -->
      <div class="mt-12 p-4 bg-muted/50 rounded-lg max-w-lg mx-auto">
        <h3 class="font-semibold mb-2">Did You Know?</h3>
        <p class="text-sm text-muted-foreground">
          The term "404" comes from the HTTP status code that means "Not Found." It was chosen because room 404 at CERN, where the World Wide Web was born, was the central hub where all the web files were stored.
        </p>
      </div>
    </div>
  </div>
</Layout>

<style>
  .glitch-text {
    position: relative;
    animation: glitch 0.5s infinite alternate-reverse;
  }
  
  .glitch-shadow {
    animation: glitch 0.5s infinite alternate-reverse;
    animation-delay: 0.1s;
    opacity: 0.5;
    filter: blur(1px);
  }
  
  @media (prefers-reduced-motion: reduce) {
    .glitch-text, .glitch-shadow {
      animation: none;
    }
  }
</style> 