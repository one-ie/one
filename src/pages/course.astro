---
import Layout from "../layouts/Layout.astro";
import { Button } from "../components/ui/button";
import { Badge } from "../components/ui/badge";
import { Card } from "../components/ui/card";
import { CheckIcon, ArrowRightIcon, ShieldCheckIcon, UserIcon } from "lucide-react";
import { HeroPill } from "../components/HeroPill";
import FaqAccordion from "@/components/FaqAccordion";
import { CourseModuleContent } from "../components/CourseModuleContent";
import { Progress } from "../components/ui/progress";
import { Separator } from "../components/ui/separator";
import { CountdownTimer } from "../components/CountdownTimer";

const title = "AI Marketing Revolution: Automate, Convert, and Scale Your Revenue";
const description = "Discover the exact AI systems top marketers are using to automate their work, dominate search rankings, and convert visitors into high-paying customers";

// Countdown timer calculation
const launchDate = "2025-04-11T00:00:00";  // Using ISO date format for better compatibility

// Course details
const courseDetails = {
  badge: "Launch Special: 72-Hour Only",
  title: "AI Marketing Revolution",
  subtitle: "Generate More Traffic, Conversions, and Sales in Half the Time",
  originalPrice: "1,997",
  currentPrice: "997",
  guarantee: "30-Day Implementation Guarantee",
  ctaText: "Secure Your Spot Now",
  valueProposition: "Join the AI marketing revolution and transform your business with automated systems that work 24/7.",
  spots: {
    total: 100,
    remaining: 25
  },
  launchDate: "April 11, 2024"
};

// Course modules data
const courseModulesData = [
  {
    title: "AI Marketing Foundations That Drive Real ROI",
    description: "Master essential AI tools and strategies",
    lessons: [
      { name: "AI Marketing Terminology", value: "Learn the key concepts that matter for your bottom line" },
      { name: "Top AI Tools", value: "Discover the exact tools top marketers use" },
      { name: "Ethical AI Practices", value: "Build customer trust and boost conversion rates" }
    ]
  },
  {
    title: "AI-Powered Market Intelligence",
    description: "Uncover hidden opportunities",
    lessons: [
      { name: "AI Research Tools", value: "Extract actionable insights your competitors miss" },
      { name: "Customer Segmentation", value: "Build segments that spend 3X more" },
      { name: "Buyer Personas", value: "Develop hyper-accurate customer profiles" }
    ]
  },
  {
    title: "Content Creation That Converts",
    description: "Generate high-converting content",
    lessons: [
      { name: "Copywriting", value: "Create content that drives immediate action" },
      { name: "SEO Optimization", value: "Rank in top search positions consistently" },
      { name: "Visual Content", value: "Design engaging visuals that increase engagement" }
    ]
  },
  {
    title: "Email Sequences That Convert",
    description: "Build powerful email automation",
    lessons: [
      { name: "Personalization", value: "Achieve 40%+ open rates with AI" },
      { name: "Subject Lines", value: "Outperform industry benchmarks consistently" },
      { name: "Behavior Triggers", value: "Send emails at perfect moments" }
    ]
  },
  {
    title: "Social Media Strategies",
    description: "Build profitable audiences",
    lessons: [
      { name: "AI Listening", value: "Identify viral trends before they explode" },
      { name: "Content Calendar", value: "Create engagement-optimized schedules" },
      { name: "Community Building", value: "Build self-sustaining sales channels" }
    ]
  },
  {
    title: "Conversational Marketing",
    description: "Close deals 24/7",
    lessons: [
      { name: "Sales Chatbots", value: "Qualify leads while you sleep" },
      { name: "Conversation Flows", value: "Convert at 3X your current rate" },
      { name: "Support AI", value: "Turn support into sales opportunities" }
    ]
  },
  {
    title: "SEO Domination Strategies",
    description: "Drive buying traffic",
    lessons: [
      { name: "Keyword Research", value: "Find untapped high-converting keywords" },
      { name: "Content Ranking", value: "Get top 3 positions within 30 days" },
      { name: "Technical SEO", value: "Double your organic traffic" }
    ]
  },
  {
    title: "Paid Advertising That Converts",
    description: "Maximize ad ROI",
    lessons: [
      { name: "AI Copy Generation", value: "Beat control versions consistently" },
      { name: "Budget Optimization", value: "Reduce CPA by up to 50%" },
      { name: "Bid Management", value: "Use 7-figure agency strategies" }
    ]
  }
];

// What you'll learn
const learningOutcomes = [
  "Generate high-converting copy in minutes, not hours",
  "Create content strategies backed by predictive data",
  "Build email sequences that adapt to each subscriber",
  "Discover untapped keywords your competitors haven't found",
  "Optimize your ad spend with precision targeting",
  "Automate 70% of your repetitive marketing tasks",
  "Scale your marketing efforts without hiring additional team members",
  "Build complete AI marketing systems that run 24/7"
];

// Bonuses
const bonuses = [
  {
    title: "AI Template Library",
    description: "100+ ready-to-use templates for every marketing function",
    value: "$997 Value"
  },
  {
    title: "The ELEVATE with AI Framework",
    description: "Our proprietary system used by 7-figure agencies",
    value: "$1,497 Value"
  },
  {
    title: "AI Automation Server with n8n",
    description: "Complete setup with pre-built workflows",
    value: "$797 Value"
  },
  {
    title: "Customizable Chatbot Templates",
    description: "Ready-to-deploy chatbots for leads and sales",
    value: "$497 Value"
  },
  {
    title: "Web Chat Integration Guide",
    description: "Add AI-powered chat to your website",
    value: "$397 Value"
  }
];

// FAQs
const faqs = [
  {
    question: "Is this course suitable for beginners to AI?",
    answer: "Absolutely! The course is specifically designed to take you from AI novice to marketing automation expert with no prior experience required. We start with the fundamentals and progress to advanced applications."
  },
  {
    question: "How quickly can I implement these strategies?",
    answer: "The course is intentionally fast-paced and designed for immediate implementation. Many students set up their first AI workflows within 24 hours of starting the course. Our step-by-step video tutorials make implementation straightforward."
  },
  {
    question: "Do I need technical experience?",
    answer: "No technical background is required. The course is designed for marketers at all technical levels, with step-by-step instructions for setting up each tool and workflow. We use n8n for automation, which has an intuitive visual interface that requires no coding."
  },
  {
    question: "How long do I have access to the course materials?",
    answer: "You receive lifetime access to all course materials, including future updates as AI tools evolve and new strategies emerge."
  },
  {
    question: "What tools will I need to purchase?",
    answer: "The course focuses on maximizing value from affordable tools. We recommend a budget of $50-100/month for essential AI tools, though many students start with even less. We provide detailed guidance on which tools provide the best ROI for your specific situation."
  },
  {
    question: "How is this different from other AI marketing courses?",
    answer: "Unlike courses that simply teach you how to use ChatGPT for marketing, this system shows you how to build integrated AI marketing ecosystems using n8n and other tools. We include ready-to-deploy chatbots, web chat integration, and automation templates that give you immediate results."
  }
];

// Calculate total bonus value
const totalBonusValue = bonuses.reduce((total, bonus) => {
  const value = parseInt(bonus.value.replace(/\$|,|\s|Value/g, ''));
  return total + value;
}, 0);
---

<Layout title={title} description={description}>
  <main class="min-h-screen bg-background">
    <!-- Hero Section -->
    <section class="relative min-h-screen flex flex-col justify-center py-20 lg:py-32 overflow-hidden">
      <!-- Background Elements -->
      <div class="absolute inset-0 bg-gradient-to-b from-primary/5 via-primary/2 to-transparent pointer-events-none" />
      <div class="absolute inset-0 bg-[url('/grid.svg')] bg-center [mask-image:linear-gradient(180deg,white,rgba(255,255,255,0))]" />

      {/* Hero Pill */}
      <div class="absolute top-20 left-1/2 -translate-x-1/2">
        <HeroPill client:load shimmerWidth={200} className="inline-flexitems-center gap-2 px-4 py-1 rounded-full bg-primary/10 one-glass-dark">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-primary"></span>
          </span>
          <span class="text-sm font-medium text-primary">Limited Launch Special: 72-Hour Only</span>
          <ArrowRightIcon className="w-4 h-4 text-primary" />
        </HeroPill>
      </div>
      
      <div class="container px-4 mx-auto relative">
        <div class="max-w-4xl mx-auto text-center">
          <!-- Social Proof Banner -->
          <div class="flex items-center justify-center gap-2 mb-8 animate-fade-in">
            <div class="flex items-center gap-6 px-4 py-2 rounded-full bg-muted/5 one-glass-dark">
              <p class="text-sm text-muted-foreground">Trusted by marketers at</p>
              <div class="flex items-center gap-4">
                <img src="/logos/google.svg" alt="Google" class="h-4 opacity-70 hover:opacity-100 transition-opacity" />
                <img src="/logos/hubspot.svg" alt="HubSpot" class="h-4 opacity-70 hover:opacity-100 transition-opacity" />
                <img src="/logos/shopify.svg" alt="Shopify" class="h-4 opacity-70 hover:opacity-100 transition-opacity" />
              </div>
            </div>
          </div>

       

          <!-- Main Title -->
          <h1 class="text-4xl md:text-6xl lg:text-7xl font-bold mb-6 tracking-tight bg-clip-text text-transparent bg-gradient-to-r from-primary to-primary/70 animate-fade-in [--animation-delay:400ms] leading-[1.1]">
            AI Marketing Revolution
          </h1>

          <!-- Subtitle -->
          <p class="text-xl md:text-2xl lg:text-3xl text-muted-foreground mb-8 animate-fade-in [--animation-delay:600ms] max-w-3xl mx-auto leading-normal">
            Generate More Traffic, Conversions, and Sales in Half the Time
          </p>

          <!-- Video Preview -->
          <div class="relative aspect-video max-w-3xl mx-auto mb-12 rounded-xl overflow-hidden one-glass-card animate-fade-in [--animation-delay:800ms]">
            <div class="absolute inset-0 bg-gradient-to-tr from-primary/10 to-transparent" />
            <img src="/video-placeholder.jpg" alt="AI Marketing Revolution Preview" class="w-full h-full object-cover" />
            <button class="absolute inset-0 flex items-center justify-center group">
              <span class="w-20 h-20 flex items-center justify-center rounded-full bg-primary/90 text-white group-hover:bg-primary group-hover:scale-110 transition-all duration-300">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                  <polygon points="5 3 19 12 5 21 5 3" fill="currentColor" />
                </svg>
              </span>
            </button>
          </div>

          <!-- Stats Grid -->
          <div class="grid md:grid-cols-3 gap-6 mb-12 animate-fade-in [--animation-delay:1000ms]">
            <Card className="card p-6">
              <div class="flex items-start gap-3">
                <div class="card-icon">
                  <CheckIcon className="w-5 h-5 text-primary" />
                </div>
                <div>
                  <div class="text-3xl font-bold text-primary mb-2">73%</div>
                  <p class="text-sm text-muted-foreground">Reduction in Content Creation Time</p>
                </div>
              </div>
            </Card>
            <Card className="card p-6">
              <div class="flex items-start gap-3">
                <div class="card-icon">
                  <CheckIcon className="w-5 h-5 text-primary" />
                </div>
                <div>
                  <div class="text-3xl font-bold text-primary mb-2">3X</div>
                  <p class="text-sm text-muted-foreground">Average Increase in Conversion Rates</p>
                </div>
              </div>
            </Card>
            <Card className="card p-6">
              <div class="flex items-start gap-3">
                <div class="card-icon">
                  <CheckIcon className="w-5 h-5 text-primary" />
                </div>
                <div>
                  <div class="text-3xl font-bold text-primary mb-2">42%</div>
                  <p class="text-sm text-muted-foreground">Reduction in Ad Spend</p>
                </div>
              </div>
            </Card>
          </div>

          <!-- CTA Section -->
          <div class="space-y-8 animate-fade-in [--animation-delay:1200ms]">
            <!-- Timer -->
            <div class="w-full">
              <p class="text-sm text-muted-foreground mb-4 text-center">Launch Special Ends In:</p>
              <div class="flex justify-center w-full mb-8">
                <CountdownTimer targetDate={launchDate} client:load />
              </div>
            </div>

            <!-- Price -->
            <div class="flex items-center justify-center gap-4 mb-6">
              <span class="text-2xl line-through text-muted-foreground">${courseDetails.originalPrice}</span>
              <span class="text-4xl md:text-5xl font-bold text-primary">${courseDetails.currentPrice}</span>
            </div>

            <!-- Button -->
            <Button size="lg" className="text-lg one-button-primary group relative overflow-hidden px-8 py-6">
              <span class="relative z-10">Secure Your Spot Now</span>
              <span class="absolute inset-0 bg-gradient-to-r from-primary/0 via-primary/10 to-primary/0 group-hover:translate-x-full duration-1000 ease-in-out transition-transform"></span>
              <ArrowRightIcon className="ml-2 h-5 w-5 group-hover:translate-x-1 transition-transform" />
            </Button>

            <!-- Trust Indicators -->
            <div class="flex flex-wrap items-center justify-center gap-6 text-sm text-muted-foreground">
              <p class="flex items-center gap-2">
                <ShieldCheckIcon className="w-5 h-5 text-primary" />
                30-Day Implementation Guarantee
              </p>
              <p class="flex items-center gap-2">
                <UserIcon className="w-5 h-5 text-primary" />
                Only {courseDetails.spots.remaining} Spots Remaining
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Course Overview -->
    <section class="py-20 relative">
      <div class="absolute inset-0 bg-gradient-to-b from-transparent via-primary/5 to-transparent pointer-events-none" />
      <div class="container px-4 mx-auto relative">
        <h2 class="text-3xl lg:text-4xl font-bold text-center mb-12">What You'll Learn</h2>
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 mb-12">
          {learningOutcomes.map((outcome) => (
            <Card className="card p-6">
              <div class="flex items-start gap-3">
                <div class="card-icon">
                  <CheckIcon className="w-5 h-5 text-primary" />
                </div>
                <p class="text-sm">{outcome}</p>
              </div>
            </Card>
          ))}
        </div>
      </div>
    </section>

    <!-- Course Modules -->
    <section class="container mx-auto px-6 py-20 border-t border-border/40">
      <div class="w-full max-w-[1400px] mx-auto">
        <h2 class="text-4xl font-bold mb-10 text-center bg-clip-text text-transparent bg-gradient-to-r from-primary to-primary/70">Course Curriculum</h2>
        {courseModulesData.map((module, index) => (
          <div data-key={index} class="mb-12">
            <h3 class="text-2xl font-bold mb-6">Module {index + 1}: {module.title}</h3>
            <p class="text-lg text-muted-foreground mb-6">{module.description}</p>
            <CourseModuleContent client:visible lessons={module.lessons} moduleNumber={index + 1} />
          </div>
        ))}
      </div>
    </section>

    <!-- Bonuses -->
    <section class="py-20">
      <div class="container px-4 mx-auto">
        <h2 class="text-3xl lg:text-4xl font-bold text-center mb-4">Exclusive Bonuses</h2>
        <p class="text-xl text-center text-muted-foreground mb-12">
          Total Value: ${totalBonusValue.toLocaleString()}
        </p>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {bonuses.map((bonus) => (
            <Card className="card p-6">
              <div class="flex items-start gap-3">
                <div class="card-icon">
                  <CheckIcon className="w-5 h-5 text-primary" />
                </div>
                <div>
                  <h3 class="text-xl font-semibold mb-2">{bonus.title}</h3>
                  <p class="text-muted-foreground mb-4">{bonus.description}</p>
                  <p class="text-primary font-semibold">{bonus.value}</p>
                </div>
              </div>
            </Card>
          ))}
        </div>
      </div>
    </section>

    {/* FAQs Section */}
    <section class="container mx-auto px-6 py-20 border-t border-border bg-background/10 backdrop-blur-sm">
      <div class="w-full max-w-[1400px] mx-auto">
        <h2 class="text-4xl font-bold mb-10 text-center text-foreground one-animate-fade-in">
          Frequently Asked Questions
        </h2>
        <div class="one-animate-fade-in">
          <FaqAccordion client:idle faqs={faqs} />
        </div>
      </div>
    </section>

    <!-- Final CTA -->
    <section class="py-20">
      <div class="container px-4 mx-auto text-center">
        <h2 class="text-3xl lg:text-4xl font-bold mb-6">Ready to Transform Your Marketing?</h2>
        <p class="text-xl text-muted-foreground mb-8 max-w-2xl mx-auto">
          Join the AI marketing revolution and start generating more traffic, conversions, and sales in half the time.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <Button size="lg" className="text-lg">
            {courseDetails.ctaText}
            <ArrowRightIcon className="ml-2 h-5 w-5" />
          </Button>
          <Button size="lg" variant="outline" className="text-lg">
            View Course Details
          </Button>
        </div>
        <p class="text-sm text-muted-foreground mt-6">
          <ShieldCheckIcon className="inline-block w-4 h-4 mr-1" />
          {courseDetails.guarantee}
        </p>
      </div>
    </section>
  </main>
</Layout>
