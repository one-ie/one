// Calculate total bonus value
const totalBonusValue = bonuses.reduce((total, bonus) => {
  const value = parseInt(bonus.value.replace(/\$|,|\s|Value/g, ''));
  return total + value;
}, 0);
---

<Layout title={title} description={description}>
  <main class="min-h-screen bg-background relative overflow-hidden">
    <!-- Enhanced Background elements with subtle animations -->
    <div class="absolute top-0 right-0 -z-10 w-full aspect-square max-w-[1000px] opacity-30 blur-3xl bg-gradient-to-bl from-primary/20 via-primary/5 to-transparent animate-pulse-slow"></div>
    <div class="absolute bottom-0 left-0 -z-10 w-full aspect-square max-w-[1000px] opacity-20 blur-3xl bg-gradient-to-tr from-primary/20 via-primary/5 to-transparent animate-pulse-slow animation-delay-2000"></div>
    <div class="absolute inset-0 -z-10 bg-noise opacity-[0.02] mix-blend-overlay pointer-events-none"></div>
    
    <!-- Hero Section -->
    <section class="relative min-h-screen flex flex-col justify-center py-20 lg:py-32 overflow-hidden">
      <!-- Background Elements -->
      <div class="absolute inset-0 bg-grid-pattern [mask-image:linear-gradient(to_bottom,white,transparent)] pointer-events-none opacity-[0.03]"></div>
      <div class="absolute inset-0 bg-[url('/grid.svg')] bg-center [mask-image:linear-gradient(180deg,white,rgba(255,255,255,0))]"></div>
      
      <div class="container px-4 mx-auto relative @container">
        <div class="max-w-4xl mx-auto text-center">
          <!-- Social Proof Banner -->
          <div class="inline-flex items-center gap-6 px-5 py-2.5 rounded-full bg-glass border border-white/10 mb-8 animate-fade-in shadow-glass">
            <p class="text-sm text-muted-foreground">Trusted by marketers at</p>
            <div class="flex items-center gap-5">
              <img src="/logos/google.svg" alt="Google" class="h-4 opacity-70 hover:opacity-100 transition-opacity" />
              <img src="/logos/hubspot.svg" alt="HubSpot" class="h-4 opacity-70 hover:opacity-100 transition-opacity" />
              <img src="/logos/shopify.svg" alt="Shopify" class="h-4 opacity-70 hover:opacity-100 transition-opacity" />
            </div>
          </div>

          <!-- Launch Badge -->
          <Badge variant="outline" className="gap-2 px-4 py-2 text-sm font-medium rounded-full bg-glass border-white/10 mb-8 animate-fade-in [--animation-delay:200ms] shadow-glass group hover:bg-glass-hover transition-all">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-primary"></span>
            </span>
            <span>Launch Special: 72-Hour Only</span>
            <RocketIcon className="w-3.5 h-3.5 ml-1 text-primary/80 group-hover:translate-x-0.5 transition-transform" />
          </Badge>

          <!-- Main Title -->
          <h1 class="text-4xl md:text-6xl lg:text-7xl font-bold mb-6 tracking-tight text-foreground animate-fade-in [--animation-delay:400ms] leading-[1.1] gradient-heading pb-1">
            AI Marketing Revolution
          </h1>

          <!-- Subtitle -->
          <p class="text-xl md:text-2xl lg:text-3xl text-muted-foreground mb-10 animate-fade-in [--animation-delay:600ms] max-w-3xl mx-auto leading-normal">
            Generate More Traffic, Conversions, and Sales in Half the Time
          </p>

          <!-- Video Preview -->
          <div class="relative aspect-video max-w-3xl mx-auto mb-14 rounded-xl overflow-hidden animate-fade-in [--animation-delay:800ms] shadow-glass-lg border border-white/10 glass-morphism group">
            <div class="absolute inset-0 bg-gradient-to-tr from-primary/10 to-transparent"></div>
            <img src="/video-placeholder.jpg" alt="AI Marketing Revolution Preview" class="w-full h-full object-cover group-hover:scale-[1.02] transition-transform duration-700" />
            <button class="absolute inset-0 flex items-center justify-center group">
              <span class="w-20 h-20 flex items-center justify-center rounded-full bg-primary/90 text-white group-hover:bg-primary group-hover:scale-110 transition-all duration-500 shadow-xl relative z-10 before:absolute before:inset-0 before:rounded-full before:bg-primary/40 before:animate-ping-slow before:z-[-1]">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                  <polygon points="5 3 19 12 5 21 5 3" fill="currentColor" />
                </svg>
              </span>
            </button>
          </div>

          <!-- Stats Grid -->
          <div class="grid md:grid-cols-3 gap-6 mb-12 animate-fade-in [--animation-delay:1000ms]">
            <Card className="p-6 glass-card hover:glass-card-hover border-white/10 group transition-all duration-500">
              <div class="flex items-center gap-3 mb-4">
                <div class="bg-primary/10 rounded-full p-2 text-primary">
                  <TrendingUpIcon className="w-5 h-5" />
                </div>
              </div>
              <div class="text-3xl font-bold text-primary mb-2 group-hover:scale-110 group-hover:translate-y-[-2px] transition-transform duration-500">73%</div>
              <p class="text-sm text-muted-foreground">Reduction in Content Creation Time</p>
            </Card>
            <Card className="p-6 glass-card hover:glass-card-hover border-white/10 group transition-all duration-500">
              <div class="flex items-center gap-3 mb-4">
                <div class="bg-primary/10 rounded-full p-2 text-primary">
                  <ZapIcon className="w-5 h-5" />
                </div>
              </div>
              <div class="text-3xl font-bold text-primary mb-2 group-hover:scale-110 group-hover:translate-y-[-2px] transition-transform duration-500">3X</div>
              <p class="text-sm text-muted-foreground">Average Increase in Conversion Rates</p>
            </Card>
            <Card className="p-6 glass-card hover:glass-card-hover border-white/10 group transition-all duration-500">
              <div class="flex items-center gap-3 mb-4">
                <div class="bg-primary/10 rounded-full p-2 text-primary">
                  <DollarSignIcon className="w-5 h-5" />
                </div>
              </div>
              <div class="text-3xl font-bold text-primary mb-2 group-hover:scale-110 group-hover:translate-y-[-2px] transition-transform duration-500">42%</div>
              <p class="text-sm text-muted-foreground">Reduction in Ad Spend</p>
            </Card>
          </div>

          <!-- CTA Section -->
          <div class="space-y-8 animate-fade-in [--animation-delay:1200ms]">
            <!-- Timer -->
            <div class="max-w-sm mx-auto glass-pill px-6 py-3 rounded-full">
              <div class="flex items-center justify-center gap-2 text-primary mb-2">
                <ClockIcon className="w-4 h-4" />
                <p class="text-sm">Launch Special Ends In:</p>
              </div>
              <CountdownTimer targetDate={launchDate} className="mb-1" client:visible />
            </div>

            <!-- Price -->
            <div class="flex items-center justify-center gap-4 mb-6">
              <span class="text-2xl line-through text-muted-foreground opacity-70">${courseDetails.originalPrice}</span>
              <span class="text-4xl md:text-5xl font-bold text-primary relative">
                ${courseDetails.currentPrice}
                <span class="absolute -top-3 -right-3 rotate-12 text-xs bg-primary/20 text-primary px-2 py-0.5 rounded-md">
                  <HeartIcon className="w-3 h-3 inline-block mr-0.5" />Save 50%
                </span>
              </span>
            </div>

            <!-- Button -->
            <Button size="lg" className="text-lg shadow-glow relative overflow-hidden px-8 py-7 rounded-xl font-medium group">
              <span class="relative z-10 flex items-center">{courseDetails.ctaText}</span>
              <span class="absolute inset-0 bg-gradient-to-r from-primary/90 to-primary bg-[length:200%_100%] group-hover:bg-position-100 transition-[background-position] duration-500"></span>
              <span class="absolute inset-0 opacity-0 group-hover:opacity-100 bg-[radial-gradient(circle_at_center,_rgba(255,255,255,0.2)_0%,_transparent_60%)] blur-sm transition-opacity duration-500"></span>
              <ArrowRightIcon className="ml-2 h-5 w-5 group-hover:translate-x-1 transition-transform" />
            </Button>

            <!-- Trust Indicators -->
            <div class="flex flex-wrap items-center justify-center gap-6 text-sm text-muted-foreground">
              <p class="flex items-center gap-2">
                <div class="bg-primary/10 p-1.5 rounded-full">
                  <ShieldCheckIcon className="w-4 h-4 text-primary" />
                </div>
                30-Day Implementation Guarantee
              </p>
              <p class="flex items-center gap-2">
                <div class="bg-primary/10 p-1.5 rounded-full">
                  <UsersIcon className="w-4 h-4 text-primary" />
                </div>
                Only {courseDetails.spots.remaining} Spots Remaining
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Pain Points Section -->
    <section class="py-20 relative">
      <div class="absolute inset-0 bg-gradient-to-b from-transparent via-primary/5 to-transparent pointer-events-none"></div>
      <div class="container px-4 mx-auto relative @container">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-3xl lg:text-4xl font-bold text-center mb-12 gradient-heading">Are You Still Marketing the Old Way?</h2>
          <div class="grid md:grid-cols-2 gap-6">
            {[
              "Spending hours creating content that disappears into the void of page 2 (or worse)",
              "Wasting budget on ads that target the wrong people with the wrong message",
              "Manually building email campaigns that barely break industry average open rates",
              "Struggling to keep pace with competitors who seem to publish everywhere at once",
              "Watching your workload grow while your results plateau or decline",
              "Losing sleep over constantly changing algorithms and platforms"
            ].map((point) => (
              <Card className="p-6 glass-card border-white/10 hover:glass-card-hover transition-all duration-500 group">
                <div class="flex items-start gap-3">
                  <span class="text-destructive group-hover:scale-110 transition-transform">❌</span>
                  <p class="text-base text-muted-foreground">{point}</p>
                </div>
              </Card>
            ))}
          </div>
          <p class="text-center text-lg text-muted-foreground mt-10 max-w-2xl mx-auto glass-pill px-6 py-3 rounded-full mt-14 animate-fade-in animation-delay-500">
            If you nodded to any of these, you're not alone. The marketing landscape has changed dramatically, but there's a revolution happening right now that's changing everything...
          </p>
        </div>
      </div>
    </section>

    <!-- Solution Section -->
    <section class="py-20 relative before:absolute before:inset-0 before:bg-gradient-to-b before:from-transparent before:via-primary/5 before:to-transparent before:pointer-events-none">
      <div class="container px-4 mx-auto relative @container">
        <div class="max-w-4xl mx-auto text-center mb-16 animate-fade-in">
          <Badge variant="outline" className="mb-6 inline-flex gap-2 px-4 py-2 rounded-full glass-pill shadow-glass group hover:bg-glass-hover transition-all">
            <SparklesIcon className="w-4 h-4 text-primary group-hover:rotate-12 transition-transform" />
            <span>The Revolution</span>
          </Badge>
          <h2 class="text-3xl lg:text-5xl font-bold mb-6 gradient-heading">How Smart Marketers Are Using AI to Triple Their Output</h2>
          <p class="text-xl text-muted-foreground max-w-3xl mx-auto">
            Today's most successful marketers aren't working harder—they're leveraging AI to create extraordinary results with less effort.
          </p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 mb-16">
          {[
            {
              title: "Generate High-Converting Copy",
              description: "Creating emails, ads, and content that consistently outperforms human-only writing",
              icon: <span class="text-4xl">✍️</span>
            },
            {
              title: "Develop Data-Backed Strategies",
              description: "Knowing which topics will drive traffic before investing time creating them",
              icon: <TrendingUpIcon className="w-10 h-10 text-primary/80" />
            },
            {
              title: "Build Adaptive Email Sequences",
              description: "Delivering the right message at the perfect moment based on behavior",
              icon: <span class="text-4xl">📧</span>
            },
            {
              title: "Discover Hidden Keywords",
              description: "Finding high-intent, low-competition search terms that drive buying traffic",
              icon: <TargetIcon className="w-10 h-10 text-primary/80" />
            },
            {
              title: "Optimize Ad Spend",
              description: "Targeting your ideal customers with messaging that speaks directly to their needs",
              icon: <span class="text-4xl">💰</span>
            },
            {
              title: "Scale Your Impact",
              description: "Automating repetitive tasks while maintaining quality and consistency",
              icon: <RocketIcon className="w-10 h-10 text-primary/80" />
            }
          ].map((feature) => (
            <Card className="group glass-card hover:glass-card-hover border-white/10 transition-all duration-500 overflow-hidden">
              <CardHeader>
                <div class="flex items-center justify-center h-16 mb-2 group-hover:scale-110 group-hover:translate-y-[-2px] transition-transform duration-500">
                  {feature.icon}
                </div>
                <h3 class="text-xl font-semibold group-hover:text-primary transition-colors">{feature.title}</h3>
              </CardHeader>
              <CardContent>
                <p class="text-muted-foreground">{feature.description}</p>
              </CardContent>
              <div class="absolute bottom-0 left-0 right-0 h-1 bg-gradient-to-r from-primary/0 via-primary/40 to-primary/0 opacity-0 group-hover:opacity-100 transition-opacity"></div>
            </Card>
          ))}
        </div>
      </div>
    </section>

    <!-- Experience Section -->
    <section class="py-20 relative">
      <div class="container px-4 mx-auto relative @container">
        <div class="max-w-4xl mx-auto">
          <Badge variant="outline" className="mb-6 mx-auto inline-flex gap-2 px-4 py-1.5 rounded-full bg-primary/5 border-primary/20 backdrop-blur-xl">
            <StarIcon className="w-4 h-4 text-primary" />
            <span>Proven Expertise</span>
          </Badge>
          <h2 class="text-3xl lg:text-4xl font-bold text-center mb-12 gradient-heading">Learn from Someone Who's Done It</h2>
          <Card className="mb-12 p-8 border-border/30 bg-card/30 backdrop-blur-sm shadow-lg">
            <CardContent className="p-0">
              <p class="text-lg mb-6">
                After spending 15+ years in digital marketing, I watched as AI tools began transforming what was possible. While others feared these changes, I embraced them—building automated marketing systems that:
              </p>
              <ul class="space-y-4">
                <li class="flex items-start gap-3">
                  <CheckIcon className="w-5 h-5 text-primary flex-shrink-0 mt-1" />
                  <span>Reduced content creation time by 73% while improving conversion rates by 31%</span>
                </li>
                <li class="flex items-start gap-3">
                  <CheckIcon className="w-5 h-5 text-primary flex-shrink-0 mt-1" />
                  <span>Generated 6-figure email campaigns using AI-powered sequencing and personalization</span>
                </li>
                <li class="flex items-start gap-3">
                  <CheckIcon className="w-5 h-5 text-primary flex-shrink-0 mt-1" />
