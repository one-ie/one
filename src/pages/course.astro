        <div class="grid md:grid-cols-3 gap-8">
          {[
            {
              name: "Jason K.",
              role: "Digital Agency Owner",
              before: "Working 60+ hour weeks to manage campaigns for clients. Struggled to scale beyond 7 clients due to time constraints.",
