          ))}
        </div>
      </div>
    </section>

    <!-- Bonuses -->
    <section class="py-20">
      <div class="container px-4 mx-auto">
        <h2 class="text-3xl lg:text-4xl font-bold text-center mb-4">Exclusive Bonuses</h2>
        <p class="text-xl text-center text-muted-foreground mb-12">
          Total Value: ${totalBonusValue.toLocaleString()}
        </p>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {bonuses.map((bonus) => (
            <Card className="card p-6">
              <div class="flex items-start gap-3">
                <div class="card-icon">
                  <CheckIcon className="w-5 h-5 text-primary" />
                </div>
                <div>
                  <h3 class="text-xl font-semibold mb-2">{bonus.title}</h3>
                  <p class="text-muted-foreground mb-4">{bonus.description}</p>
                  <p class="text-primary font-semibold">{bonus.value}</p>
                </div>
              </div>
            </Card>
          ))}
        </div>
      </div>
    </section>

    <!-- Pricing Section -->
    <section class="py-20 relative">
      <div class="absolute inset-0 bg-gradient-to-b from-transparent via-primary/5 to-transparent pointer-events-none" />
      <div class="container px-4 mx-auto relative">
        <PricingTable
          client:visible
          originalPrice={pricingData.originalPrice}
          currentPrice={pricingData.currentPrice}
          paymentOptions={pricingData.paymentOptions}
          guarantee={pricingData.guarantee}
          guaranteeDays={pricingData.guaranteeDays}
          totalValue={pricingData.totalValue}
          valueBreakdown={pricingData.valueBreakdown}
          features={pricingData.features}
          ctaText={pricingData.ctaText}
          spots={pricingData.spots}
          deadline={pricingData.deadline}
        />
      </div>
    </section>

    <!-- FAQs Section -->
    <section class="container mx-auto px-6 py-20 border-t border-border bg-background/10 backdrop-blur-sm">
      <div class="w-full max-w-[1400px] mx-auto">
        <h2 class="text-4xl font-bold mb-10 text-center text-foreground one-animate-fade-in">
          Frequently Asked Questions
        </h2>
        <div class="one-animate-fade-in">
          <FaqAccordion client:idle faqs={faqs} />
        </div>
      </div>
    </section>

    <!-- Final CTA -->
    <section class="py-20">
      <div class="container px-4 mx-auto text-center">
        <h2 class="text-3xl lg:text-4xl font-bold mb-6">Ready to Transform Your Marketing?</h2>
        <p class="text-xl text-muted-foreground mb-8 max-w-2xl mx-auto">
          Join the AI marketing revolution and start generating more traffic, conversions, and sales in half the time.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <Button size="lg" className="text-lg">
            {courseDetails.ctaText}
            <ArrowRightIcon className="ml-2 h-5 w-5" />
          </Button>
          <Button size="lg" variant="outline" className="text-lg">
            View Course Details
          </Button>
        </div>
        <p class="text-sm text-muted-foreground mt-6">
          <ShieldCheckIcon className="inline-block w-4 h-4 mr-1" />
          {courseDetails.guarantee}
        </p>
      </div>
    </section>

    <!-- Sticky Enrollment Bar -->
    <StickyEnrollBar
      client:load
      currentPrice={pricingData.currentPrice}
      ctaText={courseDetails.ctaText}
      spots={pricingData.spots}
      deadline={pricingData.deadline}
    />
  </main>
</Layout>
