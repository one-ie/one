      { name: "SEO Optimization", value: "Rank in top search positions consistently" },
      { name: "Visual Content", value: "Design engaging visuals that increase engagement" }
    ]
  },
  {
    title: "Email Sequences That Convert",
    description: "Build powerful email automation",
    lessons: [
      { name: "Personalization", value: "Achieve 40%+ open rates with AI" },
      { name: "Subject Lines", value: "Outperform industry benchmarks consistently" },
      { name: "Behavior Triggers", value: "Send emails at perfect moments" }
    ]
  },
  {
    title: "Social Media Strategies",
    description: "Build profitable audiences",
    lessons: [
      { name: "AI Listening", value: "Identify viral trends before they explode" },
      { name: "Content Calendar", value: "Create engagement-optimized schedules" },
      { name: "Community Building", value: "Build self-sustaining sales channels" }
    ]
  },
  {
    title: "Conversational Marketing",
    description: "Close deals 24/7",
    lessons: [
      { name: "Sales Chatbots", value: "Qualify leads while you sleep" },
      { name: "Conversation Flows", value: "Convert at 3X your current rate" },
      { name: "Support AI", value: "Turn support into sales opportunities" }
    ]
  },
  {
    title: "SEO Domination Strategies",
    description: "Drive buying traffic",
    lessons: [
      { name: "Keyword Research", value: "Find untapped high-converting keywords" },
      { name: "Content Ranking", value: "Get top 3 positions within 30 days" },
      { name: "Technical SEO", value: "Double your organic traffic" }
    ]
  },
  {
    title: "Paid Advertising That Converts",
    description: "Maximize ad ROI",
    lessons: [
      { name: "AI Copy Generation", value: "Beat control versions consistently" },
      { name: "Budget Optimization", value: "Reduce CPA by up to 50%" },
      { name: "Bid Management", value: "Use 7-figure agency strategies" }
    ]
  }
];

// What you'll learn
const learningOutcomes = [
  "Generate high-converting copy in minutes, not hours",
  "Create content strategies backed by predictive data",
  "Build email sequences that adapt to each subscriber",
  "Discover untapped keywords your competitors haven't found",
  "Optimize your ad spend with precision targeting",
  "Automate 70% of your repetitive marketing tasks",
  "Scale your marketing efforts without hiring additional team members",
  "Build complete AI marketing systems that run 24/7"
];

// Bonuses
const bonuses = [
  {
    title: "AI Template Library",
    description: "100+ ready-to-use templates for every marketing function",
    value: "$997 Value"
  },
  {
    title: "The ELEVATE with AI Framework",
    description: "Our proprietary system used by 7-figure agencies",
    value: "$1,497 Value"
  },
  {
    title: "AI Automation Server with n8n",
    description: "Complete setup with pre-built workflows",
    value: "$797 Value"
  },
  {
    title: "Customizable Chatbot Templates",
    description: "Ready-to-deploy chatbots for leads and sales",
    value: "$497 Value"
  },
  {
    title: "Web Chat Integration Guide",
    description: "Add AI-powered chat to your website",
    value: "$397 Value"
  }
];

// FAQs
const faqs = [
  {
    question: "Is this course suitable for beginners to AI?",
    answer: "Absolutely! The course is specifically designed to take you from AI novice to marketing automation expert with no prior experience required. We start with the fundamentals and progress to advanced applications."
  },
  {
    question: "How quickly can I implement these strategies?",
    answer: "The course is intentionally fast-paced and designed for immediate implementation. Many students set up their first AI workflows within 24 hours of starting the course. Our step-by-step video tutorials make implementation straightforward."
  },
  {
    question: "Do I need technical experience?",
    answer: "No technical background is required. The course is designed for marketers at all technical levels, with step-by-step instructions for setting up each tool and workflow. We use n8n for automation, which has an intuitive visual interface that requires no coding."
  },
  {
    question: "How long do I have access to the course materials?",
    answer: "You receive lifetime access to all course materials, including future updates as AI tools evolve and new strategies emerge."
  },
  {
    question: "What tools will I need to purchase?",
    answer: "The course focuses on maximizing value from affordable tools. We recommend a budget of $50-100/month for essential AI tools, though many students start with even less. We provide detailed guidance on which tools provide the best ROI for your specific situation."
  },
  {
    question: "How is this different from other AI marketing courses?",
    answer: "Unlike courses that simply teach you how to use ChatGPT for marketing, this system shows you how to build integrated AI marketing ecosystems using n8n and other tools. We include ready-to-deploy chatbots, web chat integration, and automation templates that give you immediate results."
  }
];

// Calculate total bonus value
const totalBonusValue = bonuses.reduce((total, bonus) => {
  const value = parseInt(bonus.value.replace(/\$|,|\s|Value/g, ''));
  return total + value;
}, 0);
---

<Layout title={title} description={description}>
  <main class="min-h-screen bg-background">
    <HeroSection
      client:load
      title={courseDetails.title}
      subtitle={{
        regular: "Generate More ",
        gradient: "Traffic & Conversions"
      }}
      description={description}
    />

    <MeetYourMarketingTeam />

    <!-- Course Overview -->
    <section class="py-20 relative">
      <div class="absolute inset-0 bg-gradient-to-b from-transparent via-primary/5 to-transparent pointer-events-none" />
      <div class="container px-4 mx-auto relative">
        <h2 class="text-3xl lg:text-4xl font-bold text-center mb-12">What You Will Achieve</h2>
        <div class="max-w-3xl mx-auto space-y-4">
          {learningOutcomes.map((outcome) => (
            <Card className="card p-5 hover:scale-[1.02] transition-all duration-200 hover:shadow-lg hover:border-emerald-500/20">
              <div class="flex items-center gap-5">
                <div class="rounded-full bg-emerald-500/10 p-3 flex items-center justify-center shadow-inner shadow-emerald-500/5">
                  <CheckIcon className="w-5 h-5 text-emerald-500" strokeWidth={3} />
                </div>
                <p class="text-base md:text-lg font-medium">{outcome}</p>
              </div>
            </Card>
          ))}
        </div>
      </div>
    </section>

    <!-- How It Works -->
    <HowItWorks />

    <!-- Course Modules -->
    <section class="container mx-auto px-6 py-20 border-t border-border/40">
      <div class="w-full max-w-[1400px] mx-auto">
        <h2 class="text-4xl font-bold mb-10 text-center bg-clip-text text-transparent bg-gradient-to-r from-primary to-primary/70">Course Curriculum</h2>
        {courseModulesData.map((module, index) => (
          <div data-key={index} class="mb-12">
            <h3 class="text-2xl font-bold mb-6">Module {index + 1}: {module.title}</h3>
            <p class="text-lg text-muted-foreground mb-6">{module.description}</p>
            <CourseModuleContent client:visible lessons={module.lessons} moduleNumber={index + 1} />
          </div>
        ))}
      </div>
    </section>

    <!-- Bonuses -->
    <section class="py-20">
      <div class="container px-4 mx-auto">
        <h2 class="text-3xl lg:text-4xl font-bold text-center mb-4">Exclusive Bonuses</h2>
        <p class="text-xl text-center text-muted-foreground mb-12">
          Total Value: ${totalBonusValue.toLocaleString()}
        </p>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {bonuses.map((bonus) => (
            <Card className="card p-6">
              <div class="flex items-start gap-3">
                <div class="card-icon">
                  <CheckIcon className="w-5 h-5 text-primary" />
                </div>
                <div>
                  <h3 class="text-xl font-semibold mb-2">{bonus.title}</h3>
                  <p class="text-muted-foreground mb-4">{bonus.description}</p>
                  <p class="text-primary font-semibold">{bonus.value}</p>
                </div>
              </div>
            </Card>
          ))}
        </div>
      </div>
    </section>

    {/* FAQs Section */}
    <section class="container mx-auto px-6 py-20 border-t border-border bg-background/10 backdrop-blur-sm">
      <div class="w-full max-w-[1400px] mx-auto">
        <h2 class="text-4xl font-bold mb-10 text-center text-foreground one-animate-fade-in">
          Frequently Asked Questions
        </h2>
        <div class="one-animate-fade-in">
          <FaqAccordion client:idle faqs={faqs} />
        </div>
      </div>
    </section>

    <!-- Final CTA -->
    <section class="py-20">
      <div class="container px-4 mx-auto text-center">
        <h2 class="text-3xl lg:text-4xl font-bold mb-6">Ready to Transform Your Marketing?</h2>
        <p class="text-xl text-muted-foreground mb-8 max-w-2xl mx-auto">
          Join the AI marketing revolution and start generating more traffic, conversions, and sales in half the time.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <Button size="lg" className="text-lg">
            {courseDetails.ctaText}
            <ArrowRightIcon className="ml-2 h-5 w-5" />
          </Button>
          <Button size="lg" variant="outline" className="text-lg">
            View Course Details
          </Button>
        </div>
        <p class="text-sm text-muted-foreground mt-6">
          <ShieldCheckIcon className="inline-block w-4 h-4 mr-1" />
          {courseDetails.guarantee}
        </p>
      </div>
    </section>
  </main>
</Layout>
