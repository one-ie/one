                </li>
              </ul>
            </CardContent>
          </Card>

          <!-- Testimonial -->
          <Card className="p-8 border-border/30 bg-gradient-to-br from-card/50 to-card/20 backdrop-blur-lg shadow-lg">
            <CardContent className="p-0">
              <div class="absolute -top-3 -left-3 text-4xl">❝</div>
              <blockquote class="text-lg italic mb-6 pl-4">
                Working with this AI marketing system changed everything for our business. We've tripled our organic traffic in just 4 months and our email campaigns are generating 213% more revenue than before.
