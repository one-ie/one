---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from "../layouts/Layout.astro";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
import { Button } from "@/components/ui/button";
import { AccordionWrapper } from "@/components/AccordionWrapper";
import { ChatConfigSchema } from '../schema/chat';

const courses = await getCollection('courses');
console.log('Available course slugs:', courses.map((c: CollectionEntry<'courses'>) => c.slug));
console.log('Available course ids:', courses.map((c: CollectionEntry<'courses'>) => c.data.id));
const course = courses.find((c: CollectionEntry<'courses'>) => c.slug === 'elevate' || c.data.id === 'elevate');
const lessons = await getCollection('lessons');

if (!course) {
  throw new Error("No course with slug 'elevate' or id 'elevate' found in src/content/courses/. Please check your file and frontmatter.");
}

const courseLessonSlugs = course.data.lessons || [];
const courseLessons = courseLessonSlugs
  .map((slug: string) => lessons.find((lesson: CollectionEntry<'lessons'>) => lesson.slug === slug))
  .filter((lesson: CollectionEntry<'lessons'> | undefined): lesson is CollectionEntry<'lessons'> => Boolean(lesson));

const courseMetadata = {
  title: course.data.title,
  description: course.data.description,
  duration: course.data.duration,
  level: course.data.level,
  prerequisites: course.data.prerequisites || [],
  instructors: course.data.instructors || [],
};

const chatConfig = ChatConfigSchema.parse(course.data.aiConfig || {});

const lessonAccordionItems = courseLessons.map((lesson: CollectionEntry<'lessons'>) => ({
  title: lesson.data.title || lesson.slug,
  content: lesson.data.description || '',
  slug: lesson.slug
}));
---

<Layout
  title={courseMetadata.title}
  description={courseMetadata.description}
  rightPanelMode="half"
  chatConfig={chatConfig}
>
  <div class="container mx-auto px-4 py-8">
    <!-- Course Header -->
    <div class="mb-8">
      <h1 class="text-4xl font-bold mb-4">{courseMetadata.title}</h1>
      <p class="text-xl text-muted-foreground mb-6">{courseMetadata.description}</p>
      <div class="flex flex-wrap gap-4 mb-6">
        {courseMetadata.duration && (
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span>{courseMetadata.duration}</span>
          </div>
        )}
        {courseMetadata.level && (
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
            <span>{courseMetadata.level}</span>
          </div>
        )}
      </div>
      <!-- Prerequisites -->
      {courseMetadata.prerequisites.length > 0 && (
        <Card className="mb-8">
          <CardHeader>
            <CardTitle>Prerequisites</CardTitle>
          </CardHeader>
          <CardContent>
            <ul class="list-disc list-inside space-y-2">
              {courseMetadata.prerequisites.map((prereq: string) => (
                <li class="text-muted-foreground">{prereq}</li>
              ))}
            </ul>
          </CardContent>
        </Card>
      )}
    </div>

    <!-- Course Content -->
    <div class="space-y-8">
      <h2 class="text-2xl font-bold mb-4">Course Content</h2>
      <AccordionWrapper client:load items={lessonAccordionItems} />
      <div class="mt-6 grid gap-4 grid-cols-1 md:grid-cols-2 lg:grid-cols-3">
        {courseLessons.map((lesson: CollectionEntry<'lessons'>) => (
          <Card>
            <CardHeader>
              <CardTitle>
                <a href={`/lessons/${lesson.slug}`} class="hover:underline text-primary">
                  {lesson.data.title || lesson.slug}
                </a>
              </CardTitle>
            </CardHeader>
            <CardContent>
              <p class="text-muted-foreground">{lesson.data.description}</p>
            </CardContent>
          </Card>
        ))}
      </div>
    </div>

    <!-- Start Learning Button -->
    <div class="mt-8 text-center">
      <Button size="lg" className="px-8">
        Start Learning
      </Button>
    </div>
  </div>
</Layout>

<style>
  .container {
    max-width: 1200px;
  }
</style> 