---
import Layout from "../layouts/Layout.astro";
import { Button } from "../components/ui/button";
import { Badge } from "../components/ui/badge";
import { Card } from "../components/ui/card";
import { CheckIcon, ArrowRightIcon, SparklesIcon, ShieldCheckIcon, ZapIcon, StarIcon, ClockIcon, UserIcon, HeartIcon, BarChartIcon, LightbulbIcon, PlayIcon } from "lucide-react";
import { AccordionWrapper } from "../components/AccordionWrapper";
import { CourseModuleContent } from "../components/CourseModuleContent";
import { Progress } from "../components/ui/progress";
import { Separator } from "../components/ui/separator";
import { BorderBeam } from "../components/magicui/border-beam";

const title = "Build Your First AI Agent in 1 Hour";
const description = "Learn to create intelligent AI assistants that can talk to customers, generate content, and automate tasks—even if you have zero coding experience";

// Countdown timer calculation
const launchDate = new Date("April 1, 2025").getTime();
const now = new Date().getTime();
const timeRemaining = Math.max(0, launchDate - now);
const days = Math.floor(timeRemaining / (1000 * 60 * 60 * 24));
const hours = Math.floor((timeRemaining % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
const minutes = Math.floor((timeRemaining % (1000 * 60 * 60)) / (1000 * 60));

// Course details
const courseDetails = {
  badge: "Launch Special: One-Time Payment",
  title: "Build Your First AI Agent in 1 Hour",
  subtitle: "Create intelligent AI assistants that work for your business 24/7",
  originalPrice: "197",
  currentPrice: "100",
  guarantee: "30-Day 100% Money-Back Guarantee",
  ctaText: "Reserve Your Spot Now",
  valueProposition: "No coding required. Just follow along and have a working AI agent in 60 minutes.",
  spots: {
    total: 100,
    remaining: 37
  },
  launchDate: "April 1, 2025"
};

// Course modules data - simplified for 1-hour course
const courseModulesData = [
  {
    title: "Setup & Foundation (15 minutes)",
    description: "Get everything ready quickly",
    lessons: [
      { name: "AI Platform Setup", value: "Connect to OpenAI or Claude in 5 minutes" },
      { name: "Agent Structure", value: "The 3-part framework for effective agents" },
      { name: "Environment Configuration", value: "Set up your workspace for success" }
    ]
  },
  {
    title: "Agent Intelligence Design (20 minutes)",
    description: "Make your AI smart and effective",
    lessons: [
      { name: "Prompt Engineering", value: "Create clear instructions your AI will follow" },
      { name: "Knowledge Integration", value: "Teach your AI about your business" },
      { name: "Personality Design", value: "Give your AI a consistent voice and style" }
    ]
  },
  {
    title: "Conversation & Task Design (15 minutes)",
    description: "Help your AI handle real conversations",
    lessons: [
      { name: "Conversation Flows", value: "Design natural discussion patterns" },
      { name: "Task Completion", value: "Enable your AI to finish specific jobs" },
      { name: "Error Handling", value: "Prevent and manage mistakes gracefully" }
    ]
  },
  {
    title: "Testing & Deployment (10 minutes)",
    description: "Get your AI working in the real world",
    lessons: [
      { name: "Test Scenarios", value: "Verify your agent works as expected" },
      { name: "Quick Deployment", value: "Make your agent available immediately" },
      { name: "Usage Guidance", value: "Learn how to interact with your agent" }
    ]
  }
];

// Benefits - focused on immediate ROI for a $100 course
const benefits = [
  { title: "Just 60 Minutes", icon: ClockIcon, description: "Go from zero to working AI agent in one hour flat" },
  { title: "Zero Coding Required", icon: CheckIcon, description: "If you can type, you can create an AI agent" },
  { title: "Immediate ROI", icon: SparklesIcon, description: "Automate tasks that would cost $500+ to outsource" },
  { title: "Ready-To-Use Templates", icon: ZapIcon, description: "Copy-paste solutions for common business needs" },
  { title: "Step-By-Step System", icon: UserIcon, description: "Never get lost with our clear, beginner-friendly guide" },
  { title: "Lifetime Updates", icon: ShieldCheckIcon, description: "Get all future improvements at no extra cost" }
];

// Fast-action bonuses
const bonuses = [
  {
    title: "Premium Prompt Library",
    value: "$49 Value",
    description: "50+ proven prompts for customer service, content creation, and sales"
  },
  {
    title: "30-Day Community Access",
    value: "$79 Value",
    description: "Get help and feedback from AI experts and fellow creators"
  },
  {
    title: "AI Agent Templates Pack",
    value: "$39 Value",
    description: "5 ready-to-deploy agent templates for common business needs"
  }
];

// Testimonials
const testimonials = [
  {
    name: "David Chen",
    role: "E-commerce Store Owner",
    content: "I had zero tech skills but followed the course step by step and had my customer service AI agent running in 45 minutes. It now handles 80% of customer questions automatically!"
  },
  {
    name: "Maria Rodriguez",
    role: "Marketing Consultant",
    content: "This course delivered exactly what it promised. I built my content creation AI in an hour, and it's already saved me 15+ hours of work in the first week alone."
  },
  {
    name: "James Wilson",
    role: "Small Business Owner",
    content: "The templates alone are worth the price. I was skeptical about the '1 hour' claim, but I actually finished in 52 minutes and had my AI booking appointments immediately."
  }
];

// FAQ items
const faqs = [
  {
    title: "Do I need coding experience?",
    content: "Absolutely not. This course is specifically designed for non-technical people. If you can use a computer and follow simple instructions, you can build an AI agent."
  },
  {
    title: "Will this really only take 1 hour?",
    content: "Yes! We've stripped away all the complexity and created a step-by-step system that takes exactly 60 minutes to complete. Many students finish even faster."
  },
  {
    title: "What kind of AI agent can I build?",
    content: "You can build customer service agents, content creation assistants, sales agents, appointment schedulers, and more. The course includes templates for all these use cases."
  },
  {
    title: "Are there any additional costs?",
    content: "The only potential additional cost is if you choose to use OpenAI's API, which starts at approximately $0.50-$2 per day depending on usage. We also cover free alternatives."
  },
  {
    title: "What if I get stuck?",
    content: "The course includes access to our community where you can get help. We also offer email support for any technical issues you might encounter."
  },
  {
    title: "What's your refund policy?",
    content: "We offer a 30-day, 100% money-back guarantee. If you're not satisfied for any reason, just email us for a full refund, no questions asked."
  }
];
---

<Layout title={title} description={description}>
  <div class="relative overflow-hidden bg-[#111111]">
    <!-- Hero Section Background Elements -->
    <div class="absolute inset-0 overflow-hidden">
      <!-- Animated gradient orbs -->
      <div class="absolute top-[10%] left-[15%] w-[600px] h-[600px] rounded-full bg-gradient-to-r from-[#1a1a1a]/30 to-[#222222]/30 blur-[120px] animate-float"></div>
      <div class="absolute top-[40%] right-[10%] w-[500px] h-[500px] rounded-full bg-gradient-to-l from-[#222222]/30 to-[#1a1a1a]/30 blur-[100px] animate-float-delay"></div>
      <div class="absolute bottom-[5%] left-[25%] w-[400px] h-[400px] rounded-full bg-gradient-to-tr from-[#1a1a1a]/30 to-[#222222]/30 blur-[80px] animate-float-slow"></div>
      
      <!-- Grid pattern overlay -->
      <div class="absolute inset-0 bg-[url('/grid-pattern.svg')] bg-center opacity-[0.03]"></div>
    </div>
    
    <!-- Hero Section -->
    <section class="relative pt-20 pb-32 md:pt-32 md:pb-40 overflow-hidden">
      <div class="max-w-7xl mx-auto px-6 lg:px-8">
        <div class="grid lg:grid-cols-2 gap-16 lg:gap-20 items-center">
          <!-- Left Column: Course Info -->
          <div class="space-y-8 max-w-2xl">
            <div>
              <div class="inline-flex items-center px-3 py-1.5 rounded-full bg-[#1a1a1a] border border-[#333333] mb-6">
                <span class="text-[#aaaaaa] text-sm font-medium">{courseDetails.badge}</span>
              </div>
              
              <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight text-white leading-tight mb-6">
                <span class="bg-clip-text text-transparent bg-gradient-to-r from-[#cccccc] to-white">
                  {courseDetails.title}
                </span>
              </h1>
              
              <p class="text-xl md:text-2xl text-[#aaaaaa] leading-relaxed">
                {courseDetails.subtitle}
              </p>
            </div>
            
            <div class="space-y-4">
              {benefits.slice(0, 3).map((benefit) => (
                <div class="flex items-start">
                  <div class="w-6 h-6 rounded-full bg-[#222222] border border-[#333333] flex items-center justify-center mr-3 flex-shrink-0">
                    <CheckIcon className="w-3.5 h-3.5 text-[#aaaaaa]" />
                  </div>
                  <p class="text-lg text-[#aaaaaa]">{benefit.description}</p>
                </div>
              ))}
            </div>
            
            <!-- Countdown Timer -->
            <div class="pt-4">
              <p class="text-[#888888] mb-4">Launching in:</p>
              <div class="flex space-x-4">
                <div class="bg-[#1a1a1a] border border-[#333333] p-3 rounded-xl text-center min-w-[80px]">
                  <div class="text-3xl font-bold text-white">{days}</div>
                  <div class="text-sm text-[#777777]">Days</div>
                </div>
                <div class="bg-[#1a1a1a] border border-[#333333] p-3 rounded-xl text-center min-w-[80px]">
                  <div class="text-3xl font-bold text-white">{hours}</div>
                  <div class="text-sm text-[#777777]">Hours</div>
                </div>
                <div class="bg-[#1a1a1a] border border-[#333333] p-3 rounded-xl text-center min-w-[80px]">
                  <div class="text-3xl font-bold text-white">{minutes}</div>
                  <div class="text-sm text-[#777777]">Minutes</div>
                </div>
              </div>
            </div>
          </div>
          
          <!-- Right Column: Pricing Card -->
          <div class="relative">
            <!-- Card glow effect -->
            <div class="absolute -inset-1 bg-gradient-to-r from-[#222222] via-[#333333] to-[#222222] rounded-2xl blur-lg opacity-70"></div>
            
            <div class="relative bg-[#1a1a1a] border border-[#333333] rounded-2xl p-8 md:p-10 shadow-xl">
              <div class="text-center mb-8">
                <div class="text-[#888888] mb-3">One-time payment</div>
                <div class="flex items-center justify-center">
                  <span class="text-[#666666] text-2xl line-through mr-3">${courseDetails.originalPrice}</span>
                  <span class="text-5xl font-bold text-white">${courseDetails.currentPrice}</span>
                </div>
                <div class="text-[#888888] mt-3">{courseDetails.guarantee}</div>
              </div>
              
              <!-- Progress bar for remaining spots -->
              <div class="mb-8">
                <div class="flex justify-between text-sm mb-2">
                  <span class="text-[#888888]">Spots remaining</span>
                  <span class="text-[#aaaaaa] font-medium">{courseDetails.spots.remaining}/{courseDetails.spots.total}</span>
                </div>
                <Progress 
                  value={100 - (courseDetails.spots.remaining / courseDetails.spots.total * 100)} 
                  className="h-2 bg-[#222222]"
                  indicatorClassName="bg-[#444444]"
                />
              </div>
              
              <!-- What you get -->
              <div class="space-y-4 mb-8">
                <h3 class="text-lg font-medium text-white">What you'll get:</h3>
                <ul class="space-y-3">
                  {courseModulesData.map((module) => (
                    <li class="flex items-start">
                      <div class="w-5 h-5 rounded-full bg-[#222222] border border-[#333333] flex items-center justify-center mr-3 flex-shrink-0 mt-0.5">
                        <CheckIcon className="w-3 h-3 text-[#aaaaaa]" />
                      </div>
                      <div>
                        <p class="text-[#dddddd]">{module.title}</p>
                        <p class="text-sm text-[#777777]">{module.description}</p>
                      </div>
                    </li>
                  ))}
                </ul>
              </div>
              
              <!-- Bonuses -->
              <div class="space-y-4 mb-8">
                <h3 class="text-lg font-medium text-white">Bonuses:</h3>
                <ul class="space-y-3">
                  {bonuses.map((bonus) => (
                    <li class="flex items-start">
                      <div class="w-5 h-5 rounded-full bg-[#222222] border border-[#333333] flex items-center justify-center mr-3 flex-shrink-0 mt-0.5">
                        <SparklesIcon className="w-3 h-3 text-[#aaaaaa]" />
                      </div>
                      <div>
                        <div class="flex items-center">
                          <p class="text-[#dddddd]">{bonus.title}</p>
                          <span class="ml-2 text-xs px-2 py-0.5 rounded-full bg-[#222222] text-[#aaaaaa]">{bonus.value}</span>
                        </div>
                        <p class="text-sm text-[#777777]">{bonus.description}</p>
                      </div>
                    </li>
                  ))}
                </ul>
              </div>
              
              <!-- CTA Button -->
              <div class="relative group">
                <!-- Button glow effect -->
                <div class="absolute -inset-1 bg-gradient-to-r from-[#333333] to-[#444444] rounded-lg blur opacity-30 group-hover:opacity-100 transition duration-1000 group-hover:duration-200"></div>
                
                <a 
                  href="/join-waitlist" 
                  class="relative flex items-center justify-center w-full px-8 py-4 rounded-lg bg-[#222222] text-white font-medium text-lg shadow-lg hover:shadow-xl transition-all duration-300 hover:bg-[#2a2a2a] active:scale-[0.98] group"
                >
                  <span>{courseDetails.ctaText}</span>
                  <ArrowRightIcon className="ml-2 w-5 h-5 group-hover:translate-x-1 transition-transform duration-300" />
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
    
    <!-- Course Content Section -->
    <section class="py-24 md:py-32 relative bg-[#0e0e0e]">
      <div class="absolute inset-0 bg-gradient-to-b from-[#111111] to-transparent h-32"></div>
      <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-[#111111] to-transparent h-32"></div>
      
      <div class="relative max-w-7xl mx-auto px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <h2 class="text-3xl md:text-4xl font-bold mb-6 text-white">What You'll Learn in Just 60 Minutes</h2>
          <p class="text-xl text-[#aaaaaa]">
            A step-by-step system to create your own AI agent without any coding or technical skills
          </p>
        </div>
        
        <div class="grid md:grid-cols-2 gap-8 lg:gap-12">
          {courseModulesData.map((module, index) => (
            <div class="bg-[#1a1a1a] border border-[#333333] rounded-2xl p-8 transition-all duration-300 hover:shadow-lg hover:shadow-black/20">
              <div class="flex items-center mb-6">
                <div class="w-12 h-12 rounded-full bg-[#222222] border border-[#333333] flex items-center justify-center text-white font-bold text-xl mr-4">
                  {index + 1}
                </div>
                <div>
                  <h3 class="text-xl font-medium text-white">{module.title}</h3>
                  <p class="text-[#888888]">{module.description}</p>
                </div>
              </div>
              
              <ul class="space-y-4">
                {module.lessons.map((lesson) => (
                  <li class="flex items-start">
                    <div class="w-5 h-5 rounded-full bg-[#222222] border border-[#333333] flex items-center justify-center mr-3 flex-shrink-0 mt-0.5">
                      <CheckIcon className="w-3 h-3 text-[#aaaaaa]" />
                    </div>
                    <div>
                      <p class="text-[#dddddd]">{lesson.name}</p>
                      <p class="text-sm text-[#777777]">{lesson.value}</p>
                    </div>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>
    
    <!-- Benefits Section -->
    <section class="py-24 md:py-32 relative">
      <div class="relative max-w-7xl mx-auto px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <h2 class="text-3xl md:text-4xl font-bold mb-6 text-white">Why This Course Is Different</h2>
          <p class="text-xl text-[#aaaaaa]">
            Designed specifically for non-technical people who want results fast
          </p>
        </div>
        
        <div class="grid md:grid-cols-3 gap-8">
          {benefits.map((benefit) => (
            <div class="bg-[#1a1a1a] border border-[#333333] rounded-2xl p-8 transition-all duration-300 hover:shadow-lg hover:shadow-black/20">
              <div class="w-12 h-12 rounded-full bg-[#222222] border border-[#333333] flex items-center justify-center mb-6">
                <benefit.icon className="w-6 h-6 text-[#aaaaaa]" />
              </div>
              <h3 class="text-xl font-medium text-white mb-3">{benefit.title}</h3>
              <p class="text-[#888888]">{benefit.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
    
    <!-- Testimonials -->
    <section class="py-24 md:py-32 relative bg-[#0e0e0e]">
      <div class="absolute inset-0 bg-gradient-to-b from-[#111111] to-transparent h-32"></div>
      <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-[#111111] to-transparent h-32"></div>
      
      <div class="relative max-w-7xl mx-auto px-6 lg:px-8">
        <h2 class="text-3xl md:text-4xl font-bold mb-16 text-center text-white">What Our Students Are Saying</h2>
        
        <div class="grid md:grid-cols-3 gap-8 lg:gap-10">
          {testimonials.map((testimonial) => (
            <div class="bg-[#1a1a1a] border border-[#333333] rounded-2xl p-8 transition-all duration-300 hover:shadow-lg hover:shadow-black/20 flex flex-col h-full">
              <div class="flex-1 mb-6">
                <div class="flex items-center mb-6">
                  {[1, 2, 3, 4, 5].map(() => (
                    <StarIcon className="w-5 h-5 text-[#aaaaaa] fill-[#aaaaaa] mr-1" />
                  ))}
                </div>
                <p class="mb-6 text-[#aaaaaa] italic leading-relaxed">"{testimonial.content}"</p>
              </div>
              <div class="flex items-center">
                <div class="w-12 h-12 rounded-full bg-[#222222] border border-[#333333] flex items-center justify-center text-white font-bold text-lg mr-4">
                  {testimonial.name.charAt(0)}
                </div>
                <div>
                  <div class="font-medium text-white">{testimonial.name}</div>
                  <div class="text-[#777777]">{testimonial.role}</div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="py-24 md:py-32">
      <div class="max-w-3xl mx-auto px-6 lg:px-8">
        <h2 class="text-3xl md:text-4xl font-bold mb-16 text-center text-white">Frequently Asked Questions</h2>
        <div class="bg-[#1a1a1a] border border-[#333333] rounded-2xl p-8 shadow-xl">
          <AccordionWrapper items={faqs} client:visible />
        </div>
      </div>
    </section>

    <!-- Final CTA -->
    <section class="py-24 md:py-32 relative">
      <!-- Background elements -->
      <div class="absolute top-0 left-0 w-full h-full overflow-hidden">
        <div class="absolute top-0 left-[20%] w-[600px] h-[600px] rounded-full bg-gradient-to-r from-[#1a1a1a]/30 to-[#222222]/30 blur-[100px] animate-float"></div>
        <div class="absolute bottom-0 right-[10%] w-[500px] h-[500px] rounded-full bg-gradient-to-l from-[#222222]/30 to-[#1a1a1a]/30 blur-[100px] animate-float-delay"></div>
      </div>
      
      <div class="relative max-w-4xl mx-auto px-6 lg:px-8 text-center">
        <div class="bg-[#1a1a1a] border border-[#333333] rounded-2xl p-10 md:p-16 shadow-xl relative overflow-hidden">
          <!-- Decorative elements -->
          <div class="absolute top-0 right-0 w-64 h-64 bg-gradient-to-r from-[#222222]/20 to-[#333333]/20 rounded-full transform translate-x-32 -translate-y-32 blur-3xl"></div>
          <div class="absolute bottom-0 left-0 w-48 h-48 bg-gradient-to-l from-[#222222]/20 to-[#333333]/20 rounded-full transform -translate-x-24 translate-y-24 blur-3xl"></div>
          
          <h2 class="text-3xl md:text-4xl font-bold mb-6 text-white relative z-10">Ready to Build Your First AI Agent?</h2>
          <p class="text-xl text-[#aaaaaa] mb-10 relative z-10">
            Join the waitlist today and be first in line when we launch on {courseDetails.launchDate}.
          </p>
          
          <div class="relative inline-block group">
            <!-- Button glow effect -->
            <div class="absolute -inset-1 bg-gradient-to-r from-[#333333] to-[#444444] rounded-lg blur opacity-30 group-hover:opacity-100 transition duration-1000 group-hover:duration-200"></div>
            
            <a 
              href="/join-waitlist" 
              class="relative inline-flex items-center justify-center px-12 py-6 rounded-lg bg-[#222222] text-white font-medium text-xl shadow-lg hover:shadow-xl transition-all duration-300 hover:bg-[#2a2a2a] active:scale-[0.98] group"
            >
              <span>Join the Waitlist</span>
              <ArrowRightIcon className="ml-3 w-6 h-6 group-hover:translate-x-1 transition-transform duration-300" />
            </a>
          </div>
          
          <p class="mt-8 text-[#777777] relative z-10">
            Only {courseDetails.spots.remaining} spots remaining for the first cohort.
          </p>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  /* Animation utilities */
  .animate-float {
    animation: float 8s ease-in-out infinite;
  }
  
  .animate-float-delay {
    animation: float 10s ease-in-out 2s infinite;
  }
  
  .animate-float-slow {
    animation: float 12s ease-in-out 1s infinite;
  }
  
  @keyframes float {
    0%, 100% {
      transform: translateY(0) scale(1);
      opacity: 0.5;
    }
    50% {
      transform: translateY(-20px) scale(1.05);
      opacity: 0.3;
    }
  }
</style>


