---
import Layout from '@/layouts/Layout.astro';
import { GroupCreateForm } from '@/components/groups/GroupCreateForm';

export const prerender = false;

// Check if user is authenticated
const user = Astro.locals.user;

if (!user) {
  return Astro.redirect('/account/signin?redirect=/group/new/create');
}

const { slug } = Astro.params;
---

<Layout title="Create Group">
  <div class="mx-auto max-w-2xl space-y-8">
    <div class="space-y-2">
      <h1 class="text-4xl font-bold tracking-tight">Create a new group</h1>
      <p class="text-lg text-muted-foreground">
        Groups help you organize teams, communities, and organizations with isolated data and
        hierarchical structure.
      </p>
    </div>

    <GroupCreateForm client:load user={user} parentSlug={slug === 'new' ? undefined : slug} />
  </div>
</Layout>
