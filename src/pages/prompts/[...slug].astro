---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Docs.astro';
import type { CollectionEntry } from 'astro:content';
import { Badge } from '@/components/ui/badge';
import { ChevronLeft, ChevronRight } from 'lucide-react';

export const prerender = true;

export async function getStaticPaths() {
  const prompts = await getCollection('prompts');
  const sortedPrompts = prompts.sort((a: CollectionEntry<'prompts'>, b: CollectionEntry<'prompts'>) => {
    const dateA = a.data.date ? new Date(a.data.date).getTime() : 0;
    const dateB = b.data.date ? new Date(b.data.date).getTime() : 0;
    return dateB - dateA;
  });
  
  return sortedPrompts.map((entry: CollectionEntry<'prompts'>, index: number) => {
    const prev = index < sortedPrompts.length - 1 ? sortedPrompts[index + 1] : null;
    const next = index > 0 ? sortedPrompts[index - 1] : null;
    return {
      params: { slug: entry.slug },
      props: { entry, prev, next },
    };
  });
}

type Props = {
  entry: CollectionEntry<'prompts'>;
  prev: CollectionEntry<'prompts'> | null;
  next: CollectionEntry<'prompts'> | null;
};

const { entry, prev, next } = Astro.props;
const { Content } = await entry.render();

// Function to create tag URL
function createTagUrl(tag: string): string {
  return `/prompts?tag=${encodeURIComponent(tag)}`;
}
---

<Layout
  title={`${entry.data.title} - Prompts`}
  description={entry.data.description}
>
  <div class="max-w-3xl mx-auto px-4">
    <article>
      <header class="mb-8">
        <h1 class="text-4xl font-bold mb-6 text-foreground">
          {entry.data.title}
        </h1>
        
        {entry.data.description && (
          <p class="text-lg text-muted-foreground mb-6 leading-relaxed">
            {entry.data.description}
          </p>
        )}
        
        {entry.data.image && (
          <div class="mb-6 rounded-lg overflow-hidden border border-border">
            <img 
              src={entry.data.image} 
              alt={entry.data.title || 'Prompt image'} 
              class="w-full h-auto max-h-96 object-cover"
            />
          </div>
        )}
        
        <div class="flex flex-wrap gap-2 mb-6">
          {entry.data.tags?.map((tag: string) => (
            <a href={createTagUrl(tag)} class="no-underline">
              <Badge variant="secondary" className="hover:bg-primary/10 hover:text-primary transition-colors cursor-pointer">
                {tag}
              </Badge>
            </a>
          ))}
        </div>
      </header>
      <div class="prose prose-neutral dark:prose-invert max-w-none [&_pre]:bg-muted">
        <Content />
      </div>
    </article>

    <!-- Navigation Section -->
    <nav class="mt-12 mb-8 border-t border-border pt-8">
      <div class="flex justify-between items-center gap-4">
        {prev && (
          <a
            href={`/prompts/${prev.slug}`}
            class="group flex items-center gap-2 text-muted-foreground hover:text-foreground transition-colors"
          >
            <ChevronLeft className="w-4 h-4 transition-transform group-hover:-translate-x-1" />
            <div class="flex flex-col">
              <span class="text-xs uppercase tracking-wider">Previous</span>
              <span class="text-sm font-medium">{prev.data.title}</span>
            </div>
          </a>
        )}
        {next && (
          <a
            href={`/prompts/${next.slug}`}
            class="group flex items-center gap-2 text-muted-foreground hover:text-foreground transition-colors ml-auto"
          >
            <div class="flex flex-col items-end">
              <span class="text-xs uppercase tracking-wider">Next</span>
              <span class="text-sm font-medium">{next.data.title}</span>
            </div>
            <ChevronRight className="w-4 h-4 transition-transform group-hover:translate-x-1" />
          </a>
        )}
      </div>
    </nav>
  </div>
</Layout>