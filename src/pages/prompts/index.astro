---
import Layout from "../../layouts/Docs.astro";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { Card } from "@/components/ui/card";
import { Badge } from "@/components/ui/badge";
import { Input } from "@/components/ui/input";
import {
  StarIcon,
  LightningBoltIcon,
  MagnifyingGlassIcon,
  ChatBubbleIcon,
  LayersIcon
} from "@radix-ui/react-icons";
import {
  Grid2x2,
  Grid3x3, 
  Search,
  List,
  Table,
  Grid,
  Tag,
  Folder,
  Zap,
  MessageSquare,
  Sparkles,
  BookText
} from "lucide-react";
import { ChatConfigSchema } from '../../schema/chat';

// Type definitions
type PromptEntry = CollectionEntry<'prompts'>;

// Special category ordering and structure
const categoryStructure: Record<string, {
  order: number;
  subcategories: string[];
  icon: any;
  description: string;
}> = {
  'Foundation': {
    order: 1,
    subcategories: ['company', 'market', 'customer'],
    icon: LayersIcon,
    description: 'Core business foundation prompts'
  },
  'Hook': {
    order: 2,
    subcategories: [],
    icon: Zap,
    description: 'Attention-grabbing engagement prompts'
  },
  'Gift': {
    order: 3,
    subcategories: [],
    icon: Sparkles,
    description: 'Value creation and offering prompts'
  },
  'Identify': {
    order: 4,
    subcategories: [],
    icon: Search,
    description: 'Customer identification and segmentation'
  },
  'Engage': {
    order: 5,
    subcategories: [],
    icon: MessageSquare,
    description: 'Customer engagement strategies'
  },
  'Sell': {
    order: 6,
    subcategories: [],
    icon: LightningBoltIcon,
    description: 'Sales and conversion prompts'
  },
  'Nurture': {
    order: 7,
    subcategories: [],
    icon: StarIcon,
    description: 'Customer relationship nurturing'
  },
  'Upsell': {
    order: 8,
    subcategories: [],
    icon: Zap,
    description: 'Upselling and expansion prompts'
  },
  'Educate': {
    order: 9,
    subcategories: [],
    icon: BookText,
    description: 'Educational content creation'
  },
  'Share': {
    order: 10,
    subcategories: [],
    icon: Grid3x3,
    description: 'Viral and shareable content'
  }
};

// Get view preference from URL or default to grid3 view (better for prompts)
const viewMode = (Astro.url.searchParams.get("view") || "grid3") as
    | "list"
    | "compact"
    | "grid1"
    | "grid2"
    | "grid3"
    | "grid4";

// Get all prompts entries
const entries = (await getCollection("prompts")) as PromptEntry[];

// Get search query from URL
const searchQuery = Astro.url.searchParams.get("search")?.toLowerCase() || '';

// Get tag filter from URL
const tagFilter = Astro.url.searchParams.get("tag")?.toLowerCase() || '';

// Get category filter from URL
const categoryFilter = Astro.url.searchParams.get("category")?.toLowerCase() || '';

// Get sort option from URL
const sortBy = Astro.url.searchParams.get("sort") || 'custom';

// Filter entries by search query, tag, or category
const filteredEntries = searchQuery || tagFilter || categoryFilter
  ? entries.filter((entry: PromptEntry) => {
      const title = entry.data.title?.toLowerCase() || '';
      const description = entry.data.description?.toLowerCase() || '';
      const tags = entry.data.tags?.map((t: string) => t.toLowerCase()) || [];
      
      // If category filter is present, filter by matching tags
      if (categoryFilter) {
        return tags.includes(categoryFilter);
      }
      
      // If tag filter is present, it takes precedence over search
      if (tagFilter) {
        return tags.includes(tagFilter);
      }
      
      // Otherwise use search query
      return title.includes(searchQuery) || 
             description.includes(searchQuery) || 
             tags.some((tag: string) => tag.includes(searchQuery));
    })
  : entries;

// Group prompts by their tags that match our categories
const categorizedPrompts: Record<string, PromptEntry[]> = {};

// Initialize all categories
Object.keys(categoryStructure).forEach(category => {
  categorizedPrompts[category] = [];
});

// Assign prompts to categories based on their tags
filteredEntries.forEach((entry: PromptEntry) => {
  const tags = entry.data.tags?.map((t: string) => t.toLowerCase()) || [];
  
  // Special handling for Foundation subcategories
  if (tags.includes('company') || tags.includes('market') || tags.includes('customer')) {
    if (!categorizedPrompts['Foundation']) {
      categorizedPrompts['Foundation'] = [];
    }
    categorizedPrompts['Foundation'].push(entry);
  }
  
  // Check for other category tags
  Object.keys(categoryStructure).forEach(category => {
    if (category !== 'Foundation' && tags.includes(category.toLowerCase())) {
      categorizedPrompts[category].push(entry);
    }
  });
  
  // If no matching category tag, add to "Other"
  const hasCategory = Object.keys(categoryStructure).some(cat => 
    tags.includes(cat.toLowerCase()) || 
    (cat === 'Foundation' && (tags.includes('company') || tags.includes('market') || tags.includes('customer')))
  );
  
  if (!hasCategory) {
    if (!categorizedPrompts['Other']) {
      categorizedPrompts['Other'] = [];
    }
    categorizedPrompts['Other'].push(entry);
  }
});

// Sort prompts within each category
Object.keys(categorizedPrompts).forEach(category => {
  categorizedPrompts[category].sort((a: PromptEntry, b: PromptEntry) => {
    if (sortBy === 'title') {
      return a.data.title.localeCompare(b.data.title);
    } else if (sortBy === 'date') {
      return new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
    }
    // Default: keep original order
    return 0;
  });
});

// Create ordered categories based on our structure
const orderedCategories: Record<string, PromptEntry[]> = {};
Object.entries(categoryStructure)
  .sort(([_a, infoA], [_b, infoB]) => infoA.order - infoB.order)
  .forEach(([category, _info]) => {
    if (categorizedPrompts[category] && categorizedPrompts[category].length > 0) {
      orderedCategories[category] = categorizedPrompts[category];
    }
  });

// Don't add "Other" category

// Configure AI assistant for prompts
const chatConfig = ChatConfigSchema.parse({
  systemPrompt: [{
    type: "text" as const,
    text: `You are an AI prompt expert, helping users discover and understand specialized prompts. Focus on:
- Explaining prompt techniques and best practices
- Recommending prompts for specific use cases
- Helping users customize prompts for their needs
- Providing guidance on effective prompt engineering`
  }],
  welcome: {
    message: "🎯 Looking for the perfect prompt? I can help you find it!",
    avatar: "/icon.svg",
    suggestions: [
      {
        label: "🔍 Find Prompts",
        prompt: "Help me find prompts for content creation"
      },
      {
        label: "✨ Customize Prompt",
        prompt: "How can I customize this prompt for my specific needs?"
      },
      {
        label: "📝 Prompt Tips",
        prompt: "What are some best practices for writing effective prompts?"
      }
    ]
  }
});

// Get appropriate icon based on category name
function getCategoryIcon(category: string) {
  const categoryInfo = categoryStructure[category as keyof typeof categoryStructure];
  if (categoryInfo && categoryInfo.icon) {
    return categoryInfo.icon;
  }
  
  // Fallback for "Other" or unknown categories
  switch (category.toLowerCase()) {
    case 'other':
      return Folder;
    default:
      return ChatBubbleIcon;
  }
}

// Format category name for display
function formatCategoryName(category: string): string {
  return category
    .split(' ')
    .map(word => word.charAt(0).toUpperCase() + word.slice(1))
    .join(' ');
}

// Function to create tag URL
function createTagUrl(tag: string): string {
  return `/prompts?tag=${encodeURIComponent(tag)}`;
}

// Function to create category URL
function createCategoryUrl(category: string): string {
  return `/prompts?category=${encodeURIComponent(category)}`;
}
---

<Layout
  title="AI Prompts - Collection of Specialized Assistants"
  description="Browse our collection of specialized AI prompts for different tasks and purposes"
  chatConfig={chatConfig}
  rightPanelMode="quarter"
>
  <div class="max-w-full px-3 sm:px-4 pt-4 pb-2">
    {/* Prompts Heading */}
    <div class="relative mb-8 pt-4">
      <div class="max-w-5xl mx-auto">
        <div class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-foreground via-foreground/95 to-foreground/90 p-6 md:p-8 shadow-lg">
          <div class="absolute inset-0 bg-gradient-to-br from-primary/20 via-transparent to-primary/10"></div>
          <div class="relative text-center">
            <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-background mb-3 tracking-tight leading-none">
              Prompts
            </h1>
            <p class="text-base md:text-lg text-background/80 max-w-2xl mx-auto font-medium">
              Master every stage of business growth with our specialized AI prompts
            </p>
          </div>
        </div>
      </div>
    </div>
    
    {/* Header with Search, Sort, and View Toggles */}
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-8 bg-muted/40 rounded-2xl p-5 border border-border/50">
      
      <div class="flex flex-col sm:flex-row gap-2 w-full md:w-auto">
        {/* Search Input */}
        <form class="relative w-full sm:w-64 md:w-80" method="GET" action="/prompts">
          <Search className="absolute left-2.5 top-2.5 h-4 w-4 text-muted-foreground" />
          <Input 
            type="search" 
            name="search" 
            placeholder="Search prompts..." 
            className="pl-9 h-9 w-full bg-muted/40 focus:bg-background"
            value={searchQuery}
          />
          {viewMode !== "grid3" && <input type="hidden" name="view" value={viewMode} />}
          {sortBy !== "date" && <input type="hidden" name="sort" value={sortBy} />}
          {categoryFilter && <input type="hidden" name="category" value={categoryFilter} />}
          <button type="submit" class="sr-only">Search</button>
        </form>
        
        {/* Sort Dropdown */}
        <select 
          name="sort" 
          class="h-9 px-3 rounded-md border border-input bg-muted/40 text-sm hover:bg-muted/60 transition-colors"
          onchange="window.location.href = updateURL('sort', this.value)"
        >
          <option value="custom" selected={sortBy === 'custom'}>Custom Order</option>
          <option value="title" selected={sortBy === 'title'}>Alphabetical</option>
        </select>
        
        <div class="flex gap-1 bg-muted/50 p-0.5 rounded-lg">
          <a
            href={`?view=list${searchQuery ? `&search=${searchQuery}` : ''}${tagFilter ? `&tag=${tagFilter}` : ''}${categoryFilter ? `&category=${categoryFilter}` : ''}${sortBy !== 'date' ? `&sort=${sortBy}` : ''}`}
            class={`p-2 rounded-md transition-all ${viewMode === "list" ? "bg-background shadow-sm" : "hover:bg-background/50"}`}
            aria-label="List view"
            title="List view"
          >
            <List className="w-4 h-4" />
          </a>
          <a
            href={`?view=compact${searchQuery ? `&search=${searchQuery}` : ''}${tagFilter ? `&tag=${tagFilter}` : ''}${categoryFilter ? `&category=${categoryFilter}` : ''}${sortBy !== 'date' ? `&sort=${sortBy}` : ''}`}
            class={`p-2 rounded-md transition-all ${viewMode === "compact" ? "bg-background shadow-sm" : "hover:bg-background/50"}`}
            aria-label="Compact view"
            title="Compact view"
          >
            <Table className="w-4 h-4" />
          </a>
          <a
            href={`?view=grid2${searchQuery ? `&search=${searchQuery}` : ''}${tagFilter ? `&tag=${tagFilter}` : ''}${categoryFilter ? `&category=${categoryFilter}` : ''}${sortBy !== 'date' ? `&sort=${sortBy}` : ''}`}
            class={`p-2 rounded-md transition-all ${viewMode === "grid2" ? "bg-background shadow-sm" : "hover:bg-background/50"}`}
            aria-label="Grid view with 2 columns"
            title="Grid view (2 columns)"
          >
            <Grid2x2 className="w-4 h-4" />
          </a>
          <a
            href={`?view=grid3${searchQuery ? `&search=${searchQuery}` : ''}${tagFilter ? `&tag=${tagFilter}` : ''}${categoryFilter ? `&category=${categoryFilter}` : ''}${sortBy !== 'date' ? `&sort=${sortBy}` : ''}`}
            class={`p-2 rounded-md transition-all ${viewMode === "grid3" ? "bg-background shadow-sm" : "hover:bg-background/50"}`}
            aria-label="Grid view with 3 columns"
            title="Grid view (3 columns)"
          >
            <Grid3x3 className="w-4 h-4" />
          </a>
          <a
            href={`?view=grid4${searchQuery ? `&search=${searchQuery}` : ''}${tagFilter ? `&tag=${tagFilter}` : ''}${categoryFilter ? `&category=${categoryFilter}` : ''}${sortBy !== 'date' ? `&sort=${sortBy}` : ''}`}
            class={`p-2 rounded-md transition-all ${viewMode === "grid4" ? "bg-background shadow-sm" : "hover:bg-background/50"}`}
            aria-label="Grid view with 4 columns"
            title="Grid view (4 columns)"
          >
            <Grid className="w-4 h-4" />
          </a>
        </div>
      </div>
    </div>

    {/* Filter Results */}
    {(searchQuery || tagFilter || categoryFilter) && (
      <div class="mb-4 bg-primary/5 rounded-lg p-2 text-base">
        <div class="flex items-center gap-2">
          {searchQuery ? (
            <>
              <MagnifyingGlassIcon className="w-4 h-4 text-primary" />
              <span>
                Found {filteredEntries.length} result{filteredEntries.length !== 1 ? 's' : ''} for <strong>"{searchQuery}"</strong>
              </span>
            </>
          ) : tagFilter ? (
            <>
              <Tag className="w-4 h-4 text-primary" />
              <span>
                Found {filteredEntries.length} prompt{filteredEntries.length !== 1 ? 's' : ''} tagged <strong>"{tagFilter}"</strong>
              </span>
            </>
          ) : (
            <>
              <Folder className="w-4 h-4 text-primary" />
              <span>
                Found {filteredEntries.length} prompt{filteredEntries.length !== 1 ? 's' : ''} in category <strong>"{formatCategoryName(categoryFilter)}"</strong>
              </span>
            </>
          )}
          <a href="/prompts" class="ml-auto text-primary hover:underline text-base">Clear</a>
        </div>
      </div>
    )}

    {/* All Categories Navigation */}
    {!searchQuery && !tagFilter && !categoryFilter && (
      <div class="mb-8">
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 lg:grid-cols-10 gap-3">
          {Object.entries(categoryStructure).map(([category, info]: [string, any]) => {
            const count = categorizedPrompts[category]?.length || 0;
            if (count === 0 && !info.subcategories?.length) return null;
            
            return (
              <a 
                href={createCategoryUrl(category.toLowerCase())} 
                class="relative flex flex-col items-center gap-3 p-4 rounded-xl bg-muted/50 hover:bg-muted/70 transition-all duration-300 no-underline group hover:shadow-lg hover:scale-105 border border-border/40"
              >
                <div class="p-3 rounded-xl bg-background/80 group-hover:bg-background transition-all duration-300 shadow-sm">
                  {(() => {
                    const Icon = getCategoryIcon(category);
                    return <Icon className="w-6 h-6 text-primary" />;
                  })()}
                </div>
                <div class="text-center space-y-1">
                  <span class="text-sm font-semibold block text-foreground">{category}</span>
                  {count > 0 && (
                    <div class="text-xs text-muted-foreground">{count} prompt{count !== 1 ? 's' : ''}</div>
                  )}
                </div>
              </a>
            );
          })}
        </div>
      </div>
    )}

    {/* Prompt Categories */}
    <div class="space-y-8">
      {(Object.entries(orderedCategories) as Array<[string, PromptEntry[]]>).map(([category, entries]) => entries.length > 0 && (
        <div class="mb-10">
          <div class="relative group">
            <div class="absolute inset-0 bg-gradient-to-r from-primary/5 to-transparent rounded-2xl blur-xl group-hover:from-primary/10 transition-all duration-500"></div>
            <div class="relative flex items-center gap-4 p-6 rounded-2xl bg-muted/50 border border-border/50">
              {/* Display category icon dynamically */}
              <div class="w-14 h-14 rounded-xl bg-background/80 flex items-center justify-center shadow-md">
                {(() => {
                  const Icon = getCategoryIcon(category);
                  return <Icon className="w-8 h-8 text-primary" />;
                })()}
              </div>
              
              <div class="flex-1">
                <div class="flex flex-wrap items-center gap-4">
                  <h2 class="text-3xl font-bold text-foreground">
                    {formatCategoryName(category)}
                  </h2>
                  <div class="text-sm text-muted-foreground">
                    {entries.length} prompt{entries.length !== 1 ? 's' : ''}
                  </div>
                  {!categoryFilter && (
                    <a href={createCategoryUrl(category.toLowerCase())} class="text-primary hover:text-primary/80 text-sm font-medium ml-auto transition-colors">
                      View prompts →
                    </a>
                  )}
                </div>
                {categoryStructure[category as keyof typeof categoryStructure]?.description && (
                  <p class="text-sm text-muted-foreground mt-2">{categoryStructure[category as keyof typeof categoryStructure].description}</p>
                )}
              </div>
            </div>
          </div>
          
          {/* Special handling for Foundation category with subcategories */}
          {category === 'Foundation' && categoryStructure.Foundation.subcategories.length > 0 && (
            <div class="mt-4 mb-6">
              <div class="flex gap-3 flex-wrap">
                {categoryStructure.Foundation.subcategories.map((subcat: string) => {
                  const subcatPrompts = entries.filter((entry: PromptEntry) => 
                    entry.data.tags?.map((t: string) => t.toLowerCase()).includes(subcat.toLowerCase())
                  );
                  return subcatPrompts.length > 0 && (
                    <a 
                      href={createTagUrl(subcat)} 
                      class="group flex items-center gap-2.5 px-4 py-2.5 rounded-xl bg-muted/60 hover:bg-muted/80 transition-all duration-300 no-underline border border-border/50"
                    >
                      <span class="text-sm font-semibold capitalize text-foreground">
                        {subcat}
                      </span>
                      <span class="text-xs text-muted-foreground">
                        {subcatPrompts.length}
                      </span>
                    </a>
                  );
                })}
              </div>
            </div>
          )}

          {/* Grid 4 View - Compact cards */}
          {viewMode === "grid4" && (
            <div class="grid gap-2.5 grid-cols-2 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
              {entries.map((entry: PromptEntry) => (
                <Card className="group p-3 hover:shadow-md transition-all duration-200 border-border/40 hover:border-primary/30 bg-gradient-to-br from-background to-muted/10 hover:from-background hover:to-primary/5">
                  <a href={`/prompts/${entry.slug}`} class="block">
                    <div class="flex items-center gap-2.5">
                      <div class="p-1.5 rounded-lg bg-gradient-to-br from-primary/10 to-primary/15 group-hover:from-primary/15 group-hover:to-primary/25 transition-all duration-200">
                        <MessageSquare className="w-4 h-4 text-primary" />
                      </div>
                      <h3 class="text-sm font-medium group-hover:text-primary transition-colors line-clamp-1 flex-1">
                        {entry.data.title}
                      </h3>
                    </div>
                  </a>
                </Card>
              ))}
            </div>
          )}

          {/* Compact View - Table-like format */}
          {viewMode === "compact" && (
            <div class="border border-border/30 rounded-xl overflow-hidden shadow-sm">
              <div class="divide-y divide-border/20">
                {entries.map((entry: PromptEntry) => (
                  <div class="grid grid-cols-[auto_1fr_auto] gap-3 items-center hover:bg-primary/5 transition-colors px-4 py-3">
                    <div class="p-2 rounded-lg bg-muted/50 flex items-center justify-center">
                      <MessageSquare className="w-4 h-4 text-muted-foreground" />
                    </div>
                    <div>
                      <a href={`/prompts/${entry.slug}`} class="group">
                        <h3 class="text-base font-medium group-hover:text-primary transition-colors no-underline">
                          {entry.data.title}
                        </h3>
                      </a>
                    </div>
                    <div class="flex flex-wrap gap-1.5 justify-end">
                      {entry.data.tags ? (
                        entry.data.tags.slice(0, 3).map((tag: string) => (
                          <a href={createTagUrl(tag)} class="no-underline">
                            <Badge className="text-xs px-2 py-0.5 bg-muted/80 hover:bg-primary/10 text-foreground/80 hover:text-primary border-none transition-colors">
                              {tag}
                            </Badge>
                          </a>
                        ))
                      ) : null}
                      {entry.data.tags && entry.data.tags.length > 3 && (
                        <span class="text-xs text-muted-foreground">+{entry.data.tags.length - 3}</span>
                      )}
                    </div>
                  </div>
                ))}
              </div>
            </div>
          )}

          {/* Standard Grid Views */}
          {(viewMode === "grid2" || viewMode === "grid3") && (
            <div
              class={`grid gap-4 ${
                viewMode === "grid3" 
                ? "md:grid-cols-2 lg:grid-cols-3" 
                : "md:grid-cols-2"
              }`}
            >
              {entries.map((entry: PromptEntry) => (
                <Card className="group h-full p-5 hover:shadow-xl transition-all duration-300 border-border/50 hover:border-primary/30 bg-gradient-to-br from-background to-muted/20 hover:from-background hover:to-primary/5">
                  <a href={`/prompts/${entry.slug}`} class="block no-underline h-full flex flex-col">
                    <div class="flex items-start gap-3 mb-3">
                      <div class="p-2 rounded-lg bg-gradient-to-br from-primary/10 to-primary/20 group-hover:from-primary/20 group-hover:to-primary/30 transition-all duration-300">
                        <MessageSquare className="w-5 h-5 text-primary" />
                      </div>
                      <h3 class="text-lg font-semibold group-hover:text-primary transition-colors line-clamp-2 flex-1">
                        {entry.data.title}
                      </h3>
                    </div>
                    <p class="text-sm text-muted-foreground line-clamp-3 mb-4 flex-grow">
                      {entry.data.description}
                    </p>
                    <div class="flex flex-wrap gap-1.5 mt-auto">
                      {entry.data.tags ? (
                        entry.data.tags.slice(0, 3).map((tag: string) => (
                          <a href={createTagUrl(tag)} class="no-underline">
                            <Badge className="text-xs px-2 py-0.5 bg-muted hover:bg-primary/10 text-foreground/70 hover:text-primary border-none transition-all duration-200">
                              {tag}
                            </Badge>
                          </a>
                        ))
                      ) : null}
                      {entry.data.tags && entry.data.tags.length > 3 && (
                        <span class="text-xs text-muted-foreground">+{entry.data.tags.length - 3}</span>
                      )}
                    </div>
                  </a>
                </Card>
              ))}
            </div>
          )}

          {/* List View - Enhanced */}
          {viewMode === "list" && (
            <div class="space-y-3">
              {entries.map((entry: PromptEntry) => (
                <Card className="group hover:shadow-lg transition-all duration-300 border-border/50 hover:border-primary/30 bg-gradient-to-r from-background to-muted/10 hover:from-background hover:to-primary/5 p-5">
                  <a href={`/prompts/${entry.slug}`} class="no-underline block">
                    <div class="flex gap-4">
                      <div class="flex-shrink-0 p-2.5 rounded-lg bg-gradient-to-br from-primary/10 to-primary/20 group-hover:from-primary/20 group-hover:to-primary/30 transition-all duration-300 h-fit">
                        <MessageSquare className="w-5 h-5 text-primary" />
                      </div>
                      <div class="min-w-0 flex flex-col gap-2.5 flex-grow">
                        <h3 class="text-lg font-semibold group-hover:text-primary transition-colors">
                          {entry.data.title}
                        </h3>
                        <p class="text-sm text-muted-foreground line-clamp-2">
                          {entry.data.description}
                        </p>
                        <div class="flex flex-wrap gap-1.5 mt-1">
                          {entry.data.tags ? (
                            entry.data.tags.map((tag: string) => (
                              <a href={createTagUrl(tag)} class="no-underline">
                                <Badge className="text-xs px-2 py-0.5 bg-muted hover:bg-primary/10 text-foreground/70 hover:text-primary border-none transition-all duration-200">
                                  {tag}
                                </Badge>
                              </a>
                            ))
                          ) : null}
                        </div>
                      </div>
                    </div>
                  </a>
                </Card>
              ))}
            </div>
          )}
        </div>
      ))}
    </div>

    {/* Empty State */}
    {filteredEntries.length === 0 && (
      <div class="text-center py-8 bg-muted/20 rounded-lg mt-4">
        <div class="max-w-md mx-auto">
          <MessageSquare className="w-12 h-12 text-muted-foreground mx-auto mb-4 opacity-50" />
          <h2 class="text-xl font-semibold mb-2">
            {searchQuery 
              ? 'No matching prompts found' 
              : tagFilter 
                ? 'No prompts with this tag' 
                : categoryFilter
                  ? 'No prompts in this category'
                  : 'No prompts found'}
          </h2>
          <p class="text-base text-muted-foreground">
            {searchQuery 
              ? `No prompts match your search for "${searchQuery}".` 
              : tagFilter
                ? `No prompts found with tag "${tagFilter}".`
                : categoryFilter
                  ? `No prompts found in category "${formatCategoryName(categoryFilter)}".`
                  : 'No prompts exist in the content collection.'}
          </p>
          {(searchQuery || tagFilter || categoryFilter) && (
            <a href="/prompts" class="inline-block mt-3 text-primary hover:underline text-base">
              View all prompts
            </a>
          )}
        </div>
      </div>
    )}
  </div>
</Layout>

<style>
  .card {
    transition: all 0.2s ease-in-out;
  }
  .card:hover {
    transform: translateY(-1px);
  }
  
  /* Gradient background styling */
  :global(body) {
    background-image: 
      radial-gradient(at 100% 0%, hsla(var(--primary-hsl) / 0.15) 0px, transparent 50%),
      radial-gradient(at 0% 100%, hsla(var(--primary-hsl) / 0.1) 0px, transparent 50%);
    background-attachment: fixed;
  }

  /* Remove underlines from all links */
  a {
    text-decoration: none !important;
  }

  /* Tag hover styling */
  .badge:hover {
    transform: translateY(-1px);
    transition: all 0.2s ease;
  }
</style>

<script>
  // Handle search form submission and URL updates
  document.addEventListener('DOMContentLoaded', () => {
    const promptSearchForm = document.querySelector('form');
    const promptSearchInput = promptSearchForm?.querySelector('input[type="search"]') as HTMLInputElement;
    const sortSelect = document.querySelector('select[name="sort"]') as HTMLSelectElement;
    const viewModeLinks = document.querySelectorAll('a[href^="?view="]');
    
    // URL update helper function
    (window as any).updateURL = function(param: string, value: string) {
      const url = new URL(window.location.href);
      if (value && value !== 'custom' && value !== 'grid3') {
        url.searchParams.set(param, value);
      } else {
        url.searchParams.delete(param);
      }
      return url.toString();
    };
    
    if (promptSearchForm && promptSearchInput) {
      // Add event listener for the form submission
      promptSearchForm.addEventListener('submit', (e) => {
        if (promptSearchInput.value.trim() === '') {
          const currentUrl = new URL(window.location.href);
          if (currentUrl.pathname === '/prompts' && !currentUrl.searchParams.has('search')) {
            e.preventDefault();
          }
        }
      });
      
      // Set focus on search input with a slight delay
      setTimeout(() => {
        if (promptSearchInput.value) {
          promptSearchInput.setSelectionRange(promptSearchInput.value.length, promptSearchInput.value.length);
        }
      }, 100);
    }
    
    // Update view mode links to preserve search query, tag, and category filters
    if (viewModeLinks.length > 0) {
      const searchParams = new URLSearchParams(window.location.search);
      const currentSearch = searchParams.get('search');
      const currentTag = searchParams.get('tag');
      const currentCategory = searchParams.get('category');
      const currentSort = searchParams.get('sort');
      
      viewModeLinks.forEach(link => {
        const href = link.getAttribute('href') || '';
        let newHref = href;
        
        if (currentSearch && !newHref.includes('search=')) {
          newHref += (newHref.includes('?') ? '&' : '?') + `search=${encodeURIComponent(currentSearch)}`;
        }
        
        if (currentTag && !newHref.includes('tag=')) {
          newHref += (newHref.includes('?') ? '&' : '?') + `tag=${encodeURIComponent(currentTag)}`;
        }
        
        if (currentCategory && !newHref.includes('category=')) {
          newHref += (newHref.includes('?') ? '&' : '?') + `category=${encodeURIComponent(currentCategory)}`;
        }
        
        if (currentSort && currentSort !== 'date' && !newHref.includes('sort=')) {
          newHref += (newHref.includes('?') ? '&' : '?') + `sort=${encodeURIComponent(currentSort)}`;
        }
        
        if (newHref !== href) {
          link.setAttribute('href', newHref);
        }
      });
    }
  });
</script>