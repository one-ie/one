---
import Landing from '../../layouts/Landing.astro';
---

<Landing title="ONE Playbook" header={false} footer={false}>
  <main class="playbook-main">
    <div class="playbook-container">
      <!-- 4x4 Grid: Exact Figma Layout -->
      <div class="playbook-grid">
        <!-- Row 1: GROW + Actions -->
        <div class="grid-item level-item">
          <img src="/playbook/clean/arrow-up.svg" alt="Arrow" class="arrow-icon" />
          <div class="level-content">
            <h3>GROW</h3>
            <p>Elevate<br/>Value</p>
          </div>
        </div>
        <div class="grid-item action-item">
          <div class="icon-circle">
            <img src="/playbook/clean/icon-upsell-clean.svg" alt="Upsell" />
          </div>
          <span>Upsell</span>
        </div>
        <div class="grid-item action-item">
          <div class="icon-circle">
            <img src="/playbook/clean/icon-educate-clean.svg" alt="Educate" />
          </div>
          <span>Educate</span>
        </div>
        <div class="grid-item action-item">
          <div class="icon-circle">
            <img src="/playbook/clean/icon-share-complete.svg" alt="Share" />
          </div>
          <span>Share</span>
        </div>

        <!-- Row 2: CONVERT + Actions -->
        <div class="grid-item level-item">
          <img src="/playbook/clean/arrow-up-convert.svg" alt="Arrow" class="arrow-icon" />
          <div class="level-content">
            <h3>CONVERT</h3>
            <p>Elevate<br/>Sales</p>
          </div>
        </div>
        <div class="grid-item action-item">
          <div class="icon-circle">
            <img src="/playbook/clean/icon-nurture-clean.svg" alt="Nurture" />
          </div>
          <span>Nurture</span>
        </div>
        <div class="grid-item action-item">
          <div class="icon-circle">
            <img src="/playbook/clean/icon-sell-cart-fixed.svg" alt="Sell" />
          </div>
          <span>Sell</span>
        </div>
        <div class="grid-item action-item">
          <div class="icon-circle">
            <img src="/playbook/clean/icon-engage-clean.svg" alt="Engage" />
          </div>
          <span>Engage</span>
        </div>

        <!-- Row 3: ATTRACT + Actions -->
        <div class="grid-item level-item">
          <img src="/playbook/clean/arrow-up-attract.svg" alt="Arrow" class="arrow-icon" />
          <div class="level-content">
            <h3>ATTRACT</h3>
            <p>Elevate<br/>Reach</p>
          </div>
        </div>
        <div class="grid-item action-item">
          <div class="icon-circle">
            <img src="/playbook/clean/icon-stop-clean.svg" alt="Stop" />
          </div>
          <span>Stop</span>
          <!-- Person positioned at Stop -->
          <div class="animated-person">
            <img src="/playbook/clean/icon-person-standalone.svg" alt="Journey Person" />
          </div>
        </div>
        <div class="grid-item action-item">
          <div class="icon-circle">
            <img src="/playbook/clean/icon-gift-clean.svg" alt="Gift" />
          </div>
          <span>Gift</span>
        </div>
        <div class="grid-item action-item">
          <div class="icon-circle">
            <img src="/playbook/clean/icon-identify-clean.svg" alt="Identify" />
          </div>
          <span>Identify</span>
        </div>

        <!-- Row 4: Foundation -->
        <div class="grid-item foundation-item">
          <span>YOU</span>
        </div>
        <div class="grid-item foundation-item">
          <span>Company</span>
        </div>
        <div class="grid-item foundation-item">
          <span>Market</span>
        </div>
        <div class="grid-item foundation-item">
          <span>Customer</span>
        </div>
      </div>
    </div>
  </main>
</Landing>

<style>
  .playbook-main {
    min-height: 100vh;
    background-color: #131313;
    color: white;
    padding: 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .playbook-container {
    max-width: 120rem;
    width: 100%;
    margin: 0 auto;
  }

  .playbook-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    aspect-ratio: 1;
    max-width: 100vh;
    margin: 0 auto;
  }

  .grid-item {
    background-color: #2B2B2B;
    border: 2px solid #4B4B4B;
    border-radius: 0.5rem;
    padding: 1rem;
    transition: all 0.2s ease;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    aspect-ratio: 1;
    position: relative;
  }

  .grid-item:hover {
    transform: scale(1.02);
    border-color: #1C3354;
    box-shadow: 0 4px 12px rgba(28, 51, 84, 0.3);
  }

  /* Level Items (Left Column) */
  .level-item {
    background-color: #2B2B2B;
    border: 2px solid #4B4B4B;
    position: relative;
  }

  .arrow-icon {
    width: 80px;
    height: 60px;
    object-fit: contain;
    margin-bottom: 1rem;
  }

  .level-content h3 {
    font-size: 1.25rem;
    font-weight: 800;
    margin: 0 0 0.5rem 0;
    text-align: center;
    color: #fff;
    font-family: 'Montserrat', sans-serif;
    text-transform: uppercase;
  }

  .level-content p {
    font-size: 0.875rem;
    margin: 0;
    text-align: center;
    line-height: 1.2;
    color: #fff;
    font-family: 'Roboto', sans-serif;
    font-weight: 700;
    text-transform: capitalize;
  }

  /* Action Items */
  .action-item {
    background-color: #2B2B2B;
    border: 2px solid #4B4B4B;
    gap: 0.75rem;
    position: relative;
  }

  /* Icon Circle */
  .icon-circle {
    width: 120px;
    height: 120px;
    background-color: #222222;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    margin-bottom: 0.5rem;
  }

  .icon-circle img {
    width: 70px;
    height: 70px;
    object-fit: contain;
  }

  /* Featured Icon Circle */
  .featured-circle {
    background-color: #1B3153;
  }

  /* Person Icon for Sell */
  .person-icon {
    position: absolute;
    bottom: 10px;
    left: 10px;
    width: 30px;
    height: 30px;
    opacity: 0.8;
  }

  .person-icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* Action Item Text */
  .action-item span {
    font-size: 1rem;
    font-weight: 400;
    text-align: center;
    color: #fff;
    font-family: 'Roboto', sans-serif;
    margin-top: 0.5rem;
  }

  /* Featured Items (Blue highlight) */
  .featured {
    background-color: #1C3354 !important;
    border-color: #4B4B4B !important;
  }

  .featured:hover {
    border-color: #1C3354 !important;
    box-shadow: 0 4px 12px rgba(28, 51, 84, 0.3) !important;
  }

  /* Foundation Items */
  .foundation-item {
    background-color: #1B1B1B;
    border: 2px solid #3B3B3B;
  }

  .foundation-item span {
    font-size: 1.125rem;
    font-weight: 800;
    text-align: center;
    color: #fff;
    font-family: 'Montserrat', sans-serif;
    text-transform: uppercase;
  }

  /* Person positioned at Stop */
  .animated-person {
    position: absolute;
    width: 75px;
    height: 75px;
    z-index: 10;
    pointer-events: none;
    /* Position in bottom left corner of the stop square */
    bottom: 10px;
    left: 10px;
  }

  .animated-person img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 2px 4px rgba(0,0,0,0.3));
  }

  @media (max-width: 768px) {
    .playbook-main {
      padding: 1rem;
    }
    
    .playbook-grid {
      gap: 0.5rem;
      max-width: 90vw;
    }
    
    .grid-item {
      padding: 0.5rem;
    }

    .icon-circle {
      width: 80px;
      height: 80px;
    }

    .icon-circle img {
      width: 50px;
      height: 50px;
    }

    .arrow-icon {
      width: 50px;
      height: 35px;
    }

    .level-content h3 {
      font-size: 1rem;
    }

    .level-content p {
      font-size: 0.75rem;
    }

    .action-item span {
      font-size: 0.875rem;
    }

    .foundation-item span {
      font-size: 1rem;
    }

    .animated-person {
      width: 25px;
      height: 25px;
    }

  }

  @media (max-width: 480px) {
    .playbook-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.5rem;
    }
  }
</style>