---
import Layout from "../layouts/Layout.astro";
import { ChatConfigSchema } from "../schema/chat";
import { GitSection } from "@/components/GitSection";
import FaqAccordion from "../components/FaqAccordion";
import Circles from "../components/Circles.astro";
import Features2 from "../components/Features2.astro";
import MeetYourTeam from "../components/MeetYourTeam.astro";

const faqs = [
  // Core Features
  {
    question: "What can I build with ONE?",
    answer:
      "ONE enables you to build complete AI-powered businesses. It's perfect for building 1) AI Sales Agents that engage customers and close deals 24/7 2) Multi-channel Content Generation for blogs, social media, and marketing 3) Full E-commerce with crypto and traditional payments 4) Courses and digital products.",
  },

  // Payments
  {
    question: "What payment methods are supported?",
    answer:
      "ONE makes it easy for you to accept all major payment methods through Stripe:\n• Credit/Debit Cards (Visa, Mastercard, American Express)\n• Digital Wallets (Apple Pay, Google Pay, Microsoft Pay)\n• Bank Transfers (ACH, SEPA, BACS)\n• Buy Now Pay Later (Klarna, Afterpay, Clearpay)\n• Local Methods (iDEAL, Bancontact, giropay)\n• International Cards (JCB, UnionPay)\n\nCrypto payments (BTC, ETH, SOL) are under active development - see progress at /crypto",
  },
  // AI Agents
  {
    question: "How powerful are the AI agents?",
    answer:
      "You can build enterprise-grade agents that can:\n• Handle complete sales cycles\n• Generate and optimize content\n• Process transactions autonomously\n• Learn from customer interactions\n• Operate in multiple languages\n• Integrate with external systems\n• Maintain context across sessions",
  },
  // Content Generation
  {
    question: "What type of content can be automated?",
    answer:
      "The content automation system handles:\n• Blog posts & articles\n• Social media content\n• Product descriptions\n• Marketing materials\n• Documentation & guides\n• Email campaigns\n• Video scripts & podcasts\n\nAll content is SEO-optimized and maintains your brand voice.",
  },
  // Technical
  {
    question: "What's the technical architecture?",
    answer:
      "ONE is built on modern technology:\n• Astro & React for frontend\n• Edge-optimized runtime\n• Vercel AI SDK integration\n• WebSocket for real-time features\n• TypeScript support\n• Shadcn/UI components\n• API-first architecture",
  },
  // Getting Started
  {
    question: "How do I get started?",
    answer:
      "Getting started is straightforward:\n1. Download and install using pnpm\n2. Connect your AI provider (OpenAI, Anthropic, etc.)\n3. Set up payment processing\n4. Configure your first AI agent\n5. Deploy to your preferred platform\n\nVisit https://one.ie/docs/quickstart for step-by-step guidance.",
  },
  // Customization
  {
    question: "Can I customize everything?",
    answer:
      "Yes, ONE is fully customizable:\n• Create custom AI agents\n• Design unique workflows\n• Build custom UI components\n• Set up custom payment flows\n• Define business rules\n• Create specialized content templates\n• Implement custom authentication",
  },
];

// You can override any default values here
const chatConfig = ChatConfigSchema.parse({
  provider: "mistral",
  model: "mistral-large-latest",
  systemPrompt: [
    {
      type: "text" as const,
      text: `You are ONE's lead AI brand architect, helping users leverage our comprehensive toolkit to build their AI-powered presence. Your role is to guide users in utilizing our free, open-source platform that combines prompts, templates, and tools for creating impactful AI solutions.

Core Capabilities:
1. Complete AI Brand Building
   • Generate engaging content across channels
   • Create interactive courses and products
   • Build custom websites and applications
   • Deploy AI agents for automation
   • Process payments globally
   • Scale without restrictions

2. Zero Cost, Maximum Freedom
   • 100% free and open source
   • No platform fees or limits
   • Deploy anywhere - local, cloud, edge
   • Full code ownership
   • Unlimited customization
   • Commercial use allowed
   • Active community support

3. Comprehensive Toolkit
   • Rich prompt library
   • Ready-to-use templates
   • Modern UI components
   • Payment integrations
   • AI agent frameworks
   • Content automation
   • Multi-platform deployment

Communication Style:
• Focus on empowerment
• Highlight creative freedom
• Emphasize zero cost
• Share practical examples
• Guide implementation
• Encourage exploration
• Build confidence`,
    },
  ],
  welcome: {
    message:
      "👋 Hi! I'm your guide to building with ONE - the free, open-source toolkit for creating AI-powered brands. Whether you want to generate content, create courses, build websites, or deploy AI agents, I'm here to help you bring your vision to life without restrictions.",
    avatar: "/icon.svg",
    suggestions: [
      {
        label: "🎯 Explore Capabilities",
        prompt: "What can I create with ONE's toolkit? Show me the possibilities!",
      },
      {
        label: "🚀 Quick Start",
        prompt: "I'm ready to start building. What's the fastest way to get going?",
      },
      {
        label: "✨ Content Creation",
        prompt: "How can I use ONE to generate and manage content across platforms?",
      },
      {
        label: "🤖 AI Agents",
        prompt: "Tell me about building custom AI agents with ONE's framework.",
      },
      {
        label: "💻 Deployment Options",
        prompt: "What are my options for deploying ONE-powered solutions?",
      },
      {
        label: "🤝 Community & Support",
        prompt: "How can I connect with other ONE developers and get help?",
      },
    ],
  },
});
---

<Layout
  title="ONE - Own Your AI Solutions Completely Free"
  chatConfig={chatConfig}
  rightPanelMode="quarter"
  >
  <main class="flex flex-col w-full">
    {/* Hero Section */}
    <section
      class="container mx-auto px-6 py-12 border-b border-border bg-background/50 backdrop-blur-sm"
    >
      <div
        class="w-full max-w-[1400px] mx-auto flex flex-col items-center gap-6 text-center"
      >
        <h1
          class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-foreground one-animate-fade-in"
        >
          Build Your <span class="text-accent">AI Brand</span>
        </h1>
        <div class="flex flex-col items-center gap-4 max-w-[800px]">
          <p
            class="text-base sm:text-lg md:text-xl text-muted-foreground leading-relaxed tracking-wide max-w-2xl one-animate-fade-in"
          >
            ONE is an toolkit, prompts, library and templates for your AI brand.
            Engineers, creators, educators, enterprises and governments can
            generate content, courses, websites, accept payments and build AI agents without
            restrictions. ONE is 100% free and open sourrce. You can host it for free. Run it locally, on your own server, in the cloud or at the
            edge. 
          </p>
        </div>
      </div>
    </section>

    <Circles />
    <MeetYourTeam />
    <Features2 />

    {/* Download Section */}
    <section
      class="container mx-auto px-6 py-16 border-b border-border bg-background/30 backdrop-blur-sm"
    >
      <GitSection client:load />
    </section>

    {/* FAQs Section */}
    <section
      class="container mx-auto px-6 py-20 border-t border-border bg-background/10 backdrop-blur-sm"
    >
      <div class="w-full max-w-[1400px] mx-auto">
        <h2
          class="text-4xl font-bold mb-10 text-center text-foreground one-animate-fade-in"
        >
          Frequently Asked Questions
        </h2>
        <div class="one-animate-fade-in">
          <FaqAccordion client:idle faqs={faqs} />
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  .prose {
    @apply mx-auto;
  }

  .prose pre {
    @apply bg-muted;
  }
</style>

<script>
  // Handle copy functionality
  document.addEventListener("DOMContentLoaded", () => {
    const copyButton = document.getElementById("copyCloneCommand");
    const copyMessage = document.getElementById("copyMessage");
    const getStartedBtn = document.getElementById("getStartedBtn");

    if (copyButton && copyMessage) {
      copyButton.addEventListener("click", () => {
        navigator.clipboard.writeText(
          "git clone https://github.com/one-ie/one.git",
        );
        copyMessage.classList.remove("opacity-0");
        setTimeout(() => copyMessage.classList.add("opacity-0"), 2000);
      });
    }

    if (getStartedBtn) {
      getStartedBtn.addEventListener("click", () => {
        const installSection = document.querySelector(".container");
        if (installSection) {
          installSection.scrollIntoView({ behavior: "smooth" });
        }
      });
    }
  });
</script>
