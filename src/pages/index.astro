      0 4px 6px -4px rgb(0 0 0 / 0.1);
  }

  .button-shadow:active {
    transform: translateY(0);
    box-shadow: 
      0 4px 6px -1px rgb(0 0 0 / 0.1),
      0 2px 4px -2px rgb(0 0 0 / 0.1);
  }

  .button-glow {
    position: relative;
    overflow: hidden;
  }

  .button-glow::before {
    content: '';
    position: absolute;
    inset: -2px;
    background: linear-gradient(
      to right,
      hsl(var(--primary) / 0.1),
      hsl(var(--primary) / 0.2),
      hsl(var(--primary) / 0.1)
    );
    z-index: -1;
    border-radius: inherit;
    transition: all 0.3s ease;
    opacity: 0;
  }

  .button-glow:hover::before {
    opacity: 1;
  }

  .button-primary {
    background: linear-gradient(
      to bottom right,
      hsl(var(--primary)),
      hsl(var(--primary) / 0.9)
    );
