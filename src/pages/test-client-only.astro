---
import Layout from "../layouts/1.blank.astro";
import { Chat } from "@/components/Chat";
import { createDefaultConfig } from "@/schema/chat";

const defaultConfig = createDefaultConfig();
---

<Layout title="Client Only Test">
  <div class="container mx-auto p-8">
    <h1 class="text-2xl font-bold mb-4">Client Only Rendering Test</h1>
    <p class="mb-4">This test uses client:only to ensure React is loaded on the client side only.</p>
    
    <div class="border rounded-lg overflow-hidden h-[600px]">
      <div class="h-full">
        <Chat client:only="react" chatConfig={defaultConfig} className="h-full" />
      </div>
    </div>
  </div>
</Layout>