import { getCollection } from "astro:content";
import { exec } from "child_process";
import { promisify } from "util";
import fs from "fs/promises";
import path from "path";

const execAsync = promisify(exec);

// Get format from params
const { format } = Astro.params;
if (!format || !["epub", "pdf", "md"].includes(format)) {
  return Astro.redirect("/404");
}

// Get all book content
const allContent = await getCollection("prompts");
const sortedContent = allContent.sort((a, b) => {
  const orderA = a.data.order || 0;
  const orderB = b.data.order || 0;
  return orderA - orderB;
});

// Create temporary directory for processing
const tempDir = path.join(process.cwd(), "temp");
await fs.mkdir(tempDir, { recursive: true });

// Write content to temporary files
const contentFiles = await Promise.all(
  sortedContent.map(async (content, index) => {
    const filename = path.join(tempDir, `${index.toString().padStart(2, "0")}-${content.slug}.md`);
    await fs.writeFile(filename, content.body);
    return filename;
  })
);

// Generate book based on format
let outputFile;
let contentType;

try {
  switch (format) {
    case "epub":
      outputFile = path.join(tempDir, "book.epub");
      contentType = "application/epub+zip";
      await execAsync(`pandoc ${contentFiles.join(" ")} -o ${outputFile} --toc --toc-depth=2 --css=src/content/book/epub-style.css`);
      break;
      
    case "pdf":
      outputFile = path.join(tempDir, "book.pdf");
      contentType = "application/pdf";
      await execAsync(`pandoc ${contentFiles.join(" ")} -o ${outputFile} --toc --toc-depth=2 --pdf-engine=xelatex`);
      break;
      
    case "md":
      outputFile = path.join(tempDir, "book.md");
      contentType = "text/markdown";
      await fs.writeFile(outputFile, sortedContent.map(c => c.body).join("\n\n"));
      break;
  }

  // Read the generated file
  const fileContent = await fs.readFile(outputFile);

  // Set response headers
  Astro.response.headers.set("Content-Type", contentType);
  Astro.response.headers.set("Content-Disposition", `attachment; filename="one-book.${format}"`);

  // Return the file
  return new Response(fileContent);
} catch (error) {
  console.error("Error generating book:", error);
  return Astro.redirect("/500");
} finally {
  // Clean up temporary files
  try {
    await fs.rm(tempDir, { recursive: true, force: true });
  } catch (error) {
    console.error("Error cleaning up temporary files:", error);
  }
} 