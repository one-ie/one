---
import { getCollection } from 'astro:content';
import type { Book } from '../../content/config';
import Layout from "../../layouts/Layout.astro";
import { Button } from "@/components/ui/button";
import { Card } from "@/components/ui/card";
import { ChatConfigSchema } from '../../schema/chat';

// Get all book content from book collection
const bookContent = await getCollection('book');

type BookEntry = { data: Book; slug: string };

// Sort content by order if available
const sortedContent = bookContent.sort((a: BookEntry, b: BookEntry) => {
  const orderA = a.data.order || 0;
  const orderB = b.data.order || 0;
  return orderA - orderB;
});

// Configure AI assistant for the book
const chatConfig = ChatConfigSchema.parse({
  // Layout and Meta
  layout: "book",
  title: "The Elevate Playbook",
  description: "Your guide to building AI-powered businesses",
  
  // AI Config
  aiProvider: "openrouter",
  aiModel: "google/gemini-2.0-flash-001",
  apiEndpoint: "https://api.openai.com/v1",
  temperature: 0.7,
  maxTokens: 2000,
  runtime: "edge",
  includeContent: true,

  // Prompt Config
  systemPrompt: [{
    type: "text",
    text: `You are an expert guide for The Elevate Playbook, a comprehensive resource for building AI-powered businesses. Your role is to help readers understand and implement the strategies outlined in the book.

Core Capabilities:
1. Book Navigation
   • Chapter summaries
   • Key concepts
   • Implementation steps
   • Best practices

2. Strategy Guidance
   • Business planning
   • AI integration
   • Growth tactics
   • Success metrics

3. Technical Support
   • Code examples
   • Architecture design
   • Implementation help
   • Troubleshooting

4. Reader Support
   • Clear explanations
   • Practical examples
   • Step-by-step guidance
   • Resource recommendations

Communication Style:
• Be clear and concise
• Provide actionable advice
• Use relevant examples
• Maintain professional tone
• Focus on practical implementation

Key Principles:
• Reader success first
• Practical implementation
• Clear guidance
• Best practices
• Security awareness`
  }],
  addSystemPrompt: true,
  addBusinessPrompt: true,

  // Welcome Config
  welcomeMessage: "👋 Welcome to The Elevate Playbook! I'm your AI guide to building AI-powered businesses. What would you like to learn about?",
  avatar: "/icon.svg",
  suggestions: [
    {
      label: "📚 Book Overview",
      prompt: "Give me an overview of The Elevate Playbook and its key concepts"
    },
    {
      label: "🎯 Getting Started",
      prompt: "What are the first steps to implementing the strategies in the book?"
    },
    {
      label: "🤖 AI Integration",
      prompt: "How do I integrate AI into my business using the playbook's approach?"
    },
    {
      label: "💡 Best Practices",
      prompt: "What are the key best practices for implementing the playbook's strategies?"
    },
    {
      label: "📈 Growth Strategy",
      prompt: "How can I use the playbook to grow my business?"
    },
    {
      label: "🔧 Technical Setup",
      prompt: "What technical setup do I need to implement the playbook's strategies?"
    }
  ]
});

// Download options
const downloadOptions = [
  {
    title: "EPUB",
    description: "For e-readers and mobile devices",
    format: "epub",
    href: "/TheElevatePlaybook.epub"
  },
  {
    title: "PDF",
    description: "For desktop and print",
    format: "pdf",
    href: "/TheElevatePlaybook.pdf"
  },
  {
    title: "Markdown",
    description: "For developers and customization",
    format: "md",
    href: "/TheElevatePlaybook.md"
  }
];
---

<Layout 
  title="The Elevate Playbook"
  description="Your guide to building AI-powered businesses"
  chatConfig={chatConfig}
  rightPanelMode="half"
>
  <div class="container mx-auto px-4 py-8">
    <!-- Welcome Section -->
    <div class="max-w-4xl mx-auto text-center mb-16">
      <h1 class="text-4xl font-bold mb-4">The Elevate Playbook</h1>
      <p class="text-xl text-muted-foreground mb-8">
        Welcome to the course you will learn about to building and scaling AI-powered ecommerce businesses
      </p>
      <div class="flex flex-wrap justify-center gap-4 mb-8">
        <span class="px-4 py-2 rounded-lg bg-primary/10 text-primary flex items-center gap-2">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          AI-Powered Strategies
        </span>
        <span class="px-4 py-2 rounded-lg bg-primary/10 text-primary flex items-center gap-2">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
          </svg>
          Step-by-Step Guide
        </span>
        <span class="px-4 py-2 rounded-lg bg-primary/10 text-primary flex items-center gap-2">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
          Practical Examples
        </span>
      </div>
    </div>

    <!-- Download Options -->
    <div class="flex flex-wrap gap-4 justify-center mb-16">
      {downloadOptions.map((option) => (
        <a href={option.href} class="inline-block">
          <Button variant="outline" className="group">
            {option.format === 'epub' && (
              <svg class="w-5 h-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
              </svg>
            )}
            {option.format === 'pdf' && (
              <svg class="w-5 h-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
            )}
            {option.format === 'md' && (
              <svg class="w-5 h-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
            )}
            Download {option.title}
          </Button>
        </a>
      ))}
    </div>

    <!-- Content Preview -->
    <div class="max-w-4xl mx-auto mb-16">
      <h2 class="text-2xl font-bold mb-4">Course Modules</h2>
      <div class="space-y-4">
        {sortedContent.map((page: BookEntry) => (
          <a
            href={`/book/${page.slug}`}
            class="block p-6 rounded-lg border hover:border-primary hover:bg-primary/5 transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-primary/40"
          >
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center text-primary font-medium flex-shrink-0">
                {page.data.chapter}
              </div>
              <div class="space-y-2">
                <h4 class="text-lg font-semibold group-hover:text-primary transition-colors">{page.data.title}</h4>
                <p class="text-muted-foreground">
                  {page.data.description}
                </p>
                {page.data.tags && (
                  <div class="flex flex-wrap gap-2 mt-2">
                    {page.data.tags.map((tag: string) => (
                      <span class="px-2 py-0.5 text-[10px] font-medium rounded-full border border-primary/20 bg-primary/5 text-primary tracking-wide uppercase">
                        {tag}
                      </span>
                    ))}
                  </div>
                )}
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</Layout> 