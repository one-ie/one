---
import Layout from "../layouts/Layout.astro";
import { Button } from "@/components/ui/button";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";

const title = "Course Login";
const description = "Login to access your course content";

// Simple client-side validation
const VALID_USERNAME = "student401";
const VALID_PASSWORD = "sdfo$#$DFdds$3D44$$$";
---

<Layout
  title={title}
  description={description}
  rightPanelMode="hidden"
>
  <div class="min-h-screen flex items-center justify-center p-4">
    <Card className="w-full max-w-md">
      <CardHeader>  
        <CardTitle className="text-2xl text-center">Course Login</CardTitle>
      </CardHeader>
      <CardContent>
        <form id="loginForm" class="space-y-4">
          <div class="space-y-2">
            <Label htmlFor="username">Username</Label>
            <Input id="username" name="username" type="text" required />
          </div>
          <div class="space-y-2">
            <Label htmlFor="password">Password</Label>
            <Input id="password" name="password" type="password" required />
          </div>
          <div id="error" class="text-red-500 text-sm hidden"></div>
          <Button type="submit" className="w-full">Login</Button>
        </form>
      </CardContent>
    </Card>
  </div>
</Layout>

<script>
  const form = document.getElementById('loginForm') as HTMLFormElement;
  const error = document.getElementById('error') as HTMLDivElement;

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const formData = new FormData(form);
    const username = formData.get('username');
    const password = formData.get('password');

    if (username === 'student401' && password === 'sdfo$#$DFdds$3D44$$$') {
      window.location.href = '/book';
    } else {
      error.textContent = 'Invalid username or password';
      error.classList.remove('hidden');
    }
  });
</script>

