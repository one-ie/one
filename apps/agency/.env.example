# === SETUP INSTRUCTIONS ===
# 1. Copy this file: cp .env.example .env.local
# 2. Set AGENCY_OWNER_EMAIL to your email
# 3. Run: bun run setup
#
# one setup auto-mints an agent key and provisions your workspace — no account needed.
# Optionally set ONE_API_KEY if you already have an account on one.ie.

# === OPTIONAL (auto-minted by `one setup` if blank) ===
ONE_API_URL=https://one.ie
# ONE_API_KEY=osk_xxx                  # Leave blank — one setup mints this automatically
AGENCY_OWNER_EMAIL=owner@example.com   # Your email — receives an ownership invite

# === FROM agency.toml (already set — keep in sync) ===
AGENCY_SLUG=myagency
AGENCY_NAME=My Agency

# === WRITTEN BY `one setup` — do not hand-edit ===
# ONE_API_KEY=osk_...    (replaced with admin-scoped key after bootstrap)
# AGENCY_WSID=019ebebe...
# CC_ACTOR_ID=019ebebe...
