---
/**
 * CardDemo.astro — standalone showcase for the Card block.
 *
 * Drop into any page to preview every variant in context:
 *   import CardDemo from '@/components/blocks/demos/CardDemo.astro'
 *   <CardDemo />
 *
 * Self-contained: brings its own section chrome (eyebrow + title) and grids,
 * all responsive. Shows feature · stat · profile · pricing rows.
 */

import Card from '../Card.astro'

const features = [
  {
    accent: 'primary' as const,
    title: 'Design tokens',
    body: 'Six tokens every component inherits — primary, secondary, tertiary, background, foreground, font. Change one value, the whole system responds.',
    href: '/design',
    linkText: 'Explore the system →',
    icon: '<circle cx="12" cy="12" r="3"/><path d="M20.188 10.934a8 8 0 1 0-8.688 9.134"/>',
  },
  {
    accent: 'secondary' as const,
    title: 'Motion library',
    body: 'Reveal, Parallax, ScrollScene, and Stagger — built on Motion with shared ease + duration tokens. Reduced-motion safe by default.',
    href: '/motion',
    linkText: 'See it live →',
    icon: '<path d="m5 3 14 9-14 9V3z"/>',
  },
  {
    accent: 'tertiary' as const,
    title: 'AI chat',
    body: 'Drop a chat widget onto any page with plugin-chat. Agent personality defined in markdown. Zero backend code, zero bundle cost.',
    href: '/plugins',
    linkText: 'Browse plugins →',
    icon: '<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>',
  },
]

const stats = [
  { accent: 'primary' as const, stat: '4,217', label: 'sites deployed', trend: 'up' as const, trendLabel: '+12%' },
  { accent: 'tertiary' as const, stat: '3.2d', label: 'avg to first deploy', trend: 'down' as const, trendLabel: '−0.8d' },
  { accent: 'secondary' as const, stat: '94%', label: 'active after 6 months', trend: 'up' as const, trendLabel: '+6%' },
  { accent: 'primary' as const, stat: '< 80 KB', label: 'JS bundle (gzipped)' },
]

const team = [
  {
    name: 'Sarah Mercer',
    role: 'Head of Growth, Acme',
    bio: 'Took a wireframe to production in three days. Now ships every client site on ONE.',
    socials: [
      { label: 'GitHub', href: '#', icon: 'github' as const },
      { label: 'Twitter', href: '#', icon: 'twitter' as const },
      { label: 'Website', href: '#', icon: 'globe' as const },
    ],
  },
  {
    name: 'James Lin',
    role: 'Founder, BuildFast',
    bio: 'The token system survived a full client rebrand — six values, no hunting hex codes.',
    socials: [
      { label: 'LinkedIn', href: '#', icon: 'linkedin' as const },
      { label: 'GitHub', href: '#', icon: 'github' as const },
      { label: 'Email', href: '#', icon: 'mail' as const },
    ],
  },
  {
    name: 'Maya Kovač',
    role: 'CTO, NorthStack',
    bio: 'Added an AI agent to a client site in an afternoon. Cut support tickets by 40%.',
    socials: [
      { label: 'Twitter', href: '#', icon: 'twitter' as const },
      { label: 'LinkedIn', href: '#', icon: 'linkedin' as const },
      { label: 'Website', href: '#', icon: 'globe' as const },
    ],
  },
]

const pricing = [
  {
    tier: 'Starter',
    note: 'For solo builders shipping their first site.',
    price: '$0',
    period: 'forever',
    features: ['MIT-licensed template', 'Full design system', 'Motion library', 'Community support'],
    ctaLabel: 'Clone the template',
    ctaHref: 'https://github.com/one-ie/one',
    featured: false,
    accent: 'tertiary' as const,
  },
  {
    tier: 'Pro',
    note: 'For agencies running client work at scale.',
    price: '$29',
    period: '/mo',
    features: ['Everything in Starter', 'AI chat + tracking plugins', 'Hosted admin console', 'Priority support', 'Unlimited workspaces'],
    ctaLabel: 'Start free trial',
    ctaHref: '#',
    featured: true,
    accent: 'primary' as const,
  },
  {
    tier: 'Enterprise',
    note: 'For teams with custom infrastructure needs.',
    price: 'Custom',
    period: '',
    features: ['Everything in Pro', 'Dedicated support', 'SLA + uptime guarantees', 'Custom plugins', 'On-prem deployment'],
    ctaLabel: 'Talk to us',
    ctaHref: '#',
    featured: false,
    accent: 'secondary' as const,
  },
]
---

<section class="card-demo">
  <div class="card-demo__container">
    <header class="card-demo__head">
      <p class="card-demo__eyebrow">One card, five layouts</p>
      <h2 class="card-demo__title">A card for every surface</h2>
      <p class="card-demo__sub">
        Feature, stat, profile, and pricing — all from a single composable
        component. Hairline borders, the icon-chip treatment, colour as a
        sparing accent. Switch a theme in the nav and watch every card respond.
      </p>
    </header>

    <!-- (a) Feature cards — whole-card links -->
    <div class="card-demo__grid card-demo__grid--3">
      {
        features.map((f) => (
          <Card variant="feature" accent={f.accent} href={f.href}>
            <svg
              slot="icon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              set:html={f.icon}
            />
            <Fragment slot="header">{f.title}</Fragment>
            {f.body}
            <span slot="footer" class="card-demo__cardlink">{f.linkText}</span>
          </Card>
        ))
      }
    </div>

    <!-- (b) Stat cards — oversized numbers + trend -->
    <div class="card-demo__grid card-demo__grid--4">
      {
        stats.map((s) => (
          <Card
            variant="stat"
            accent={s.accent}
            stat={s.stat}
            label={s.label}
            trend={s.trend}
            trendLabel={s.trendLabel}
          />
        ))
      }
    </div>

    <!-- (c) Profile / team row -->
    <div class="card-demo__grid card-demo__grid--3">
      {
        team.map((p) => (
          <Card variant="profile" name={p.name} role={p.role} socials={p.socials}>
            {p.bio}
          </Card>
        ))
      }
    </div>

    <!-- (d) Pricing row — middle tier featured -->
    <div class="card-demo__grid card-demo__grid--3 card-demo__grid--pricing">
      {
        pricing.map((t) => (
          <Card
            variant="pricing"
            featured={t.featured}
            accent={t.accent}
            tier={t.tier}
            price={t.price}
            period={t.period}
            features={t.features}
            ctaLabel={t.ctaLabel}
            ctaHref={t.ctaHref}
          >
            <Fragment slot="header">{t.note}</Fragment>
          </Card>
        ))
      }
    </div>
  </div>
</section>

<style>
  .card-demo {
    padding: 5rem 0;
  }
  .card-demo__container {
    max-width: var(--content-wide);
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .card-demo__head {
    max-width: 42rem;
    margin: 0 auto 3.5rem;
    text-align: center;
  }
  .card-demo__eyebrow {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-primary);
    margin: 0 0 0.75rem;
  }
  .card-demo__title {
    font-size: clamp(2rem, 4.5vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.12;
    color: var(--color-font);
    margin: 0;
  }
  .card-demo__sub {
    font-size: 1.02rem;
    line-height: 1.7;
    color: var(--color-muted);
    max-width: 38rem;
    margin: 1rem auto 0;
  }

  /* Section rhythm — even vertical gap between the four rows. */
  .card-demo__grid {
    display: grid;
    gap: 1.5rem;
  }
  .card-demo__grid + .card-demo__grid {
    margin-top: 1.5rem;
  }
  .card-demo__grid--3 { grid-template-columns: repeat(3, 1fr); }
  .card-demo__grid--4 { grid-template-columns: repeat(4, 1fr); }

  /* Featured pricing tier lifts slightly on wide screens. */
  .card-demo__grid--pricing :global(.card--featured) {
    transform: translateY(-8px);
  }

  /* The slotted feature-card link inherits .card__footer a styling, but we
     add the demo's own class so it reads as a link even outside a Card. */
  .card-demo__cardlink {
    color: var(--color-primary);
    font-weight: 600;
  }

  @media (max-width: 1024px) {
    .card-demo__grid--3 { grid-template-columns: repeat(2, 1fr); }
    .card-demo__grid--4 { grid-template-columns: repeat(2, 1fr); }
    .card-demo__grid--pricing { grid-template-columns: 1fr; }
    .card-demo__grid--pricing :global(.card--featured) { transform: none; }
  }
  @media (max-width: 640px) {
    .card-demo__grid--3,
    .card-demo__grid--4 { grid-template-columns: 1fr; }
  }

  @media (prefers-reduced-motion: reduce) {
    .card-demo__grid--pricing :global(.card--featured) { transform: none; }
  }
</style>
