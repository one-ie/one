---
export interface Props {
  agent: string
  view?: 'icon' | 'half' | 'full'
  position?: 'left' | 'right'
  primary?: string
  ws?: string
  greeting?: string
}

const { agent, view, position, primary, ws, greeting } = Astro.props
---

<script
  async
  src="https://one.ie/c/chat.js"
  data-agent={agent}
  data-view={view}
  data-position={position}
  data-primary={primary}
  data-ws={ws}
  data-greeting={greeting}
></script>
