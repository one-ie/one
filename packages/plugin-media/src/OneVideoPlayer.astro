---
export interface Props {
  /** Workspace slug — required for the connected tier key check */
  ws: string
  /** Mux playbackId or YouTube video ID */
  videoId: string
  /** Video provider. Default: 'mux' */
  provider?: 'mux' | 'youtube'
  /** Start playback automatically. Default: false */
  autoplay?: boolean
  /** SRI hash — set when pinning a specific version URL, e.g. /m/media@1.2.0.js */
  integrity?: string
}

const { ws, videoId, provider, autoplay, integrity } = Astro.props
---

<div id={`one-video-${videoId}`}></div>
<script
  async
  src="https://one.ie/m/media.js"
  crossorigin="anonymous"
  integrity={integrity}
  data-mount="player"
  data-ws={ws}
  data-video-id={videoId}
  data-provider={provider}
  data-autoplay={autoplay ? 'true' : undefined}
></script>
