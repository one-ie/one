---
export interface Props {
  /** Workspace slug (required) */
  ws: string
  /** Agent slug to handle mail actions (auto-draft, prioritize) */
  agent?: string
  /** Folder list shown in the sidebar */
  folders?: string[]
  /** Layout style — three-pane (default) or list only */
  layout?: 'three-pane' | 'list'
  /** Channels worker URL override — defaults to ONE backend */
  channelsUrl?: string
  /** Override the default API endpoint */
  endpoint?: string
  /** SRI hash — set when pinning a specific version URL, e.g. /ml/mail@1.2.3.js */
  integrity?: string
}

const {
  ws,
  agent,
  folders,
  layout,
  channelsUrl,
  endpoint,
  integrity,
} = Astro.props
---

<div id="one-mail" style="height:100vh"></div>
<script
  async
  src="https://one.ie/ml/mail.js"
  crossorigin="anonymous"
  integrity={integrity}
  data-mount="mail"
  data-ws={ws}
  data-agent={agent}
  data-folders={folders?.join(',')}
  data-layout={layout}
  data-channels-url={channelsUrl}
  data-endpoint={endpoint}
></script>
