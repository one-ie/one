---
export interface Props {
  /** Workspace slug (required) */
  ws: string
  /** ISO date string — defaults to today */
  date?: string
  /** Slot duration in minutes */
  duration?: number
  /** IANA timezone — defaults to browser timezone at runtime */
  timezone?: string
  /** SRI hash — set when pinning a specific version URL, e.g. /b/booking@1.2.3.js */
  integrity?: string
}

const { ws, date, duration, timezone, integrity } = Astro.props
---

<div id="one-availability"></div>
<script
  async
  src="https://one.ie/b/booking.js"
  data-mount="availability"
  crossorigin="anonymous"
  integrity={integrity}
  data-ws={ws}
  data-date={date}
  data-duration={duration}
  data-timezone={timezone}
></script>
