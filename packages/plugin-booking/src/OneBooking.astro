---
export interface Props {
  /** Workspace slug (required) */
  ws: string
  /** Agent slug to handle bookings */
  agent?: string
  /** Default appointment duration in minutes */
  duration?: number
  /** Calendar integration */
  calendar?: 'google' | 'ical' | 'both'
  /** IANA timezone — defaults to browser timezone at runtime */
  timezone?: string
  /** Send email confirmation to the booker */
  confirmEmail?: boolean
  /** Override the default API endpoint */
  endpoint?: string
  /** SRI hash — set when pinning a specific version URL, e.g. /b/booking@1.2.3.js */
  integrity?: string
}

const { ws, agent, duration, calendar, timezone, confirmEmail, endpoint, integrity } = Astro.props
---

<div id="one-booking"></div>
<script
  async
  src="https://one.ie/b/booking.js"
  data-mount="booking"
  crossorigin="anonymous"
  integrity={integrity}
  data-ws={ws}
  data-agent={agent}
  data-duration={duration}
  data-calendar={calendar}
  data-timezone={timezone}
  data-confirm-email={confirmEmail}
  data-endpoint={endpoint}
></script>
