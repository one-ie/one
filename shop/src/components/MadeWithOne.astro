---
// The gift, passed on: the ONE link the ONE License asks every site to keep.
// `badge: false` is for the ONE Enterprise License (white-label).
import config from '../../one.config'
const href = 'https://one.ie/'
---
{config.badge && (
  <p class="made-with-one">
    <a href={href} rel="noopener">Made with ONE — get your free key</a>
  </p>
)}

<style>
  .made-with-one { margin: 0; font-size: 0.8rem; color: var(--muted); }
  .made-with-one a { color: inherit; text-decoration: underline; text-underline-offset: 2px; }
</style>
