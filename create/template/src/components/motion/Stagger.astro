---
interface Props {
  stagger?: number
  dist?: 'sm' | 'md' | 'lg'
  class?: string
}

const { stagger = 0.08, dist = 'sm', class: className } = Astro.props

const distMap = { sm: '12px', md: '24px', lg: '48px' } as const
---

<div
  class:list={['stagger', className]}
  style={`--stagger-y:${distMap[dist]};--stagger-step:${stagger}s`}
>
  <slot />
</div>

<!-- is:global — the staggered children are ALWAYS slotted from a parent, so
     they carry the parent's scope hash, not this component's. A scoped
     `.stagger > *` rule would never match them. -->
<style is:global>
  /* Children cascade in on scroll via IntersectionObserver (see <script>), so
     it works in every browser (animation-timeline: view() is Chrome-only).
     We use a keyframe ANIMATION (not a transition) because card children carry
     their own `transition` for hover — a transition-based reveal would collide
     and snap in. `animation-fill-mode: backwards` holds the hidden state during
     each child's delay but releases after, so hover transforms still work. */
  .stagger--armed > * { opacity: 0; }
  .stagger--in > * {
    animation: stagger-rise 0.55s cubic-bezier(0.22, 1, 0.36, 1) backwards;
  }
  .stagger--in > *:nth-child(1)  { animation-delay: calc(var(--stagger-step) * 0); }
  .stagger--in > *:nth-child(2)  { animation-delay: calc(var(--stagger-step) * 1); }
  .stagger--in > *:nth-child(3)  { animation-delay: calc(var(--stagger-step) * 2); }
  .stagger--in > *:nth-child(4)  { animation-delay: calc(var(--stagger-step) * 3); }
  .stagger--in > *:nth-child(5)  { animation-delay: calc(var(--stagger-step) * 4); }
  .stagger--in > *:nth-child(6)  { animation-delay: calc(var(--stagger-step) * 5); }
  .stagger--in > *:nth-child(7)  { animation-delay: calc(var(--stagger-step) * 6); }
  .stagger--in > *:nth-child(8)  { animation-delay: calc(var(--stagger-step) * 7); }
  .stagger--in > *:nth-child(9)  { animation-delay: calc(var(--stagger-step) * 8); }
  .stagger--in > *:nth-child(10) { animation-delay: calc(var(--stagger-step) * 9); }
  .stagger--in > *:nth-child(11) { animation-delay: calc(var(--stagger-step) * 10); }
  .stagger--in > *:nth-child(12) { animation-delay: calc(var(--stagger-step) * 11); }

  @keyframes stagger-rise {
    from { opacity: 0; transform: translateY(var(--stagger-y, 12px)); }
    to   { opacity: 1; transform: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .stagger--in > * { animation: none; }
    .stagger--armed > * { opacity: 1; }
  }
</style>

<script>
  function armStaggers() {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    const els = document.querySelectorAll<HTMLElement>('.stagger:not([data-stagger-bound])')
    if (!els.length) return
    if (reduce) {
      els.forEach((el) => { el.dataset.staggerBound = '1' })
      return
    }
    const io = new IntersectionObserver(
      (entries, obs) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            const el = e.target as HTMLElement
            el.classList.remove('stagger--armed')
            el.classList.add('stagger--in')
            obs.unobserve(el)
          }
        }
      },
      { rootMargin: '0px 0px -10% 0px', threshold: 0.05 },
    )
    els.forEach((el) => {
      el.dataset.staggerBound = '1'
      el.classList.add('stagger--armed')
      io.observe(el)
    })
  }

  armStaggers()
  document.addEventListener('astro:page-load', armStaggers)
</script>
