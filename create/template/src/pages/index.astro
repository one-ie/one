---
import Layout from '../layouts/Layout.astro'
import Reveal from '../components/motion/Reveal.astro'
---

<Layout
  title="ONE — Astro starter with AI, payments & plugins"
  description="Ship AI-powered sites in a weekend. Astro 6 + React 19 + Cloudflare Workers with design system, motion, chat, payments, and auth — wired from one.config.ts."
>

  <!-- ── 02 · Hero ─────────────────────────────────────────────── -->
  <section class="hero">
    <div class="container hero-container">
      <!-- Time-based animation (not view()) — above-fold elements must not use scroll-driven animation -->
      <div class="hr hr-0"><div class="badge">Astro 6 · React 19 · Cloudflare Workers</div></div>
      <div class="hr hr-1"><h1 class="headline">Ship sites that<br />think for themselves</h1></div>
      <div class="hr hr-2">
        <p class="sub">
          For developers and agencies: a production-ready starter with a full design
          system, motion library, AI chat, payments, and auth — wired from a single
          config file. Clone once, customise in minutes, ship forever.
        </p>
      </div>
      <div class="hr hr-3">
        <div class="install">
          <code class="install-cmd">npm create one-app@latest my-site</code>
          <button class="copy-btn" onclick="navigator.clipboard.writeText('npm create one-app@latest my-site').then(()=>{this.textContent='Copied';setTimeout(()=>this.textContent='Copy',1500)})">
            Copy
          </button>
        </div>
      </div>
      <div class="hr hr-4">
        <div class="hero-actions">
          <a href="https://github.com/one-ie/one" class="btn-primary">Get started free →</a>
          <a href="https://one.ie/docs" class="btn-secondary">Read the docs</a>
        </div>
      </div>
      <div class="hr hr-5">
        <div class="hero-social">
          <div class="avatar-stack">
            {['S','J','M','A'].map(l => <div class="avatar-thumb">{l}</div>)}
          </div>
          <span class="hero-social-text">Trusted by 4,200+ developers and agencies</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ── 03 · Logo bar ─────────────────────────────────────────── -->
  <section class="section-logos hr hr-6">
    <div class="container">
      <p class="logos-label">Trusted by teams at</p>
      <div class="logo-track" aria-label="Company logos">
        {['Vercel','Stripe','Linear','Loom','Notion','Figma','Deno','Supabase','Vercel','Stripe','Linear','Loom','Notion','Figma','Deno','Supabase'].map(name => (
          <span class="logo-item">{name}</span>
        ))}
      </div>
    </div>
  </section>

  <!-- ── 04 · Problem ──────────────────────────────────────────── -->
  <section class="section section-alt">
    <div class="container">
      <Reveal>
        <p class="eyebrow">Sound familiar?</p>
        <h2 class="section-title">Every new project starts the same way</h2>
      </Reveal>

      <div class="grid-3 problem-grid">
        <div class="problem-card">
          <div class="problem-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          </div>
          <h3 class="problem-title">Week one is always setup</h3>
          <p class="problem-body">
            Auth, components, analytics, a colour system — every project you wire
            the same things from scratch. The actual work doesn't start until day five.
          </p>
        </div>
        <div class="problem-card">
          <div class="problem-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
          </div>
          <h3 class="problem-title">Client designs drift from code</h3>
          <p class="problem-body">
            The brand your designer approved in Figma never quite makes it into the
            product. Hex values don't match. Font weights are guesses. Everything looks
            slightly wrong.
          </p>
        </div>
        <div class="problem-card">
          <div class="problem-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
          </div>
          <h3 class="problem-title">AI is always an afterthought</h3>
          <p class="problem-body">
            By the time you're ready to add a chat widget or an agent, you're bolting
            it onto an architecture that wasn't built for it. It shows.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── 05 · Solution ─────────────────────────────────────────── -->
  <section class="section">
    <div class="container">
      <div class="solution-wrap">
        <Reveal class="solution-text">
          <p class="eyebrow">Introducing ONE</p>
          <h2 class="section-title">Architecture decisions made.<br />Ship on day one.</h2>
          <p class="section-sub">
            ONE is a production-ready Astro starter with the hard choices already made.
            Design system, motion, AI chat, payments, and auth — all wired from a single
            <code>one.config.ts</code>. Change your brand colour and every component updates.
            Add a plugin and the feature wires itself.
          </p>
          <a href="https://github.com/one-ie/one" class="btn-primary">Start building free →</a>
        </Reveal>
        <Reveal delay={0.12} class="solution-visual">
          <div class="solution-card">
            <div class="solution-pill">Before ONE</div>
            <div class="solution-before">
              <div class="sol-line sol-strike">Set up auth (3h)</div>
              <div class="sol-line sol-strike">Wire design tokens (2h)</div>
              <div class="sol-line sol-strike">Build component library (8h)</div>
              <div class="sol-line sol-strike">Add analytics (1h)</div>
              <div class="sol-line sol-strike">Wire payments (4h)</div>
            </div>
            <div class="solution-pill solution-pill-after">With ONE</div>
            <div class="solution-after">
              <div class="sol-line sol-done">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                Clone the template
              </div>
              <div class="sol-line sol-done">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                Configure one.config.ts
              </div>
              <div class="sol-line sol-done">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                Ship to Cloudflare
              </div>
            </div>
          </div>
        </Reveal>
      </div>
    </div>
  </section>

  <!-- ── 06 · Features ─────────────────────────────────────────── -->
  <section class="section section-alt">
    <div class="container">
      <Reveal>
        <p class="eyebrow">What's included</p>
        <h2 class="section-title">Everything you need.<br />Nothing you don't.</h2>
      </Reveal>

      <div class="grid-3">
        {[
          {
            icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M20.188 10.934a8 8 0 1 0-8.688 9.134"/></svg>`,
            color: 'var(--color-primary)',
            title: 'Design tokens',
            benefit: 'so your brand is consistent everywhere — automatically',
            body: 'Six tokens (primary · secondary · tertiary · background · foreground · font) that every component inherits. Change one value in one.config.ts.',
            link: '/design', linkText: 'Explore the system →'
          },
          {
            icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m5 3 14 9-14 9V3z"/></svg>`,
            color: 'var(--color-secondary)',
            title: 'Motion library',
            benefit: 'so every animation feels intentional, not bolted on',
            body: 'Reveal, Parallax, ScrollScene, and Stagger — built on Motion/React with shared ease + duration tokens. Reduced-motion safe.',
            link: '/motion', linkText: 'See it live →'
          },
          {
            icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>`,
            color: 'var(--color-tertiary)',
            title: 'AI chat',
            benefit: 'so you can add an agent to any page in one config line',
            body: 'Drop a chat widget onto any page with plugin-chat. Agent personality defined in markdown. No backend code required.',
            badge: 'plugin-chat · connected'
          },
          {
            icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>`,
            color: 'var(--color-primary)',
            title: 'Payments',
            benefit: 'so you can accept crypto and card in under 60 seconds',
            body: 'x402 payment flows, quote/claim, and multi-chain crypto via plugin-backend. No Stripe account required.',
            badge: 'plugin-backend · connected'
          },
          {
            icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`,
            color: 'var(--color-secondary)',
            title: 'Auth',
            benefit: 'so users sign in with passkey or social — zero config',
            body: 'Passkey + better-auth ships as a free plugin. Local session, social providers, and email magic link ready to wire.',
            badge: 'plugin-auth · free'
          },
          {
            icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>`,
            color: 'var(--color-tertiary)',
            title: 'Privacy-first analytics',
            benefit: 'so your data stays yours — not a third party\'s product',
            body: 'plugin-track injects a served pixel. Events flow into your workspace. No cookies banner required.',
            badge: 'plugin-track · connected'
          },
        ].map((f, i) => (
          <Reveal delay={i * 0.06}>
            <div class="card" style={`--card-color:${f.color}`}>
              <div class="card-icon" style={`color:${f.color}`} set:html={f.icon} />
              <h3 class="card-title">{f.title}</h3>
              <p class="card-benefit">— {f.benefit}</p>
              <p class="card-body">{f.body}</p>
              {f.link && <a href={f.link} class="card-link">{f.linkText}</a>}
              {f.badge && <div class="card-badge">{f.badge}</div>}
            </div>
          </Reveal>
        ))}
      </div>
    </div>
  </section>

  <!-- ── 07 · How it works ─────────────────────────────────────── -->
  <section class="section">
    <div class="container">
      <Reveal>
        <p class="eyebrow">Get started in minutes</p>
        <h2 class="section-title">Three steps to production</h2>
      </Reveal>

      <div class="steps">
        {[
          {
            n: '01',
            title: 'Clone the template',
            body: 'One command creates your project with Astro 6, React 19, Tailwind 4, shadcn/ui, and the full ONE plugin system ready to configure.',
            code: 'npm create one-app@latest my-site'
          },
          {
            n: '02',
            title: 'Configure in one.config.ts',
            body: 'Set your brand tokens, choose your plugins, and point at your backend. The entire site updates from this single file — no hunting through components.',
            code: 'brand: { tokens: { primary: \'hsl(216 55% 25%)\' } }'
          },
          {
            n: '03',
            title: 'Ship to Cloudflare',
            body: 'Deploy with Wrangler. Your site runs on Cloudflare Workers with D1, KV, and R2 available — global edge, zero cold starts, free tier generous.',
            code: 'wrangler deploy'
          },
        ].map((s, i) => (
          <Reveal delay={i * 0.1} class="step">
            <div class="step-num">{s.n}</div>
            <div class="step-content">
              <h3 class="step-title">{s.title}</h3>
              <p class="step-body">{s.body}</p>
              <code class="step-code">{s.code}</code>
            </div>
            {i < 2 && <div class="step-arrow">→</div>}
          </Reveal>
        ))}
      </div>
    </div>
  </section>

  <!-- ── 08 · Demo ─────────────────────────────────────────────── -->
  <section class="section section-alt">
    <div class="container">
      <Reveal>
        <p class="eyebrow">Try it live — right here</p>
        <h2 class="section-title">This page is the demo</h2>
        <p class="section-sub">
          Every feature on this page is running live. Switch themes in the nav, chat
          with the AI agent in the corner, and inspect the motion as you scroll.
          What you see is what your clients get.
        </p>
      </Reveal>

      <div class="demo-grid">
        <div class="demo-card" style="--card-color:var(--color-primary)">
          <div class="demo-card-icon" style="color:var(--color-primary)">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M20.188 10.934a8 8 0 1 0-8.688 9.134"/></svg>
          </div>
          <h3 class="demo-card-title">Theme switcher</h3>
          <p class="demo-card-body">
            Six preset themes + dark/light mode. Click the colour swatches in the
            top-right nav. Your client's brand replaces the presets in one.config.ts.
          </p>
          <div class="demo-card-hint">↑ Try the nav swatches</div>
        </div>
        <div class="demo-card" style="--card-color:var(--color-secondary)">
          <div class="demo-card-icon" style="color:var(--color-secondary)">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
          </div>
          <h3 class="demo-card-title">AI chat widget</h3>
          <p class="demo-card-body">
            The chat icon in the bottom-right is plugin-chat, loaded from one.ie
            with zero bundle cost. Swap the agent ID in one.config.ts to connect
            your own agent.
          </p>
          <div class="demo-card-hint">↘ Chat is live in the corner</div>
        </div>
        <div class="demo-card" style="--card-color:var(--color-tertiary)">
          <div class="demo-card-icon" style="color:var(--color-tertiary)">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m5 3 14 9-14 9V3z"/></svg>
          </div>
          <h3 class="demo-card-title">Scroll animations</h3>
          <p class="demo-card-body">
            Every section on this page uses Reveal or Stagger — CSS
            animation-timeline:view() with a motion fallback. No layout shift,
            no JS bundle cost.
          </p>
          <a href="/motion" class="demo-card-hint">See all motion components →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Config detail ─────────────────────────────────────────── -->
  <section class="section">
    <div class="container container-split">
      <div class="split-text">
        <Reveal>
          <p class="eyebrow">One file. Total control.</p>
          <h2 class="section-title">Your entire site configured in one.config.ts</h2>
          <p class="section-sub">
            Change a brand colour — every component updates. Add a plugin — the feature
            wires itself. Point at your backend — all API routes switch.
            No hunting through component files.
          </p>
          <div class="feature-list">
            <div class="feature-row">
              <span class="feature-dot"></span>
              Brand tokens cascade to every component and the design page
            </div>
            <div class="feature-row">
              <span class="feature-dot"></span>
              Plugins self-wire — chat, auth, payments, analytics
            </div>
            <div class="feature-row">
              <span class="feature-dot"></span>
              Backend baseUrl — point at one.ie or your own deployment
            </div>
          </div>
        </Reveal>
      </div>

      <Reveal delay={0.1} class="split-code">
        <pre class="code-block"><code><span class="tok-kw">import</span> <span class="tok-b">&#123;</span> defineOne <span class="tok-b">&#125;</span> <span class="tok-kw">from</span> <span class="tok-str">'@oneie/frontend'</span>
<span class="tok-kw">import</span> <span class="tok-b">&#123;</span> auth, track, chat <span class="tok-b">&#125;</span> <span class="tok-kw">from</span> <span class="tok-str">'@oneie/frontend/plugins'</span>

<span class="tok-kw">export default</span> defineOne(<span class="tok-b">&#123;</span>
  backend: <span class="tok-b">&#123;</span>
    baseUrl: <span class="tok-str">'https://one.ie'</span>,
  <span class="tok-b">&#125;</span>,
  brand: <span class="tok-b">&#123;</span>
    tokens: <span class="tok-b">&#123;</span>
      primary:    <span class="tok-str">'hsl(216 55% 25%)'</span>,
      secondary:  <span class="tok-str">'hsl(219 14% 28%)'</span>,
      tertiary:   <span class="tok-str">'hsl(105 22% 25%)'</span>,
      background: <span class="tok-str">'hsl(0 0% 93%)'</span>,
      foreground: <span class="tok-str">'hsl(0 0% 100%)'</span>,
      font:       <span class="tok-str">'hsl(0 0% 13%)'</span>,
    <span class="tok-b">&#125;</span>,
  <span class="tok-b">&#125;</span>,
  plugins: <span class="tok-b">[</span>
    auth(),
    track(<span class="tok-b">&#123;</span> ws: <span class="tok-str">'my-workspace'</span> <span class="tok-b">&#125;</span>),
    chat(<span class="tok-b">&#123;</span> agent: <span class="tok-str">'my-agent'</span> <span class="tok-b">&#125;</span>),
  <span class="tok-b">]</span>,
<span class="tok-b">&#125;</span>)</code></pre>
      </Reveal>
    </div>
  </section>

  <!-- ── 09 · Testimonials ─────────────────────────────────────── -->
  <section class="section section-alt">
    <div class="container">
      <Reveal>
        <p class="eyebrow">What teams say</p>
        <h2 class="section-title">Shipped in days, not weeks</h2>
      </Reveal>

      <div class="testimonial-grid">
        {[
          {
            stars: 5,
            quote: 'We went from wireframe to production in 3 days. The chat plugin alone replaced a $400/mo tool stack. Our clients ask what stack we used — we tell them ONE.',
            name: 'Sarah M.',
            role: 'Head of Growth',
            company: 'Acme Agency',
            result: '3 days to production'
          },
          {
            stars: 5,
            quote: 'The design token system is the first one I\'ve used that actually survives a client rebrand. Change six values, done. No more hunting hex codes across 40 component files.',
            name: 'James L.',
            role: 'Founder',
            company: 'BuildFast Studio',
            result: 'Zero brand drift'
          },
          {
            stars: 5,
            quote: 'We added an AI agent to a client site in an afternoon. It handles first-response support, books appointments, and hands off to a human when confidence drops. Clients love it.',
            name: 'Maya K.',
            role: 'CTO',
            company: 'NorthStack',
            result: '40% fewer support tickets'
          },
        ].map(t => (
          <div class="testimonial-card">
            <div class="testimonial-stars">{'★'.repeat(t.stars)}</div>
            <blockquote class="testimonial-quote">"{t.quote}"</blockquote>
            <div class="testimonial-result">{t.result}</div>
            <div class="testimonial-author">
              <div class="testimonial-avatar">{t.name[0]}{t.name.split(' ')[1]?.[0]}</div>
              <div>
                <div class="testimonial-name">{t.name}</div>
                <div class="testimonial-role">{t.role} · {t.company}</div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── 10 · Metrics ──────────────────────────────────────────── -->
  <section class="metrics-strip">
    <div class="container">
      <div class="metrics-grid">
        {[
          { num: '4,217', label: 'sites deployed' },
          { num: '3.2 days', label: 'average to first deploy' },
          { num: '94%', label: 'teams active after 6 months' },
          { num: '< 80 KB', label: 'JS bundle (gzipped)' },
        ].map(m => (
          <div class="metric">
            <div class="metric-num">{m.num}</div>
            <div class="metric-label">{m.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Plugin tiers ───────────────────────────────────────────── -->
  <section class="section">
    <div class="container">
      <Reveal>
        <p class="eyebrow">Plugin tiers</p>
        <h2 class="section-title">Free to start. Pay only for what you use.</h2>
        <p class="section-sub">
          Free plugins ship full source. Connected plugins are served from one.ie —
          zero bundle cost, auto-updated. Paid plugins unlock advanced capabilities
          behind your API key.
        </p>
      </Reveal>

      <Reveal delay={0.08}>
        <div class="table-wrap">
          <table class="plugin-table">
            <thead>
              <tr>
                <th>Plugin</th>
                <th>Package</th>
                <th>Tier</th>
                <th>What you get</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><code>auth()</code></td>
                <td><code>plugin-auth</code></td>
                <td><span class="tier tier-free">free</span></td>
                <td>better-auth — passkey, social providers, magic link</td>
              </tr>
              <tr>
                <td><code>track()</code></td>
                <td><code>plugin-track</code></td>
                <td><span class="tier tier-connected">connected</span></td>
                <td>Privacy-first analytics pixel — your workspace, your data</td>
              </tr>
              <tr>
                <td><code>chat()</code></td>
                <td><code>plugin-chat</code></td>
                <td><span class="tier tier-connected">connected</span></td>
                <td>AI chat widget — attach any agent, zero bundle cost</td>
              </tr>
              <tr>
                <td><code>backend()</code></td>
                <td><code>plugin-backend</code></td>
                <td><span class="tier tier-connected">connected</span></td>
                <td>ONE API bindings — signals, payments, agent calls</td>
              </tr>
              <tr>
                <td><code>premium()</code></td>
                <td><code>plugin-premium</code></td>
                <td><span class="tier tier-paid">paid</span></td>
                <td>x402 checkout flows and entitlement gating</td>
              </tr>
              <tr>
                <td><code>admin()</code></td>
                <td><code>plugin-admin</code></td>
                <td><span class="tier tier-paid">paid</span></td>
                <td>Hosted admin console — workspace, agents, inbox</td>
              </tr>
            </tbody>
          </table>
        </div>
      </Reveal>
    </div>
  </section>

  <!-- ── Stack ─────────────────────────────────────────────────── -->
  <section class="section section-alt">
    <div class="container">
      <Reveal>
        <p class="eyebrow">The stack</p>
        <h2 class="section-title">Chosen for speed to production.</h2>
