# ONE Backend — set ONE_API_KEY to enable BaaS mode (auth, data, chat, tracking)
# Without it the app runs in standalone mode with local better-auth + D1
# `one onboard` writes ONE_API_KEY + AGENCY_WSID here automatically.
ONE_API_KEY=one_…
ONE_BASE_URL=https://one.ie
AGENCY_WSID=

# Auth (required in standalone mode)
BETTER_AUTH_SECRET=change-me-in-production

# Payments — crypto (optional; used by /wallet's payment-link generator)
PAY_URL=https://pay.one.ie

# Payments — fiat (optional)
STRIPE_SECRET_KEY=sk_live_…
STRIPE_WEBHOOK_SECRET=whsec_…

# AI (optional — used by optional AI routes)
OPENROUTER_API_KEY=sk-or-…
