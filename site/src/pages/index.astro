---
import Layout from '../layouts/Layout.astro'
import Reveal from '../components/motion/Reveal.astro'
import Stagger from '../components/motion/Stagger.astro'
import CountUp from '../components/home/CountUp'
import { LighthouseRings } from '../components/home/LighthouseRings'
import DesignSystem from '../components/design/DesignSystem.astro'
import ThemeGallery from '../components/home/ThemeGallery.astro'
import MotionSection from '../components/home/MotionSection.astro'
import CardDemo from '../components/blocks/demos/CardDemo.astro'
import CarouselDemo from '../components/blocks/demos/CarouselDemo.astro'
import TabsDemo from '../components/blocks/demos/TabsDemo.astro'
import QuoteDemo from '../components/blocks/demos/QuoteDemo.astro'
import ProofTerminal from '../components/lifecycle/ProofTerminal'
import PaymentLinkGenerator from '../components/payments/PaymentLinkGenerator'
import PhysicalCardCheckout from '../components/payments/PhysicalCardCheckout'
import CardCheckoutPreview from '../components/payments/CardCheckoutPreview'
import Button from '../components/blocks/Button.astro'
import Card from '../components/blocks/Card.astro'
import Pattern from '../components/blocks/Pattern.astro'
import Footer from '../components/blocks/Footer.astro'
import { getEnv } from '../lib/cf-env'

// ── Real proof only ───────────────────────────────────────────────────────
// This is a promise page: every number below is measured or verifiable, not
// invented. These Lighthouse scores were measured against THIS page's own
// `bun run build && bun run preview` output (Lighthouse 13.x, headless
// Chrome) — not copied from /speed.astro, which measures a different build.
// The payment link generator mints a real pay.one.ie link on click; the
// on-chain digests are genuine, independently-verifiable Sui testnet txs.
const LIGHTHOUSE_DATE = '2026-07-09'
const DESKTOP_SCORES: [number, number, number, number] = [100, 100, 100, 100]
const MOBILE_PERF = 86

const PROOF_COMMAND =
  'bun pay/tools/agent-onboarding-lifecycle-demo.ts --assert-tracked --api-url https://one.ie'
const PROOF_STEPS = [
  { t: 6.3, ok: true, label: 'register', detail: 'POST /api/auth/agent — no key, no human. uid + apiKey minted, wallet bound at signup.' },
  { t: 16.1, ok: true, label: 'bootstrap', detail: 'agent:bootstrap — own workspace, gid + aid + scopedKey minted.' },
  { t: 17.2, ok: true, label: 'tracked', detail: 'lifecycle:mine — registered→bootstrapped, 2 rows written by rules.' },
]
const PROOF_VERDICT = 'PASS — the funnel filled itself'

const TXS = [
  { digest: 'Bf7V7F6baz5pD9c3KH5vnCR41tUgoebiW3puuBfQRCsh', label: 'Signed transfer', amount: '0.995 SUI', detail: 'A real payer keypair signed and sent funds to this starter\'s wallet — settlement, live.' },
  { digest: 'B6XqzCQEw39xxeMqHCX6WUnBma8KAZdZ9iK5GC7fV9DU', label: 'Faucet drop', amount: '1 SUI', detail: 'Public testnet faucet funding the same wallet /wallet displays.' },
  { digest: 'AdEFmNNB5dDNsFHTdmXfYkSeTBkzTnZveQi4gn75CHBP', label: 'Auto-fund at bootstrap', amount: '0.05 SUI', detail: 'Treasury faucet dispensing to a freshly bootstrapped agent — the funding wall, removed.' },
  { digest: '3rTxWzgh7313MW357q3caSPaQ9aeB1jUXkQprP2EQgaq', label: 'Dispense, repeated', amount: '0.05 SUI', detail: 'Second treasury dispense — and the 24h per-address rate limit held on the retry.' },
]

// Same live/preview switch payments.astro uses — real Stripe Elements the
// moment both keys exist, an honest static preview until then.
const env = await getEnv()
const stripePublishableKey =
  (env.PUBLIC_STRIPE_PUBLISHABLE_KEY as string | undefined) ??
  (env.STRIPE_PUBLIC_KEY as string | undefined)
const stripeLive = Boolean(stripePublishableKey && env.STRIPE_SECRET_KEY)
---

<Layout
  title="ONE — design beautiful websites with perfect Lighthouse scores"
  description="Open-source Astro 7 + React 19 starter with a production design system, motion library, and payment stack. 14 themes, a perfect Lighthouse score, measured against this repo's own build."
>

  <!-- ── Hero — the promise, proven in place ───────────────────────── -->
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <div class="hr hr-0"><div class="badge"><span class="badge-dot"></span>Astro 7 + React 19</div></div>
        <h1 class="hr hr-1 headline">
          Design beautiful websites{' '}
          <span class="headline-gradient">with perfect Lighthouse scores.</span>
        </h1>
        <div class="hr hr-2">
          <p class="sub">
            Clone it and your first build already scores 100 — tokens,
            motion, and payments come wired together, no separate
            integration pass.
          </p>
        </div>
        <div class="hr hr-3">
          <div class="hero-cta-group">
            <div class="hero-actions">
              <Button href="https://github.com/one-ie/one" variant="primary" size="lg">Get started free <Fragment slot="icon-right">→</Fragment></Button>
              <Button href="/design" variant="secondary" size="lg">See the design system</Button>
            </div>
          </div>
        </div>
      </div>

      <!-- The proof is the hero: real Lighthouse scores, not a mockup. -->
      <div class="hr hr-4 hero-proof">
        <div class="proof-glow" aria-hidden="true"></div>
        <div class="proof-card">
          <div class="proof-header">
            <span class="proof-live"><span class="live-dot"></span>Live — not a mockup</span>
            <span class="proof-date">{LIGHTHOUSE_DATE}</span>
          </div>
          <LighthouseRings
            client:visible
            scores={DESKTOP_SCORES}
            caption={`Desktop, this exact page. ${MOBILE_PERF} on throttled Slow 4G.`}
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ── 1 — Design ──────────────────────────────────────────────────── -->
  <div id="design" class="section-alt">
    <DesignSystem full={false} />
  </div>

  <!-- ── 2 — Themes ──────────────────────────────────────────────────── -->
  <div id="themes">
    <ThemeGallery />
  </div>

  <!-- ── 3 — Motion ──────────────────────────────────────────────────── -->
  <div id="motion" class="section-alt">
    <MotionSection />
  </div>

  <!-- ── 4 — Cards ───────────────────────────────────────────────────── -->
  <div id="cards">
    <CardDemo />
  </div>

  <!-- ── 5 — Carousels ───────────────────────────────────────────────── -->
  <div id="carousels" class="section-alt">
    <CarouselDemo />
  </div>

  <!-- ── 6 — Tabs ────────────────────────────────────────────────────── -->
  <div id="tabs">
    <TabsDemo />
  </div>

  <!-- ── 7 — Quotes ──────────────────────────────────────────────────── -->
  <div id="quotes" class="section-alt">
    <QuoteDemo />
  </div>

  <!-- ── 8 — Payments ────────────────────────────────────────────────── -->
  <section id="payments" class="section">
    <div class="container">
      <Reveal class="section-head" dist="lg">
        <p class="eyebrow">Payments, first-class</p>
        <h2 class="section-title">Two rails. Zero custody.</h2>
        <p class="section-sub">
          Every clone ships a working payment stack. Crypto links are live the moment
          you clone; the card rail is a real Stripe scaffold that goes live with your key.
        </p>
      </Reveal>
      <Stagger class="rails-grid" stagger={0.1} dist="md">
        <Card variant="feature" accent="primary" pattern="dots">
          <svg slot="icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="M12 7v10M8.5 9.5c0-1.4 1.6-2.5 3.5-2.5s3.5 1 3.5 2.2c0 3-7 1.6-7 4.6 0 1.4 1.6 2.5 3.5 2.5s3.5-1 3.5-2.2"/></svg>
          <Fragment slot="header">Crypto — live today</Fragment>
          Signed payment links across Sui, Ethereum, Solana, and Bitcoin. Every link is
          Ed25519-signed server-side and verified before it renders — no custody, no
          chargebacks. Settlement is the transaction itself.
          <a slot="footer" href="/payments#try-it" class="card__link">Create one now →</a>
        </Card>
        <Card variant="feature" accent="tertiary" pattern="grid">
          <svg slot="icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2.5" y="5.5" width="19" height="13" rx="2"/><path d="M2.5 9.5h19"/></svg>
          <Fragment slot="header">Card — bring your own key</Fragment>
          Real Stripe Elements, fully wired: <code>/api/pay/create-intent</code> mints
          PaymentIntents and <code>/api/pay/webhook</code> verifies signatures — both
          fail-closed until you add two env vars. Then this exact form is live on your account.
          <a slot="footer" href="/payments" class="card__link">See the card rail →</a>
        </Card>
        <Card variant="feature" accent="secondary" pattern="diagonal">
          <svg slot="icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2" y="7" width="20" height="12" rx="2"/><path d="M2 11h20M6 15h4"/></svg>
          <Fragment slot="header">Wallet — self-hosted</Fragment>
          Run <code>one wallet keygen</code> and your keys never leave your machine. The
          <code>/wallet</code> page reads live on-chain balances over public RPC — no
          backend required. Payment links settle straight to it.
          <a slot="footer" href="/wallet" class="card__link">Open the wallet →</a>
        </Card>
      </Stagger>

      <!-- Live proof widget — mints a real pay.one.ie link on click. -->
      <div class="pay-widget">
        <Reveal>
          <div class="widget-frame">
            <div class="widget-caption">
              <span class="widget-live"><span class="live-dot"></span>Live — not a mockup</span>
              <span class="widget-hint">Create a real link ↓</span>
            </div>
            <PaymentLinkGenerator client:visible />
          </div>
        </Reveal>
      </div>

      <Stagger class="speed-grid" stagger={0.08} dist="md">
        <div class="speed"><div class="speed-v"><CountUp client:visible value="6.3s" /></div><div class="speed-l">to register — no key, no human</div></div>
        <div class="speed"><div class="speed-v"><CountUp client:visible value="16.1s" /></div><div class="speed-l">to a bootstrapped workspace</div></div>
        <div class="speed"><div class="speed-v"><CountUp client:visible value="17.2s" /></div><div class="speed-l">to a tracked, filled funnel</div></div>
      </Stagger>

      <div class="proof-grid">
        <Reveal>
          <ProofTerminal client:visible command={PROOF_COMMAND} steps={PROOF_STEPS} verdict={PROOF_VERDICT} />
        </Reveal>
        <Stagger class="tx-list" stagger={0.08} dist="md">
          {TXS.map((tx) => (
            <a class="tx-card" href={`https://suiscan.xyz/testnet/tx/${tx.digest}`} target="_blank" rel="noopener">
              <div class="tx-top">
                <span class="tx-label">{tx.label}</span>
                <span class="tx-amount">{tx.amount}</span>
              </div>
              <code class="tx-digest">{tx.digest}</code>
              <p class="tx-detail">{tx.detail}</p>
              <span class="tx-verify">Verify on suiscan ↗</span>
            </a>
          ))}
        </Stagger>
      </div>
    </div>
  </section>

  <!-- ── Card checkout — live, its own stage ──────────────────────────── -->
  <section class="card-rail" id="card">
    <Pattern pattern="crosshatch" opacity={0.07} tone="tertiary" />
    <div class="container">
      <Reveal class="card-rail-head">
        <div class="rail-tag rail-tag--card"><span class="rail-dot"></span>Card · your Stripe key</div>
        <h2 class="card-rail-title">And a card form you'd want to fill in.</h2>
        <p class="card-rail-sub">
          Real Stripe Elements dressed as a card — tilts to your cursor, guides you
          field to field, and settles straight to your own Stripe account. It goes
          live the moment you add two env vars; until then it's an honest preview.
        </p>
        <ul class="card-rail-list">
          <li>✓ PCI stays with Stripe — we never see a digit</li>
          <li>✓ Fail-closed without your keys</li>
          <li>✓ Cards, wallets, and Link out of the box</li>
        </ul>
        <a href="/payments" class="card__link">See the full payments page →</a>
      </Reveal>
      <div class="card-rail-widget">
        {stripeLive && stripePublishableKey
          ? <PhysicalCardCheckout client:visible publishableKey={stripePublishableKey} />
          : <CardCheckoutPreview client:visible />}
      </div>
    </div>
  </section>

  <!-- ── Final CTA — the last word before the footer ───────────────── -->
  <section class="section cta-section">
    <Pattern pattern="diagonal" opacity={0.08} tone="contrast" fade />
    <div class="container cta-container">
      <Stagger dist="lg" stagger={0.1}>
        <h2 class="cta-title">Clone it. Ship it. Score 100.</h2>
        <p class="cta-sub">Free forever. No card required. Your first perfect Lighthouse run is one command away.</p>
        <div class="install install-cta">
          <code class="install-cmd">npm create one-app@latest my-site</code>
          <button class="copy-btn copy-btn-cta" onclick="navigator.clipboard.writeText('npm create one-app@latest my-site').then(()=>{this.textContent='Copied';setTimeout(()=>this.textContent='Copy',1500)})">Copy</button>
        </div>
        <div class="hero-actions">
          <a href="https://github.com/one-ie/one" class="btn-cta-primary">View on GitHub →</a>
          <a href="/design" class="btn-cta-secondary">See the design system</a>
        </div>
        <p class="cta-risk">Source-available · Free forever · No card required · Every claim on this page is live</p>
      </Stagger>
    </div>
  </section>

  <Footer
    tagline="The open-source Astro starter that ships a design system, motion, and payments on day one — wired from one.config.ts."
    columns={[
      { heading: 'Product', links: [
        { label: 'Design system', href: '/design' },
        { label: 'Motion', href: '/motion' },
        { label: 'Components', href: '/components' },
        { label: 'Payments', href: '/payments' },
        { label: 'Speed proof', href: '/speed' },
        { label: 'Wallet', href: '/wallet' },
      ] },
      { heading: 'Resources', links: [
        { label: 'Documentation', href: 'https://one.ie/docs' },
        { label: 'GitHub', href: 'https://github.com/one-ie/one', external: true },
        { label: 'Changelog', href: 'https://one.ie/docs' },
      ] },
      { heading: 'Company', links: [
        { label: 'About', href: 'https://one.ie' },
        { label: 'Blog', href: 'https://one.ie' },
        { label: 'Contact', href: 'https://one.ie' },
      ] },
      { heading: 'Legal', links: [
        { label: 'License', href: 'https://github.com/one-ie/one/blob/main/LICENSE' },
        { label: 'Privacy', href: 'https://one.ie' },
        { label: 'Terms', href: 'https://one.ie' },
      ] },
    ]}
    note="Free forever, one license · Built on the open web."
  />

</Layout>

<script>
  // Scroll-spy for the global header — homepage only (this script ships with
  // this page alone). Tags the nav link whose section is in view; the
  // `.one-nav-links a.is-active` style lives with the nav in Layout.astro.
  function wireNavSpy() {
    const links = Array.from(
      document.querySelectorAll<HTMLAnchorElement>('#one-nav .one-nav-links a[href^="/#"]'),
    )
    if (!links.length || links[0].dataset.spyBound) return
    links.forEach((l) => { l.dataset.spyBound = '1' })

    const byId = new Map(links.map((l) => [l.getAttribute('href')!.slice(2), l]))
    const sections = Array.from(byId.keys())
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => !!el)
    if (!sections.length) return

    const io = new IntersectionObserver(
      (entries) => {
        const visible = entries.filter((e) => e.isIntersecting)
        if (!visible.length) return
        links.forEach((l) => l.classList.remove('is-active'))
        byId.get(visible[0].target.id)?.classList.add('is-active')
      },
      { rootMargin: '-30% 0px -60% 0px', threshold: 0 },
    )
    sections.forEach((s) => io.observe(s))
  }
  wireNavSpy()
  document.addEventListener('astro:page-load', wireNavSpy)
</script>

<style>
  /* ── Time-based hero reveal (NOT scroll-driven — above the fold uses
        animation-delay, never animation-timeline:view()). ───────────── */
  .hr { animation: hr-in 0.6s cubic-bezier(0.22, 1, 0.36, 1) both; }
  .hr-0 { animation-delay: 0.02s; }
  .hr-1 { animation-delay: 0.09s; }
  .hr-2 { animation-delay: 0.16s; }
  .hr-3 { animation-delay: 0.23s; }
  .hr-4 { animation-delay: 0.30s; }
  @keyframes hr-in {
    from { opacity: 0; transform: translateY(18px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .hr { animation: none; opacity: 1; transform: none; }
  }

  /* Smooth in-page jumps for the global nav's #design/#themes/etc. links —
     page-scoped (this stylesheet only loads on the homepage), so Layout.astro's
     global scroll behavior for every other page is untouched. */
  :global(html) { scroll-behavior: smooth; }
  @media (prefers-reduced-motion: reduce) {
    :global(html) { scroll-behavior: auto; }
  }

  /* ── Section anchors — offset for the sticky #one-nav so a jump doesn't
        tuck the heading under it. ─────────────────────────────────────── */
  :global(#design), :global(#themes), :global(#motion), :global(#cards),
  :global(#carousels), :global(#tabs), :global(#quotes), :global(#payments),
  :global(#card) {
    scroll-margin-top: calc(var(--nav-total-h) + 16px);
  }

  /* ── Layout shells ─────────────────────────────────────────────── */
  .container { max-width: var(--content); margin: 0 auto; padding: 0 1.5rem; }
  .section { padding: 7rem 0; }
  .section-alt {
    background: color-mix(in oklab, var(--color-primary) 7%, var(--color-foreground));
    /* A theme can fill --color-foreground with a saturated brand tone
       (Plum, in light mode) — shadow the derived typography tokens so
       everything nested (custom sections + demo components alike, which
       all read var(--color-font)/var(--color-muted)) resolves against
       on-foreground instead. */
    --color-font: var(--color-on-foreground);
    --color-muted: color-mix(in oklab, var(--color-on-foreground) 60%, transparent);
    --color-border: color-mix(in oklab, var(--color-on-foreground) 12%, transparent);
    --color-border-strong: color-mix(in oklab, var(--color-on-foreground) 24%, transparent);
    padding: 1px 0; /* clip margin collapse from nested sections */
  }
  .section-alt .eyebrow { color: var(--color-accent-on-foreground); }

  :global(.section-head) { max-width: 42rem; margin: 0 auto 3.5rem; text-align: center; }
  :global(.section-head) .section-sub { margin-left: auto; margin-right: auto; }

  .eyebrow {
    font-size: 0.72rem; font-weight: 700; letter-spacing: 0.12em;
    text-transform: uppercase; color: var(--color-primary); margin: 0 0 0.75rem;
  }
  .section-title {
    font-size: clamp(2rem, 4.5vw, 3rem); font-weight: 700; letter-spacing: -0.035em;
    color: var(--color-font); margin: 0 0 1rem; line-height: 1.12;
  }
  .section-sub {
    font-size: 1.05rem; color: var(--color-muted); line-height: 1.7;
    max-width: 40rem; margin: 0;
  }
  .section-sub code {
    font-family: 'SF Mono', 'Fira Code', monospace; font-size: 0.82rem; color: var(--color-tertiary);
  }

  /* ── Hero ───────────────────────────────────────────────────────── */
  .hero { padding: clamp(4.5rem, 10vw, 8rem) 0 clamp(3rem, 7vw, 5rem); position: relative; overflow: hidden; }
  .hero::before {
    /* inset:0 (not a %-of-self height like 130%) — the old sizing measured
       against .hero's own content-driven box height, so any sub-pixel
       reflow (hydration, font metrics settling) recomputed this pseudo-
       element's box too and Lighthouse counted it as a layout shift
       (CLS 0.25, intermittent under CPU throttling). .hero's overflow:
       hidden still clips the gradient the same as the old overscan did. */
    content: ''; position: absolute; inset: 0;
    background: radial-gradient(60% 55% at 22% 15%,
      color-mix(in oklab, var(--color-primary) 14%, transparent), transparent 70%),
      radial-gradient(50% 45% at 85% 10%,
      color-mix(in oklab, var(--color-tertiary) 12%, transparent), transparent 70%);
    pointer-events: none; z-index: 0;
  }
  /* Widen just the hero: at the site's standard 56rem content width, a
     67px display headline has ~440px to work with and shatters into
     single-word lines. The hero earns extra room; other sections keep
     the narrower rhythm. */
  .hero .container { max-width: 78rem; }
  .hero-grid {
    display: grid; grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(2.5rem, 5vw, 4.5rem); align-items: center;
    position: relative; z-index: 1;
  }
  @media (max-width: 900px) { .hero-grid { grid-template-columns: 1fr; } }

  .hero-copy { display: flex; flex-direction: column; gap: 1.5rem; }

  .badge {
    display: inline-flex; align-items: center; gap: 0.5rem; font-size: 0.72rem; font-weight: 600;
    letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-primary);
    background: color-mix(in oklab, var(--color-primary) 10%, transparent);
    border: 1px solid color-mix(in oklab, var(--color-primary) 20%, transparent);
    border-radius: 9999px; padding: 0.35rem 0.95rem 0.35rem 0.8rem;
  }
  .badge-dot {
    width: 6px; height: 6px; border-radius: 9999px; background: var(--color-primary);
    box-shadow: 0 0 0 0 color-mix(in oklab, var(--color-primary) 55%, transparent);
    animation: live-pulse 2s ease-out infinite;
  }
  @media (prefers-reduced-motion: reduce) { .badge-dot { animation: none; } }
  .headline {
    font-size: clamp(2.25rem, 3.4vw, 3.5rem); font-weight: 800; line-height: 1.14;
    letter-spacing: -0.03em; color: var(--color-font); margin: 0;
  }
  .headline-gradient {
    background: linear-gradient(90deg, var(--color-primary), var(--color-tertiary));
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .sub {
    font-size: 1.15rem; color: var(--color-muted); line-height: 1.65;
    max-width: 34rem; margin: 0;
  }

  .hero-cta-group { display: flex; flex-direction: column; gap: 0.85rem; }
  .hero-actions { display: flex; gap: 0.75rem; flex-wrap: wrap; }

  /* ── Hero proof — the live Lighthouse card ──────────────────────── */
  .hero-proof { position: relative; }
  .proof-glow {
    position: absolute; inset: -1.5rem;
    background: linear-gradient(135deg,
      color-mix(in oklab, var(--color-primary) 20%, transparent),
      color-mix(in oklab, var(--color-tertiary) 20%, transparent));
    filter: blur(48px); border-radius: 28px; z-index: 0;
  }
  .proof-card {
    position: relative; z-index: 1;
    border: 1px solid var(--color-border); border-radius: var(--radius-lg);
    background: var(--color-background); box-shadow: var(--shadow-card);
    padding: 1.5rem 1.5rem 1.75rem;
  }
  .proof-header {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 1.5rem; padding-bottom: 1rem; border-bottom: 1px solid var(--color-border);
    font-size: 0.72rem;
  }
  .proof-live {
    display: inline-flex; align-items: center; gap: 0.4rem; font-weight: 700;
    letter-spacing: 0.04em; text-transform: uppercase; color: var(--color-primary);
  }
  .live-dot {
    width: 7px; height: 7px; border-radius: 9999px; background: var(--color-success);
    box-shadow: 0 0 0 0 color-mix(in oklab, var(--color-success) 60%, transparent);
    animation: live-pulse 2s ease-out infinite;
  }
  @keyframes live-pulse {
    0% { box-shadow: 0 0 0 0 color-mix(in oklab, var(--color-success) 55%, transparent); }
    70% { box-shadow: 0 0 0 7px transparent; }
    100% { box-shadow: 0 0 0 0 transparent; }
