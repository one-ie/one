---
import Layout from '../layouts/Layout.astro'
import Reveal from '../components/motion/Reveal.astro'
import Stagger from '../components/motion/Stagger.astro'
import { LighthouseRings } from '../components/home/LighthouseRings'
import DesignSystem from '../components/design/DesignSystem.astro'
import ThemeGallery from '../components/home/ThemeGallery.astro'
import MotionSection from '../components/home/MotionSection.astro'
import CardDemo from '../components/blocks/demos/CardDemo.astro'
import CarouselDemo from '../components/blocks/demos/CarouselDemo.astro'
import TabsDemo from '../components/blocks/demos/TabsDemo.astro'
import QuoteDemo from '../components/blocks/demos/QuoteDemo.astro'
import PaymentLinkGenerator from '../components/payments/PaymentLinkGenerator'
import PhysicalCardCheckout from '../components/payments/PhysicalCardCheckout'
import CardCheckoutPreview from '../components/payments/CardCheckoutPreview'
import Card from '../components/blocks/Card.astro'
import Pattern from '../components/blocks/Pattern.astro'
import Footer from '../components/blocks/Footer.astro'
import { getEnv, getCfCtx } from '../lib/cf-env'
import { SITE } from '../lib/seo-site'
import { edgeCache, normalizeRepo, readStars, starsNote } from '../lib/github-stars'

// ── Real proof only ───────────────────────────────────────────────────────
// This is a promise page: every number below is measured or verifiable, not
// invented. Re-measured 2026-09-14 on Astro 7.3.2, Lighthouse 13.2.0,
// headless Chrome, against `wrangler dev` — the SAME worker runtime and the
// SAME brotli encoding production serves, on localhost so the reading is the
// site and not the tester's own connection.
//
// Desktop `--preset=desktop`: 3 runs, Performance 100 in all three.
//   LCP 0.5-0.6s, CLS 0.001.
// Mobile stock preset (Slow 4G): 3 runs — 100, 99, 98.
//   FCP 1.1-1.2s, LCP 1.2-1.3s, CLS 0.008.
// Accessibility, Best Practices and SEO: raw 1.0 in all six runs.
// Cross-checked against the deployed site (template.one.ie): 100/100/100/100
// desktop AND mobile.
//
// WHY THE RECIPE CHANGED, because the old number was an artifact of it:
// `astro preview` serves the document UNCOMPRESSED — 421 KB where production
// sends 69.7 KB brotli, a 6x transfer penalty on a simulated Slow 4G link.
// That recipe scored mobile 76-89. It was measuring the preview server, not
// the site. `wrangler dev` is the honest local read: same runtime, same
// encoding, no network in the way.
//
// The payment link generator mints a real pay.one.ie link on click.
const LIGHTHOUSE_DATE = '2026-09-14'
const DESKTOP_SCORES: [number, number, number, number] = [100, 100, 100, 100]
const MOBILE_PERF = 100

// Same live/preview switch payments.astro uses — real Stripe Elements the
// moment both keys exist, an honest static preview until then.
const env = await getEnv()
const stripePublishableKey =
  (env.PUBLIC_STRIPE_PUBLISHABLE_KEY as string | undefined) ??
  (env.STRIPE_PUBLIC_KEY as string | undefined)
const stripeLive = Boolean(stripePublishableKey && env.STRIPE_SECRET_KEY)

// ── Open source, live ─────────────────────────────────────────────────────
// The repo whose stars are shown comes from site config (SITE.repo, or the
// SITE_REPO var). Unset in a fresh clone, so it shows no count — never ONE's.
// The count is read at the edge and cached (lib/github-stars.ts); the page
// says how old it is.
const repo = normalizeRepo(env.SITE_REPO || SITE.repo)
const repoUrl = repo ? `https://github.com/${repo}` : ''
const zipUrl = repo ? `${repoUrl}/archive/refs/heads/main.zip` : ''
const cfCtx = await getCfCtx()
const now = Date.now()
const stars = await readStars(repo, {
  cache: edgeCache(),
  fetch: globalThis.fetch.bind(globalThis),
  now: () => now,
  waitUntil: cfCtx ? (p) => cfCtx.waitUntil(p) : undefined,
  token: env.GITHUB_TOKEN || undefined,
})
const starsLine = stars ? starsNote(stars, now) : ''

const CREATE = 'npx oneie create my-app'
const cloneSteps = `git clone ${repoUrl} my-app\ncd my-app && bun install\ncd site && bun run dev`
// The same three commands a person types, in the order an agent can run them
// unattended. `oneie init` writes the key to ~/.config/one/key and @oneie/mcp
// reads that file, so step 3 needs no key pasted.
const agentSteps = `npx oneie create my-app
npx oneie init
claude mcp add oneie -- npx -y @oneie/mcp`

// npm figures are the @oneie packages every clone runs on, ALL-TIME, measured
// 2026-10-08 (ONE's own npm download counter). Never hand-edit one
// alone; re-measure and change them together.
const NPM_ORG = 'https://www.npmjs.com/org/oneie'
const chips: Array<{ value: string; label: string; href?: string; gold?: boolean }> = [
  ...(stars
    ? [
        { value: stars.stars.toLocaleString('en-US'), label: 'GitHub stars', href: `${repoUrl}/stargazers`, gold: true },
        { value: stars.forks.toLocaleString('en-US'), label: 'forks', href: `${repoUrl}/forks`, gold: true },
      ]
    : []),
  { value: '75,248', label: '@oneie npm downloads, all time', href: NPM_ORG },
  { value: '31', label: '@oneie packages', href: NPM_ORG },
]

// The five words. Keys are made on one.ie or offline with `one wallet keygen`;
// the other four run on this site.
const pillars = [
  {
    word: 'Keys',
    line: 'One key, made in your browser or offline, for Sui, Ethereum, Solana, Bitcoin and ASI.',
    proof: 'The secret never leaves your device. Nobody can hold it, freeze it or lose it, and nobody can get it back for you either.',
    href: 'https://one.ie/key',
    cta: 'Make a key',
  },
  {
    word: 'Wallets',
    line: 'Wallets on standard derivation paths, read live over public RPC.',
    proof: 'Any wallet can open them, and @oneie/recover restores them offline. No backend needed.',
    href: '/wallet',
    cta: 'Open the wallet',
  },
  {
    word: 'Products',
    line: 'A shop, product pages, a cart and checkout.',
    proof: 'Your catalog is files in your own repository. Add a product by adding a file, and it is for sale on the next deploy.',
    href: '/products/',
    cta: 'See the shop',
  },
  {
    word: 'Payments',
    line: 'Signed crypto payment links, and a card rail on your own Stripe account.',
    proof: 'Nobody holds the money in between. Moving money costs gas, and the sponsored path adds 1%. Cards go live when you add your Stripe keys.',
    href: '/payments',
    cta: 'Watch a payment clear',
  },
  {
    word: 'Sovereign',
    line: 'It runs on your own Cloudflare account, with no ONE account and no API key.',
    proof: 'Your key and the code leave with you. Self-hosted, your data is in your own database.',
    href: '/docs/',
    cta: 'Read the docs',
  },
]

const GITHUB_MARK =
  'M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12'
const STAR =
  'M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z'
---

<Layout
  title={`${SITE.name} — the open-source template for AI agents`}
  description="Keys, wallets, products and payments on your own Cloudflare account. Free and open source: clone it, deploy it, keep the brand and it is yours to sell."
>

  <!-- ── Hero — open source, proven in place: live stars, then install ─ -->
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <div class="hr hr-0">
          {repo ? (
            <a class="star-pill" href={`${repoUrl}/stargazers`} target="_blank" rel="noopener noreferrer">
              <span class="star-pill-label">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={GITHUB_MARK} /></svg>
                Star {repo} on GitHub
              </span>
              {stars && (
                <span class="star-pill-count">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={STAR} /></svg>
                  {stars.stars.toLocaleString('en-US')}
                </span>
              )}
            </a>
          ) : (
            <div class="badge"><span class="badge-dot"></span>Free and open source</div>
          )}
        </div>
        <h1 class="hr hr-1 headline">
          {SITE.name} is{' '}
          <span class="headline-gradient">open source.</span>
        </h1>
        <div class="hr hr-2">
          <p class="sub">
            The template for building and deploying AI agents. Keys, wallets, products
            and payments, on your own Cloudflare account. Free. Keep the brand, and it
            is yours to sell.
          </p>
        </div>
        <ul class="hr hr-3 proof-chips" aria-label="Proof">
          {chips.map((c) => {
            const Tag = c.href ? 'a' : 'span'
            return (
              <li>
                <Tag
                  class:list={['chip', c.gold && 'chip--gold']}
                  {...(c.href ? { href: c.href, target: '_blank', rel: 'noopener noreferrer' } : {})}
                >
                  <strong>{c.value}</strong> {c.label}
                </Tag>
              </li>
            )
          })}
        </ul>
        {stars && <p class="hr hr-3 stars-note" data-stars-source={stars.source}>{starsLine}</p>}
      </div>

      <!-- The proof is the hero: real Lighthouse scores, not a mockup. -->
      <div class="hr hr-4 hero-proof">
        <div class="proof-glow" aria-hidden="true"></div>
        <div class="proof-card">
          <div class="proof-header">
            <span class="proof-live"><span class="live-dot"></span>Live — not a mockup</span>
            <span class="proof-date">{LIGHTHOUSE_DATE}</span>
          </div>
          <LighthouseRings
            client:visible
            scores={DESKTOP_SCORES}
            caption={`Desktop, measured ${LIGHTHOUSE_DATE} on this site's earlier front page. ${MOBILE_PERF} on throttled Slow 4G.`}
          />
        </div>
      </div>
    </div>

    <!-- Install — for a person and for an agent, side by side -->
    <div class="container install-grid">
      <article class="install-card">
        <div class="install-card-head">
          <h2>Install it</h2>
          <span>No account, no API key</span>
        </div>
        <div class="install">
          <code class="install-cmd">{CREATE}</code>
          <button type="button" class="copy-btn" data-copy={CREATE}>Copy</button>
        </div>
        {repo && (
          <div class="install-links">
            <button type="button" class="install-link" data-copy={cloneSteps}>git clone</button>
            <a class="install-link" href={zipUrl}>Download .zip</a>
            <a class="install-link" href={repoUrl} target="_blank" rel="noopener noreferrer">GitHub</a>
          </div>
        )}
        <p class="install-note">
          A running site at <code>localhost:4321</code> with a shop, checkout, auth and
          docs. The only prerequisite is <a href="https://bun.sh" target="_blank" rel="noopener noreferrer">Bun</a>.
        </p>
      </article>
      <article class="install-card" id="agents">
        <div class="install-card-head">
          <h2>For your agent</h2>
          <span>Runs unattended</span>
        </div>
        <pre class="agent-steps"><code>{agentSteps}</code></pre>
        <button type="button" class="copy-btn copy-btn--wide" data-copy={agentSteps}>Copy for your agent</button>
        <p class="install-note">
          The site, then a workspace and key with no account, then every ONE tool in
          Claude Code, Cursor or any MCP client.
        </p>
      </article>
    </div>
  </section>

  <!-- ── The five words ─────────────────────────────────────────────── -->
  <section class="section five-words" aria-labelledby="five-words">
    <div class="container">
      <Reveal class="section-head" dist="lg">
        <p class="eyebrow">What you get</p>
        <h2 id="five-words" class="section-title">Five words, all in the box.</h2>
      </Reveal>
      <div class="pillars">
        {pillars.map((p) => (
          <a class="pillar" href={p.href}>
            <h3>{p.word}</h3>
            <p class="pillar-line">{p.line}</p>
            <p class="pillar-proof">{p.proof}</p>
            <span class="card__link">{p.cta} →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ── 1 — Design ──────────────────────────────────────────────────── -->
  <div id="design" class="section-alt">
    <DesignSystem full={false} />
  </div>

  <!-- ── 2 — Themes ──────────────────────────────────────────────────── -->
  <div id="themes">
    <ThemeGallery />
  </div>

  <!-- ── 3 — Motion ──────────────────────────────────────────────────── -->
  <div id="motion" class="section-alt">
    <MotionSection />
  </div>

  <!-- ── 4 — Cards ───────────────────────────────────────────────────── -->
  <div id="cards">
    <CardDemo />
  </div>

  <!-- ── 5 — Carousels ───────────────────────────────────────────────── -->
  <div id="carousels" class="section-alt">
    <CarouselDemo />
  </div>

  <!-- ── 6 — Tabs ────────────────────────────────────────────────────── -->
  <div id="tabs">
    <TabsDemo />
  </div>

  <!-- ── 7 — Quotes ──────────────────────────────────────────────────── -->
  <div id="quotes" class="section-alt">
    <QuoteDemo />
  </div>

  <!-- ── 8 — Payments ────────────────────────────────────────────────── -->
  <section id="payments" class="section">
    <div class="container">
      <Reveal class="section-head" dist="lg">
        <p class="eyebrow">Payments, first-class</p>
        <h2 class="section-title">Two rails. Zero custody.</h2>
        <p class="section-sub">
          Every clone ships a working payment stack. Crypto links are live the moment
          you clone; the card rail is a real Stripe scaffold that goes live with your key.
        </p>
      </Reveal>
      <Stagger class="rails-grid" stagger={0.1} dist="md">
        <Card variant="feature" accent="primary" pattern="dots">
          <svg slot="icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="M12 7v10M8.5 9.5c0-1.4 1.6-2.5 3.5-2.5s3.5 1 3.5 2.2c0 3-7 1.6-7 4.6 0 1.4 1.6 2.5 3.5 2.5s3.5-1 3.5-2.2"/></svg>
          <Fragment slot="header">Crypto — live today</Fragment>
          Signed payment links across Sui, Ethereum, Solana, and Bitcoin. Every link is
          Ed25519-signed server-side and verified before it renders — no custody, no
          chargebacks. Settlement is the transaction itself.
          <a slot="footer" href="/payments#try-it" class="card__link">Create one now →</a>
        </Card>
        <Card variant="feature" accent="tertiary" pattern="grid">
          <svg slot="icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2.5" y="5.5" width="19" height="13" rx="2"/><path d="M2.5 9.5h19"/></svg>
          <Fragment slot="header">Card — bring your own key</Fragment>
          Real Stripe Elements, fully wired: <code>/api/pay/create-intent</code> mints
          PaymentIntents and <code>/api/pay/webhook</code> verifies signatures — both
          fail-closed until you add two env vars. Then this exact form is live on your account.
          <a slot="footer" href="/payments" class="card__link">See the card rail →</a>
        </Card>
        <Card variant="feature" accent="secondary" pattern="diagonal">
          <svg slot="icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2" y="7" width="20" height="12" rx="2"/><path d="M2 11h20M6 15h4"/></svg>
          <Fragment slot="header">Wallet — self-hosted</Fragment>
          Run <code>one wallet keygen</code> and your keys never leave your machine. The
          <code>/wallet</code> page reads live on-chain balances over public RPC — no
          backend required. Payment links settle straight to it.
          <a slot="footer" href="/wallet" class="card__link">Open the wallet →</a>
        </Card>
      </Stagger>

      <!-- Live proof widget — mints a real pay.one.ie link on click. -->
      <div class="pay-widget">
        <Reveal>
          <div class="widget-frame">
            <div class="widget-caption">
              <span class="widget-live"><span class="live-dot"></span>Live — not a mockup</span>
              <span class="widget-hint">Create a real link ↓</span>
            </div>
            <PaymentLinkGenerator client:visible />
          </div>
        </Reveal>
      </div>

    </div>
  </section>

  <!-- ── Card checkout — live, its own stage ──────────────────────────── -->
  <section class="card-rail" id="card">
    <Pattern pattern="crosshatch" opacity={0.07} tone="tertiary" />
    <div class="container">
      <Reveal class="card-rail-head">
        <div class="rail-tag rail-tag--card"><span class="rail-dot"></span>Card · your Stripe key</div>
        <h2 class="card-rail-title">And a card form you'd want to fill in.</h2>
        <p class="card-rail-sub">
          Real Stripe Elements dressed as a card — tilts to your cursor, guides you
          field to field, and settles straight to your own Stripe account. It goes
          live the moment you add two env vars; until then it's an honest preview.
        </p>
        <ul class="card-rail-list">
          <li>✓ PCI stays with Stripe — we never see a digit</li>
          <li>✓ Fail-closed without your keys</li>
          <li>✓ Cards, wallets, and Link out of the box</li>
        </ul>
        <a href="/payments" class="card__link">See the full payments page →</a>
      </Reveal>
      <div class="card-rail-widget">
        {stripeLive && stripePublishableKey
          ? <PhysicalCardCheckout client:visible publishableKey={stripePublishableKey} />
          : <CardCheckoutPreview client:visible />}
      </div>
    </div>
  </section>

  <!-- ── Final CTA — the last word before the footer ───────────────── -->
  <section class="section cta-section">
    <Pattern pattern="diagonal" opacity={0.08} tone="contrast" fade />
    <div class="container cta-container">
      <Stagger dist="lg" stagger={0.1}>
        <h2 class="cta-title">Clone it. Ship it. Measure it yourself.</h2>
        <p class="cta-sub">Free forever. No card required. Your first Lighthouse run is one command away.</p>
        <div class="install install-cta">
          <code class="install-cmd">{CREATE}</code>
          <button type="button" class="copy-btn copy-btn-cta" data-copy={CREATE}>Copy</button>
        </div>
        <div class="hero-actions">
          {repo && <a href={repoUrl} class="btn-cta-primary">View on GitHub →</a>}
          <a href="/design" class="btn-cta-secondary">See the design system</a>
        </div>
        <p class="cta-risk">Source-available · Free forever · No card required · Every claim on this page is live</p>
      </Stagger>
    </div>
  </section>

  <Footer
    tagline="The open-source Astro starter that ships a design system, motion, and payments on day one — wired from one.config.ts."
    columns={[
      { heading: 'Product', links: [
        { label: 'Design system', href: '#' },
        { label: 'Motion', href: '#' },
        { label: 'Components', href: '#' },
        { label: 'Payments', href: '#' },
        { label: 'Speed proof', href: '#' },
        { label: 'Wallet', href: '#' },
      ] },
      { heading: 'Resources', links: [
        { label: 'Documentation', href: '#' },
        { label: 'GitHub', href: '#' },
        { label: 'Changelog', href: '#' },
      ] },
      { heading: 'Company', links: [
        { label: 'About', href: '#' },
        { label: 'Blog', href: '#' },
        { label: 'Contact', href: '#' },
      ] },
      { heading: 'Legal', links: [
        { label: 'License', href: '#' },
        { label: 'Privacy', href: '#' },
        { label: 'Terms', href: '#' },
      ] },
    ]}
    note="Free forever, one license · Built on the open web."
  />

</Layout>

<script>
  // Scroll-spy for the global header — homepage only (this script ships with
  // this page alone). Tags the nav link whose section is in view; the
  // `.one-nav-links a.is-active` style lives with the nav in Layout.astro.
  function wireNavSpy() {
    const links = Array.from(
      document.querySelectorAll<HTMLAnchorElement>('#one-nav .one-nav-links a[href^="/#"]'),
    )
    if (!links.length || links[0].dataset.spyBound) return
    links.forEach((l) => { l.dataset.spyBound = '1' })

    const byId = new Map(links.map((l) => [l.getAttribute('href')!.slice(2), l]))
    const sections = Array.from(byId.keys())
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => !!el)
    if (!sections.length) return

    const io = new IntersectionObserver(
      (entries) => {
        const visible = entries.filter((e) => e.isIntersecting)
        if (!visible.length) return
        links.forEach((l) => l.classList.remove('is-active'))
        byId.get(visible[0].target.id)?.classList.add('is-active')
      },
      { rootMargin: '-30% 0px -60% 0px', threshold: 0 },
    )
    sections.forEach((s) => io.observe(s))
  }
  wireNavSpy()
  document.addEventListener('astro:page-load', wireNavSpy)

  // Copy buttons: data-copy holds the text; the label flips to "Copied".
  function wireCopy() {
    document.querySelectorAll<HTMLButtonElement>('button[data-copy]').forEach((b) => {
      if (b.dataset.copyBound) return
      b.dataset.copyBound = '1'
      const label = b.textContent ?? 'Copy'
      b.addEventListener('click', () => {
        navigator.clipboard.writeText(b.dataset.copy ?? '').then(() => {
          b.textContent = 'Copied'
          setTimeout(() => { b.textContent = label }, 1500)
        })
      })
    })
  }
  wireCopy()
  document.addEventListener('astro:page-load', wireCopy)
</script>

<style>
  /* ── Time-based hero reveal (NOT scroll-driven — above the fold uses
        animation-delay, never animation-timeline:view()). ───────────── */
  .hr { animation: hr-in 0.6s cubic-bezier(0.22, 1, 0.36, 1) both; }
  .hr-0 { animation-delay: 0.02s; }
  .hr-1 { animation-delay: 0.09s; }
  .hr-2 { animation-delay: 0.16s; }
  .hr-3 { animation-delay: 0.23s; }
  .hr-4 { animation-delay: 0.30s; }
  @keyframes hr-in {
    from { opacity: 0; transform: translateY(18px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .hr { animation: none; opacity: 1; transform: none; }
  }

  /* Smooth in-page jumps for the global nav's #design/#themes/etc. links —
     page-scoped (this stylesheet only loads on the homepage), so Layout.astro's
     global scroll behavior for every other page is untouched. */
  :global(html) { scroll-behavior: smooth; }
  @media (prefers-reduced-motion: reduce) {
    :global(html) { scroll-behavior: auto; }
  }

  /* ── Section anchors — offset for the sticky #one-nav so a jump doesn't
        tuck the heading under it. ─────────────────────────────────────── */
  :global(#design), :global(#themes), :global(#motion), :global(#cards),
