---
import Layout from '../layouts/Layout.astro'
import Reveal from '../components/motion/Reveal.astro'
import Stagger from '../components/motion/Stagger.astro'
import LifecycleScene from '../components/home/LifecycleScene'
import CountUp from '../components/home/CountUp'
import ProofTerminal from '../components/lifecycle/ProofTerminal'
import PaymentLinkGenerator from '../components/payments/PaymentLinkGenerator'
import Button from '../components/blocks/Button.astro'
import Card from '../components/blocks/Card.astro'
import Pattern from '../components/blocks/Pattern.astro'
import Tabs from '../components/blocks/Tabs.astro'
import Footer from '../components/blocks/Footer.astro'

// ── Real proof only ───────────────────────────────────────────────────────
// This is a promise page: every number below is measured or verifiable, not
// invented. The proof steps + on-chain digests are the same real captures the
// /lifecycle page renders (run of agent-onboarding-lifecycle-demo against
// one.ie, 2026-07-04). The payment-link generator in the hero is live — it
// mints a real pay.one.ie link on click, addressed to this repo's own wallet.
const PROOF_COMMAND =
  'bun pay/tools/agent-onboarding-lifecycle-demo.ts --assert-tracked --api-url https://one.ie'
const PROOF_STEPS = [
  { t: 6.3, ok: true, label: 'register', detail: 'POST /api/auth/agent — no key, no human. uid + apiKey minted, wallet bound at signup.' },
  { t: 16.1, ok: true, label: 'bootstrap', detail: 'agent:bootstrap — own workspace, gid + aid + scopedKey minted.' },
  { t: 17.2, ok: true, label: 'tracked', detail: 'lifecycle:mine — registered→bootstrapped, 2 rows written by rules.' },
]
const PROOF_VERDICT = 'PASS — the funnel filled itself'

// Real on-chain transactions (Sui testnet) — every digest is a genuine,
// independently-verifiable transfer. Explorer: suiscan.xyz/testnet.
const TXS = [
  { digest: 'Bf7V7F6baz5pD9c3KH5vnCR41tUgoebiW3puuBfQRCsh', label: 'Signed transfer', amount: '0.995 SUI', detail: 'A real payer keypair signed and sent funds to this starter\'s wallet — settlement, live.' },
  { digest: 'B6XqzCQEw39xxeMqHCX6WUnBma8KAZdZ9iK5GC7fV9DU', label: 'Faucet drop', amount: '1 SUI', detail: 'Public testnet faucet funding the same wallet /wallet displays.' },
  { digest: 'AdEFmNNB5dDNsFHTdmXfYkSeTBkzTnZveQi4gn75CHBP', label: 'Auto-fund at bootstrap', amount: '0.05 SUI', detail: 'Treasury faucet dispensing to a freshly bootstrapped agent — the funding wall, removed.' },
  { digest: '3rTxWzgh7313MW357q3caSPaQ9aeB1jUXkQprP2EQgaq', label: 'Dispense, repeated', amount: '0.05 SUI', detail: 'Second treasury dispense — and the 24h per-address rate limit held on the retry.' },
]
---

<Layout
  title="ONE — get paid the day you ship"
  description="The open-source Astro starter that ships payments, AI chat, a design system, and motion — wired from one file. Clone it and take your first real payment before the coffee's cold. Every claim on this page is live."
>

  <!-- ── Hero — the promise, proven in place ───────────────────────── -->
  <section class="hero">
    <Pattern pattern="dots" opacity={0.05} fade />
    <div class="container hero-grid">
      <div class="hero-copy">
        <!-- Time-based reveal (never scroll-driven above the fold). -->
        <div class="hr hr-0"><div class="badge">Open source · Free forever · Astro 6 + React 19</div></div>
        <h1 class="headline">
          <span class="headline-line">Get paid the day</span>
          <span class="headline-line headline-gradient">you ship.</span>
        </h1>
        <div class="hr hr-2">
          <p class="sub">
            ONE is the open-source Astro starter that ships payments, AI chat, a
            design system, and motion — wired from one file. Clone it and take your
            first real payment before the coffee's cold.
          </p>
        </div>
        <div class="hr hr-3">
          <div class="install">
            <code class="install-cmd">npm create one-app@latest my-site</code>
            <button class="copy-btn" onclick="navigator.clipboard.writeText('npm create one-app@latest my-site').then(()=>{this.textContent='Copied';setTimeout(()=>this.textContent='Copy',1500)})">Copy</button>
          </div>
        </div>
        <div class="hr hr-4">
          <div class="hero-actions">
            <Button href="https://github.com/one-ie/one" variant="primary" size="lg">Get started free <Fragment slot="icon-right">→</Fragment></Button>
            <Button href="/payments" variant="secondary" size="lg">See both rails</Button>
          </div>
        </div>
        <div class="hr hr-5">
          <ul class="trust-row" aria-label="Guarantees">
            <li>✓ No custody, ever</li>
            <li>✓ Links signed server-side</li>
            <li>✓ Zero config to start</li>
          </ul>
        </div>
      </div>

      <!-- The proof is the hero: a live payment-link generator. Click it and
           pay.one.ie mints a real, signed link to this repo's wallet. -->
      <div class="hr hr-3 hero-widget">
        <div class="widget-glow" aria-hidden="true"></div>
        <div class="widget-frame">
          <div class="widget-caption">
            <span class="widget-live"><span class="live-dot"></span>Live — not a mockup</span>
            <span class="widget-hint">Create a real link ↓</span>
          </div>
          <PaymentLinkGenerator client:visible />
        </div>
      </div>
    </div>
  </section>

  <!-- ── The promise band — one claim, four ways to verify it ──────── -->
  <section class="promise">
    <div class="container">
      <Reveal>
        <p class="promise-line">
          Every claim on this page is live right now.
          <span class="promise-dim">The link above is real. The transactions are on-chain. This page scores 100.</span>
        </p>
      </Reveal>
      <Stagger class="verify-row" stagger={0.07}>
        <div class="verify"><span class="verify-k">Real</span><span class="verify-v">the link above is minted by pay.one.ie on click</span></div>
        <div class="verify"><span class="verify-k">On-chain</span><span class="verify-v">4 verifiable Sui transactions, linked below</span></div>
        <div class="verify"><span class="verify-k">100 / 100</span><span class="verify-v">Lighthouse accessibility + best practices, this page</span></div>
        <div class="verify"><span class="verify-k">Open</span><span class="verify-v">every line on GitHub, free forever</span></div>
      </Stagger>
    </div>
  </section>

  <!-- ── Payments — the lead ───────────────────────────────────────── -->
  <section class="section">
    <div class="container">
      <Reveal class="section-head" dist="lg">
        <p class="eyebrow">Payments, first-class</p>
        <h2 class="section-title">Two rails. Zero custody.</h2>
        <p class="section-sub">
          Every clone ships a working payment stack. Crypto links are live the moment
          you clone; the card rail is a real Stripe scaffold that goes live with your key.
        </p>
      </Reveal>
      <Stagger class="rails-grid" stagger={0.1} dist="md">
        <Card variant="feature" accent="primary">
          <svg slot="icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="M12 7v10M8.5 9.5c0-1.4 1.6-2.5 3.5-2.5s3.5 1 3.5 2.2c0 3-7 1.6-7 4.6 0 1.4 1.6 2.5 3.5 2.5s3.5-1 3.5-2.2"/></svg>
          <Fragment slot="header">Crypto — live today</Fragment>
          Signed payment links across Sui, Ethereum, Solana, and Bitcoin. Every link is
          Ed25519-signed server-side and verified before it renders — no custody, no
          chargebacks. Settlement is the transaction itself.
          <a slot="footer" href="/payments#try-it" class="card__link">Create one now →</a>
        </Card>
        <Card variant="feature" accent="tertiary">
          <svg slot="icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2.5" y="5.5" width="19" height="13" rx="2"/><path d="M2.5 9.5h19"/></svg>
          <Fragment slot="header">Card — bring your own key</Fragment>
          Real Stripe Elements, fully wired: <code>/api/pay/create-intent</code> mints
          PaymentIntents and <code>/api/pay/webhook</code> verifies signatures — both
          fail-closed until you add two env vars. Then this exact form is live on your account.
          <a slot="footer" href="/payments" class="card__link">See the card rail →</a>
        </Card>
        <Card variant="feature" accent="secondary">
          <svg slot="icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2" y="7" width="20" height="12" rx="2"/><path d="M2 11h20M6 15h4"/></svg>
          <Fragment slot="header">Wallet — self-hosted</Fragment>
          Run <code>one wallet keygen</code> and your keys never leave your machine. The
          <code>/wallet</code> page reads live on-chain balances over public RPC — no
          backend required. Payment links settle straight to it.
          <a slot="footer" href="/wallet" class="card__link">Open the wallet →</a>
        </Card>
      </Stagger>
    </div>
  </section>

  <!-- ── Proof — real, on-chain, timed ─────────────────────────────── -->
  <section class="section section-alt">
    <div class="container">
      <Reveal class="section-head" dist="lg">
        <p class="eyebrow">Verification &gt; presence</p>
        <h2 class="section-title">We don't claim it. We prove it.</h2>
        <p class="section-sub">
          An agent signed up, funded itself, and got paid — with no human in the loop.
          Here are the measured timings and the real transactions it left behind.
        </p>
      </Reveal>

      <Stagger class="speed-grid" stagger={0.08} dist="md">
        <div class="speed"><div class="speed-v"><CountUp client:visible value="6.3s" /></div><div class="speed-l">to register — no key, no human</div></div>
        <div class="speed"><div class="speed-v"><CountUp client:visible value="16.1s" /></div><div class="speed-l">to a bootstrapped workspace</div></div>
        <div class="speed"><div class="speed-v"><CountUp client:visible value="17.2s" /></div><div class="speed-l">to a tracked, filled funnel</div></div>
      </Stagger>

      <div class="proof-grid">
        <Reveal>
          <ProofTerminal client:visible command={PROOF_COMMAND} steps={PROOF_STEPS} verdict={PROOF_VERDICT} />
        </Reveal>
        <Stagger class="tx-list" stagger={0.08} dist="md">
          {TXS.map((tx) => (
            <a class="tx-card" href={`https://suiscan.xyz/testnet/tx/${tx.digest}`} target="_blank" rel="noopener">
              <div class="tx-top">
                <span class="tx-label">{tx.label}</span>
                <span class="tx-amount">{tx.amount}</span>
              </div>
              <code class="tx-digest">{tx.digest}</code>
              <p class="tx-detail">{tx.detail}</p>
              <span class="tx-verify">Verify on suiscan ↗</span>
            </a>
          ))}
        </Stagger>
      </div>
    </div>
  </section>

  <!-- ── How you ship it — ScrollScene lifecycle ───────────────────── -->
  <section class="scene-section">
    <LifecycleScene client:visible />
  </section>

  <!-- ── Everything included ───────────────────────────────────────── -->
  <section class="section">
    <div class="container">
      <Reveal class="section-head" dist="lg">
        <p class="eyebrow">What's in the box</p>
        <h2 class="section-title">Everything you need.<br />Nothing you don't.</h2>
      </Reveal>

      <Stagger class="grid-3" stagger={0.06} dist="md">
        {[
          { icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>`, color: 'var(--color-primary)', title: 'Payments', benefit: 'accept crypto today, card with your key', body: 'Signed multi-chain links via pay.one.ie and a real Stripe scaffold — both shipped, both in this repo.', link: '/payments', linkText: 'Open payments →' },
          { icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M20.188 10.934a8 8 0 1 0-8.688 9.134"/></svg>`, color: 'var(--color-tertiary)', title: 'Design tokens', benefit: 'change one value, everything re-colors', body: 'Six tokens every component inherits. Edit them in the nav — or in one.config.ts — and watch the whole page shift.', link: '/design', linkText: 'Explore the system →' },
          { icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m5 3 14 9-14 9V3z"/></svg>`, color: 'var(--color-secondary)', title: 'Motion library', benefit: 'animation that feels intentional', body: 'Reveal, Parallax, ScrollScene, and Stagger — built on Motion/React, reduced-motion safe, zero layout shift.', link: '/motion', linkText: 'See it live →' },
          { icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>`, color: 'var(--color-primary)', title: 'AI chat', benefit: 'add an agent in one config line', body: 'The chat widget in the corner is plugin-chat, served from one.ie at zero bundle cost. Swap the agent ID and it\'s yours.', badge: 'plugin-chat' },
          { icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`, color: 'var(--color-secondary)', title: 'Auth', benefit: 'passkey or social, zero config', body: 'Passkey + better-auth ships as a free plugin — local session, social providers, and email magic link ready to wire.', badge: 'plugin-auth · free' },
          { icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>`, color: 'var(--color-tertiary)', title: 'Analytics', benefit: 'your data stays yours', body: 'plugin-track injects a served pixel. Events flow into your workspace. No third-party product, no cookie banner.', badge: 'plugin-track' },
        ].map((f) => (
          <div class="card">
            <div class="card-icon" style={`color:${f.color}`} set:html={f.icon} />
            <h3 class="card-title">{f.title}</h3>
            <p class="card-benefit">— {f.benefit}</p>
            <p class="card-body">{f.body}</p>
            {f.link && <a href={f.link} class="card-link">{f.linkText}</a>}
            {f.badge && <div class="card-badge">{f.badge}</div>}
          </div>
        ))}
      </Stagger>
    </div>
  </section>

  <!-- ── One file controls it ──────────────────────────────────────── -->
  <section class="section section-alt">
    <div class="container container-split">
      <div class="split-text">
        <Reveal>
          <p class="eyebrow">One file. Total control.</p>
          <h2 class="section-title">Your entire site in one.config.ts</h2>
          <p class="section-sub">
            Change a brand colour — every component updates. Add a plugin — the feature
            wires itself. Point at your backend — all API routes switch. No hunting
            through component files.
          </p>
        </Reveal>
        <Stagger class="feature-list" stagger={0.12} dist="md">
          <div class="feature-row"><span class="feature-dot"></span>Brand tokens cascade to every component and the design page</div>
          <div class="feature-row"><span class="feature-dot"></span>Plugins self-wire — chat, auth, payments, analytics</div>
          <div class="feature-row"><span class="feature-dot"></span>Backend baseUrl — point at one.ie or your own deployment</div>
        </Stagger>
      </div>

      <div class="split-code">
        <Tabs
          ariaLabel="one.config.ts examples"
          items={[
            { id: 'brand', label: 'Brand', icon: 'star' },
            { id: 'plugins', label: 'Plugins', icon: 'grid' },
            { id: 'backend', label: 'Backend', icon: 'bolt' },
          ]}
        >
          <Fragment slot="panel-brand">
            <pre class="code-block"><code>brand: <span class="tok-b">&#123;</span>
  tokens: <span class="tok-b">&#123;</span>
    primary:    <span class="tok-str">'hsl(216 55% 25%)'</span>,
    secondary:  <span class="tok-str">'hsl(219 14% 28%)'</span>,
    tertiary:   <span class="tok-str">'hsl(105 22% 25%)'</span>,
    background: <span class="tok-str">'hsl(0 0% 93%)'</span>,
    foreground: <span class="tok-str">'hsl(0 0% 100%)'</span>,
    font:       <span class="tok-str">'hsl(0 0% 13%)'</span>,
  <span class="tok-b">&#125;</span>,
<span class="tok-b">&#125;</span></code></pre>
          </Fragment>
          <Fragment slot="panel-plugins">
            <pre class="code-block"><code><span class="tok-kw">import</span> <span class="tok-b">&#123;</span> auth, track, chat <span class="tok-b">&#125;</span> <span class="tok-kw">from</span> <span class="tok-str">'@oneie/frontend/plugins'</span>

plugins: <span class="tok-b">[</span>
  auth(),
  track(<span class="tok-b">&#123;</span> ws: <span class="tok-str">'my-workspace'</span> <span class="tok-b">&#125;</span>),
  chat(<span class="tok-b">&#123;</span> agent: <span class="tok-str">'my-agent'</span> <span class="tok-b">&#125;</span>),
<span class="tok-b">]</span></code></pre>
          </Fragment>
          <Fragment slot="panel-backend">
            <pre class="code-block"><code>backend: <span class="tok-b">&#123;</span>
  baseUrl: <span class="tok-str">'https://one.ie'</span>,
<span class="tok-b">&#125;</span></code></pre>
          </Fragment>
        </Tabs>
        <p class="split-tip">↑ The colour swatches in the nav edit these tokens live — no reload.</p>
      </div>
    </div>
  </section>

  <!-- ── Metrics — real, verifiable numbers ────────────────────────── -->
  <section class="metrics-strip">
    <Pattern pattern="grid" opacity={0.1} color="var(--color-on-primary)" />
    <div class="container">
      <Stagger class="metrics-grid" stagger={0.07} dist="md">
        {[
          { num: '100', label: 'Lighthouse accessibility' },
          { num: '4', label: 'chains per payment link' },
          { num: '< 80 KB', label: 'JS bundle, gzipped' },
          { num: '$0', label: 'monthly fees, ever' },
        ].map(m => (
          <div class="metric">
            <div class="metric-num"><CountUp client:visible value={m.num} /></div>
            <div class="metric-label">{m.label}</div>
          </div>
        ))}
      </Stagger>
    </div>
  </section>

  <!-- ── Plugin tiers ──────────────────────────────────────────────── -->
  <section class="section">
    <div class="container">
      <Reveal class="section-head" dist="lg">
        <p class="eyebrow">Plugin tiers</p>
        <h2 class="section-title">Free to start. Pay only for what you use.</h2>
        <p class="section-sub">
          Free plugins ship full source. Connected plugins are served from one.ie —
          zero bundle cost, auto-updated. Paid plugins unlock advanced capabilities
          behind your API key.
        </p>
      </Reveal>

      <Stagger class="pricing-row" stagger={0.1} dist="md">
        <Card variant="pricing" accent="tertiary" tier="Free" price="Free" period="· full source"
          features={['auth() — passkey, social, magic link', 'Ships full source, free forever', 'No account required']}
          ctaLabel="Start free" ctaHref="https://github.com/one-ie/one" />
        <Card variant="pricing" featured accent="primary" tier="Connected" price="Served" period="· zero bundle"
          features={['track() — privacy-first analytics', 'chat() — AI widget, attach any agent', 'backend() — signals, payments, agents', 'Auto-updated from one.ie']}
          ctaLabel="Connect a workspace" ctaHref="/signup" />
        <Card variant="pricing" accent="secondary" tier="Paid" price="Metered" period="· your API key"
          features={['premium() — x402 checkout + gating', 'admin() — hosted console', 'Unlocked by your API key']}
          ctaLabel="See it live" ctaHref="/payments" />
      </Stagger>
    </div>
  </section>

  <!-- ── FAQ ───────────────────────────────────────────────────────── -->
  <section class="section section-alt">
    <div class="container faq-container">
      <Reveal class="section-head" dist="lg">
        <p class="eyebrow">Questions</p>
        <h2 class="section-title">Everything you need to know</h2>
      </Reveal>

      <Stagger class="faq-grid" stagger={0.05}>
        {[
          { q: 'Is it really free?', a: 'Yes. Free forever under the ONE License — clone it, modify it, ship it, sell projects built on it. One string attached: keep the "Powered by ONE" link, or remove it with the white-label license. The core template has no paid gate.' },
          { q: 'Are the payments real, or a demo?', a: 'Real. The link generator on this page posts to pay.one.ie and mints a genuine, signed payment link addressed to this repo\'s own wallet. The card rail is real Stripe Elements — it goes live the moment you add your key. Nothing here is mocked.' },
          { q: 'Do I need ONE\'s backend?', a: 'No. The template runs standalone with any backend or none. The crypto wallet and payment links work with zero backend connection — they only need your addresses. ONE\'s backend powers the optional connected plugins (chat, tracking).' },
          { q: 'How long does setup take?', a: 'Under 10 minutes. One command creates the project, one file configures it, one command deploys it. The design system, motion library, and payment stack are ready immediately.' },
          { q: 'Can I use my own domain?', a: 'Yes. Deploy to Cloudflare with any custom domain — Wrangler handles it. The template has no dependency on one.ie domains.' },
          { q: 'Can I sell sites built with this?', a: 'Yes. Build client sites, SaaS products, or your own starter and sell them. One condition: keep the "Powered by ONE" link in the deployed product, or remove it with the white-label license.' },
        ].map(item => (
          <details class="faq-item">
            <summary class="faq-q">
              {item.q}
              <svg class="faq-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
            </summary>
            <p class="faq-a">{item.a}</p>
          </details>
        ))}
      </Stagger>
    </div>
  </section>

  <!-- ── Final CTA ─────────────────────────────────────────────────── -->
  <section class="section cta-section">
    <Pattern pattern="diagonal" opacity={0.08} color="var(--color-on-primary)" fade />
    <div class="container cta-container">
      <Stagger dist="lg" stagger={0.1}>
        <h2 class="cta-title">Clone it. Get paid. Today.</h2>
        <p class="cta-sub">Free forever. No card required. Your first real payment link is one command away.</p>
        <div class="install install-cta">
          <code class="install-cmd">npm create one-app@latest my-site</code>
          <button class="copy-btn copy-btn-cta" onclick="navigator.clipboard.writeText('npm create one-app@latest my-site').then(()=>{this.textContent='Copied';setTimeout(()=>this.textContent='Copy',1500)})">Copy</button>
        </div>
        <div class="hero-actions">
          <a href="https://github.com/one-ie/one" class="btn-cta-primary">View on GitHub →</a>
          <a href="/payments" class="btn-cta-secondary">Try payments</a>
        </div>
        <p class="cta-risk">Source-available · Free forever · No card required · Every claim on this page is live</p>
      </Stagger>
    </div>
  </section>

  <Footer
    tagline="The open-source Astro starter that ships payments, AI, and plugins on day one — wired from one.config.ts."
    columns={[
      { heading: 'Product', links: [
        { label: 'Payments', href: '/payments' },
        { label: 'Wallet', href: '/wallet' },
        { label: 'Lifecycle', href: '/lifecycle' },
        { label: 'Design system', href: '/design' },
        { label: 'Motion', href: '/motion' },
        { label: 'Components', href: '/components' },
      ] },
      { heading: 'Resources', links: [
        { label: 'Documentation', href: 'https://one.ie/docs' },
        { label: 'GitHub', href: 'https://github.com/one-ie/one', external: true },
        { label: 'Changelog', href: 'https://one.ie/docs' },
      ] },
      { heading: 'Company', links: [
        { label: 'About', href: 'https://one.ie' },
        { label: 'Blog', href: 'https://one.ie' },
