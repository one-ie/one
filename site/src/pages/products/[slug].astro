---
import Layout from '../../layouts/Layout.astro'
import Reveal from '../../components/motion/Reveal.astro'
import Pattern from '../../components/blocks/Pattern.astro'
import Footer from '../../components/blocks/Footer.astro'
import PaymentLinkGenerator from '../../components/payments/PaymentLinkGenerator'
import { getCollection } from 'astro:content'

export const prerender = true

export async function getStaticPaths() {
  const products = await getCollection('products')
  return products.map((p) => ({ params: { slug: p.id }, props: { product: p } }))
}

const { product } = Astro.props
---

<Layout
  title={`${product.data.name} — ONE`}
  description={product.data.description}
>
  <section class="hero">
    <Pattern pattern="dots" opacity={0.09} color="var(--color-primary)" fade />
    <div class="container">
      <nav class="back">
        <a href="/products">← All products</a>
      </nav>

      <div class="layout">
        <Reveal class="details">
          <span class="price">${(product.data.priceCents / 100).toFixed(2)}</span>
          <h1 class="name">{product.data.name}</h1>
          <p class="desc">{product.data.description}</p>
          <ul class="trust" aria-label="Guarantees">
            <li>✓ Price enforced server-side, never client-set</li>
            <li>✓ Paid straight to the merchant's wallet</li>
            <li>✓ No account needed to buy</li>
          </ul>
        </Reveal>

        <Reveal delay={0.08} class="buy">
          <PaymentLinkGenerator
            client:visible
            catalogProduct={{ slug: product.id, cents: product.data.priceCents, label: product.data.name }}
          />
        </Reveal>
      </div>
    </div>
  </section>

  <Footer
    tagline="The open-source Astro starter that ships payments, AI, and plugins on day one — wired from one.config.ts."
    columns={[
      { heading: 'Product', links: [
        { label: 'Payments', href: '/payments' },
        { label: 'Products', href: '/products' },
        { label: 'Wallet', href: '/wallet' },
      ] },
      { heading: 'Resources', links: [
        { label: 'Documentation', href: 'https://one.ie/docs' },
        { label: 'GitHub', href: 'https://github.com/one-ie/one', external: true },
      ] },
    ]}
    note="Free forever, one license · Built on the open web."
  />
</Layout>

<style>
  .container { max-width: var(--content, 72rem); margin: 0 auto; padding: 0 1.5rem; }
  .hero { position: relative; padding: 3rem 0 5rem; }

  .back { margin-bottom: 2rem; }
  .back a { font-size: 0.85rem; font-weight: 600; color: var(--color-muted); text-decoration: none; }
  .back a:hover { color: var(--color-font); }

  .layout { display: grid; grid-template-columns: 1.1fr 1fr; gap: 3rem; align-items: start; }
  @media (max-width: 860px) { .layout { grid-template-columns: 1fr; } }

  .price { display: inline-block; font-size: 0.95rem; font-weight: 700; color: var(--color-primary); margin-bottom: 0.5rem; }
  .name { font-size: clamp(1.8rem, 4vw, 2.5rem); font-weight: 800; letter-spacing: -0.02em; margin: 0 0 0.75rem; }
  .desc { font-size: 1.05rem; line-height: 1.6; color: var(--color-muted); margin: 0 0 1.5rem; }

  .trust { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.5rem; }
  .trust li { font-size: 0.85rem; color: var(--color-muted); }
</style>
