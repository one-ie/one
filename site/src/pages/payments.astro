---
import Layout from '../layouts/Layout.astro'
import Reveal from '../components/motion/Reveal.astro'
import Stagger from '../components/motion/Stagger.astro'
import Tabs from '../components/blocks/Tabs.astro'
import Button from '../components/blocks/Button.astro'
import Footer from '../components/blocks/Footer.astro'
import Pattern from '../components/blocks/Pattern.astro'
import PaymentLinkGenerator from '../components/payments/PaymentLinkGenerator'
import CardCheckoutPreview from '../components/payments/CardCheckoutPreview'
import PhysicalCardCheckout from '../components/payments/PhysicalCardCheckout'
import { getEnv } from '../lib/cf-env'

export const prerender = false

// Stripe Elements goes live the moment both keys exist — same switch the
// shop plugin's provider:'stripe' checkout uses. No keys → honest preview.
const env = await getEnv()
const stripePublishableKey =
  (env.PUBLIC_STRIPE_PUBLISHABLE_KEY as string | undefined) ??
  (env.STRIPE_PUBLIC_KEY as string | undefined)
const stripeLive = Boolean(stripePublishableKey && env.STRIPE_SECRET_KEY)
---

<Layout
  title="Payments — ONE"
  description="Two rails to get paid, both live on the page: crypto payment links across four chains (no account, no custody) and real Stripe card checkout that goes live with your key."
>

  <!-- ── Hero: the page IS the demo ─────────────────────────────── -->
  <section class="hero" id="top">
    <Pattern pattern="dots" opacity={0.09} color="var(--color-primary)" fade />
    <div class="container">
      <div class="hero-head">
        <!-- Time-based reveal — above the fold is never scroll-driven -->
        <div class="hr hr-0"><span class="eyebrow">Payments, first-class</span></div>
        <h1 class="hr hr-1 headline">
          Two rails to get paid.<br /><span class="grad">Both live, right here.</span>
        </h1>
        <p class="hr hr-2 sub">
          Crypto links work the moment you clone — four chains, no account, no custody.
          Cards are real Stripe Elements that go live with your key. Try both below —
          nothing on this page is a mockup.
        </p>
        <ul class="hr hr-3 trust" aria-label="Guarantees">
          <li>✓ No custody, ever</li>
          <li>✓ Signed server-side</li>
          <li>✓ Cards by Stripe</li>
          <li>✓ Zero config to start</li>
        </ul>
      </div>

      <div class="hr hr-3 hero-rail">
        <div class="rail">
          <div class="rail-tag rail-tag--crypto"><span class="rail-dot"></span>Crypto · live today</div>
          <PaymentLinkGenerator client:visible />
          <p class="rail-foot">A real, signed link to your wallet — created on click, no backend needed. <a href="#card">Prefer a card? ↓</a></p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Card rail — live, its own stage ────────────────────────── -->
  <section class="card-rail" id="card">
    <Pattern pattern="crosshatch" opacity={0.07} color="var(--color-tertiary)" />
    <div class="container">
      <div class="card-rail-grid">
        <div class="card-rail-copy">
          <div class="rail-tag rail-tag--card"><span class="rail-dot"></span>Card · your Stripe key</div>
          <h2 class="card-rail-title">And a card form you'd want to fill in.</h2>
          <p class="card-rail-sub">
            Real Stripe Elements dressed as a card — tilts to your cursor, guides you
            field to field, and settles straight to your own Stripe account. It goes
            live the moment you add two env vars; until then it's an honest preview.
          </p>
          <ul class="card-rail-list">
            <li>✓ PCI stays with Stripe — we never see a digit</li>
            <li>✓ Fail-closed without your keys</li>
            <li>✓ Cards, wallets, and Link out of the box</li>
          </ul>
        </div>
        <div class="card-rail-widget">
          {stripeLive && stripePublishableKey
            ? <PhysicalCardCheckout client:visible publishableKey={stripePublishableKey} />
            : <CardCheckoutPreview client:visible />}
        </div>
      </div>
    </div>
  </section>

  <!-- ── Stats ─────────────────────────────────────────────────── -->
  <section class="stats">
    <div class="container">
      <Stagger stagger={0.07}>
        <div class="stats-grid">
          <div class="stat"><div class="stat-v">4</div><div class="stat-l">chains per link</div></div>
          <div class="stat"><div class="stat-v">✓</div><div class="stat-l">no custody, ever</div></div>
          <div class="stat"><div class="stat-v">$0</div><div class="stat-l">monthly fees</div></div>
          <div class="stat"><div class="stat-v">2</div><div class="stat-l">env vars for cards</div></div>
        </div>
      </Stagger>
    </div>
  </section>

  <!-- ── Which rail? — two trades, side by side ─────────────────── -->
  <section class="choose">
    <div class="container">
      <Reveal class="section-head">
        <p class="eyebrow">Which rail?</p>
        <h2 class="section-title">Two different trades</h2>
        <p class="section-sub">Ship both. Point buyers at whichever fits — or let them choose.</p>
      </Reveal>

      <Stagger stagger={0.1}>
        <div class="trade-grid">
          <article class="trade trade--crypto">
            <header class="trade-head">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="M12 7v10M8.5 9.5c0-1.4 1.6-2.5 3.5-2.5s3.5 1 3.5 2.2c0 3-7 1.6-7 4.6 0 1.4 1.6 2.5 3.5 2.5s3.5-1 3.5-2.2"/></svg>
              <div>
                <h3>Crypto</h3>
                <span class="trade-tag">Live today · no account</span>
              </div>
            </header>
            <ul class="trade-list">
              <li><b>Setup</b><span>Zero — works out of the box</span></li>
              <li><b>Custody</b><span>Never — peer to peer</span></li>
              <li><b>Chargebacks</b><span>None — the transaction is final</span></li>
              <li><b>Fees</b><span>Network gas only</span></li>
              <li><b>Best for</b><span>Agents, global buyers, instant settlement</span></li>
            </ul>
            <a href="#top" class="trade-cta">Create a link ↑</a>
          </article>

          <article class="trade trade--card">
            <header class="trade-head">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2.5" y="5.5" width="19" height="13" rx="2"/><path d="M2.5 9.5h19"/></svg>
              <div>
                <h3>Card</h3>
                <span class="trade-tag">Bring your own key</span>
              </div>
            </header>
            <ul class="trade-list">
              <li><b>Setup</b><span>Your own Stripe key — two env vars</span></li>
              <li><b>Custody</b><span>Held by Stripe until payout</span></li>
              <li><b>Chargebacks</b><span>Possible, per Stripe's terms</span></li>
              <li><b>Fees</b><span>Stripe's standard processing rate</span></li>
              <li><b>Best for</b><span>Familiar checkout, existing card customers</span></li>
            </ul>
            <a href="#top" class="trade-cta">Fill the card ↑</a>
          </article>
        </div>
      </Stagger>
    </div>
  </section>

  <!-- ── How it works ──────────────────────────────────────────── -->
  <section class="how">
    <div class="container">
      <Reveal class="section-head">
        <p class="eyebrow">Crypto, start to settled</p>
        <h2 class="section-title">Three steps, no middle account</h2>
      </Reveal>
      <Stagger stagger={0.1}>
        <div class="how-grid">
          <div class="how-card">
            <div class="how-head"><span class="how-n">01</span><span class="how-chip">✎</span></div>
            <h3>Create</h3>
            <p>One POST — or the form above. The link carries the amount, the chains, and your wallet addresses, signed so nothing can be swapped in transit.</p>
          </div>
          <div class="how-card">
            <div class="how-head"><span class="how-n">02</span><span class="how-chip">↗</span></div>
            <h3>Share</h3>
            <p>It's just a URL and a QR code. Drop it in an invoice, a chat message, a checkout page — anywhere a buyer can tap.</p>
          </div>
          <div class="how-card">
            <div class="how-head"><span class="how-n">03</span><span class="how-chip">✓</span></div>
            <h3>Settle</h3>
            <p>The payer picks a chain and signs. Funds land directly in your wallet — no middle account, nothing to withdraw.</p>
          </div>
        </div>
      </Stagger>
    </div>
  </section>

  <!-- ── Code ──────────────────────────────────────────────────── -->
  <section class="code-section">
    <div class="container">
      <Reveal class="section-head">
        <p class="eyebrow">For developers</p>
        <h2 class="section-title">See it in code</h2>
      </Reveal>
      <Reveal delay={0.08}>
        <Tabs
          ariaLabel="Payment rail code examples"
          items={[
            { id: 'crypto', label: 'Crypto link' },
            { id: 'card', label: 'Card intent' },
          ]}
        >
          <Fragment slot="panel-crypto">
            <pre class="code-block"><code>{`curl -X POST https://pay.one.ie/ \\
  -H 'Content-Type: application/json' \\
  -d '{
    "protocol": "payment_link_create",
    "data": {
      "amount": 25,
      "unit": "usd",
      "product": "Pro plan",
      "merchantSlug": "your-workspace",
      "chains": ["SUI", "ETH", "SOL", "BTC"],
      "treasuries": { "SUI": "0x...", "ETH": "0x..." }
    }
  }'

# → { "success": true, "data": { "url": "https://pay.one.ie/l/...", "qr": "..." } }
# Signed server-side. Visiting the link verifies the signature before it
# renders — an unsigned or tampered link never reaches a payer.`}</code></pre>
          </Fragment>
          <Fragment slot="panel-card">
            <pre class="code-block"><code>{`// src/pages/api/pay/create-intent.ts — real, ships in the starter
const stripe = new Stripe(env.STRIPE_SECRET_KEY, {
  httpClient: Stripe.createFetchHttpClient(),  // runs on Cloudflare Workers
})
const intent = await stripe.paymentIntents.create({
  amount, currency: 'usd',
  automatic_payment_methods: { enabled: true },
})
return Response.json({ clientSecret: intent.client_secret })

// <PhysicalCardCheckout /> mounts live Stripe Elements on that clientSecret.
// The webhook verifies every event's signature (constructEventAsync —
// Workers' SubtleCrypto is async). Fail-closed without the two keys.`}</code></pre>
          </Fragment>
        </Tabs>
      </Reveal>
    </div>
  </section>

  <!-- ── Final CTA ─────────────────────────────────────────────── -->
  <section class="final-cta">
    <div class="container">
      <Reveal>
        <div class="cta-panel">
          <Pattern pattern="grid" opacity={0.08} color="var(--color-primary)" fade />
          <h2 class="cta-title">Clone it. Get paid<br /><span class="grad">today.</span></h2>
          <p class="cta-sub">Run <code>one wallet keygen</code>, share a link, or add your Stripe key. That's the whole setup.</p>
          <div class="cta-actions">
            <Button href="#top" variant="primary" size="lg">Try both rails <Fragment slot="icon-right">↑</Fragment></Button>
            <Button href="https://github.com/one-ie/one" variant="secondary" size="lg">Clone on GitHub</Button>
          </div>
        </div>
      </Reveal>
    </div>
  </section>

  <Footer
    tagline="The open-source Astro starter that ships payments, AI, and plugins on day one — wired from one.config.ts."
    columns={[
      { heading: 'Product', links: [
        { label: 'Payments', href: '/payments' },
        { label: 'Wallet', href: '/wallet' },
        { label: 'Lifecycle', href: '/lifecycle' },
        { label: 'Design system', href: '/design' },
        { label: 'Motion', href: '/motion' },
        { label: 'Components', href: '/components' },
      ] },
      { heading: 'Resources', links: [
        { label: 'Documentation', href: 'https://one.ie/docs' },
        { label: 'GitHub', href: 'https://github.com/one-ie/one', external: true },
        { label: 'Changelog', href: 'https://one.ie/docs' },
      ] },
      { heading: 'Company', links: [
        { label: 'About', href: 'https://one.ie' },
        { label: 'Blog', href: 'https://one.ie' },
        { label: 'Contact', href: 'https://one.ie' },
      ] },
      { heading: 'Legal', links: [
        { label: 'License', href: 'https://github.com/one-ie/one/blob/main/LICENSE' },
        { label: 'Privacy', href: 'https://one.ie' },
        { label: 'Terms', href: 'https://one.ie' },
      ] },
    ]}
    note="Free forever, one license · Built on the open web."
  />
</Layout>

<style>
  .container { max-width: var(--content, 72rem); margin: 0 auto; padding: 0 1.5rem; }

  /* ── Time-based hero reveal ───────────────────────────────────── */
  .hr { animation: hr-in 0.6s cubic-bezier(0.22, 1, 0.36, 1) both; }
  .hr-0 { animation-delay: 0.02s; }
  .hr-1 { animation-delay: 0.10s; }
  .hr-2 { animation-delay: 0.18s; }
  .hr-3 { animation-delay: 0.26s; }
  @keyframes hr-in { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: translateY(0); } }
  @media (prefers-reduced-motion: reduce) { .hr { animation: none; opacity: 1; transform: none; } }

  .eyebrow {
    display: inline-block; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--color-primary); margin: 0 0 1rem;
  }
  .grad {
    background: linear-gradient(90deg, var(--color-primary), var(--color-tertiary));
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }

  /* ── Hero ─────────────────────────────────────────────────────── */
  .hero { padding: clamp(3.5rem, 8vw, 6rem) 0 clamp(2.5rem, 6vw, 4rem); position: relative; overflow: hidden; }
  .hero-head { max-width: 44rem; margin: 0 auto 3rem; text-align: center; position: relative; z-index: 1; }
  .headline {
    font-size: clamp(2.4rem, 6vw, 4rem); font-weight: 800; line-height: 1.04;
    letter-spacing: -0.045em; color: var(--color-font); margin: 0 0 1.4rem;
  }
  .sub {
    font-size: clamp(1.02rem, 1.6vw, 1.18rem); line-height: 1.65; color: var(--color-muted);
    max-width: 40rem; margin: 0 auto 1.6rem;
  }
  .trust {
    display: flex; flex-wrap: wrap; gap: 0.4rem 1.35rem; justify-content: center;
    list-style: none; padding: 0; margin: 0; font-size: 0.8rem; color: var(--color-muted);
  }

  /* Hero rail — the live crypto demo, centred */
  .hero-rail { max-width: 30rem; margin: 0 auto; position: relative; z-index: 1; }
  .rail { display: flex; flex-direction: column; gap: 0.75rem; min-width: 0; }
  .rail-tag {
    display: inline-flex; align-items: center; gap: 0.45rem; align-self: flex-start;
    font-size: 0.72rem; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase;
    padding: 0.28rem 0.7rem; border-radius: 9999px;
  }
  .rail-dot { width: 7px; height: 7px; border-radius: 9999px; background: currentColor; }
  .rail-tag--crypto { color: var(--color-primary); background: color-mix(in oklab, var(--color-primary) 12%, transparent); }
  .rail-tag--card { color: var(--color-tertiary); background: color-mix(in oklab, var(--color-tertiary) 14%, transparent); }
  .rail-foot { font-size: 0.78rem; line-height: 1.5; color: var(--color-muted); margin: 0.1rem 0 0; }
  .rail-foot a { color: var(--color-primary); text-decoration: none; font-weight: 600; white-space: nowrap; }
  .rail-foot a:hover { text-decoration: underline; }

  /* Card rail — its own stage, below the fold (keeps live Stripe out of the
     first paint so the page holds its Lighthouse scores; still fully live). */
  .card-rail { padding: clamp(3rem, 7vw, 5.5rem) 0; border-top: 1px solid var(--color-border); background: color-mix(in oklab, var(--color-tertiary) 4%, var(--color-background)); scroll-margin-top: 4rem; position: relative; overflow: hidden; }
  .card-rail-grid { display: grid; grid-template-columns: 1fr 0.95fr; gap: clamp(2rem, 5vw, 4rem); align-items: center; position: relative; z-index: 1; }
  @media (max-width: 860px) { .card-rail-grid { grid-template-columns: 1fr; gap: 2rem; max-width: 32rem; margin: 0 auto; } }
  .card-rail-copy .rail-tag { margin-bottom: 1.1rem; }
  .card-rail-title { font-size: clamp(1.7rem, 3.5vw, 2.5rem); font-weight: 800; letter-spacing: -0.04em; line-height: 1.1; color: var(--color-font); margin: 0 0 1rem; }
  .card-rail-sub { font-size: 1rem; line-height: 1.65; color: var(--color-muted); margin: 0 0 1.4rem; max-width: 32rem; }
  .card-rail-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.55rem; font-size: 0.88rem; color: var(--color-font); }
  .card-rail-widget { min-width: 0; }

  /* ── Section header ───────────────────────────────────────────── */
  :global(.section-head) { max-width: 40rem; margin: 0 auto 2.75rem; text-align: center; }
  :global(.section-head) .section-sub { margin-left: auto; margin-right: auto; }
  .section-title {
    font-size: clamp(1.7rem, 3.5vw, 2.4rem); font-weight: 700; letter-spacing: -0.035em;
    color: var(--color-font); margin: 0 0 0.6rem; line-height: 1.12;
  }
  .section-sub { font-size: 1rem; color: var(--color-muted); line-height: 1.6; margin: 0; }

  /* ── Stats ────────────────────────────────────────────────────── */
  .stats { border-block: 1px solid var(--color-border); padding: clamp(1.75rem, 4vw, 2.75rem) 0; }
  .stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; text-align: center; }
  @media (max-width: 640px) { .stats-grid { grid-template-columns: repeat(2, 1fr); } }
  .stat-v { font-size: clamp(1.9rem, 4vw, 2.7rem); font-weight: 800; letter-spacing: -0.03em; color: var(--color-font); font-variant-numeric: tabular-nums; }
  .stat-l { font-size: 0.74rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-muted); margin-top: 0.3rem; }

  /* ── Choose / trades ──────────────────────────────────────────── */
  .choose { padding: clamp(3.5rem, 8vw, 6rem) 0; }
  .trade-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem; }
  @media (max-width: 760px) { .trade-grid { grid-template-columns: 1fr; max-width: 28rem; margin: 0 auto; } }
  .trade {
    border: 1px solid var(--color-border); border-radius: var(--radius-lg, 18px);
    padding: 1.75rem; background: var(--color-foreground);
    display: flex; flex-direction: column; gap: 1.1rem;
    transition: border-color var(--ease), transform var(--ease), box-shadow var(--ease);
  }
  .trade:hover { border-color: var(--color-border-strong); transform: translateY(-2px); box-shadow: var(--shadow-pop); }
  .trade-head { display: flex; align-items: center; gap: 0.8rem; }
  .trade-head svg { flex-shrink: 0; width: 38px; height: 38px; padding: 9px; border-radius: 11px; box-sizing: border-box; }
  .trade--crypto .trade-head svg { color: var(--color-primary); background: color-mix(in oklab, var(--color-primary) 12%, transparent); }
  .trade--card .trade-head svg { color: var(--color-tertiary); background: color-mix(in oklab, var(--color-tertiary) 14%, transparent); }
  .trade-head h3 { font-size: 1.15rem; font-weight: 700; color: var(--color-font); margin: 0; }
  .trade-tag { font-size: 0.74rem; color: var(--color-muted); }
  .trade-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
  .trade-list li {
    display: flex; justify-content: space-between; gap: 1rem; padding: 0.6rem 0;
    border-top: 1px solid var(--color-border); font-size: 0.86rem;
  }
  .trade-list li:first-child { border-top: none; }
  .trade-list b { color: var(--color-muted); font-weight: 600; flex-shrink: 0; }
  .trade-list span { color: var(--color-font); text-align: right; }
  .trade-cta { margin-top: auto; font-size: 0.86rem; font-weight: 600; color: var(--color-primary); text-decoration: none; }
  .trade--card .trade-cta { color: var(--color-tertiary); }
  .trade-cta:hover { text-decoration: underline; }

  /* ── How it works ─────────────────────────────────────────────── */
  .how { padding: clamp(2.5rem, 6vw, 4rem) 0; border-top: 1px solid var(--color-border); }
  .how-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
  @media (max-width: 760px) { .how-grid { grid-template-columns: 1fr; } }
  .how-card { border: 1px solid var(--color-border); border-radius: 16px; padding: 1.5rem; background: var(--color-foreground); }
  .how-head { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.9rem; }
  .how-n { font-size: 2rem; font-weight: 800; letter-spacing: -0.04em; color: var(--color-muted); font-variant-numeric: tabular-nums; line-height: 1; }
  .how-chip { display: flex; align-items: center; justify-content: center; width: 32px; height: 32px; border-radius: 9999px; background: color-mix(in oklab, var(--color-primary) 12%, transparent); color: var(--color-primary); font-size: 0.9rem; }
  .how-card h3 { font-size: 1.05rem; font-weight: 700; color: var(--color-font); margin: 0 0 0.4rem; }
  .how-card p { font-size: 0.86rem; line-height: 1.6; color: var(--color-muted); margin: 0; }

  /* ── Code ─────────────────────────────────────────────────────── */
  .code-section { padding: clamp(3rem, 7vw, 5rem) 0; }
  .code-block {
    background: var(--color-foreground); border: 1px solid var(--color-border); border-radius: 14px;
    padding: 1.25rem 1.5rem; margin: 0; overflow-x: auto; font-size: 0.82rem; line-height: 1.65; color: var(--color-font);
  }
  .code-block code { font-family: 'SF Mono', 'Fira Code', monospace; }

  /* ── Final CTA ────────────────────────────────────────────────── */
  .final-cta { padding: clamp(2rem, 6vw, 3.5rem) 0 clamp(4rem, 8vw, 6rem); }
  .cta-panel {
    position: relative; border: 1px solid var(--color-border); border-radius: 24px; overflow: hidden;
    padding: clamp(3rem, 8vw, 5rem) 1.5rem; text-align: center;
    background: linear-gradient(135deg, color-mix(in oklab, var(--color-primary) 12%, transparent), transparent 45%, color-mix(in oklab, var(--color-tertiary) 12%, transparent));
  }
  .cta-title { position: relative; z-index: 1; font-size: clamp(2rem, 5vw, 3.2rem); font-weight: 800; letter-spacing: -0.04em; line-height: 1.08; color: var(--color-font); margin: 0 0 1rem; }
  .cta-sub { position: relative; z-index: 1; font-size: 1.02rem; color: var(--color-muted); max-width: 34rem; margin: 0 auto 2rem; line-height: 1.6; }
  .cta-sub code { font-family: 'SF Mono', 'Fira Code', monospace; font-size: 0.9em; background: var(--color-foreground); border: 1px solid var(--color-border); border-radius: 5px; padding: 0.12em 0.45em; }
  .cta-actions { position: relative; z-index: 1; display: flex; flex-wrap: wrap; gap: 0.85rem; justify-content: center; }
</style>
