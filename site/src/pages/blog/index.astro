---
// blog({ injectRoutes: false }) in one.config.ts — BlogIndex is a bare
// fragment, so this site supplies the actual page: our own Layout (nav,
// <head>, globals.css) wrapping the plugin's real content.
import Layout from '../../layouts/Layout.astro'
import BlogIndex from '@oneie/plugin-blog/BlogIndex.astro'

export const prerender = true
---

<Layout title="ONE Blog — Product Updates, Release Notes, and Engineering Posts" description="Product updates, engineering write-ups, and release notes from the team building the ONE starter and platform.">
  <BlogIndex />
</Layout>
