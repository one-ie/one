---
// blog({ injectRoutes: false }) in one.config.ts — see blog/index.astro.
// Site is output:'server', so this resolves the post at request time.
import Layout from '../../layouts/Layout.astro'
import BlogPost from '@oneie/plugin-blog/BlogPost.astro'
import { getCollection, render } from 'astro:content'

const { slug } = Astro.params
const posts = await getCollection('blog')
const entry = posts.find((p) => p.id === slug)

if (!entry) {
  return Astro.redirect('/blog')
}

const { headings } = await render(entry)
---

<Layout title={`${entry.data.title} — ONE`} description={entry.data.description}>
  <BlogPost entry={entry} headings={headings} />
</Layout>
