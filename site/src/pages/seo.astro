---
export const prerender = true
import Layout from '@/layouts/Layout.astro'
import Button from '@/components/blocks/Button.astro'
import { getCollection } from 'astro:content'
import { buildPiece } from '@jdevalk/seo-graph-core'
import type { FAQPage } from 'schema-dts'
import { SITE } from '@/lib/seo-site'

// Every figure on this page is read from the real content collections or the
// same build this page ships in — nothing here is decorative.
const [blogPosts, docsPages, products] = await Promise.all([
  getCollection('blog'),
  getCollection('docs'),
  getCollection('products'),
])
const samplePost = blogPosts[0]?.id ?? 'hello-template'
const sampleDoc = docsPages[0]?.id ?? 'getting-started'

// The feature catalogue — the spine of the page. Grouped by audience/stage,
// every entry true against what actually shipped. `href` entries are real,
// fetchable URLs (the page's whole ethos: click it, it's live).
const groups = [
  {
    eyebrow: 'Structured data',
    title: 'A linked knowledge graph',
    tagline: 'One @graph of cross-referenced entities, not isolated JSON-LD blobs pasted per page — this is how Google and LLMs actually resolve who an entity is.',
    features: [
      { name: 'Graph on every page', detail: 'Organization + WebSite + WebPage baseline, emitted from one place, deduplicated by @id.' },
      { name: 'Organization with logo + sameAs', detail: 'Real entity disambiguation — linked to the actual GitHub, X, Discord, and LinkedIn profiles, not invented ones.' },
      { name: 'BlogPosting + BreadcrumbList', detail: 'Per post — author, published + git-resolved modified dates, breadcrumb trail.', href: `/blog/${samplePost}/` },
      { name: 'TechArticle + BreadcrumbList', detail: 'Per doc — the technical-reference subtype, chosen deliberately over generic Article.', href: `/docs/${sampleDoc}/` },
      { name: 'FAQPage', detail: 'This page proves it — the questions at the bottom are answered inside its own JSON-LD.' },
      { name: 'Self-checking graph', detail: 'A page referencing an entity that was never defined is a build failure, not a silent gap Google discovers for you.' },
    ],
  },
  {
    eyebrow: 'Discovery',
    title: 'Findable by machines',
    tagline: 'The surface search engines and crawlers read to map the whole site in one pass.',
    features: [
      { name: '/sitemap.xml', detail: 'Every canonical, indexable URL — trailing-slash-correct so crawlers never waste a hop on a redirect, with real git-resolved lastmod dates instead of a build timestamp.', href: '/sitemap.xml' },
      { name: '/rss.xml', detail: 'Every blog post, real dates, canonical trailing-slash-correct links — discoverable from a <link> tag on every page.', href: '/rss.xml' },
      { name: 'robots.txt + Sitemap', detail: 'Permissive by default, AI crawlers allowed, sitemap directive wired.', href: '/robots.txt' },
      { name: '/.well-known/api-catalog', detail: 'RFC 9727 linkset — declares this site as one of four coordinated ONE surfaces.', href: '/.well-known/api-catalog' },
      { name: 'A 404 that helps', detail: 'Real HTTP 404 status, plus a fuzzy-matched "did you mean" against the real sitemap — not a dead end.' },
    ],
  },
  {
    eyebrow: 'AI agents',
    title: 'Built for LLMs, not just crawlers',
    tagline: 'Answer-engine optimization, not retrofitted — almost no templates ship this layer today. ChatGPT, Perplexity, and Claude read this site natively instead of scraping rendered HTML.',
    features: [
      { name: '/llms.txt', detail: 'Auto-generated site summary, one line per page with its real description.', href: '/llms.txt' },
      { name: 'Markdown alternates', detail: 'Every post + doc served as clean .md at a twin URL, with a discovery link on the HTML.', href: `/blog/${samplePost}.md` },
      { name: '/schema.json', detail: 'The corpus-wide graph across blog + docs — one fetch instead of crawling page by page.', href: '/schema.json' },
      { name: '/schema-map.xml', detail: 'Discovery listing of the schema.org endpoints, distinct from the page sitemap.', href: '/schema-map.xml' },
    ],
  },
  {
    eyebrow: 'AI citation',
    title: 'Written to be quoted, not just indexed',
    tagline: 'Answer engines extract a chunk and cite it — not the page. If a paragraph only makes sense after three sentences of setup, it never gets lifted. Every answer here is written to be correct standing alone.',
    features: [
      { name: '/faq', detail: 'Real, sourced answers — license terms, tech stack, what ships by default — each one self-contained and lifted straight into its own FAQPage schema, not written after the fact.', href: '/faq/' },
      { name: 'Direct-answer openings', detail: 'The homepage and this page both lead with the answer in the first sentence, not after a paragraph of scene-setting an engine would have to discard.' },
      { name: 'Structured facts over prose', detail: 'What a real product includes rendered as a checklist on /products, not buried in a sales paragraph an engine has to parse to extract.', href: '/products/' },
      { name: 'No invented numbers', detail: 'Every reused figure (Lighthouse scores, plugin counts) is sourced from one real place and re-verified before it\'s repeated anywhere else — drift between two pages is what erodes an entity\'s citability.' },
    ],
  },
  {
    eyebrow: 'Per page',
    title: 'The fundamentals, automatic',
    tagline: 'Every page inherits these from the shared <Seo> layer — no page has to remember them.',
    features: [
      { name: 'Self-referencing canonical', detail: 'Query-stripped by default; correctly omitted when a page is noindex, per Google guidance.' },
      { name: 'A real default share image', detail: '1200×630, generated from the actual brand tokens — every share gets a real card, not a bare link.', href: '/og.png' },
      { name: 'Article Open Graph', detail: 'Blog posts emit og:type=article with real published/modified timestamps, not the generic website type.' },
      { name: 'Robots meta', detail: 'max-snippet:-1, max-image-preview:large, max-video-preview:-1 — opted in everywhere.' },
      { name: 'noindex control', detail: 'One prop flips a page to noindex and drops its canonical, the correct pairing.' },
      { name: 'Search Console / Bing slots', detail: 'Verification meta tags ready on every page — set an env var, no code change, to go live.' },
    ],
  },
  {
    eyebrow: 'Validation',
    title: 'Caught at build, not in production',
    tagline: 'Most sites find these problems via an audit tool months after they ship. Here they fail the build itself — the checks are the guardrail, not a report.',
    features: [
      { name: 'Exactly one H1', detail: 'Zero or duplicate H1s flagged — a common accessibility and ranking issue.' },
      { name: 'Unique metadata', detail: 'Two pages sharing a title or description is a cannibalisation smell, caught across the corpus.' },
      { name: 'Image alt text', detail: 'Missing alt flagged; alt="" and role="presentation" respected as intentionally decorative.' },
      { name: 'Metadata length', detail: 'Title 30–65, description 70–200 — SERP-truncation-safe bounds, not arbitrary ones.' },
      { name: 'Internal links', detail: 'Trailing-slash redirects and true 404s caught; intentional SSR routes correctly exempt.' },
    ],
  },
  {
    eyebrow: 'Operations',
    title: 'Verified live, then watched',
    tagline: 'Almost nobody re-checks SEO after launch until traffic drops. This runs the same checks on a schedule, so drift is caught the week it happens, not the quarter revenue does.',
    features: [
      { name: 'Launch gate', detail: 'scripts/seo-gate.sh — the pre-launch checklist as runnable checks against a live URL.' },
      { name: 'Drift monitor', detail: 'scripts/seo-drift.sh — snapshots and diffs; a new Disallow line is the loudest alarm.' },
      { name: 'Single identity source', detail: 'One file holds the production origin — rebrand the whole template by editing it alone.' },
      { name: 'IndexNow ready', detail: 'Wired and waiting — deliberately off until the workspace identity is final (a one-way signal).' },
    ],
  },
]

// FAQPage node — assembled the same way the blog/docs pages assemble their
// own schema. The three Q&As below render in both the HTML and this graph.
const faqEntity = buildPiece<FAQPage>({
  '@type': 'FAQPage',
  '@id': `${SITE.url}/seo/#faq`,
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What powers SEO on this template?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: '@jdevalk/astro-seo-graph — a schema.org knowledge-graph builder, not a meta-tag plugin. It links a real, disambiguated Organization entity into every page, enforces SEO fundamentals at build time instead of via an audit tool, and extends discovery to AI answer engines through llms.txt, per-page markdown, and a corpus-wide schema endpoint most templates never build.',
      },
    },
    {
      '@type': 'Question',
      name: 'Can AI agents read this site efficiently?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes — three ways. /llms.txt summarises every page; each blog post and doc is served as clean markdown at a .md twin URL linked from the HTML; and /schema.json returns the whole knowledge graph in one request, so an agent never has to crawl page by page.',
      },
    },
    {
      '@type': 'Question',
      name: 'Is the structured data on this page real?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Real. View source (or curl this page) and the FAQPage entity answering this exact question is in the application/ld+json script tag — the same mechanism every page on this site uses.',
      },
    },
  ],
})
const pageGraph = { '@graph': [faqEntity] }
---

<Layout
  title="SEO on this template — every mechanism, live and clickable | ONE"
  description="A linked schema.org knowledge graph and an AI-agent discovery layer most templates skip — enforced at build time, not left to an audit tool to find later."
  graph={pageGraph}
>
  <main class="mx-auto max-w-[1000px] px-6 py-14 md:py-24">

    <!-- ─── HERO ─── -->
    <header class="mb-14 md:mb-20">
      <div class="text-xs font-bold uppercase tracking-[0.2em] text-tertiary mb-4">SEO · proven, not promised</div>
      <h1 class="text-[2.75rem] md:text-[4.5rem] font-bold leading-[1.02] tracking-tight max-w-[16ch]">
        Every SEO feature this template <span class="text-primary">actually ships.</span>
      </h1>
      <p class="mt-6 text-lg text-font/60 max-w-[62ch] leading-relaxed">
        Most site templates treat SEO as meta tags bolted onto a `&lt;head&gt;`. This one builds a linked schema.org knowledge graph, then extends the same discovery layer to answer engines — ChatGPT, Perplexity, Claude — that don't crawl the way Google does. Core engine:
        <a href="https://github.com/jdevalk/seo-graph/tree/main/packages/astro-seo-graph" class="underline decoration-primary/40 underline-offset-2 hover:decoration-primary">@jdevalk/astro-seo-graph</a>.
        Nothing below is a mockup — click anything.
      </p>
      <div class="mt-8 flex flex-wrap gap-2.5">
        <Button href="/sitemap.xml" variant="secondary" size="sm">sitemap.xml</Button>
        <Button href="/rss.xml" variant="secondary" size="sm">rss.xml</Button>
        <Button href="/schema.json" variant="secondary" size="sm">schema.json</Button>
        <Button href="/.well-known/api-catalog" variant="secondary" size="sm">api-catalog</Button>
        <Button href="/llms.txt" variant="secondary" size="sm">llms.txt</Button>
        <Button href={`/blog/${samplePost}.md`} variant="secondary" size="sm">a page as .md</Button>
        <Button href="/og.png" variant="secondary" size="sm">og:image</Button>
        <Button href="/faq/" variant="secondary" size="sm">/faq</Button>
      </div>
    </header>

    <!-- ─── FEATURE CATALOGUE ─── -->
    <div class="space-y-5 md:space-y-6">
      {groups.map((group, i) => (
        <section
          class="rounded-3xl py-8 px-6 md:py-11 md:px-10 grid md:grid-cols-[minmax(0,240px)_1fr] gap-6 md:gap-12"
          style={`background: color-mix(in oklab, var(--color-primary) 7%, var(--color-foreground)); --color-font: var(--color-on-foreground); --color-border: color-mix(in oklab, var(--color-on-foreground) 12%, transparent);`}
        >
          <div class="md:sticky md:top-24 self-start">
            <div class="flex items-baseline gap-3">
              <span class="text-3xl font-bold tabular-nums text-font/15">{String(i + 1).padStart(2, '0')}</span>
              <span class="text-xs font-bold uppercase tracking-[0.15em]" style={`color: var(--color-accent-on-foreground)`}>{group.eyebrow}</span>
            </div>
            <h2 class="mt-3 text-2xl font-bold tracking-tight leading-tight text-font">{group.title}</h2>
            <p class="mt-2.5 text-sm text-font/55 leading-relaxed max-w-[36ch]">{group.tagline}</p>
          </div>
          <div class="grid sm:grid-cols-2 gap-3.5">
            {group.features.map((f) => (
              <div
                class="rounded-xl p-4"
                style={`background: var(--color-background); border: 1px solid var(--color-border-fixed); box-shadow: var(--shadow-card); --color-font: var(--color-font-fixed);`}
              >
                <div class="flex items-center gap-2">
                  <svg class="shrink-0 text-primary" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M20 6 9 17l-5-5"/></svg>
                  {f.href ? (
                    <a href={f.href} class="font-medium text-[15px] text-font hover:text-primary transition-colors">
                      <span class="font-mono text-[13px]">{f.name}</span> <span class="opacity-30 text-xs">↗</span>
                    </a>
                  ) : (
                    <span class="font-medium text-[15px] text-font">{f.name}</span>
                  )}
                </div>
                <p class="mt-1.5 pl-[23px] text-sm text-font/55 leading-relaxed">{f.detail}</p>
              </div>
            ))}
          </div>
        </section>
      ))}
    </div>

    <!-- ─── FAQ (mirrors the FAQPage in this page's JSON-LD) ─── -->
    <section class="mt-16 md:mt-24">
      <div class="text-xs font-bold uppercase tracking-widest text-tertiary mb-2">Frequently asked</div>
      <h2 class="text-2xl font-bold mb-5 tracking-tight">Answered here — and in this page's schema</h2>
      <div class="divide-y rounded-2xl border" style={`background: var(--color-foreground); border-color: var(--color-border); box-shadow: var(--shadow-card);`}>
        {[
          { q: 'What powers SEO on this template?', a: '@jdevalk/astro-seo-graph — a schema.org knowledge-graph builder, not a meta-tag plugin. It links a real, disambiguated Organization entity into every page, enforces SEO fundamentals at build time instead of via an audit tool, and extends discovery to AI answer engines through llms.txt, per-page markdown, and a corpus-wide schema endpoint most templates never build.' },
          { q: 'Can AI agents read this site efficiently?', a: 'Yes — three ways. /llms.txt summarises every page; each post and doc is served as clean markdown at a .md twin URL linked from the HTML; and /schema.json returns the whole knowledge graph in one request.' },
          { q: 'Is the structured data on this page real?', a: 'Real — view source and the FAQPage entity answering this exact question is in the application/ld+json script tag, the same mechanism every page uses.' },
        ].map((item) => (
          <div class="p-5 md:p-6">
            <div class="font-medium text-[15px] mb-1.5">{item.q}</div>
            <div class="text-sm text-font/60 leading-relaxed">{item.a}</div>
          </div>
        ))}
      </div>
    </section>

    <!-- ─── CLOSING ─── -->
    <section class="mt-16 md:mt-20 flex items-center justify-center gap-3 flex-wrap">
      <Button href="/design/" variant="primary">See the design system</Button>
      <Button href="/speed/" variant="secondary">See the speed proof</Button>
    </section>

  </main>
</Layout>
