---
/**
 * ContactForm — the ONE design-system contact form.
 *
 * A polished, accessible form built from a single reusable field shape:
 * top <label>, hairline-bordered control, helper text, and per-field error +
 * subtle valid states. Pure Astro markup + one small scoped <script> for
 * inline validation UX — no React island.
 *
 * Every control has a real <label for>; invalid controls get aria-invalid +
 * aria-describedby pointing at a live error <p>. Validation runs on submit and
 * on blur, then re-validates on input once a field has errored. Submission is
 * simulated (no network) — the form announces success via an aria-live region.
 *
 * The field markup is rendered HERE (not slotted) so the scoped styles below
 * actually match it — an Astro <style> can't reach slotted children.
 *
 * Tokens only — no hex. Error = --color-destructive, valid = --color-success,
 * focus ring = --color-ring. All states flip with dark mode automatically.
 *
 * Usage:
 *   import ContactForm from '@/components/blocks/ContactForm.astro'
 *   <ContactForm />
 *   <ContactForm submitLabel="Send enquiry" topics={['Sales', 'Support']} />
 */

interface Props {
  /** Form id — also namespaces every field id so two forms can coexist. */
  id?: string
  /** Submit button label. */
  submitLabel?: string
  /** Options for the topic <select>. */
  topics?: string[]
  /** Minimum message length before the message field is considered valid. */
  minMessage?: number
  /** Extra classes, appended after the component's own. */
  class?: string
}

const {
  id = 'contact',
  submitLabel = 'Send message',
  topics = ['General enquiry', 'Sales', 'Support', 'Partnership', 'Press'],
  minMessage = 20,
  class: className,
} = Astro.props

// Per-form id namespace so the component can be rendered more than once.
const f = id
---

<form
  id={`${f}-form`}
  class:list={['one-cf', className]}
  novalidate
  data-min-message={minMessage}
  aria-describedby={`${f}-status`}
>
  <!-- ── Name ──────────────────────────────────────────────────────── -->
  <div class="one-cf__field" data-field>
    <label class="one-cf__label" for={`${f}-name`}>
      Name <span class="one-cf__req" aria-hidden="true">*</span>
    </label>
    <input
      class="one-cf__control"
      id={`${f}-name`}
      name="name"
      type="text"
      required
      autocomplete="name"
      placeholder="Ada Lovelace"
      aria-describedby={`${f}-name-error`}
      data-validate
    />
    <p class="one-cf__error" id={`${f}-name-error`} data-error aria-live="polite"></p>
  </div>

  <!-- ── Email ─────────────────────────────────────────────────────── -->
  <div class="one-cf__field" data-field>
    <label class="one-cf__label" for={`${f}-email`}>
      Email <span class="one-cf__req" aria-hidden="true">*</span>
    </label>
    <input
      class="one-cf__control"
      id={`${f}-email`}
      name="email"
      type="email"
      required
      autocomplete="email"
      placeholder="ada@example.com"
      aria-describedby={`${f}-email-help ${f}-email-error`}
      data-validate
    />
    <p class="one-cf__help" id={`${f}-email-help`}>We'll only use this to reply.</p>
    <p class="one-cf__error" id={`${f}-email-error`} data-error aria-live="polite"></p>
  </div>

  <!-- ── Topic ─────────────────────────────────────────────────────── -->
  <div class="one-cf__field" data-field>
    <label class="one-cf__label" for={`${f}-topic`}>Topic</label>
    <div class="one-cf__select-wrap">
      <select class="one-cf__control" id={`${f}-topic`} name="topic" data-validate>
        {topics.map((t) => <option value={t}>{t}</option>)}
      </select>
      <svg
        class="one-cf__chevron"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
    </div>
  </div>

  <!-- ── Message ───────────────────────────────────────────────────── -->
  <div class="one-cf__field" data-field>
    <label class="one-cf__label" for={`${f}-message`}>
      Message <span class="one-cf__req" aria-hidden="true">*</span>
    </label>
    <textarea
      class="one-cf__control one-cf__textarea"
      id={`${f}-message`}
      name="message"
      rows="5"
      required
      minlength={minMessage}
      placeholder="Tell us a little about what you need…"
      aria-describedby={`${f}-message-help ${f}-message-error`}
      data-validate></textarea>
    <p class="one-cf__help" id={`${f}-message-help`}>
      A sentence or two is plenty — at least {minMessage} characters.
    </p>
    <p class="one-cf__error" id={`${f}-message-error`} data-error aria-live="polite"></p>
  </div>

  <!-- ── Consent ───────────────────────────────────────────────────── -->
  <div class="one-cf__field" data-field>
    <label class="one-cf__check">
      <input
        class="one-cf__checkbox"
        id={`${f}-consent`}
        name="consent"
        type="checkbox"
        required
        aria-describedby={`${f}-consent-error`}
        data-validate
      />
      <span class="one-cf__check-box" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
      </span>
      <span class="one-cf__check-text">
        I agree to be contacted about my enquiry. <span class="one-cf__req" aria-hidden="true">*</span>
      </span>
    </label>
    <p class="one-cf__error" id={`${f}-consent-error`} data-error aria-live="polite"></p>
  </div>

  <!-- ── Submit ────────────────────────────────────────────────────── -->
  <button class="one-cf__submit" id={`${f}-submit`} type="submit">
    <span class="one-cf__submit-label">{submitLabel}</span>
    <span class="one-cf__spinner" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M21 12a9 9 0 1 1-6.219-8.56" /></svg>
    </span>
  </button>

  <!-- ── Live status — announces success to assistive tech ─────────── -->
  <p class="one-cf__status" id={`${f}-status`} role="status" aria-live="polite" data-status hidden>
    <svg class="one-cf__status-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
    <span data-status-text>Thanks — your message is on its way. We'll be in touch shortly.</span>
  </p>
</form>

<style>
  /* ── Form shell ───────────────────────────────────────────────────
       A simple vertical rhythm. Each field owns its own spacing so the
       form stays even whether or not helper/error lines are present. */
  .one-cf {
    display: flex;
    flex-direction: column;
    gap: 1.35rem;
    color: var(--color-font);
  }

  /* ── Field ────────────────────────────────────────────────────────
       label → control → helper → error, stacked. */
  .one-cf__field {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .one-cf__label {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--color-font);
    line-height: 1.2;
  }
  .one-cf__req {
    color: var(--color-destructive);
    font-weight: 600;
  }

  /* ── The one control shape — input · select · textarea share it ──── */
  .one-cf__control {
    width: 100%;
    box-sizing: border-box;
    padding: 0.7rem 0.85rem;
    font: inherit;
    font-size: 0.92rem;
    color: var(--color-on-foreground);
    background: var(--color-foreground);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    appearance: none;
    transition:
      border-color var(--ease),
      box-shadow var(--ease),
      background var(--ease);
  }
  .one-cf__control::placeholder {
    color: color-mix(in oklab, var(--color-on-foreground) 60%, transparent);
  }
  .one-cf__control:hover {
    border-color: var(--color-border-strong);
  }
  .one-cf__control:focus-visible {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--color-ring) 22%, transparent);
  }

  .one-cf__textarea {
    resize: vertical;
    min-height: 7rem;
    line-height: 1.6;
  }

  /* ── Select — custom chevron, native control underneath ──────────── */
  .one-cf__select-wrap {
    position: relative;
  }
  .one-cf__select-wrap .one-cf__control {
    padding-right: 2.5rem;
    cursor: pointer;
  }
  .one-cf__chevron {
    position: absolute;
    top: 50%;
    right: 0.85rem;
    width: 1.05rem;
    height: 1.05rem;
    transform: translateY(-50%);
    color: var(--color-muted);
    pointer-events: none;
  }

  /* ── Helper + error text ──────────────────────────────────────────
       The error <p> is empty until validation fills it, then it shows. */
  .one-cf__help {
    font-size: 0.78rem;
    line-height: 1.5;
    color: var(--color-muted);
    margin: 0;
  }
  .one-cf__error {
    font-size: 0.78rem;
    line-height: 1.5;
    color: var(--color-destructive);
    margin: 0;
    display: none;
  }

  /* ── Error state — set on the field wrapper via [data-invalid] ───── */
  .one-cf__field[data-invalid] .one-cf__error {
    display: flex;
    align-items: flex-start;
    gap: 0.3rem;
    animation: one-cf-error-in 0.18s ease both;
  }
  .one-cf__field[data-invalid] .one-cf__control {
    border-color: var(--color-destructive);
  }
  .one-cf__field[data-invalid] .one-cf__control:focus-visible {
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--color-destructive) 22%, transparent);
  }
  /* hide the helper while an error is showing — one line of guidance at a time */
  .one-cf__field[data-invalid] .one-cf__help {
    display: none;
  }

  /* ── Valid state — subtle success tint after a field passes ──────── */
  .one-cf__field[data-valid] .one-cf__control {
    border-color: color-mix(in oklab, var(--color-success) 55%, var(--color-border));
  }
  .one-cf__field[data-valid] .one-cf__control:focus-visible {
    border-color: var(--color-success);
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--color-success) 20%, transparent);
  }

  @keyframes one-cf-error-in {
    from { opacity: 0; transform: translateY(-2px); }
    to   { opacity: 1; transform: none; }
  }

  /* ── Checkbox ─────────────────────────────────────────────────────
       Real <input> visually hidden; the styled box is the visible proxy.
       Focus ring rides on the box when the input is focused. */
  .one-cf__check {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: start;
    gap: 0.65rem;
    cursor: pointer;
    user-select: none;
  }
  .one-cf__checkbox {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    margin: 0;
    pointer-events: none;
  }
  .one-cf__check-box {
    width: 1.15rem;
    height: 1.15rem;
    margin-top: 0.05rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    background: var(--color-foreground);
    color: var(--color-on-primary);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: background var(--ease), border-color var(--ease);
  }
  .one-cf__check-box svg {
    width: 0.8rem;
    height: 0.8rem;
    opacity: 0;
    transform: scale(0.6);
    transition: opacity var(--ease), transform var(--ease);
  }
  .one-cf__checkbox:checked + .one-cf__check-box {
    background: var(--color-primary);
    border-color: var(--color-primary);
  }
  .one-cf__checkbox:checked + .one-cf__check-box svg {
    opacity: 1;
    transform: scale(1);
  }
  .one-cf__checkbox:focus-visible + .one-cf__check-box {
    outline: 2px solid var(--color-ring);
    outline-offset: 2px;
  }
  .one-cf__check-text {
    font-size: 0.86rem;
    line-height: 1.5;
    color: var(--color-font);
  }
  /* invalid consent — tint the box red */
  .one-cf__field[data-invalid] .one-cf__check-box {
    border-color: var(--color-destructive);
  }

  /* ── Submit ───────────────────────────────────────────────────────
       Full-width on mobile; auto on wider viewports. Content fades for
       the spinner during the simulated send so the box never reflows. */
  .one-cf__submit {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    box-sizing: border-box;
    height: 2.95rem;
    margin-top: 0.25rem;
    padding: 0 1.5rem;
    font: inherit;
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.005em;
    color: var(--color-on-primary);
    background: var(--color-primary);
    border: 1px solid transparent;
    border-radius: var(--radius-md);
    cursor: pointer;
    transition:
      background var(--ease),
      box-shadow var(--ease),
      transform var(--ease),
      opacity var(--ease);
  }
  .one-cf__submit:hover {
    background: color-mix(in oklab, var(--color-primary) 90%, var(--color-font));
    transform: translateY(-1px);
    box-shadow: var(--shadow-card);
  }
  .one-cf__submit:active {
    transform: scale(0.99);
    box-shadow: none;
  }
  .one-cf__submit:focus-visible {
    outline: 2px solid var(--color-ring);
    outline-offset: 2px;
  }

  .one-cf__spinner {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
  }
  .one-cf__spinner svg {
    width: 1.1rem;
    height: 1.1rem;
    animation: one-cf-spin 0.7s linear infinite;
  }

  /* Busy state — set while the simulated send runs. */
  .one-cf__submit[aria-busy='true'] {
    cursor: progress;
    pointer-events: none;
  }
  .one-cf__submit[aria-busy='true'] .one-cf__submit-label {
    opacity: 0;
  }
  .one-cf__submit[aria-busy='true'] .one-cf__spinner {
    opacity: 1;
  }
  .one-cf__submit[aria-busy='true']:hover {
    transform: none;
    box-shadow: none;
  }
  @keyframes one-cf-spin {
    to { transform: rotate(360deg); }
  }

  /* ── Success status ───────────────────────────────────────────────
       Revealed after a successful (simulated) submit. */
  .one-cf__status {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin: 0;
    padding: 0.85rem 1rem;
    font-size: 0.88rem;
    line-height: 1.45;
    color: var(--color-success);
    background: color-mix(in oklab, var(--color-success) 10%, var(--color-foreground));
    border: 1px solid color-mix(in oklab, var(--color-success) 35%, transparent);
    border-radius: var(--radius-md);
    animation: one-cf-error-in 0.22s ease both;
  }
  .one-cf__status[hidden] {
    display: none;
  }
  .one-cf__status-icon {
    width: 1.1rem;
    height: 1.1rem;
    flex-shrink: 0;
  }

  /* ── Reduced motion ──────────────────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .one-cf__control,
    .one-cf__submit,
    .one-cf__check-box,
    .one-cf__check-box svg {
      transition: none;
    }
    .one-cf__submit:hover,
    .one-cf__submit:active {
      transform: none;
    }
    .one-cf__spinner svg {
      animation: none;
    }
    .one-cf__field[data-invalid] .one-cf__error,
    .one-cf__status {
      animation: none;
    }
  }
</style>

<script>
  // ── Inline validation UX ──────────────────────────────────────────
  // Friendly messages over native bubbles. Validates on submit + on blur;
  // once a field has errored it re-validates live on input. Submission is
  // simulated — we never POST. Each form is wired independently so the
  // component can be rendered multiple times on one page.
  type FieldEl = HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement

  function friendlyMessage(el: FieldEl, minMessage: number): string {
    const v = el.validity
    if (v.valueMissing) {
      if (el instanceof HTMLInputElement && el.type === 'checkbox')
        return 'Please tick this box to continue.'
      if (el.id.endsWith('-name')) return 'Please enter your name.'
      if (el.id.endsWith('-email')) return 'Please enter your email address.'
      if (el.id.endsWith('-message')) return 'Please write a short message.'
      return 'This field is required.'
    }
    if (v.typeMismatch && el instanceof HTMLInputElement && el.type === 'email')
      return 'That doesn’t look like an email address.'
    if (v.tooShort && el instanceof HTMLTextAreaElement)
      return `A little more, please — at least ${minMessage} characters (you have ${el.value.trim().length}).`
    return 'Please check this field.'
  }

  function setupForm(form: HTMLFormElement): void {
    const minMessage = Number(form.dataset.minMessage || '0')
    const submit = form.querySelector<HTMLButtonElement>('.one-cf__submit')!
    const status = form.querySelector<HTMLElement>('[data-status]')!
    const fields = Array.from(
      form.querySelectorAll<FieldEl>('[data-validate]'),
    )
    // Track which fields have been interacted with (so we don't shout early).
    const touched = new WeakSet<FieldEl>()

    function paint(el: FieldEl): boolean {
      const wrap = el.closest<HTMLElement>('[data-field]')
      const errorP = wrap?.querySelector<HTMLElement>('[data-error]')
      const ok = el.checkValidity()

      if (!wrap) return ok

      if (ok) {
        wrap.removeAttribute('data-invalid')
        el.removeAttribute('aria-invalid')
        if (errorP) errorP.textContent = ''
        // Subtle valid state only for fields the user actually filled.
        const hasValue =
          el instanceof HTMLInputElement && el.type === 'checkbox'
            ? el.checked
            : el.value.trim().length > 0
        wrap.toggleAttribute('data-valid', hasValue && touched.has(el))
      } else {
        wrap.setAttribute('data-invalid', '')
        wrap.removeAttribute('data-valid')
        el.setAttribute('aria-invalid', 'true')
        if (errorP) errorP.textContent = friendlyMessage(el, minMessage)
      }
      return ok
    }

    for (const el of fields) {
      const onChange = (): void => {
        touched.add(el)
        paint(el)
      }
      // Blur validates; checkboxes/selects validate on change.
      el.addEventListener('blur', onChange)
      if (el instanceof HTMLSelectElement || (el instanceof HTMLInputElement && el.type === 'checkbox'))
        el.addEventListener('change', onChange)
      // Re-validate live once a field has already errored.
      el.addEventListener('input', () => {
        if (el.closest('[data-field]')?.hasAttribute('data-invalid')) paint(el)
      })
    }

    form.addEventListener('submit', (e: SubmitEvent) => {
      e.preventDefault()
      status.hidden = true

      let firstInvalid: FieldEl | null = null
      for (const el of fields) {
        touched.add(el)
        if (!paint(el) && !firstInvalid) firstInvalid = el
      }
      if (firstInvalid) {
        firstInvalid.focus()
        return
      }

      // ── Simulate a send — no network. ──────────────────────────────
      submit.setAttribute('aria-busy', 'true')
      window.setTimeout(() => {
        submit.removeAttribute('aria-busy')
        status.hidden = false
        form.reset()
        // Clear transient valid/invalid styling after reset.
        for (const el of fields) {
          const wrap = el.closest<HTMLElement>('[data-field]')
          wrap?.removeAttribute('data-valid')
          wrap?.removeAttribute('data-invalid')
          el.removeAttribute('aria-invalid')
        }
      }, 1100)
    })
  }

  // Wire every contact form on the page.
  document
    .querySelectorAll<HTMLFormElement>('.one-cf')
    .forEach((form) => setupForm(form))
</script>
