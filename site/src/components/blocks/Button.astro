---
/**
 * Button — the ONE design-system button.
 *
 * A single, polished primitive: filled / outlined / ghost variants, three sizes,
 * leading + trailing icon slots, loading + disabled states. Renders a real
 * <a> when `href` is set, otherwise a real <button> — never a div.
 *
 * Usage:
 *   <Button>Save</Button>
 *   <Button variant="secondary" size="lg">Read the docs</Button>
 *   <Button href="/start" variant="primary">Get started <Fragment slot="icon-right">→</Fragment></Button>
 *   <Button variant="ghost"><svg slot="icon-left" .../>Filter</Button>
 *   <Button variant="destructive" loading>Deleting…</Button>
 *   <Button iconOnly label="Search"><svg slot="icon-left" .../></Button>
 *
 * Tokens only — no hex. `on-*` labels auto-flip in dark mode (handled by Layout).
 */

interface Props {
  /** Visual style. */
  variant?: 'primary' | 'secondary' | 'tertiary' | 'ghost' | 'destructive'
  /** Size — controls height, padding, font-size, icon-size. */
  size?: 'sm' | 'md' | 'lg'
  /** When set, renders an <a> instead of a <button>. */
  href?: string
  /** Native button type (ignored when `href` is set). */
  type?: 'button' | 'submit' | 'reset'
  /** Square icon button — requires `label` for an accessible name. */
  iconOnly?: boolean
  /** Accessible name. Required when `iconOnly`; optional title otherwise. */
  label?: string
  /** Shows a spinner + sets aria-busy; suppresses pointer interaction. */
  loading?: boolean
  /** Dims + removes from tab order + blocks interaction. */
  disabled?: boolean
  /** Stretches to fill its container. */
  fullWidth?: boolean
  /** Extra classes, appended after the component's own. */
  class?: string
  /** rel — forwarded to the anchor (e.g. "noopener"). */
  rel?: string
  /** target — forwarded to the anchor. */
  target?: string
}

const {
  variant = 'primary',
  size = 'md',
  href,
  type = 'button',
  iconOnly = false,
  label,
  loading = false,
  disabled = false,
  fullWidth = false,
  class: className,
  rel,
  target,
} = Astro.props

const isLink = !!href
// A link can't be natively disabled — when disabled/loading it becomes inert.
const inert = disabled || loading

const classes = [
  'one-btn',
  `one-btn--${variant}`,
  `one-btn--${size}`,
  iconOnly && 'one-btn--icon-only',
  fullWidth && 'one-btn--full',
  loading && 'is-loading',
  className,
]
  .filter(Boolean)
  .join(' ')

// Shared aria/data attributes for both element types.
const shared = {
  class: classes,
  'aria-label': label || undefined,
  'aria-busy': loading ? ('true' as const) : undefined,
  'data-variant': variant,
}
---

{
  isLink ? (
    <a
      href={inert ? undefined : href}
      rel={rel}
      target={target}
      role={inert ? 'link' : undefined}
      aria-disabled={inert ? 'true' : undefined}
      tabindex={inert ? -1 : undefined}
      {...shared}
    >
      <span class="one-btn__content">
        <span class="one-btn__icon one-btn__icon--left"><slot name="icon-left" /></span>
        {!iconOnly && (
          <span class="one-btn__label">
            <slot />
          </span>
        )}
        <span class="one-btn__icon one-btn__icon--right"><slot name="icon-right" /></span>
      </span>
      <span class="one-btn__spinner" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
          <path d="M21 12a9 9 0 1 1-6.219-8.56" />
        </svg>
      </span>
    </a>
  ) : (
    <button type={type} disabled={inert} {...shared}>
      <span class="one-btn__content">
        <span class="one-btn__icon one-btn__icon--left"><slot name="icon-left" /></span>
        {!iconOnly && (
          <span class="one-btn__label">
            <slot />
          </span>
        )}
        <span class="one-btn__icon one-btn__icon--right"><slot name="icon-right" /></span>
      </span>
      <span class="one-btn__spinner" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
          <path d="M21 12a9 9 0 1 1-6.219-8.56" />
        </svg>
      </span>
    </button>
  )
}

<style>
  /* ── Base ──────────────────────────────────────────────────────────
       One shape for every variant. Position:relative so the spinner can
       overlay the content without changing the button's width. */
  .one-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    border: 1px solid transparent;
    border-radius: var(--radius-md);
    font-family: inherit;
    font-weight: 600;
    letter-spacing: 0.005em;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
    transition:
      background var(--ease),
      border-color var(--ease),
      color var(--ease),
      box-shadow var(--ease),
      transform var(--ease),
      opacity var(--ease);
  }

  /* Content row — icons + label share one baseline; gap scales per size. */
  .one-btn__content {
    display: inline-flex;
    align-items: center;
    gap: var(--btn-gap);
    transition: opacity var(--ease);
  }
  .one-btn__label {
    display: inline-block;
  }

  /* Icon slots collapse to nothing when their slot is empty. */
  .one-btn__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .one-btn__icon:empty {
    display: none;
  }
  /* Size every icon (svg / img / glyph) to the per-size token. */
  .one-btn__icon :global(svg),
  .one-btn__icon :global(img) {
    width: var(--btn-icon);
    height: var(--btn-icon);
    display: block;
  }

  /* ── Sizes ─────────────────────────────────────────────────────────
       Each size sets its own height, padding, font, gap, icon size. */
  .one-btn--sm {
    --btn-gap: 0.4rem;
    --btn-icon: 14px;
    height: 32px;
    padding: 0 0.85rem;
    font-size: 0.82rem;
  }
  .one-btn--md {
    --btn-gap: 0.5rem;
    --btn-icon: 16px;
    height: 40px;
    padding: 0 1.25rem;
    font-size: 0.9rem;
  }
  .one-btn--lg {
    --btn-gap: 0.6rem;
    --btn-icon: 18px;
    height: 48px;
    padding: 0 1.6rem;
    font-size: 1rem;
  }

  /* Icon-only — square, centred, padding removed. */
  .one-btn--icon-only.one-btn--sm { width: 32px; padding: 0; }
  .one-btn--icon-only.one-btn--md { width: 40px; padding: 0; }
  .one-btn--icon-only.one-btn--lg { width: 48px; padding: 0; }

  .one-btn--full {
    display: flex;
    width: 100%;
  }

  /* ── Variant · primary ─────────────────────────────────────────────
       Filled brand. Label uses the auto-contrast on-primary token. */
  .one-btn--primary {
    background: var(--color-primary);
    color: var(--color-on-primary);
  }
  .one-btn--primary:hover {
    background: color-mix(in oklab, var(--color-primary) 90%, var(--color-font));
  }

  /* ── Variant · secondary ───────────────────────────────────────────
       Surface fill + hairline border — the calm, neutral action. */
  .one-btn--secondary {
    background: var(--color-foreground);
    color: var(--color-on-foreground);
    border-color: var(--color-border);
  }
  .one-btn--secondary:hover {
    background: var(--color-background);
    border-color: var(--color-border-strong);
  }

  /* ── Variant · tertiary ────────────────────────────────────────────
       Filled accent. */
  .one-btn--tertiary {
    background: var(--color-tertiary);
    color: var(--color-on-tertiary);
  }
  .one-btn--tertiary:hover {
    background: color-mix(in oklab, var(--color-tertiary) 90%, var(--color-font));
  }

  /* ── Variant · ghost ───────────────────────────────────────────────
       Transparent until hover — muted text resolves to full font colour. */
  .one-btn--ghost {
    background: transparent;
    color: var(--color-muted);
  }
  .one-btn--ghost:hover {
    background: color-mix(in oklab, var(--color-font) 6%, transparent);
    color: var(--color-font);
  }

  /* ── Variant · destructive ─────────────────────────────────────────
       Filled danger. Label is always near-white for contrast on red. */
  .one-btn--destructive {
    background: var(--color-destructive);
    /* System contrast label — #fff in light mode, #000 in dark (the dark
       destructive is lightened for small-text AA, so white fails on it). */
    color: var(--color-on-destructive);
  }
  .one-btn--destructive:hover {
    background: color-mix(in oklab, var(--color-destructive) 88%, var(--color-black));
  }

  /* ── Micro-interactions ────────────────────────────────────────────
       Lift on hover, press on active, crisp ring on keyboard focus. */
  .one-btn:hover {
    transform: translateY(-1px);
    box-shadow: var(--shadow-card);
  }
  .one-btn:active {
    transform: scale(0.98);
    box-shadow: none;
  }
  .one-btn--ghost:hover {
    box-shadow: none;
  }

  .one-btn:focus-visible {
    outline: 2px solid var(--color-ring);
    outline-offset: 2px;
  }

  /* ── Loading ───────────────────────────────────────────────────────
       Content fades out (its width is preserved so the box never jumps);
       the spinner fades in, centred over the content. */
  .one-btn__spinner {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
  }
  .one-btn__spinner svg {
    width: var(--btn-icon);
    height: var(--btn-icon);
    animation: one-btn-spin 0.7s linear infinite;
  }
  .one-btn.is-loading {
    cursor: progress;
  }
  .one-btn.is-loading .one-btn__content {
    opacity: 0;
  }
  .one-btn.is-loading .one-btn__spinner {
    opacity: 1;
  }
  .one-btn.is-loading:hover {
    transform: none;
    box-shadow: none;
  }
  @keyframes one-btn-spin {
    to { transform: rotate(360deg); }
  }

  /* ── Disabled ──────────────────────────────────────────────────────
       Native <button:disabled> and the inert <a> (aria-disabled). */
  .one-btn:disabled,
  .one-btn[aria-disabled='true'] {
    opacity: 0.45;
    cursor: not-allowed;
    pointer-events: none;
    transform: none;
    box-shadow: none;
  }
  /* loading isn't "disabled" but must not accept clicks either */
  .one-btn.is-loading {
    pointer-events: none;
  }

  /* ── Reduced motion ────────────────────────────────────────────────
       Drop all transforms + the spin; keep opacity-only feedback. */
  @media (prefers-reduced-motion: reduce) {
    .one-btn {
      transition: background var(--ease), border-color var(--ease), color var(--ease), opacity var(--ease);
    }
    .one-btn:hover,
    .one-btn:active {
      transform: none;
    }
    .one-btn__spinner svg {
      animation: none;
    }
  }
</style>
