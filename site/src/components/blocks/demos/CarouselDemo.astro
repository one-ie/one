---
/**
 * CarouselDemo.astro — standalone showcase for <Carousel>.
 *
 * Renders two carousels under one section header:
 *   (a) a testimonial carousel (quote + avatar + name/role), one slide per view
 *   (b) a feature/card carousel, multiple slides per view with an adjacent peek
 *
 * Drop it into any page: <CarouselDemo />. Self-contained scoped styles; uses
 * only the ONE 6-token design system.
 */
import Carousel from '../Carousel.astro'

const testimonials = [
  {
    quote:
      'We went from wireframe to production in three days. The carousel alone replaced a paid component library. Clients ask what stack we used — we tell them ONE.',
    name: 'Sarah Mehta',
    role: 'Head of Growth · Acme Agency',
  },
  {
    quote:
      'The design tokens survive a client rebrand. Change six values and every surface — carousels included — recolors. No hunting hex codes across forty files.',
    name: 'James Lin',
    role: 'Founder · BuildFast Studio',
  },
  {
    quote:
      'It feels like Linear and reads like Stripe. Hairline borders, real whitespace, motion that respects reduced-motion. The polish is the product.',
    name: 'Maya Khanna',
    role: 'CTO · NorthStack',
  },
  {
    quote:
      'Native scroll-snap means it just works on touch — no JS animation jank, no dependency. My phone scrolls it as smoothly as my trackpad does.',
    name: 'Diego Alvarez',
    role: 'Design Engineer · Loom-ish',
  },
]

const features = [
  {
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M20.188 10.934a8 8 0 1 0-8.688 9.134"/></svg>`,
    color: 'var(--color-primary)',
    eyebrow: 'Tokens',
    title: 'Design system',
    body: 'Six tokens every component inherits. Change one value in one.config.ts and the whole carousel recolors with it.',
  },
  {
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m5 3 14 9-14 9V3z"/></svg>`,
    color: 'var(--color-secondary)',
    eyebrow: 'Motion',
    title: 'Reduced-motion safe',
    body: 'Smooth scroll-snap by default, instant jumps when the visitor asks for less motion. Accessibility is the floor, not a flag.',
  },
  {
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>`,
    color: 'var(--color-tertiary)',
    eyebrow: 'AI',
    title: 'Chat-ready',
    body: 'Pair any slide with plugin-chat. Agent personality lives in markdown, the widget loads with zero bundle cost.',
  },
  {
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>`,
    color: 'var(--color-primary)',
    eyebrow: 'Payments',
    title: 'Accept in 60s',
    body: 'x402 flows, quote/claim, multi-chain crypto via plugin-backend. Wire a paywall into a slide without a Stripe account.',
  },
  {
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`,
    color: 'var(--color-secondary)',
    eyebrow: 'Auth',
    title: 'Passkey sign-in',
    body: 'Passkey + better-auth ships free. Social providers and magic links are one config line away.',
  },
]
---

<section class="cx-demo">
  <div class="cx-demo-inner">
    <header class="cx-demo-head">
      <p class="cx-demo-eyebrow">Component</p>
      <h2 class="cx-demo-title">Carousel</h2>
      <p class="cx-demo-sub">
        A content carousel on native CSS scroll-snap — smooth, touch-native, and
        reduced-motion safe. Drag, click the arrows, tap a dot, or use the arrow keys.
      </p>
    </header>

    <!-- (a) Testimonials — one slide per view, generous side peek. -->
    <div class="cx-demo-block">
      <p class="cx-demo-label">Testimonials</p>
      <Carousel label="Customer testimonials" perView={1} peek="lg" class="cx-demo-carousel">
        {
          testimonials.map((t) => (
            <figure class="cx-quote">
              <svg class="cx-quote-mark" width="34" height="34" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M9.5 4C6.5 4 4 6.6 4 9.8c0 2.9 2 5 4.6 5 .3 0 .6 0 .9-.1-.6 1.8-2.2 3.2-4 3.7-.4.1-.6.5-.5.9.1.4.5.6.9.5C8.9 19 12 15.3 12 10.4 12 6.7 10 4 9.5 4Zm9 0C15.5 4 13 6.6 13 9.8c0 2.9 2 5 4.6 5 .3 0 .6 0 .9-.1-.6 1.8-2.2 3.2-4 3.7-.4.1-.6.5-.5.9.1.4.5.6.9.5 2.6-.7 5.6-4.4 5.6-9.3C20 6.7 19 4 18.5 4Z" />
              </svg>
              <blockquote class="cx-quote-body">{t.quote}</blockquote>
              <figcaption class="cx-quote-author">
                <span class="cx-quote-avatar" aria-hidden="true">
                  {t.name.split(' ').map((w) => w[0]).slice(0, 2).join('')}
                </span>
                <span class="cx-quote-meta">
                  <span class="cx-quote-name">{t.name}</span>
                  <span class="cx-quote-role">{t.role}</span>
                </span>
              </figcaption>
            </figure>
          ))
        }
      </Carousel>
    </div>

    <!-- (b) Feature cards — data-driven via items, with a peek of the next. -->
    <div class="cx-demo-block">
      <p class="cx-demo-label">Feature cards</p>
      <Carousel label="Platform features" perView={1} peek="md" class="cx-demo-carousel">
        {
          features.map((f) => (
            <article class="cx-feature">
              <span class="cx-feature-icon" style={`color:${f.color}`} set:html={f.icon} />
              <p class="cx-feature-eyebrow">{f.eyebrow}</p>
              <h3 class="cx-feature-title">{f.title}</h3>
              <p class="cx-feature-body">{f.body}</p>
            </article>
          ))
        }
      </Carousel>
    </div>
  </div>
</section>

<style>
  .cx-demo {
    padding: 5rem 0;
    background: var(--color-page);
  }
  .cx-demo-inner {
    max-width: var(--content-wide);
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* ── Header ────────────────────────────────────────────────────── */
  .cx-demo-head {
    max-width: 38rem;
    margin: 0 0 3rem;
  }
  .cx-demo-eyebrow {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-primary);
    margin: 0 0 0.75rem;
  }
  .cx-demo-title {
    font-size: clamp(1.9rem, 4vw, 2.6rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    color: var(--color-font);
    margin: 0 0 0.85rem;
    line-height: 1.1;
  }
  .cx-demo-sub {
    font-size: 1.02rem;
    line-height: 1.7;
    color: var(--color-muted);
    margin: 0;
  }

  /* ── Block (label + carousel) ──────────────────────────────────── */
  .cx-demo-block + .cx-demo-block { margin-top: 3.5rem; }
  .cx-demo-label {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin: 0 0 1rem;
  }

  /* ── Testimonial slide ─────────────────────────────────────────── */
  .cx-quote {
    height: 100%;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin: 0;
    background: var(--color-foreground);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 2.5rem;
    transition: border-color var(--ease), box-shadow var(--ease);
    /* A theme can fill --color-foreground with a saturated brand tone
       (Plum, in light mode) — shadow the derived typography tokens so
       .cx-quote-body/.cx-quote-name/.cx-quote-role below resolve against
       on-foreground. .cx-quote-mark uses --color-primary directly (a fill
       color, not a derived one) so it gets its own override just below. */
    --color-font: var(--color-on-foreground);
    --color-muted: color-mix(in oklab, var(--color-on-foreground) 60%, transparent);
    --color-border-strong: color-mix(in oklab, var(--color-on-foreground) 24%, transparent);
  }
  .cx-quote:hover {
    border-color: var(--color-border-strong);
    box-shadow: var(--shadow-card);
  }
  .cx-quote-mark {
    color: var(--color-accent-on-foreground);
    opacity: 0.28;
    flex-shrink: 0;
  }
  .cx-quote-body {
    font-size: clamp(1.05rem, 2.4vw, 1.3rem);
    font-weight: 500;
    line-height: 1.55;
    letter-spacing: -0.01em;
    color: var(--color-font);
    margin: 0;
    flex: 1;
  }
  .cx-quote-author {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }
  .cx-quote-avatar {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    flex-shrink: 0;
    border-radius: 50%;
    background: var(--color-primary);
    color: var(--color-on-primary);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }
  .cx-quote-meta {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .cx-quote-name {
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--color-font);
  }
  .cx-quote-role {
    font-size: 0.8rem;
    color: var(--color-muted);
  }

  /* ── Feature slide ─────────────────────────────────────────────── */
  .cx-feature {
    height: 100%;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    background: var(--color-background);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 2rem;
    transition: border-color var(--ease), transform var(--ease), box-shadow var(--ease);
  }
  .cx-feature:hover {
    border-color: var(--color-border-strong);
    transform: translateY(-2px);
    box-shadow: var(--shadow-pop);
  }
  .cx-feature-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-md);
    background: color-mix(in oklab, currentColor 10%, transparent);
    margin-bottom: 0.5rem;
  }
  .cx-feature-eyebrow {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin: 0;
  }
  .cx-feature-title {
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--color-font);
    margin: 0;
  }
  .cx-feature-body {
    font-size: 0.88rem;
    line-height: 1.65;
    color: var(--color-muted);
    margin: 0;
    flex: 1;
  }

  /* On wider viewports show two feature cards at once for a fuller layout.
     Carousel width math reads --cx-per-view, so override it here. */
  @media (min-width: 720px) {
    .cx-demo-block:last-child :global(.cx-demo-carousel) {
      --cx-per-view: 2;
    }
  }
  @media (min-width: 1040px) {
    .cx-demo-block:last-child :global(.cx-demo-carousel) {
      --cx-per-view: 3;
    }
  }
</style>
