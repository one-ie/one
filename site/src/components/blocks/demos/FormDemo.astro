---
/**
 * FormDemo — a self-contained showcase for <ContactForm>.
 *
 * Renders the full contact form in a centred narrow column, plus a compact
 * inline newsletter variant below it that reuses the same field shape (one
 * row: email + button, label visually hidden). Scoped styles — no page
 * dependencies. Beautiful standalone.
 *
 * Usage:
 *   import FormDemo from '@/components/blocks/demos/FormDemo.astro'
 *   <FormDemo />
 */
import ContactForm from '../ContactForm.astro'
---

<section class="fd">
  <div class="fd__container">
    <header class="fd__head">
      <p class="fd__eyebrow">Get in touch</p>
      <h2 class="fd__title">Let's talk</h2>
      <p class="fd__sub">
        One reusable field shape — hairline borders, token-driven colour, crisp
        focus rings, and forgiving inline validation. Every state is accounted
        for, and the whole thing flips with dark mode.
      </p>
    </header>

    <div class="fd__card">
      <ContactForm />
    </div>

    <!-- ── Newsletter — the same field shape, compact + inline ───────── -->
    <div class="fd__news">
      <div class="fd__news-copy">
        <h3 class="fd__news-title">Or just stay in the loop</h3>
        <p class="fd__news-sub">Product notes and the occasional release. No spam.</p>
      </div>

      <form class="fd__news-form" id="newsletter-form" novalidate aria-describedby="newsletter-status">
        <div class="fd__news-row" data-field>
          <label class="fd__visually-hidden" for="newsletter-email">Email address</label>
          <input
            class="fd__news-input"
            id="newsletter-email"
            name="email"
            type="email"
            required
            autocomplete="email"
            placeholder="you@example.com"
            aria-describedby="newsletter-email-error"
            data-validate
          />
          <button class="fd__news-submit" type="submit">
            <span class="fd__news-label">Subscribe</span>
            <span class="fd__news-spinner" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M21 12a9 9 0 1 1-6.219-8.56" /></svg>
            </span>
          </button>
        </div>
        <p class="fd__news-error" id="newsletter-email-error" data-error aria-live="polite"></p>
        <p class="fd__news-status" id="newsletter-status" role="status" aria-live="polite" data-status hidden>
          You're on the list — check your inbox to confirm.
        </p>
      </form>
    </div>
  </div>
</section>

<style>
  .fd {
    padding: 5rem 0;
    background: var(--color-page);
    color: var(--color-font);
  }
  .fd__container {
    max-width: var(--content-narrow);
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* ── Header ─────────────────────────────────────────────────────── */
  .fd__head {
    text-align: center;
    max-width: 36rem;
    margin: 0 auto 2.75rem;
  }
  .fd__eyebrow {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-primary);
    margin: 0 0 0.75rem;
  }
  .fd__title {
    font-size: clamp(2rem, 4.5vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.12;
    margin: 0 0 1rem;
  }
  .fd__sub {
    font-size: 1.02rem;
    line-height: 1.7;
    color: var(--color-muted);
    margin: 0 auto;
    max-width: 34rem;
  }

  /* ── Form card ──────────────────────────────────────────────────── */
  .fd__card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-background);
    box-shadow: var(--shadow-card);
    padding: 2rem;
  }

  /* ── Newsletter ─────────────────────────────────────────────────── */
  .fd__news {
    margin-top: 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-background);
    padding: 1.75rem 2rem;
  }
  .fd__news-copy {
    margin-bottom: 1.1rem;
  }
  .fd__news-title {
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin: 0 0 0.3rem;
    color: var(--color-font);
  }
  .fd__news-sub {
    font-size: 0.86rem;
    line-height: 1.5;
    color: var(--color-muted);
    margin: 0;
  }

  /* The inline row — input grows, button hugs its label. */
  .fd__news-row {
    display: flex;
    gap: 0.6rem;
  }

  /* Reuse the contact-form control shape, tuned for the inline row. */
  .fd__news-input {
    flex: 1 1 auto;
    min-width: 0;
    box-sizing: border-box;
    padding: 0.7rem 0.85rem;
    font: inherit;
    font-size: 0.92rem;
    color: var(--color-font);
    background: var(--color-foreground);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    appearance: none;
    transition: border-color var(--ease), box-shadow var(--ease);
  }
  .fd__news-input::placeholder {
    color: var(--color-muted);
  }
  .fd__news-input:hover {
    border-color: var(--color-border-strong);
  }
  .fd__news-input:focus-visible {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--color-ring) 22%, transparent);
  }
  .fd__news-row[data-invalid] .fd__news-input {
    border-color: var(--color-destructive);
  }
  .fd__news-row[data-invalid] .fd__news-input:focus-visible {
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--color-destructive) 22%, transparent);
  }
  .fd__news-row[data-valid] .fd__news-input {
    border-color: color-mix(in oklab, var(--color-success) 55%, var(--color-border));
  }

  .fd__news-submit {
    position: relative;
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 2.6rem;
    padding: 0 1.25rem;
    font: inherit;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-on-primary);
    background: var(--color-primary);
    border: 1px solid transparent;
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: background var(--ease), transform var(--ease), box-shadow var(--ease);
  }
  .fd__news-submit:hover {
    background: color-mix(in oklab, var(--color-primary) 90%, var(--color-font));
    transform: translateY(-1px);
    box-shadow: var(--shadow-card);
  }
  .fd__news-submit:active {
    transform: scale(0.99);
    box-shadow: none;
  }
  .fd__news-submit:focus-visible {
    outline: 2px solid var(--color-ring);
    outline-offset: 2px;
  }
  .fd__news-spinner {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
  }
  .fd__news-spinner svg {
    width: 1rem;
    height: 1rem;
    animation: fd-spin 0.7s linear infinite;
  }
  .fd__news-submit[aria-busy='true'] {
    cursor: progress;
    pointer-events: none;
  }
  .fd__news-submit[aria-busy='true'] .fd__news-label {
    opacity: 0;
  }
  .fd__news-submit[aria-busy='true'] .fd__news-spinner {
    opacity: 1;
  }
  @keyframes fd-spin {
    to { transform: rotate(360deg); }
  }

  .fd__news-error {
    font-size: 0.78rem;
    line-height: 1.5;
    color: var(--color-destructive);
    margin: 0.55rem 0 0;
    display: none;
  }
  .fd__news-row[data-invalid] ~ .fd__news-error {
    display: block;
  }
  .fd__news-status {
    font-size: 0.84rem;
    line-height: 1.5;
    color: var(--color-success);
    margin: 0.65rem 0 0;
  }
  .fd__news-status[hidden] {
    display: none;
  }

  /* Visually-hidden but available to screen readers + label association. */
  .fd__visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 520px) {
    .fd__news-row {
      flex-direction: column;
    }
    .fd__news-submit {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fd__news-input,
    .fd__news-submit {
      transition: none;
    }
    .fd__news-submit:hover,
    .fd__news-submit:active {
      transform: none;
    }
    .fd__news-spinner svg {
      animation: none;
    }
  }
</style>

<script>
  // ── Newsletter inline validation ──────────────────────────────────
  // Mirrors ContactForm's UX in miniature: friendly message, validate on
  // blur, re-validate live once errored, simulated submit (no network).
  type EmailInput = HTMLInputElement

  function setupNewsletter(form: HTMLFormElement): void {
    const input = form.querySelector<EmailInput>('[data-validate]')
    const submit = form.querySelector<HTMLButtonElement>('.fd__news-submit')
    const status = form.querySelector<HTMLElement>('[data-status]')
    const row = form.querySelector<HTMLElement>('[data-field]')
    const errorP = form.querySelector<HTMLElement>('[data-error]')
    if (!input || !submit || !status || !row || !errorP) return

    let touched = false

    function message(): string {
      const v = input!.validity
      if (v.valueMissing) return 'Please enter your email address.'
      if (v.typeMismatch) return 'That doesn’t look like an email address.'
      return 'Please check this field.'
    }

    function paint(): boolean {
      const ok = input!.checkValidity()
      if (ok) {
        row!.removeAttribute('data-invalid')
        input!.removeAttribute('aria-invalid')
        errorP!.textContent = ''
        row!.toggleAttribute('data-valid', input!.value.trim().length > 0 && touched)
      } else {
        row!.setAttribute('data-invalid', '')
        row!.removeAttribute('data-valid')
        input!.setAttribute('aria-invalid', 'true')
        errorP!.textContent = message()
      }
      return ok
    }

    input.addEventListener('blur', () => {
      touched = true
      paint()
    })
    input.addEventListener('input', () => {
      if (row.hasAttribute('data-invalid')) paint()
    })

    form.addEventListener('submit', (e: SubmitEvent) => {
      e.preventDefault()
      status.hidden = true
      touched = true
      if (!paint()) {
        input.focus()
        return
      }
      submit.setAttribute('aria-busy', 'true')
      window.setTimeout(() => {
        submit.removeAttribute('aria-busy')
        status.hidden = false
        form.reset()
        row.removeAttribute('data-valid')
        row.removeAttribute('data-invalid')
        input.removeAttribute('aria-invalid')
      }, 1000)
    })
  }

  document
    .querySelectorAll<HTMLFormElement>('.fd__news-form')
    .forEach((form) => setupNewsletter(form))
</script>
