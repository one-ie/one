---
/**
 * BreadcrumbsDemo.astro — standalone showcase for the Breadcrumbs block.
 *
 * Drop into any page to preview all three behaviours:
 *   import BreadcrumbsDemo from '@/components/blocks/demos/BreadcrumbsDemo.astro'
 *   <BreadcrumbsDemo />
 *
 * Self-contained: brings its own section chrome (eyebrow + title) and frames.
 */

import Breadcrumbs from '../Breadcrumbs.astro'

// (a) Short, everyday trail — 3 levels.
const shortTrail = [
  { label: 'Docs', href: '/docs' },
  { label: 'Components', href: '/docs/components' },
  { label: 'Breadcrumbs' },
]

// (b) Long trail — exceeds maxItems, so the middle collapses into a '…' menu.
const longTrail = [
  { label: 'Home', href: '/', icon: 'home' },
  { label: 'Workspace', href: '/workspace', icon: 'grid' },
  { label: 'Projects', href: '/workspace/projects', icon: 'folder' },
  { label: 'ONE Starter', href: '/workspace/projects/one', icon: 'layers' },
  { label: 'Plugins', href: '/workspace/projects/one/plugins', icon: 'tag' },
  { label: 'plugin-chat', href: '/workspace/projects/one/plugins/chat', icon: 'doc' },
  { label: 'Settings' },
]

// (c) Home icon + slash separators.
const slashTrail = [
  { label: 'Home', href: '/' },
  { label: 'Blog', href: '/blog' },
  { label: 'Engineering', href: '/blog/engineering' },
  { label: 'Shipping a design system that survives a rebrand' },
]
---

<section class="crumbs-demo">
  <div class="crumbs-demo__container">
    <header class="crumbs-demo__head">
      <p class="crumbs-demo__eyebrow">Navigation</p>
      <h2 class="crumbs-demo__title">A breadcrumb trail, three ways</h2>
    </header>

    <div class="crumbs-demo__stack">
      <!-- (a) Short trail -->
      <figure class="crumbs-demo__case">
        <Breadcrumbs items={shortTrail} />
        <figcaption class="crumbs-demo__caption">
          A short three-level trail with chevron separators
        </figcaption>
      </figure>

      <!-- (b) Long trail — collapses the middle into an accessible '…' menu -->
      <figure class="crumbs-demo__case">
        <Breadcrumbs items={longTrail} maxItems={4} homeIcon />
        <figcaption class="crumbs-demo__caption">
          A deep trail collapsed past four levels — open the
          <span class="crumbs-demo__kbd">…</span> menu for the hidden crumbs
        </figcaption>
      </figure>

      <!-- (c) Home icon + slash separators + a long current crumb -->
      <figure class="crumbs-demo__case">
        <Breadcrumbs items={slashTrail} separator="slash" homeIcon />
        <figcaption class="crumbs-demo__caption">
          A leading home icon, slash separators, and a long current page that
          truncates
        </figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  .crumbs-demo {
    padding: 5rem 0;
  }
  .crumbs-demo__container {
    max-width: var(--content);
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .crumbs-demo__head {
    max-width: 40rem;
    margin: 0 auto 3rem;
    text-align: center;
  }
  .crumbs-demo__eyebrow {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-primary);
    margin: 0 0 0.75rem;
  }
  .crumbs-demo__title {
    font-size: clamp(2rem, 4.5vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.12;
    color: var(--color-font);
    margin: 0;
  }

  /* Each example sits in a quiet framed card so the trail reads as a sample. */
  .crumbs-demo__stack {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    max-width: var(--content-narrow);
    margin: 0 auto;
  }

  .crumbs-demo__case {
    margin: 0;
    padding: 1.4rem 1.5rem;
    background: var(--color-background);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    transition: border-color var(--ease);
  }
  .crumbs-demo__case:hover {
    border-color: var(--color-border-strong);
  }

  .crumbs-demo__caption {
    margin-top: 0.9rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--color-border);
    font-size: 0.78rem;
    line-height: 1.5;
    color: var(--color-muted);
  }
  .crumbs-demo__kbd {
    display: inline-flex;
    align-items: center;
    padding: 0 0.35rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    font-weight: 600;
    color: var(--color-font);
    line-height: 1.3;
  }
</style>
