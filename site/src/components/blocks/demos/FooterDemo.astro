---
/**
 * FooterDemo.astro — standalone showcase for the Footer block.
 *
 * Drop into any page to preview the complete marketing footer:
 *   import FooterDemo from '@/components/blocks/demos/FooterDemo.astro'
 *   <FooterDemo />
 *
 * Self-contained: brings its own section chrome (eyebrow + title), then
 * renders the full-bleed <Footer /> beneath with all defaults — so it
 * looks finished with zero props.
 */

import Footer from '../Footer.astro'
---

<section class="footer-demo">
  <div class="footer-demo__head">
    <p class="footer-demo__eyebrow">Block</p>
    <h2 class="footer-demo__title">Footer</h2>
    <p class="footer-demo__sub">
      A complete marketing footer — brand column, social icons, link columns,
      newsletter signup, and a legal bottom bar. Renders finished with no props.
    </p>
  </div>

  <!-- Full-bleed: the footer owns the page width, edge to edge. -->
  <div class="footer-demo__bleed">
    <Footer />
  </div>
</section>

<style>
  .footer-demo {
    padding: 5rem 0 0;
  }

  .footer-demo__head {
    max-width: 40rem;
    margin: 0 auto 3rem;
    padding: 0 1.5rem;
    text-align: center;
  }
  .footer-demo__eyebrow {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-primary);
    margin: 0 0 0.75rem;
  }
  .footer-demo__title {
    font-size: clamp(2rem, 4.5vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.12;
    color: var(--color-font);
    margin: 0;
  }
  .footer-demo__sub {
    font-size: 1.02rem;
    line-height: 1.65;
    color: var(--color-muted);
    margin: 1rem auto 0;
    max-width: 34rem;
  }

  /* Break out of any centered content column to span the full viewport. */
  .footer-demo__bleed {
    width: 100vw;
    margin-left: 50%;
    transform: translateX(-50%);
  }
</style>
