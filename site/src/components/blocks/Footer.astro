---
/**
 * Footer.astro — a complete marketing footer.
 *
 * Renders out-of-the-box with sensible defaults — `<Footer />` is a full,
 * finished footer with brand column, social icons, four link columns, a
 * newsletter signup, and a legal bottom bar. Every part can be overridden.
 *
 * Usage:
 *   <Footer />
 *
 *   <Footer
 *     brand="ONE"
 *     tagline="The Astro starter that ships AI, payments & plugins on day one."
 *     columns={[
 *       { heading: 'Product', links: [{ label: 'Design', href: '/design' }] },
 *     ]}
 *     socials={[{ label: 'GitHub', href: '…', icon: 'github' }]}
 *     legalLinks={[{ label: 'Privacy', href: '/privacy/' }]}
 *     newsletter={{ heading: 'Stay in the loop', placeholder: 'you@studio.com' }}
 *     note="Free forever, one license · Built on the open web."
 *   />
 *
 *   <!-- Suppress the newsletter block -->
 *   <Footer newsletter={false} />
 *
 * Tokens only — no hardcoded colours. Auto-flips for dark mode.
 * Accessible: <footer role="contentinfo">, labelled nav landmarks, a real
 * (visually-hidden) <label> on the email input, focus rings via --color-ring.
 */

type SocialIcon = 'github' | 'x' | 'discord' | 'linkedin'

interface FooterLink {
  label: string
  href: string
  /** External links open in a new tab + get rel="noopener". */
  external?: boolean
}

interface FooterColumn {
  heading: string
  links: FooterLink[]
}

interface SocialLink {
  label: string
  href: string
  icon: SocialIcon
}

interface Newsletter {
  heading?: string
  description?: string
  placeholder?: string
  cta?: string
}

interface Props {
  /** Wordmark — matches the nav logo. */
  brand?: string
  /** One-line tagline under the wordmark. */
  tagline?: string
  /** Link columns. Defaults to Product / Resources / Company / Legal. */
  columns?: FooterColumn[]
  /** Social icon buttons. Defaults to GitHub / X / Discord / LinkedIn. */
  socials?: SocialLink[]
  /** Small legal links in the bottom bar (right side). */
  legalLinks?: FooterLink[]
  /** Newsletter signup config, or `false` to hide it. */
  newsletter?: Newsletter | false
  /** Built-with / legal note in the bottom bar (left side). */
  note?: string
  /** Optional extra class on the root. */
  class?: string
}

const DEFAULT_COLUMNS: FooterColumn[] = [
  {
    heading: 'Product',
    links: [
      { label: 'Design system', href: '#' },
      { label: 'Motion', href: '#' },
      { label: 'Plugins', href: '#' },
      { label: 'Pricing', href: '#' },
    ],
  },
  {
    heading: 'Resources',
    links: [
      { label: 'Documentation', href: '#' },
      { label: 'Components', href: '#' },
      { label: 'Templates', href: '#' },
      { label: 'Changelog', href: '#' },
    ],
  },
  {
    heading: 'Company',
    links: [
      { label: 'About', href: '#' },
      { label: 'Blog', href: '#' },
      { label: 'Careers', href: '#' },
      { label: 'Contact', href: '#' },
    ],
  },
  {
    heading: 'Legal',
    links: [
      { label: 'Privacy', href: '#' },
      { label: 'Terms', href: '#' },
      { label: 'License', href: '#' },
      { label: 'Security', href: '#' },
    ],
  },
]

const DEFAULT_SOCIALS: SocialLink[] = [
  { label: 'GitHub', href: '#', icon: 'github' },
  { label: 'X', href: '#', icon: 'x' },
  { label: 'Discord', href: '#', icon: 'discord' },
  { label: 'LinkedIn', href: '#', icon: 'linkedin' },
]

const DEFAULT_LEGAL: FooterLink[] = [
  { label: 'Privacy', href: '#' },
  { label: 'Terms', href: '#' },
  { label: 'Status', href: '#' },
]

const DEFAULT_NEWSLETTER: Newsletter = {
  heading: 'Ship updates, not spam',
  description: 'New plugins, template releases, and the occasional deep-dive — once a month.',
  placeholder: 'you@studio.com',
  cta: 'Subscribe',
}

const {
  brand = 'ONE',
  tagline = 'The production-ready Astro starter — design system, motion, AI chat, payments, and auth, wired from one file.',
  columns = DEFAULT_COLUMNS,
  socials = DEFAULT_SOCIALS,
  legalLinks = DEFAULT_LEGAL,
  newsletter,
  note = 'Built with ONE · Free forever, one license · Deployed on the edge.',
  class: className,
} = Astro.props

// `newsletter` defaults to the standard block; pass `false` to suppress it,
// or a partial object to override individual fields.
const news =
  newsletter === false
    ? null
    : { ...DEFAULT_NEWSLETTER, ...(newsletter ?? {}) }

const year = new Date().getFullYear()

/** Inline brand glyphs — 24×24 viewBox, currentColor. */
const SOCIAL_SVG: Record<SocialIcon, string> = {
  github:
    '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.37.5 0 5.87 0 12.5c0 5.3 3.44 9.8 8.2 11.39.6.11.82-.26.82-.58l-.01-2.05c-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.33-1.76-1.33-1.76-1.09-.74.08-.73.08-.73 1.2.09 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.5.99.11-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.13-.3-.54-1.52.12-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6.01 0c2.29-1.55 3.3-1.23 3.3-1.23.66 1.66.25 2.88.12 3.18.77.84 1.23 1.91 1.23 3.22 0 4.61-2.8 5.62-5.48 5.92.43.37.81 1.1.81 2.22l-.01 3.29c0 .32.22.7.83.58A12.01 12.01 0 0 0 24 12.5C24 5.87 18.63.5 12 .5Z"/></svg>',
  x:
    '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24h-6.656l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231 5.45-6.231Zm-1.161 17.52h1.833L7.084 4.126H5.117L17.083 19.77Z"/></svg>',
  discord:
    '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.317 4.369A19.79 19.79 0 0 0 15.432 2.85a.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.249a18.27 18.27 0 0 0-5.487 0 12.6 12.6 0 0 0-.617-1.25.077.077 0 0 0-.079-.036 19.74 19.74 0 0 0-4.885 1.52.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.04.078.078 0 0 0 .084-.028c.462-.63.873-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.1 13.1 0 0 1-1.872-.892.077.077 0 0 1-.008-.128c.126-.094.252-.192.372-.291a.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.009c.12.099.246.198.373.292a.077.077 0 0 1-.006.127c-.598.349-1.225.645-1.873.891a.076.076 0 0 0-.04.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.029 19.84 19.84 0 0 0 6.002-3.04.078.078 0 0 0 .032-.057c.5-5.177-.838-9.673-3.549-13.66a.06.06 0 0 0-.031-.029ZM8.02 15.331c-1.182 0-2.156-1.085-2.156-2.419 0-1.333.955-2.419 2.156-2.419 1.21 0 2.175 1.096 2.156 2.42 0 1.333-.955 2.418-2.156 2.418Zm7.974 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.175 1.096 2.156 2.42 0 1.333-.946 2.418-2.156 2.418Z"/></svg>',
  linkedin:
    '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286ZM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065Zm1.782 13.019H3.555V9h3.564v11.452ZM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0Z"/></svg>',
}

const relFor = (link: FooterLink | SocialLink) =>
  'external' in link && link.external ? 'noopener noreferrer' : undefined
const targetFor = (link: FooterLink | SocialLink) =>
  'external' in link && link.external ? '_blank' : undefined
---

<footer
  role="contentinfo"
  class:list={['footer', className]}
  aria-labelledby="footer-brand"
>
  <div class="footer__inner">
    <!-- ── Top: brand + link columns ──────────────────────────────── -->
    <div class="footer__top">
      <!-- Brand column -->
      <div class="footer__brand">
        <a id="footer-brand" href="/" class="footer__logo">{brand}</a>
        <p class="footer__tagline">{tagline}</p>

        {
          socials.length > 0 && (
            <nav class="footer__socials" aria-label="Social media">
              {socials.map((s) => (
                <a
                  class="footer__social"
                  href={s.href}
                  target={targetFor(s)}
                  rel="noopener noreferrer"
                  aria-label={s.label}
                >
                  <span class="footer__social-icon" aria-hidden="true" set:html={SOCIAL_SVG[s.icon]} />
                </a>
              ))}
            </nav>
          )
        }
      </div>

      <!-- Link columns -->
      <nav class="footer__columns" aria-label="Footer">
        {
          columns.map((col) => (
            <div class="footer__column">
              <h2 class="footer__heading">{col.heading}</h2>
              <ul class="footer__list">
                {col.links.map((link) => (
                  <li>
                    <a
                      class="footer__link"
                      href={link.href}
                      target={targetFor(link)}
                      rel={relFor(link)}
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
    </div>

    <!-- ── Newsletter ─────────────────────────────────────────────── -->
    {
      news && (
        <div class="footer__news">
          <div class="footer__news-copy">
            <h2 class="footer__news-heading">{news.heading}</h2>
            {news.description && (
              <p class="footer__news-desc">{news.description}</p>
            )}
          </div>
          <form class="footer__form" method="post" action="#" data-newsletter-form>
            <label class="footer__sr-only" for="footer-email">
              Email address
            </label>
            <input
              class="footer__input"
              id="footer-email"
              name="email"
              type="email"
              autocomplete="email"
              required
              placeholder={news.placeholder}
              data-newsletter-input
            />
            <button class="footer__submit" type="submit" data-newsletter-submit>
              {news.cta}
            </button>
          </form>
          <p class="footer__news-error" role="alert" aria-live="polite" hidden data-newsletter-error></p>
        </div>
      )
    }

    <!-- ── Bottom bar ─────────────────────────────────────────────── -->
    <div class="footer__bottom">
      <p class="footer__copy">
        <span>© {year} {brand}</span>
        {note && <span class="footer__sep" aria-hidden="true">·</span>}
        {note && <span class="footer__note">{note}</span>}
      </p>

      {
        legalLinks.length > 0 && (
          <nav class="footer__legal" aria-label="Legal">
            {legalLinks.map((link) => (
              <a
                class="footer__legal-link"
                href={link.href}
                target={targetFor(link)}
                rel={relFor(link)}
              >
                {link.label}
              </a>
            ))}
          </nav>
        )
      }
    </div>
  </div>
</footer>

{
  news && (
    <script>
      import { bindNewsletterForms } from '@oneie/plugin-newsletter'
      bindNewsletterForms()
    </script>
  )
}

<style>
  /* ── Shell ──────────────────────────────────────────────────────── */
  .footer {
    background: var(--color-foreground);
    border-top: 1px solid var(--color-border);
    color: var(--color-on-foreground);
    /* The footer is a surface island on --color-foreground (can be a filled
       brand tone, e.g. Plum in light mode) — shadow the derived typography
       tokens so every var(--color-font/muted/faint/border*) below resolves
       against on-foreground automatically, EXCEPT inside .footer__input:
       that field deliberately sinks to the untinted --color-background (the
       normal "inputs sink" rule), so it re-shadows back to the true globals
       itself — see its rule below. */
    --color-font: var(--color-on-foreground);
    --color-muted: color-mix(in oklab, var(--color-on-foreground) 60%, transparent);
    --color-faint: color-mix(in oklab, var(--color-on-foreground) 40%, transparent);
    --color-border: color-mix(in oklab, var(--color-on-foreground) 10%, transparent);
    --color-border-strong: color-mix(in oklab, var(--color-on-foreground) 20%, transparent);
  }
  .footer__inner {
    max-width: var(--content-wide);
    margin: 0 auto;
    padding: 4.5rem 1.5rem 2rem;
  }

  /* ── Top region ─────────────────────────────────────────────────── */
  .footer__top {
    display: grid;
    grid-template-columns: 1.4fr 2.6fr;
    gap: 4rem;
  }

  /* Brand column */
  .footer__brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    max-width: 22rem;
  }
  .footer__logo {
    font-size: 1.1rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--color-primary);
    text-decoration: none;
    transition: opacity var(--ease);
  }
  .footer__logo:hover { opacity: 0.75; }
  .footer__tagline {
    margin: 1rem 0 0;
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--color-muted);
  }

  /* Social icon buttons */
  .footer__socials {
    display: flex;
    gap: 0.6rem;
    margin-top: 1.75rem;
  }
  .footer__social {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    /* Deliberately escapes .footer's on-foreground shadow above — a light
       circular icon button, same "sinks to background" exception as
       .footer__input. */
    border: 1px solid var(--color-border-fixed);
    background: var(--color-background);
    color: var(--color-muted-fixed);
    transition:
      color var(--ease),
      border-color var(--ease),
      background var(--ease),
      transform var(--ease);
  }
  .footer__social:hover {
    color: var(--color-font-fixed);
    border-color: var(--color-border-strong-fixed);
    background: color-mix(in oklab, var(--color-primary) 6%, var(--color-background));
    transform: translateY(-2px);
  }
  .footer__social:focus-visible {
    outline: 2px solid var(--color-ring);
    outline-offset: 2px;
  }
  .footer__social-icon {
    display: inline-flex;
    width: 17px;
    height: 17px;
  }
  .footer__social-icon :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
  }

  /* ── Link columns ───────────────────────────────────────────────── */
  .footer__columns {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
  }
  .footer__column {
    display: flex;
    flex-direction: column;
  }
  .footer__heading {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin: 0 0 1.1rem;
  }
  .footer__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }
  .footer__link {
    font-size: 0.9rem;
    line-height: 1.4;
    color: var(--color-muted);
    text-decoration: none;
    transition: color var(--ease);
  }
  .footer__link:hover { color: var(--color-font); }
  .footer__link:focus-visible {
    outline: 2px solid var(--color-ring);
    outline-offset: 3px;
    border-radius: var(--radius-sm);
    color: var(--color-font);
  }

  /* ── Newsletter ─────────────────────────────────────────────────── */
  .footer__news {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 2rem;
    margin-top: 3.5rem;
    padding: 1.75rem 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }
  .footer__news-heading {
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--color-font);
    margin: 0;
  }
  .footer__news-desc {
    font-size: 0.86rem;
    line-height: 1.55;
    color: var(--color-muted);
    margin: 0.35rem 0 0;
    max-width: 34rem;
  }

  .footer__form {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
  }
  .footer__sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
  .footer__input {
    flex: 1;
    min-width: 0;
    width: 16rem;
    max-width: 100%;
    height: 40px;
    padding: 0 0.85rem;
    font: inherit;
    font-size: 0.88rem;
    /* Deliberately escapes .footer's on-foreground shadow above — this
       field sinks to the untinted --color-background (the normal "inputs
       sink" rule), so its own text/border must stay mode-only too. */
    color: var(--color-font-fixed);
    background: var(--color-background);
    border: 1px solid var(--color-border-fixed);
    border-radius: var(--radius-md);
    transition: border-color var(--ease), box-shadow var(--ease);
  }
  .footer__input::placeholder { color: var(--color-faint-fixed); }
  .footer__input:hover { border-color: var(--color-border-strong-fixed); }
  .footer__input:focus-visible {
    outline: none;
    border-color: var(--color-ring);
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--color-ring) 22%, transparent);
  }
  .footer__submit {
    flex-shrink: 0;
    height: 40px;
    padding: 0 1.15rem;
    font: inherit;
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--color-on-primary);
    background: var(--color-primary);
    border: 1px solid transparent;
    border-radius: var(--radius-md);
    cursor: pointer;
    white-space: nowrap;
    transition: opacity var(--ease), transform var(--ease);
  }
  .footer__submit:hover { opacity: 0.88; transform: translateY(-1px); }
  .footer__submit:focus-visible {
    outline: 2px solid var(--color-ring);
    outline-offset: 2px;
  }
  .footer__submit:disabled { cursor: default; opacity: 1; transform: none; }
  .footer__news-error {
    grid-column: 1 / -1;
    margin: 0.6rem 0 0;
    font-size: 0.82rem;
    color: var(--color-destructive);
  }
  .footer__news-error[hidden] { display: none; }

  /* ── Bottom bar ─────────────────────────────────────────────────── */
  .footer__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2rem;
  }
  /* When the newsletter is hidden, the bottom bar grows its own hairline. */
  .footer__news + .footer__bottom { margin-top: 1.5rem; }

  .footer__copy {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 0.82rem;
    color: var(--color-muted);
    margin: 0;
  }
  .footer__sep { color: var(--color-faint); }
  .footer__note { color: var(--color-muted); }

  .footer__legal {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.5rem;
  }
  .footer__legal-link {
    font-size: 0.82rem;
    color: var(--color-muted);
    text-decoration: none;
    transition: color var(--ease);
  }
  .footer__legal-link:hover { color: var(--color-font); }
  .footer__legal-link:focus-visible {
    outline: 2px solid var(--color-ring);
    outline-offset: 3px;
    border-radius: var(--radius-sm);
    color: var(--color-font);
  }

  /* ── Responsive ─────────────────────────────────────────────────── */
  @media (max-width: 880px) {
    .footer__inner { padding-top: 3.5rem; }
    .footer__top {
      grid-template-columns: 1fr;
      gap: 2.75rem;
    }
    .footer__brand { max-width: none; }
    .footer__columns { grid-template-columns: repeat(2, 1fr); gap: 2.25rem; }
    .footer__news {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
    .footer__form { width: 100%; }
    .footer__input { width: auto; flex: 1; }
  }
  @media (max-width: 480px) {
    .footer__columns { grid-template-columns: 1fr; gap: 2rem; }
    .footer__bottom { flex-direction: column; align-items: flex-start; }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer__social,
    .footer__submit { transition: color var(--ease), border-color var(--ease); }
    .footer__social:hover,
    .footer__submit:hover { transform: none; }
  }
</style>
