---
/**
 * Card.astro — one composable card, five elegant layouts.
 *
 * Usage:
 *   <!-- Feature: icon chip + title + body + link -->
 *   <Card variant="feature" accent="primary" href="/design">
 *     <svg slot="icon" …/>
 *     <Fragment slot="header">Design tokens</Fragment>
 *     Six tokens every component inherits. Change one value, the whole system responds.
 *     <a slot="footer" href="/design" class="card__link">Explore the system →</a>
 *   </Card>
 *
 *   <!-- Stat: oversized number + label + optional trend -->
 *   <Card variant="stat" stat="4,217" label="sites deployed" trend="up" trendLabel="+12% MoM" accent="primary" />
 *
 *   <!-- Profile: avatar + name + role + socials row -->
 *   <Card variant="profile" name="Sarah Mercer" role="Head of Growth, Acme" avatarInitials="SM"
 *         socials={[{ label: 'GitHub', href: '…', icon: 'github' }]} />
 *
 *   <!-- Pricing: tier + big price + period + feature list + CTA -->
 *   <Card variant="pricing" featured tier="Pro" price="$29" period="/mo"
 *         features={['Unlimited projects', 'AI chat', 'Priority support']}
 *         ctaLabel="Start free trial" ctaHref="/signup" accent="primary" />
 *
 * Variants:
 *   default — bare card surface; compose freely with media/icon/header/body/footer slots
 *   feature — icon chip → header → body → footer link (the home-page .card, elevated)
 *   stat    — oversized number + label + optional trend arrow
 *   profile — avatar (initials on --color-primary) + name + role + socials row
 *   pricing — tier name + big price + period + feature checklist + CTA in footer
 *
 * Props of note:
 *   href     — makes the WHOLE card a keyboard-focusable link (visible focus ring).
 *              Don't nest interactive controls inside; use a non-href card for those.
 *   featured — pricing only: primary ring + a small "Popular" badge.
 *   accent   — tints the icon chip / number / accents ('primary' | 'secondary' | 'tertiary').
 *   pattern  — attaches a background texture to the card surface, inked with the
 *              SAME accent and masked to fade before the body copy — one prop,
 *              color and pattern always agree.
 *
 * Tokens only — no hardcoded colours. Auto-flips for dark mode.
 * Slotted content is styled via :global() (slotted nodes carry the PARENT scope hash).
 */

import Pattern from './Pattern.astro'

type Accent = 'primary' | 'secondary' | 'tertiary'

interface Social {
  /** Accessible label, e.g. "GitHub". */
  label: string
  href: string
  /** Built-in glyph, or omit and pass your own <svg> — see icon set below. */
  icon?: 'github' | 'twitter' | 'linkedin' | 'globe' | 'mail'
}

interface Props {
  variant?: 'default' | 'feature' | 'stat' | 'profile' | 'pricing'
  /** Whole-card link. Keyboard-focusable with a visible ring. */
  href?: string
  /** Pricing: highlight as the recommended tier (ring + "Popular" badge). */
  featured?: boolean
  /** Tints the icon chip / number / accents. */
  accent?: Accent
  /** Background texture attached to the card surface — inked with the card's accent. */
  pattern?: 'dots' | 'grid' | 'diagonal' | 'crosshatch' | 'noise'
  /** Badge text for `featured` pricing cards. */
  badge?: string

  /* — stat — */
  stat?: string
  label?: string
  trend?: 'up' | 'down'
  trendLabel?: string

  /* — profile — */
  name?: string
  role?: string
  avatarInitials?: string
  socials?: Social[]

  /* — pricing — */
  tier?: string
  price?: string
  period?: string
  features?: string[]
  ctaLabel?: string
  ctaHref?: string
  /** Pricing: a named plan from lib/plan-pricing.ts — the CTA becomes a
   *  real checkout link (/payments?plan=…, both Stripe + crypto rails,
   *  the server-resolved real price), overriding ctaHref. */
  checkoutPlan?: string

  /** Extra class on the root. */
  class?: string
}

const {
  variant = 'default',
  href,
  featured = false,
  accent = 'primary',
  pattern,
  badge = 'Popular',
  stat,
  label,
  trend,
  trendLabel,
  name,
  role,
  avatarInitials,
  socials = [],
  tier,
  price,
  period,
  features = [],
  ctaLabel,
  ctaHref,
  checkoutPlan,
  class: className,
} = Astro.props

const resolvedCtaHref = checkoutPlan ? `/payments?plan=${encodeURIComponent(checkoutPlan)}` : ctaHref

// Whole-card link only when there's no in-card interactive content (pricing CTA, profile socials).
const interactive = !!href && variant !== 'pricing' && variant !== 'profile'
const Root = interactive ? 'a' : 'div'

const initials =
  avatarInitials ??
  (name
    ? name
        .trim()
        .split(/\s+/)
        .slice(0, 2)
        .map((w) => w[0])
        .join('')
        .toUpperCase()
    : '')

// Accent drives the icon-chip / number colour via currentColor on the .card__accent host.
const accentColor = `var(--color-${accent})`

// Inline social glyphs (1.5px stroke, round caps) — token-driven via currentColor.
const SOCIAL_PATHS: Record<NonNullable<Social['icon']>, string> = {
  github:
    'M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22',
  twitter:
    'M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z',
  linkedin:
    'M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6zM2 9h4v12H2zM4 2a2 2 0 1 1 0 4 2 2 0 0 1 0-4z',
  globe:
    'M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zM2 12h20M12 2a15.3 15.3 0 0 1 0 20 15.3 15.3 0 0 1 0-20z',
  mail: 'M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2zM22 6l-10 7L2 6',
}
---

<Root
  class:list={['card', `card--${variant}`, { 'card--featured': featured }, className]}
  style={`--card-accent:${accentColor}`}
  {...interactive ? { href } : {}}
>
  {
    pattern && (
      <span class="card__pattern" aria-hidden="true">
        <Pattern pattern={pattern} color="var(--card-accent)" opacity={pattern === 'noise' ? 0.14 : 0.08} />
      </span>
    )
  }

  {
    featured && variant === 'pricing' && (
      <span class="card__badge" aria-hidden="true">{badge}</span>
    )
  }

  <!-- media: top aspect box / image -->
  {
    Astro.slots.has('media') && (
      <div class="card__media">
        <slot name="media" />
      </div>
    )
  }

  {/* ── default — fully composable ───────────────────────────────── */}
  {
    variant === 'default' && (
      <>
        {Astro.slots.has('icon') && (
          <span class="card__chip" aria-hidden="true">
            <slot name="icon" />
          </span>
        )}
        {Astro.slots.has('header') && (
          <h3 class="card__title">
            <slot name="header" />
          </h3>
        )}
        <div class="card__body"><slot /></div>
        {Astro.slots.has('footer') && (
          <div class="card__footer"><slot name="footer" /></div>
        )}
      </>
    )
  }

  {/* ── feature — icon chip · title · body · link ─────────────────── */}
  {
    variant === 'feature' && (
      <>
        {Astro.slots.has('icon') && (
          <span class="card__chip" aria-hidden="true">
            <slot name="icon" />
          </span>
        )}
        <h3 class="card__title"><slot name="header" /></h3>
        <p class="card__body"><slot /></p>
        {Astro.slots.has('footer') && (
          <div class="card__footer"><slot name="footer" /></div>
        )}
      </>
    )
  }

  {/* ── stat — oversized number · label · trend ──────────────────── */}
  {
    variant === 'stat' && (
      <>
        <div class="card__stat">{stat}</div>
        <div class="card__statrow">
          {label && <span class="card__label">{label}</span>}
          {trend && (
            <span class:list={['card__trend', `card__trend--${trend}`]}>
              <svg
                width="13"
                height="13"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.4"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                {trend === 'up' ? (
                  <>
                    <polyline points="22 7 13.5 15.5 8.5 10.5 2 17" />
                    <polyline points="16 7 22 7 22 13" />
                  </>
                ) : (
                  <>
                    <polyline points="22 17 13.5 8.5 8.5 13.5 2 7" />
                    <polyline points="16 17 22 17 22 11" />
                  </>
                )}
              </svg>
              {trendLabel}
            </span>
          )}
        </div>
        {Astro.slots.has('default') && <div class="card__statfoot"><slot /></div>}
      </>
    )
  }

  {/* ── profile — avatar · name · role · socials ─────────────────── */}
  {
    variant === 'profile' && (
      <>
        <div class="card__person">
          <span class="card__avatar" aria-hidden="true">{initials}</span>
          <span class="card__who">
            {name && <span class="card__name">{name}</span>}
            {role && <span class="card__role">{role}</span>}
          </span>
        </div>
        {Astro.slots.has('default') && <p class="card__bio"><slot /></p>}
        {socials.length > 0 && (
          <div class="card__socials">
            {socials.map((s) => (
              <a
                class="card__social"
                href={s.href}
                aria-label={s.label}
                target="_blank"
                rel="noopener noreferrer"
              >
                {s.icon ? (
                  <svg
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.7"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    set:html={`<path d="${SOCIAL_PATHS[s.icon]}" />`}
                  />
                ) : (
                  s.label
                )}
              </a>
            ))}
          </div>
        )}
      </>
    )
  }

  {/* ── pricing — tier · price · features · CTA ──────────────────── */}
  {
    variant === 'pricing' && (
      <>
        <div class="card__tierhead">
          <h3 class="card__tier">{tier}</h3>
          {Astro.slots.has('header') && <p class="card__tiernote"><slot name="header" /></p>}
        </div>
        <div class="card__price">
          <span class="card__amount">{price}</span>
          {period && <span class="card__period">{period}</span>}
        </div>
        {features.length > 0 && (
          <ul class="card__features">
            {features.map((f) => (
              <li class="card__feature">
                <svg
                  class="card__check"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.4"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <polyline points="20 6 9 17 4 12" />
                </svg>
                <span>{f}</span>
              </li>
            ))}
          </ul>
        )}
        <div class="card__footer card__footer--cta">
          {ctaLabel && (
            <a
              class:list={['card__cta', { 'card__cta--solid': featured }]}
              href={resolvedCtaHref ?? '#'}
            >
              {ctaLabel}
            </a>
          )}
        </div>
      </>
    )
  }
</Root>

<style>
  /* ── Base surface — the home-page .card language, elevated ──────── */
  .card {
    position: relative;
    /* New stacking context so the pattern layer (z:-1) stays ABOVE the
       card's own background fill while sitting under every child. */
    isolation: isolate;
    display: flex;
    flex-direction: column;
    background-color: var(--color-background);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1.85rem;
    color: var(--color-font);
    text-decoration: none;
    box-shadow: var(--shadow-card);
    transition:
      border-color var(--ease),
      transform var(--ease),
      box-shadow var(--ease);
  }

  /* /patterns' "Background" pick — a real texture on the design system's
     actual L1 surface, not a decorative page-wide overlay. A pseudo-
     element (not a second `background-image` layer on .card itself) so
     --pattern-bg-opacity can dim JUST the image — these are legacy
     low-alpha web textures, often calibrated for a light L1 fill, so
     they need independent intensity control on a dark one. Defaults to
     `none`/`1` — a no-op until /patterns sets a pick. */
  .card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    pointer-events: none;
    background-image: var(--pattern-bg-image, none);
    background-repeat: repeat;
    opacity: var(--pattern-bg-opacity, 1);
  }

  /* ── Pattern layer — accent-inked texture attached to the card surface ── */
  .card__pattern {
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    overflow: hidden;
    pointer-events: none;
    /* Texture lives in the card's top zone (icon/title) and fades out
       before the body copy — pattern never runs under reading text. */
    -webkit-mask-image: linear-gradient(to bottom, black, transparent 72%);
    mask-image: linear-gradient(to bottom, black, transparent 72%);
  }

  /* Interactive (whole-card link) — hover lift + keyboard focus ring. */
  a.card:hover {
    border-color: var(--color-border-strong);
    transform: translateY(-2px);
    box-shadow: var(--shadow-pop);
  }
  a.card:focus-visible {
    outline: 2px solid var(--color-ring);
    outline-offset: 2px;
  }

  /* ── Icon chip — 40px rounded square, accent at 10% over transparent ── */
  .card__chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-md);
    color: var(--card-accent);
    background: color-mix(in oklab, var(--card-accent) 10%, transparent);
    margin-bottom: 1.1rem;
  }
  /* Slotted SVGs carry the PARENT scope hash, not ours — reach them with :global(). */
  .card__chip :global(svg) {
    width: 20px;
    height: 20px;
    display: block;
  }

  .card__title {
    font-size: 1.02rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--color-font);
    margin: 0;
    line-height: 1.3;
  }

  .card__body {
    font-size: 0.9rem;
    line-height: 1.65;
    color: var(--color-muted);
    margin: 0.55rem 0 0;
    flex: 1;
  }
  .card__body :global(code) {
    font-family: 'SF Mono', 'Fira Code', monospace;
    font-size: 0.82rem;
    color: var(--color-tertiary);
  }

  .card__footer {
    margin-top: 1.1rem;
  }
  /* Style slotted footer links consistently — but NOT the pricing CTA button
     (.card__cta), whose own button styles must win (the type+class specificity
     of `.card__footer a` would otherwise override the solid CTA's label colour
     to match its background, rendering it invisible). */
  .card__footer :global(a:not(.card__cta)) {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-primary);
    text-decoration: none;
  }
  .card__footer :global(a:not(.card__cta):hover) {
    text-decoration: underline;
  }

  .card__media {
    margin: -1.85rem -1.85rem 1.4rem;
    border-radius: var(--radius-lg) var(--radius-lg) 0 0;
    overflow: hidden;
  }
  .card__media :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  /* ── stat ───────────────────────────────────────────────────────── */
  .card--stat { gap: 0; }
  .card__stat {
    font-size: clamp(2.4rem, 5vw, 3.1rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--card-accent);
  }
  .card__statrow {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 0.75rem;
    flex-wrap: wrap;
  }
  .card__label {
    font-size: 0.82rem;
    color: var(--color-muted);
    line-height: 1.4;
  }
  .card__trend {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    padding: 0.15rem 0.5rem;
    border-radius: 9999px;
  }
  .card__trend--up {
    color: var(--color-success);
    background: color-mix(in oklab, var(--color-success) 12%, transparent);
  }
  .card__trend--down {
    color: var(--color-destructive);
    background: color-mix(in oklab, var(--color-destructive) 12%, transparent);
  }
  .card__statfoot {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
    font-size: 0.82rem;
    line-height: 1.6;
    color: var(--color-muted);
  }

  /* ── profile ────────────────────────────────────────────────────── */
  .card__person {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }
  .card__avatar {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--color-primary);
    color: var(--color-on-primary);
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    line-height: 1;
  }
  .card__who {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }
  .card__name {
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--color-font);
  }
  .card__role {
    font-size: 0.82rem;
    color: var(--color-muted);
    line-height: 1.45;
  }
  .card__bio {
    font-size: 0.88rem;
    line-height: 1.65;
    color: var(--color-muted);
    margin: 1.1rem 0 0;
    flex: 1;
  }
  .card__socials {
    display: flex;
    gap: 0.5rem;
    margin-top: 1.25rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--color-border);
  }
  .card__social {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
    color: var(--color-muted);
    text-decoration: none;
    font-size: 0.72rem;
    transition:
      color var(--ease),
      border-color var(--ease),
      background var(--ease);
  }
  .card__social:hover {
    color: var(--color-primary);
    border-color: color-mix(in oklab, var(--color-primary) 40%, transparent);
    background: color-mix(in oklab, var(--color-primary) 7%, transparent);
  }
  .card__social:focus-visible {
    outline: 2px solid var(--color-ring);
    outline-offset: 2px;
  }

  /* ── pricing ────────────────────────────────────────────────────── */
  .card--pricing { gap: 0; }
  .card--featured {
    border-color: color-mix(in oklab, var(--color-primary) 55%, var(--color-border));
    box-shadow:
      0 0 0 1px color-mix(in oklab, var(--color-primary) 45%, transparent),
      var(--shadow-pop);
  }
  .card__badge {
    position: absolute;
    top: 1.85rem;
    right: 1.85rem;
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--color-on-primary);
    background: var(--color-primary);
    border-radius: 9999px;
    padding: 0.22rem 0.7rem;
  }
  .card__tierhead {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .card__tier {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--card-accent);
    margin: 0;
  }
  .card__tiernote {
    font-size: 0.85rem;
    color: var(--color-muted);
    line-height: 1.5;
    margin: 0;
  }
  .card__price {
    display: flex;
    align-items: baseline;
    gap: 0.3rem;
    margin: 1.1rem 0 1.4rem;
  }
  .card__amount {
    font-size: clamp(2.4rem, 5vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--color-font);
  }
  .card__period {
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--color-muted);
  }
  .card__features {
    list-style: none;
    margin: 0 0 1.6rem;
    padding: 1.4rem 0 0;
    border-top: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    flex: 1;
  }
  .card__feature {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    font-size: 0.88rem;
    line-height: 1.5;
    color: var(--color-font);
  }
  .card__check {
    flex-shrink: 0;
    margin-top: 0.1rem;
    color: var(--color-tertiary);
  }
  .card__footer--cta {
    margin-top: auto;
    text-align: center;
  }
  .card__cta {
    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: auto;
    padding: 0.7rem 1.75rem;
    border-radius: var(--radius-md);
    font-size: 0.88rem;
    font-weight: 600;
    text-decoration: none;
    border: 1px solid var(--color-border-strong);
    background-color: var(--color-foreground);
    color: var(--color-on-foreground);
    transition:
      background var(--ease),
      border-color var(--ease),
      opacity var(--ease),
      transform var(--ease);
  }
  /* /patterns' "Foreground" pick — see .card::before above for why this is
     a pseudo-element (independent opacity) rather than a second
     background-image layer on the button itself. */
  .card__cta::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    pointer-events: none;
    background-image: var(--pattern-fg-image, none);
    background-repeat: repeat;
    opacity: var(--pattern-fg-opacity, 1);
  }
  .card__cta:hover {
    border-color: var(--color-primary);
    /* Not plain --color-primary — this button's own fill IS
