---
/**
 * Carousel.astro — a premium content carousel built on native CSS scroll-snap.
 *
 * No JS animation loop: the track is a horizontal scroll-snap container, and a
 * scoped script wires arrows / dots / keyboard via IntersectionObserver. Smooth
 * scroll is the only motion; it is disabled under prefers-reduced-motion.
 *
 * Two ways to provide slides (combine freely):
 *   1. Pass `items` — each renders inside an article slide.
 *   2. Use the default <slot> — each top-level child becomes a slide.
 *
 * Usage:
 *   <Carousel label="Customer stories">
 *     <div>…slide one…</div>
 *     <div>…slide two…</div>
 *   </Carousel>
 *
 *   <Carousel label="Features" items={[{ title, body }, …]} peek="lg" />
 *
 * NOTE: slotted children carry the *parent page's* scope hash, so the slide
 * padding/snap rules below target `.one-carousel-slide` (our own wrapper around
 * each child) rather than the children themselves — that stays scoped-clean.
 */

interface Item {
  /** Optional eyebrow above the title. */
  eyebrow?: string
  title?: string
  body?: string
}

interface Props {
  /** Accessible name for the carousel region. Required for a11y. */
  label: string
  /** Slides rendered from data. Combined with default <slot> children. */
  items?: Item[]
  /** Slide width as a fraction of the viewport track. */
  perView?: 1 | 2 | 3
  /** How much of the adjacent slide peeks in. */
  peek?: 'none' | 'sm' | 'md' | 'lg'
  /** Gap between slides. */
  gap?: string
  /** Extra class on the root region. */
  class?: string
}

const {
  label,
  items = [],
  perView = 1,
  peek = 'md',
  gap = '1.25rem',
  class: className = '',
} = Astro.props

const peekRem = { none: '0rem', sm: '1.5rem', md: '3rem', lg: '5rem' }[peek]

// A stable id so script + ARIA wiring can scope to this instance.
const uid = `carousel-${Math.random().toString(36).slice(2, 9)}`
---

<section
  class:list={['one-carousel', className]}
  role="region"
  aria-roledescription="carousel"
  aria-label={label}
  data-carousel={uid}
  style={`--cx-per-view-base:${perView}; --cx-peek:${peekRem}; --cx-gap:${gap};`}
>
  <div class="one-carousel-viewport">
    <div
      class="one-carousel-track"
      id={`${uid}-track`}
      tabindex="0"
      aria-label={`${label} — use arrow keys to navigate`}
    >
      {
        items.map((item) => (
          <article class="one-carousel-slide" aria-roledescription="slide">
            <div class="one-carousel-item">
              {item.eyebrow && <p class="one-carousel-eyebrow">{item.eyebrow}</p>}
              {item.title && <h3 class="one-carousel-item-title">{item.title}</h3>}
              {item.body && <p class="one-carousel-item-body">{item.body}</p>}
            </div>
          </article>
        ))
      }
      <slot />
    </div>
  </div>

  <div class="one-carousel-controls" data-controls={uid}>
    <button
      type="button"
      class="one-carousel-arrow"
      data-dir="prev"
      aria-label="Previous slide"
      disabled
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="15 18 9 12 15 6" />
      </svg>
    </button>

    <div class="one-carousel-dots" role="tablist" aria-label={`${label} slide picker`} data-dots={uid}></div>

    <button
      type="button"
      class="one-carousel-arrow"
      data-dir="next"
      aria-label="Next slide"
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="9 18 15 12 9 6" />
      </svg>
    </button>
  </div>

  <!-- Polite announcer — kept visually hidden, updated on slide change. -->
  <p class="one-carousel-live" aria-live="polite" data-live={uid}></p>
</section>

<style>
  .one-carousel {
    --cx-radius: var(--radius-lg);
    /* `--cx-per-view-base` is set inline from the prop; consumers may override
       `--cx-per-view` directly (e.g. responsive media queries) — an inline
       custom property would win the cascade, so the prop feeds the *-base var
       and this indirection keeps overrides working. */
    --cx-per-view: var(--cx-per-view-base, 1);
    display: block;
    width: 100%;
    max-width: 100%;
  }

  /* Viewport masks the overflow; the track scrolls inside it. */
  .one-carousel-viewport {
    position: relative;
    overflow: hidden;
    border-radius: var(--cx-radius);
  }

  .one-carousel-track {
    display: flex;
    gap: var(--cx-gap);
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    /* Reserve room so the peek of the next slide is visible. */
    padding: 0.25rem calc(var(--cx-peek) + 0.25rem) 1rem 0.25rem;
    scroll-padding-inline: 0.25rem;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    outline: none;
  }
  .one-carousel-track::-webkit-scrollbar { display: none; }

  .one-carousel-track:focus-visible {
    outline: 2px solid var(--color-ring);
    outline-offset: 3px;
    border-radius: var(--cx-radius);
  }

  /* Each slide is one snap target. Width derives from per-view + peek + gap. */
  .one-carousel-slide {
    scroll-snap-align: start;
    flex: 0 0 auto;
    box-sizing: border-box;
    width: calc(
      (100% - var(--cx-peek) - (var(--cx-per-view) - 1) * var(--cx-gap))
        / var(--cx-per-view)
    );
    min-width: 0;
  }

  /* Default card chrome for data-driven (items) slides. Slotted children
     bring their own markup, so this only styles the .one-carousel-item we wrap
     around `items`. */
  .one-carousel-item {
    height: 100%;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    background: var(--color-background);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 2rem;
    transition: border-color var(--ease), transform var(--ease), box-shadow var(--ease);
  }
  .one-carousel-item:hover {
    border-color: var(--color-border-strong);
    transform: translateY(-2px);
    box-shadow: var(--shadow-pop);
  }
  .one-carousel-eyebrow {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-primary);
    margin: 0;
  }
  .one-carousel-item-title {
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--color-font);
    margin: 0;
  }
  .one-carousel-item-body {
    font-size: 0.9rem;
    line-height: 1.65;
    color: var(--color-muted);
    margin: 0;
  }

  /* ── Controls ──────────────────────────────────────────────────── */
  .one-carousel-controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    margin-top: 1.25rem;
  }

  .one-carousel-arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    border-radius: 9999px;
    border: 1px solid var(--color-border);
    background: var(--color-foreground);
    color: var(--color-on-foreground);
    cursor: pointer;
    transition: transform var(--ease), border-color var(--ease), background var(--ease),
      color var(--ease), opacity var(--ease);
  }
  .one-carousel-arrow:hover:not(:disabled) {
    transform: translateY(-2px);
    border-color: var(--color-border-strong);
    background: color-mix(in oklab, var(--color-primary) 7%, var(--color-foreground));
    color: var(--color-primary);
    box-shadow: var(--shadow-pop);
  }
  .one-carousel-arrow:focus-visible {
    outline: 2px solid var(--color-ring);
    outline-offset: 2px;
  }
  .one-carousel-arrow:disabled {
    opacity: 0.35;
    cursor: default;
  }

  /* ── Dots ──────────────────────────────────────────────────────── */
  .one-carousel-dots {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  /* Dot rules live in the is:global block below — the dots are created by
     the init script, so they never receive Astro's scope attribute and any
     scoped rule for them is dead code (verified live: they rendered as
     unstyled default buttons). */

  /* Visually-hidden polite announcer. */
  .one-carousel-live {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .one-carousel-track { scroll-behavior: auto; }
    .one-carousel-arrow:hover:not(:disabled) { transform: none; }
  }
</style>

<!-- Slide snap + count badge must reach slotted children, which carry the
     parent page's scope hash — so these few rules are global, keyed by the
     wrapper class the script adds to every slide. -->
<style is:global>
  .one-carousel-track > * {
    scroll-snap-align: start;
  }
  /* Script-created dots — global on purpose (no Astro scope attribute).
     Visual is a 7px bar; padding + content-box clip grow the tap target
     to 25px (WCAG 2.5.8 needs ≥24) without changing the look. */
  .one-carousel-dot {
    box-sizing: content-box;
    width: 7px;
    height: 7px;
    padding: 9px;
    border: none;
    border-radius: 9999px;
    /* background-COLOR (not the shorthand) everywhere below — the shorthand
       resets background-clip and paints the full 25px hit area. */
    background-color: var(--color-faint);
    background-clip: content-box;
    cursor: pointer;
    transition: width var(--ease), background var(--ease), transform var(--ease);
  }
  .one-carousel-dot:hover {
    background-color: color-mix(in oklab, var(--color-primary) 55%, var(--color-faint));
  }
  .one-carousel-dot[aria-selected='true'] {
    width: 22px;
    background-color: var(--color-primary);
  }
  .one-carousel-dot:focus-visible {
    outline: 2px solid var(--color-ring);
    outline-offset: 3px;
  }
  .one-carousel-slide-wrap {
    position: relative;
    flex: 0 0 auto;
    box-sizing: border-box;
    min-width: 0;
  }
  .one-carousel-slide-wrap > * {
    height: 100%;
  }
  .one-carousel-sr-count {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
</style>

<script>
  // One initializer per carousel instance. Idempotent + reduced-motion aware.
  function initCarousel(root: HTMLElement) {
    if (root.dataset.cxReady === '1') return
    root.dataset.cxReady = '1'

    const track = root.querySelector<HTMLElement>('.one-carousel-track')
    const dotsHost = root.querySelector<HTMLElement>('.one-carousel-dots')
    const live = root.querySelector<HTMLElement>('.one-carousel-live')
    const prevBtn = root.querySelector<HTMLButtonElement>('.one-carousel-arrow[data-dir="prev"]')
    const nextBtn = root.querySelector<HTMLButtonElement>('.one-carousel-arrow[data-dir="next"]')
    if (!track || !dotsHost || !prevBtn || !nextBtn) return

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    const label = root.getAttribute('aria-label') || 'Carousel'

    // Normalize every direct child into a snap slide + add a visually-hidden
    // "N of M" count for screen readers (data-driven slides already carry the
    // .one-carousel-slide wrapper; slotted children get .one-carousel-slide-wrap).
    const slides = Array.from(track.children).filter(
      (c): c is HTMLElement => c instanceof HTMLElement,
    )
    const total = slides.length
    if (total === 0) return

    slides.forEach((slide, i) => {
      if (!slide.classList.contains('one-carousel-slide')) {
        slide.classList.add('one-carousel-slide-wrap')
      }
      slide.setAttribute('aria-roledescription', 'slide')
      slide.setAttribute('aria-label', `${i + 1} of ${total}`)
      // Sectioning elements (article/section) keep their implicit role —
      // overriding them with role="group" mis-shapes the accessibility tree.
      if (slide.tagName !== 'ARTICLE' && slide.tagName !== 'SECTION') {
        slide.setAttribute('role', 'group')
      }
      // Mirror the computed slide width onto wrapped slotted children so the
      // peek geometry matches the data-driven path.
      if (slide.classList.contains('one-carousel-slide-wrap')) {
        slide.style.width =
          'calc((100% - var(--cx-peek) - (var(--cx-per-view) - 1) * var(--cx-gap)) / var(--cx-per-view))'
      }
    })

    // Build dot indicators.
    const dots: HTMLButtonElement[] = slides.map((_, i) => {
      const dot = document.createElement('button')
      dot.type = 'button'
      dot.className = 'one-carousel-dot'
      dot.setAttribute('role', 'tab')
      dot.setAttribute('aria-label', `Go to slide ${i + 1}`)
      dot.addEventListener('click', () => scrollToIndex(i))
      dotsHost.appendChild(dot)
      return dot
    })

    let current = 0

    function scrollToIndex(i: number) {
      const idx = Math.max(0, Math.min(total - 1, i))
      const target = slides[idx]
      if (!target) return
      track!.scrollTo({
        left: target.offsetLeft - track!.offsetLeft,
        behavior: reduceMotion ? 'auto' : 'smooth',
      })
    }

    function render() {
      dots.forEach((d, i) => d.setAttribute('aria-selected', String(i === current)))
      prevBtn!.disabled = current <= 0
      nextBtn!.disabled = current >= total - 1
      if (live) live.textContent = `${label}: slide ${current + 1} of ${total}`
    }

    // Track the most-visible slide via IntersectionObserver — keeps dots and
    // arrow disabled-state synced to whatever the user lands on (drag, snap,
    // keyboard, or programmatic scroll).
    const ratios = new Array(total).fill(0)
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          const i = slides.indexOf(e.target as HTMLElement)
          if (i >= 0) ratios[i] = e.isIntersecting ? e.intersectionRatio : 0
        }
        let best = 0
        let bestRatio = -1
        for (let i = 0; i < total; i++) {
          if (ratios[i] > bestRatio) {
            bestRatio = ratios[i]
            best = i
          }
        }
        if (best !== current) {
          current = best
          render()
        }
      },
      { root: track, threshold: [0.25, 0.5, 0.75, 1] },
    )
    slides.forEach((s) => io.observe(s))

    prevBtn.addEventListener('click', () => scrollToIndex(current - 1))
    nextBtn.addEventListener('click', () => scrollToIndex(current + 1))

    // Keyboard navigation on the focusable track.
    track.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
        e.preventDefault()
        scrollToIndex(current + 1)
      } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
        e.preventDefault()
        scrollToIndex(current - 1)
      } else if (e.key === 'Home') {
        e.preventDefault()
        scrollToIndex(0)
      } else if (e.key === 'End') {
        e.preventDefault()
        scrollToIndex(total - 1)
      }
    })

    render()
  }

  function initAll() {
    document
      .querySelectorAll<HTMLElement>('.one-carousel')
      .forEach((el) => initCarousel(el))
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAll)
  } else {
    initAll()
  }
  // Re-run after Astro view transitions / client navigations.
  document.addEventListener('astro:page-load', initAll)
</script>
