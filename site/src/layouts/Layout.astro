---
import OneChat from '@oneie/plugin-chat/OneChat.astro'
import { getCollection } from 'astro:content'

interface Props {
  title: string
  description?: string
  ogTitle?: string
  ogDescription?: string
  ogImage?: string
  ogUrl?: string
}

const {
  title,
  description = 'The open-source Astro starter that ships payments, AI, and plugins on day one.',
  ogTitle,
  ogDescription,
  ogImage,
  ogUrl,
} = Astro.props

// Canonical + social defaults are derived so every page gets them for free —
// no page has to remember to pass og props. Canonical reflects the serving
// origin (the real host in production SSR).
const siteName = 'ONE'
const canonicalURL = new URL(Astro.url.pathname, Astro.url.origin).href
const ogT = ogTitle ?? title
const ogD = ogDescription ?? description

// Every product file in src/content/products/ becomes a real nav link,
// site-wide — writing a product is the whole "list it for sale" step.
const products = await getCollection('products')
const ogU = ogUrl ?? canonicalURL
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonicalURL} />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#eeeeee" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#1a1a1a" />

    <!-- Open Graph — always emitted, defaulted from title/description/URL -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={ogT} />
    <meta property="og:description" content={ogD} />
    <meta property="og:url" content={ogU} />
    {ogImage && <meta property="og:image" content={ogImage} />}

    <!-- Twitter -->
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={ogT} />
    <meta name="twitter:description" content={ogD} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />

    <!-- Critical tokens — inlined to prevent FOUC on first paint -->
    <style is:inline>
      :root {
        --color-background: hsl(0 0% 93%);
        --color-foreground: hsl(0 0% 100%);
        --color-font: hsl(0 0% 13%);
        --color-primary: hsl(216 55% 25%);
        --color-secondary: hsl(219 14% 28%);
        --color-tertiary: hsl(105 22% 25%);
        --color-on-primary: #fff;
        --color-on-secondary: #fff;
        --color-on-tertiary: #fff;
        --color-border: color-mix(in oklab, var(--color-font) 10%, transparent);
        --color-page: color-mix(in oklab, var(--color-background) 96%, var(--color-font));
        /* Invariants — never themed, never flipped. Declared here (not only in
           Tailwind's @theme) so var() references resolve at runtime everywhere. */
        --color-white: #fff;
        --color-black: #000;
        --color-destructive: hsl(0 70% 50%);
        --color-success: hsl(140 60% 40%);
        --color-on-destructive: #fff;
        --color-on-success: #fff;
        --color-gold: hsl(42 90% 52%);
      }
      html.dark {
        --color-background: hsl(0 0% 10%);
        --color-foreground: hsl(0 0% 13%);
        --color-font: hsl(0 0% 100%);
        --color-primary: hsl(216 55% 65%);
        --color-secondary: hsl(219 14% 65%);
        --color-tertiary: hsl(105 22% 65%);
        --color-on-primary: #000;
        --color-on-secondary: #000;
        --color-on-tertiary: #000;
        /* Status invariants lighten in dark mode so small text on dark
           surfaces keeps WCAG AA contrast (the light values sit ~3.3:1). */
        --color-destructive: hsl(0 75% 66%);
        --color-success: hsl(140 55% 55%);
        --color-on-destructive: #000;
        --color-on-success: #000;
      }
      body { background: var(--color-page); color: var(--color-font); margin: 0; }
    </style>

    <!--
      Anti-FOUC: runs synchronously before first paint.
      Reads localStorage, applies dark class + theme CSS vars immediately.
    -->
    <script is:inline>
      (function () {
        /* Six preset themes — light/dark token pairs + swatch color */
        window.__T = {
          navy:   { l:['hsl(216 55% 25%)','hsl(219 14% 28%)','hsl(105 22% 25%)'], d:['hsl(216 55% 65%)','hsl(219 14% 65%)','hsl(105 22% 65%)'], s:'hsl(216 55% 35%)', name:'Navy'   },
          ocean:  { l:['hsl(198 70% 28%)','hsl(175 55% 28%)','hsl(210 80% 30%)'], d:['hsl(198 70% 62%)','hsl(175 55% 62%)','hsl(210 80% 65%)'], s:'hsl(198 60% 38%)', name:'Ocean'  },
          forest: { l:['hsl(140 45% 22%)','hsl(160 35% 26%)','hsl(90  40% 24%)'], d:['hsl(140 45% 60%)','hsl(160 35% 62%)','hsl(90  40% 60%)'], s:'hsl(140 42% 30%)', name:'Forest' },
          sunset: { l:['hsl(24  75% 35%)','hsl(35  65% 38%)','hsl(4   60% 35%)'], d:['hsl(24  75% 65%)','hsl(35  65% 65%)','hsl(4   60% 65%)'], s:'hsl(24  70% 42%)', name:'Sunset' },
          violet: { l:['hsl(268 55% 30%)','hsl(248 50% 35%)','hsl(288 45% 30%)'], d:['hsl(268 55% 68%)','hsl(248 50% 68%)','hsl(288 45% 68%)'], s:'hsl(268 50% 40%)', name:'Violet' },
          rose:   { l:['hsl(342 65% 35%)','hsl(320 50% 38%)','hsl(14  60% 36%)'], d:['hsl(342 65% 68%)','hsl(320 50% 68%)','hsl(14  60% 65%)'], s:'hsl(342 60% 43%)', name:'Rose'   },
        }

        window.__applyTheme = function (name, dark) {
          var t = window.__T[name]; if (!t) return
          var c = dark ? t.d : t.l, on = dark ? '#000' : '#fff'
          var el = document.documentElement
          el.style.setProperty('--color-primary',      c[0])
          el.style.setProperty('--color-secondary',    c[1])
          el.style.setProperty('--color-tertiary',     c[2])
          el.style.setProperty('--color-on-primary',   on)
          el.style.setProperty('--color-on-secondary', on)
          el.style.setProperty('--color-on-tertiary',  on)
        }

        /* Custom token overrides — written by /design's editor ('one-custom'),
           applied on EVERY page so picks survive navigation. Same inline-style
           mechanism as presets, so there is exactly one specificity level. */
        var TOKENS = ['background', 'foreground', 'font', 'primary', 'secondary', 'tertiary']
        window.__applyCustom = function (custom, dark) {
          var set = dark ? custom.dark : custom.light
          if (!set) return
          var el = document.documentElement
          TOKENS.forEach(function (k) {
            if (set[k]) el.style.setProperty('--color-' + k, 'hsl(' + set[k] + ')')
          })
          ;['primary', 'secondary', 'tertiary'].forEach(function (k) {
            if (set[k]) el.style.setProperty('--color-on-' + k,
              parseFloat(set[k].split(/\s+/)[2]) < 60 ? '#fff' : '#000')
          })
        }

        /* The one entry point: preset first, custom on top, then announce.
           Every control (nav swatches, nav mode button, /design's editor)
           routes through this — single source of truth. */
        window.__syncTheme = function () {
          var el = document.documentElement
          var dark = el.classList.contains('dark')
          TOKENS.forEach(function (k) {
            el.style.removeProperty('--color-' + k)
            el.style.removeProperty('--color-on-' + k)
          })
          window.__applyTheme(localStorage.getItem('one-theme') || 'navy', dark)
          var raw = localStorage.getItem('one-custom')
          if (raw) { try { window.__applyCustom(JSON.parse(raw), dark) } catch (e) {} }
          window.dispatchEvent(new CustomEvent('one:theme'))
        }

        var rawDark = localStorage.getItem('one-dark')
        var dark = rawDark !== null
          ? rawDark === 'true'
          : window.matchMedia('(prefers-color-scheme: dark)').matches
        if (dark) document.documentElement.classList.add('dark')
        window.__syncTheme()
      })()
    </script>

    <slot name="head" />
  </head>

  <body>

    <!-- ── Nav ──────────────────────────────────────────────────── -->
    <header id="one-nav">
      <div class="one-nav-left">
        <a href="/" class="one-logo">ONE</a>
        <nav class="one-nav-links" aria-label="Primary">
          <a href="/payments">Payments</a>
          {products.map((p) => (
            <a href={`/products/${p.id}`}>{p.data.name}</a>
          ))}
          <a href="/wallet">Wallet</a>
          <a href="/lifecycle">Lifecycle</a>
          <a href="/design">Design</a>
          <a href="/motion">Motion</a>
          <a href="/components">Components</a>
        </nav>
      </div>
      <div class="one-controls">
        <div id="one-swatches" class="one-swatches" role="group" aria-label="Color theme"></div>
        <div class="one-divider"></div>
        <button id="one-mode" class="one-mode" type="button" aria-label="Toggle dark mode"></button>
        <button
          id="one-menu-btn"
          class="one-menu-btn"
          type="button"
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="one-mobile-menu"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 6h18M3 12h18M3 18h18" /></svg>
        </button>
      </div>
    </header>

    <!-- Mobile menu — the primary links are display:none under 640px; this
         drawer restores them (opened by the hamburger above). -->
    <nav id="one-mobile-menu" class="one-mobile-menu" aria-label="Primary (mobile)">
      <a href="/payments">Payments</a>
      {products.map((p) => (
        <a href={`/products/${p.id}`}>{p.data.name}</a>
      ))}
      <a href="/wallet">Wallet</a>
      <a href="/lifecycle">Lifecycle</a>
      <a href="/design">Design</a>
      <a href="/motion">Motion</a>
      <a href="/components">Components</a>
    </nav>

    <!-- ── Page content ─────────────────────────────────────────── -->
    <main>
      <slot />
    </main>
    <slot name="footer" />

    <!-- ── Chat widget ───────────────────────────────────────────── -->
    <OneChat
      agent="one"
      view="icon"
      position="right"
      greeting="Hi! Ask me anything about the ONE platform."
    />

    <!-- ── Theme wiring — runs after DOM is ready ───────────────── -->
    <script is:inline>
      (function () {
        var T = window.__T
        var names = Object.keys(T)

        function state() {
          return {
            theme: localStorage.getItem('one-theme') || 'navy',
            dark: document.documentElement.classList.contains('dark'),
            custom: localStorage.getItem('one-custom') !== null,
          }
        }

        function apply(name, d) {
          d ? document.documentElement.classList.add('dark')
            : document.documentElement.classList.remove('dark')
          localStorage.setItem('one-theme', name)
          localStorage.setItem('one-dark', String(d))
          window.__syncTheme()
        }

        function sync() {
          var s = state()
          document.querySelectorAll('.one-sw').forEach(function (b) {
            /* A custom edit (from /design) means no preset is "the" theme —
               drop the active ring until a preset is picked again. */
            var on = !s.custom && b.dataset.t === s.theme
            b.style.outline      = on ? '2px solid ' + T[s.theme].s : 'none'
            b.style.outlineOffset = '2px'
            b.style.transform    = on ? 'scale(1.15)' : 'scale(1)'
          })
          var mb = document.getElementById('one-mode')
          if (mb) mb.innerHTML = s.dark
            ? '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>'
            : '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>'
        }

        /* Build swatch buttons — picking a preset leaves custom-edit mode */
        var sc = document.getElementById('one-swatches')
        names.forEach(function (name) {
          var b = document.createElement('button')
          b.className = 'one-sw'
          b.title = T[name].name
          b.dataset.t = name
          b.type = 'button'
          b.style.background = T[name].s
          b.setAttribute('aria-label', T[name].name + ' theme')
          b.onclick = function () {
            localStorage.removeItem('one-custom')
            apply(name, state().dark)
          }
          sc.appendChild(b)
        })

        /* Mode toggle — keeps custom edits, flips their mode set */
        var mb = document.getElementById('one-mode')
        if (mb) mb.onclick = function () {
          var s = state()
          apply(s.theme, !s.dark)
        }

        /* Mobile menu — hamburger toggles the drawer of primary links that
           are display:none under 640px. Closes on link click and Escape. */
        var menuBtn = document.getElementById('one-menu-btn')
        var menu = document.getElementById('one-mobile-menu')
        if (menuBtn && menu) {
          function setMenu(open) {
            menu.classList.toggle('open', open)
            menuBtn.setAttribute('aria-expanded', String(open))
          }
          menuBtn.onclick = function () { setMenu(!menu.classList.contains('open')) }
          menu.querySelectorAll('a').forEach(function (a) {
            a.addEventListener('click', function () { setMenu(false) })
          })
          window.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') setMenu(false)
          })
        }

        /* Stay honest when another surface (e.g. /design's editor) changes
           the theme — __syncTheme dispatches this after every apply. */
        window.addEventListener('one:theme', sync)
        sync()
      })()
    </script>

  </body>
</html>

<style>
  /*
   * ONE Design System — 6 extractable tokens + 5 invariants + derived helpers.
   */
  @theme {
    --color-*: initial;

    /* Invariants */
    --color-white: #fff;
    --color-black: #000;
    --color-transparent: transparent;
    --color-current: currentColor;
    --color-destructive: hsl(0 70% 50%);
    --color-success: hsl(140 60% 40%);

    /* 6 extractable tokens */
    --color-background: hsl(0 0% 93%);
    --color-foreground: hsl(0 0% 100%);
    --color-font: hsl(0 0% 13%);
    --color-primary: hsl(216 55% 25%);
    --color-secondary: hsl(219 14% 28%);
    --color-tertiary: hsl(105 22% 25%);

    /* Auto-contrast labels */
    --color-on-primary: #fff;
    --color-on-secondary: #fff;
    --color-on-tertiary: #fff;

    /* shadcn/ui aliases */
    --color-popover: var(--color-background);
    --color-popover-foreground: var(--color-font);
    --color-card: var(--color-background);
    --color-card-foreground: var(--color-font);
    --color-muted: var(--color-foreground);
    --color-muted-foreground: color-mix(in oklab, var(--color-font) 60%, transparent);
    --color-accent: var(--color-foreground);
    --color-accent-foreground: var(--color-font);
    --color-input: var(--color-background);
  }

  :root {
    --color-border:        color-mix(in oklab, var(--color-font) 10%, transparent);
    --color-border-strong: color-mix(in oklab, var(--color-font) 20%, transparent);
    --color-muted:         color-mix(in oklab, var(--color-font) 60%, transparent);
    --color-faint:         color-mix(in oklab, var(--color-font) 40%, transparent);
    --color-ring:          var(--color-primary);
    --color-page:          color-mix(in oklab, var(--color-background) 96%, var(--color-font));

    --content-narrow: 42rem;
    --content:        56rem;
    --content-wide:   64rem;

    --radius-sm: 6px;
    --radius-md: 10px;
    --radius-lg: 16px;

    --shadow-card: 0 1px 2px color-mix(in oklab, var(--color-font) 6%, transparent);
    --shadow-pop:  0 4px 16px color-mix(in oklab, var(--color-font) 10%, transparent);
    --ease: 120ms ease;
  }

  html.dark {
    --color-background: hsl(0 0% 10%);
    --color-foreground: hsl(0 0% 13%);
    --color-font:       hsl(0 0% 100%);
    --color-primary:    hsl(216 55% 65%);
    --color-secondary:  hsl(219 14% 65%);
    --color-tertiary:   hsl(105 22% 65%);
    --color-on-primary: #000;
    --color-on-secondary: #000;
    --color-on-tertiary: #000;
  }

  body {
    background:  var(--color-page);
    color:       var(--color-font);
    font-family: system-ui, sans-serif;
    margin:      0;
  }

  /* ── Nav ───────────────────────────────────────────────────────── */
  #one-nav {
    position: sticky;
    top: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 1.5rem;
    height: 52px;
    background: color-mix(in oklab, var(--color-foreground) 90%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-border);
  }

  .one-logo {
    font-size: 0.9rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--color-primary);
    text-decoration: none;
    transition: opacity var(--ease);
  }
  .one-logo:hover { opacity: 0.75; }

  .one-nav-left { display: flex; align-items: center; gap: 1.5rem; }
  .one-nav-links { display: flex; align-items: center; gap: 1.25rem; }
  .one-nav-links a {
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--color-muted);
    text-decoration: none;
    transition: color var(--ease);
  }
  .one-nav-links a:hover { color: var(--color-font); }

  /* ── Mobile menu ───────────────────────────────────────────────── */
  .one-menu-btn {
    display: none;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
    background: var(--color-background);
    color: var(--color-font);
    cursor: pointer;
    flex-shrink: 0;
    transition: background var(--ease), border-color var(--ease), color var(--ease);
  }
  .one-menu-btn:hover {
    background: color-mix(in oklab, var(--color-primary) 8%, var(--color-background));
    border-color: color-mix(in oklab, var(--color-primary) 40%, transparent);
    color: var(--color-primary);
  }
  .one-mobile-menu {
    display: none;
    position: sticky;
    top: 52px;
    z-index: 99;
    flex-direction: column;
    padding: 0.25rem 1.5rem 0.75rem;
    background: color-mix(in oklab, var(--color-foreground) 92%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-border);
  }
  .one-mobile-menu.open { display: flex; }
  .one-mobile-menu a {
    padding: 0.75rem 0.25rem;
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--color-font);
    text-decoration: none;
    border-bottom: 1px solid var(--color-border);
  }
  .one-mobile-menu a:last-child { border-bottom: none; }

  @media (max-width: 640px) {
    .one-nav-links { display: none; }
    .one-menu-btn { display: flex; }
  }
  /* Never leave the drawer open past the breakpoint where the button vanishes. */
  @media (min-width: 641px) { .one-mobile-menu.open { display: none; } }

  .one-controls {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .one-swatches {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .one-divider {
    width: 1px;
    height: 18px;
    background: var(--color-border);
  }

  .one-mode {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
    background: var(--color-background);
    color: var(--color-font);
    cursor: pointer;
    transition: background var(--ease), border-color var(--ease), color var(--ease);
    flex-shrink: 0;
  }
  .one-mode:hover {
    background: color-mix(in oklab, var(--color-primary) 8%, var(--color-background));
    border-color: color-mix(in oklab, var(--color-primary) 40%, transparent);
    color: var(--color-primary);
  }
</style>

<!-- Swatch styles must be global — buttons are created by JS and don't get the Astro scope attribute -->
<style is:global>
  .one-sw {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    border: none;
    cursor: pointer;
    padding: 0;
    flex-shrink: 0;
    transition: transform 120ms ease, outline 80ms ease;
  }
  .one-sw:hover { transform: scale(1.25) !important; }
</style>
