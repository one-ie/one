{
  "name": "web",
  "version": "0.1.0",
  "description": "ONE starter — Astro 6 + React 19 + shadcn/ui on Cloudflare Workers",
  "type": "module",
  "private": true,
  "scripts": {
    "setup": "oneie init --write-env --name web",
    "dev": "astro dev",
    "build": "astro build",
    "typecheck": "astro check",
    "preview": "astro preview",
    "deploy": "astro build && wrangler deploy",
    "deploy:template": "astro build && wrangler deploy --config wrangler.template-deploy.toml"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^13.3.1",
    "@astrojs/react": "^5.0.4",
    "@oneie/frontend": "^0.1.0",
    "@oneie/plugin-chat": "^0.1.0",
    "@stripe/react-stripe-js": "^6.7.0",
    "@stripe/stripe-js": "^9.9.0",
    "@tailwindcss/vite": "^4.0.0",
    "astro": "^6.2.2",
    "better-auth": "^1.6.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.14.0",
    "motion": "^12.38.0",
    "radix-ui": "^1.4.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sonner": "^2.0.7",
    "stripe": "^22.3.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.0.0",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@oneie/cli": "^0.10.0",
    "@astrojs/check": "^0.9.9",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5.7.3",
    "vite": "7.3.2",
    "wrangler": "^4.0.0"
  }
}
